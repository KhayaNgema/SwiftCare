        /* ============================================================
           DURATION
           ============================================================ */

        function formatDuration(
            seconds
        ) {

            if (
                !seconds ||
                seconds < 1
            ) {

                return "Voice";

            }


            const rounded =
                Math.max(
                    1,
                    Math.round(seconds)
                );


            const minutes =
                Math.floor(
                    rounded / 60
                );


            return minutes
                ? `${minutes}:${String(rounded % 60).padStart(2, "0")}`
                : `${rounded}s`;

        }


        /* ============================================================
           WAIT
           ============================================================ */

        const wait =
            milliseconds =>
                new Promise(
                    resolve =>
                        setTimeout(
                            resolve,
                            milliseconds
                        )
                );


        /* ============================================================
           AZURE SPEECH TOKEN
           ============================================================ */

        async function getAzureSpeechToken() {

            if (
                speechTokenPromise &&
                speechTokenExpiresAt >
                Date.now() + 30000
            ) {

                return speechTokenPromise;

            }


            speechTokenPromise =
                fetch(
                    "/VolunteerInterview/SpeechToken?token=" +
                    encodeURIComponent(
                        sessionToken
                    ),
                    {
                        cache:
                            "no-store"
                    }
                )
                .then(
                    async response => {

                        const data =
                            await response
                                .json()
                                .catch(
                                    () => null
                                );


                        if (
                            !response.ok ||
                            !data?.success ||
                            !data.token ||
                            !data.region
                        ) {

                            throw new Error(
                                "Could not obtain Azure Speech token."
                            );

                        }


                        speechTokenExpiresAt =
                            Date.now() +
                            9 * 60 * 1000;


                        return data;

                    }
                )
                .catch(
                    error => {

                        speechTokenPromise =
                            null;

                        speechTokenExpiresAt =
                            0;

                        throw error;

                    }
                );


            return speechTokenPromise;

        }


        /* ============================================================
           CREATE RECOGNIZER
           ============================================================ */

        async function createRecognizer() {

            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                throw new Error(
                    "Azure Speech SDK is not loaded."
                );

            }


            const data =
                await getAzureSpeechToken();


            const config =
                SpeechSDK.SpeechConfig
                    .fromAuthorizationToken(
                        data.token,
                        data.region
                    );


            config.speechRecognitionLanguage =
                "en-ZA";


            try {

                config.setProperty(
                    SpeechSDK.PropertyId
                        .SpeechServiceConnection_EndSilenceTimeoutMs,
                    "1500"
                );

            }
            catch (_) {}


            return new SpeechSDK.SpeechRecognizer(
                config,
                SpeechSDK.AudioConfig
                    .fromDefaultMicrophoneInput()
            );

        }


        /* ============================================================
           SILENCE TIMER
           ============================================================ */

        function clearSilenceTimer() {

            if (silenceTimer) {

                clearTimeout(
                    silenceTimer
                );

            }


            silenceTimer =
                null;

        }


        function armSilenceTimer() {

            clearSilenceTimer();


            if (
                !listeningNow ||
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            silenceTimer =
                setTimeout(
                    () => {

                        if (
                            !interviewCompleted &&
                            !suspiciousActivityHandled &&
                            !terminatingInterview
                        ) {

                            finishListeningAndSubmit()
                                .catch(
                                    console.error
                                );

                        }

                    },
                    ANSWER_SILENCE
                );

        }


        /* ============================================================
           START MICROPHONE
           ============================================================ */

        async function startListening() {

            if (
                microphoneStarting ||
                speaking ||
                questionProcessing ||
                !greetingFinished ||
                interviewCompleted ||
                submittingAnswer ||
                listeningNow ||
                !currentQuestionId ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            microphoneStarting =
                true;


            const myQuestion =
                currentQuestionKey;


            answerParts =
                [];


            speechStartedAt =
                Date.now();


            recognitionStopping =
                false;


            hideThinking();


            try {

                const recognizer =
                    await createRecognizer();


                if (
                    speaking ||
                    questionProcessing ||
                    myQuestion !== currentQuestionKey ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    recognizer.close();

                    return;

                }


                speechRecognizer =
                    recognizer;


                recognizer.recognizing =
                    (_, event) => {

                        if (
                            !listeningNow ||
                            submittingAnswer
                        ) {

                            return;

                        }


                        if (
                            (
                                event?.result?.text ||
                                ""
                            )
                            .trim()
                            .length >
                            MINIMUM_ANSWER_LENGTH
                        ) {

                            clearSilenceTimer();

                        }

                    };


                recognizer.recognized =
                    (_, event) => {

                        if (
                            !listeningNow ||
                            submittingAnswer ||
                            interviewCompleted ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return;

                        }


                        if (
                            event?.result?.reason !==
                            SpeechSDK.ResultReason
                                .RecognizedSpeech
                        ) {

                            return;

                        }


                        const value =
                            (
                                event.result.text ||
                                ""
                            )
                            .trim();


                        if (value) {

                            answerParts.push(
                                value
                            );


                            armSilenceTimer();

                        }

                    };


                recognizer.canceled =
                    () => {

                        if (
                            speechRecognizer !==
                            recognizer ||
                            recognitionStopping ||
                            submittingAnswer ||
                            interviewCompleted ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return;

                        }


                        speechRecognizer =
                            null;


                        listeningNow =
                            false;


                        hideListening();


                        try {

                            recognizer.close();

                        }
                        catch (_) {}


                        setStatus(
                            "Reconnecting microphone..."
                        );


                        setTimeout(
                            () =>
                                startListening()
                                    .catch(
                                        console.error
                                    ),
                            900
                        );

                    };


                recognizer.sessionStopped =
                    () => {

                        if (
                            speechRecognizer !==
                            recognizer ||
                            recognitionStopping ||
                            submittingAnswer ||
                            interviewCompleted ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return;

                        }


                        speechRecognizer =
                            null;


                        listeningNow =
                            false;


                        hideListening();


                        try {

                            recognizer.close();

                        }
                        catch (_) {}


                        if (
                            answerParts.length
                        ) {

                            submitCollectedAnswer()
                                .catch(
                                    console.error
                                );

                        }
                        else {

                            setTimeout(
                                () =>
                                    startListening()
                                        .catch(
                                            console.error
                                        ),
                                900
                            );

                        }

                    };


                await new Promise(
                    (
                        resolve,
                        reject
                    ) => {

                        recognizer
                            .startContinuousRecognitionAsync(
                                resolve,
                                reject
                            );

                    }
                );


                if (
                    speechRecognizer !==
                    recognizer ||
                    speaking ||
                    questionProcessing ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    try {

                        recognizer
                            .stopContinuousRecognitionAsync(
                                () =>
                                    recognizer.close(),
                                () =>
                                    recognizer.close()
                            );

                    }
                    catch (_) {

                        try {

                            recognizer.close();

                        }
                        catch (_) {}

                    }


                    return;

                }


                listeningNow =
                    true;


                showListening();


                setStatus(
                    "Listening..."
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] Microphone error:",
                    error
                );


                listeningNow =
                    false;


                hideListening();


                if (speechRecognizer) {

                    try {

                        speechRecognizer.close();

                    }
                    catch (_) {}


                    speechRecognizer =
                        null;

                }


                if (
                    !interviewCompleted &&
                    !suspiciousActivityHandled &&
                    !terminatingInterview
                ) {

                    setStatus(
                        "Microphone unavailable; you can type your answer.",
                        true
                    );


                    setTimeout(
                        () =>
                            startListening()
                                .catch(
                                    console.error
                                ),
                        1800
                    );

                }

            }
            finally {

                microphoneStarting =
                    false;

            }

        }


        /* ============================================================
           STOP RECOGNITION
           ============================================================ */

        async function stopRecognition() {

            clearSilenceTimer();


            listeningNow =
                false;


            hideListening();


            const recognizer =
                speechRecognizer;


            speechRecognizer =
                null;


            if (!recognizer)
                return;


            recognitionStopping =
                true;


            try {

                await new Promise(
                    resolve =>
                        recognizer
                            .stopContinuousRecognitionAsync(
                                resolve,
                                resolve
                            )
                );

            }
            catch (_) {}


            try {

                recognizer.close();

            }
            catch (_) {}


            recognitionStopping =
                false;

        }


        /* ============================================================
           FINISH LISTENING
           ============================================================ */

        async function finishListeningAndSubmit() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            if (!answerParts.length) {

                armSilenceTimer();

                return;

            }


            await submitCollectedAnswer();

        }


        /* ============================================================
           SERVER SUSPICIOUS STATE
           ============================================================ */

        async function handleServerSuspiciousState(
            message
        ) {

            if (
                suspiciousActivityHandled ||
                interviewCompleted
            ) {

                return;

            }


            suspiciousActivityHandled =
                true;


            interviewCompleted =
                true;


            cancelActiveSpeech();


            clearSilenceTimer();


            setTextResponseEnabled(
                false
            );


            await stopRecognition();


            hideListening();

            hideThinking();


            if (suspiciousOverlay) {

                suspiciousOverlay.classList.add(
                    "scv-visible"
                );

            }


            if (suspiciousStatus) {

                suspiciousStatus.textContent =
                    message ||
                    "This interview has already been submitted for administrative review.";

            }


            setStatus(
                "Interview ended",
                true
            );


            stopCameraTracks();

        }


        /* ============================================================
           REVIEW ERROR
           ============================================================ */

        function isReviewError(
            error
        ) {

            const message =
                String(
                    error?.message ||
                    error
                ).toLowerCase();


            return (
                message.includes(
                    "administrative review"
                ) ||
                message.includes(
                    "ended and submitted"
                )
            );

        }


        /* ============================================================
           SUBMIT VOICE ANSWER
           ============================================================ */

        async function submitCollectedAnswer() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            const answer =
                answerParts
                    .join(" ")
                    .trim();


            if (
                answer.length <
                MINIMUM_ANSWER_LENGTH
            ) {

                armSilenceTimer();

                return;

            }


            submittingAnswer =
                true;


            clearSilenceTimer();


            const duration =
                speechStartedAt
                    ? (
                        Date.now() -
                        speechStartedAt
                    ) / 1000
                    : 0;


            await stopRecognition();


            if (
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            addApplicantVoiceBubble(
                duration
            );


            answerParts =
                [];


            setStatus(
                "Interviewer is thinking..."
            );


            showThinking();


            try {

                if (
                    connection?.state !==
                    signalR.HubConnectionState.Connected
                ) {

                    throw new Error(
                        "Interview connection is unavailable."
                    );

                }


                console.log(
                    "[SWIFTCARE] SubmitAnswer:",
                    {
                        questionNumber:
                            currentQuestionNumber
                    }
                );


                await connection.invoke(
                    "SubmitAnswer",
                    sessionToken,
                    answer
                );


            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] SubmitAnswer failed:",
                    error
                );


                if (
                    isReviewError(error)
                ) {

                    await handleServerSuspiciousState();

                    return;

                }


                submittingAnswer =
                    false;


                hideThinking();


                setStatus(
                    "Could not submit answer. Please type or try again.",
                    true
                );


                setTimeout(
                    () =>
                        startListening()
                            .catch(
                                console.error
                            ),
                    1000
                );

            }

        }


        /* ============================================================
           SUBMIT TEXT ANSWER
           ============================================================ */

        async function submitTextAnswer() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            if (
                !currentQuestionId ||
                !greetingFinished ||
                questionProcessing
            ) {

                setStatus(
                    "Please wait until the question has finished.",
                    true
                );

                return;

            }


            const answer =
                (
                    textResponse?.value ||
                    ""
                ).trim();


            if (
                answer.length <
                MINIMUM_ANSWER_LENGTH ||
                answer.length >
                MAX_TEXT_RESPONSE_LENGTH
            ) {

                setStatus(
                    "Enter an answer of up to 3000 characters.",
                    true
                );


                focusTextResponse();


                return;

            }


            submittingAnswer =
                true;


            clearSilenceTimer();


            await stopRecognition();


            if (
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            addApplicantTextBubble(
                answer
            );


            clearTextResponse();


            setTextResponseEnabled(
                false
            );


            setStatus(
                "Interviewer is thinking..."
            );


            showThinking();


            try {

                if (
                    connection?.state !==
                    signalR.HubConnectionState.Connected
                ) {

                    throw new Error(
                        "Interview connection is unavailable."
                    );

                }


                console.log(
                    "[SWIFTCARE] SubmitAnswer typed:",
                    {
                        questionNumber:
                            currentQuestionNumber
                    }
                );


                await connection.invoke(
                    "SubmitAnswer",
                    sessionToken,
                    answer
                );


            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] Text answer failed:",
                    error
                );


                if (
                    isReviewError(error)
                ) {

                    await handleServerSuspiciousState();

                    return;

                }


                submittingAnswer =
                    false;


                hideThinking();


                setTextResponseEnabled(
                    true
                );


                if (textResponse) {

                    textResponse.value =
                        answer;


                    updateTextResponseCount();

                }


                setStatus(
                    "Could not submit your answer. Please try again.",
                    true
                );

            }

        }


        /* ============================================================
           TEXT EVENTS
           ============================================================ */

        textResponse?.addEventListener(
            "input",
            () => {

                if (
                    textResponse.value.length >
                    MAX_TEXT_RESPONSE_LENGTH
                ) {

                    textResponse.value =
                        textResponse.value.slice(
                            0,
                            MAX_TEXT_RESPONSE_LENGTH
                        );

                }


                updateTextResponseCount();

            }
        );


        textResponse?.addEventListener(
            "keydown",
            event => {

                if (
                    event.key === "Enter" &&
                    (
                        event.ctrlKey ||
                        event.metaKey
                    )
                ) {

                    event.preventDefault();


                    submitTextAnswer()
                        .catch(
                            console.error
                        );

                }

            }
        );


        sendTextResponse?.addEventListener(
            "click",
            () =>
                submitTextAnswer()
                    .catch(
                        console.error
                    )
        );


        updateTextResponseCount();


        setTextResponseEnabled(
            false
        );


        /* ============================================================
           SPEECH XML
           ============================================================ */

        function escapeXml(
            value
        ) {

            return String(value)
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&apos;"
                );

        }


        function buildSpeechSsml(
            text,
            options = {}
        ) {

            const name =
                (
                    options.pronunciationName ||
                    ""
                ).trim();


            const index =
                options.useZuluNameVoice &&
                name
                    ? text.indexOf(name)
                    : -1;


            const voice =
                (
                    value,
                    voiceName
                ) => {

                    if (!value)
                        return "";


                    return (
                        `<voice name="${voiceName}">` +
                        `<prosody rate="-6%" pitch="0%">` +
                        `${escapeXml(value)}` +
                        `</prosody>` +
                        `</voice>`
                    );

                };


            const content =
                index < 0

                    ? voice(
                        text,
                        INTERVIEWER_VOICE
                    )

                    : voice(
                        text.slice(
                            0,
                            index
                        ),
                        INTERVIEWER_VOICE
                    )
                    +
                    voice(
                        name,
                        ZULU_NAME_VOICE
                    )
                    +
                    voice(
                        text.slice(
                            index +
                            name.length
                        ),
                        INTERVIEWER_VOICE
                    );


            return (
                `<speak version="1.0" ` +
                `xmlns="http://www.w3.org/2001/10/synthesis" ` +
                `xml:lang="en-ZA">` +
                content +
                `</speak>`
            );

        }


        /* ============================================================
           BROWSER TTS FALLBACK
           ============================================================ */

        function speakTextBrowserFallback(
            text,
            generation
        ) {

            return new Promise(
                resolve => {

                    if (
                        !window.speechSynthesis ||
                        generation !== speechGeneration
                    ) {

                        resolve(
                            "cancelled"
                        );

                        return;

                    }


                    try {

                        window.speechSynthesis.cancel();

                    }
                    catch (_) {}


                    const utterance =
                        new SpeechSynthesisUtterance(
                            text
                        );


                    utterance.lang =
                        "en-ZA";


                    utterance.rate =
                        0.94;


                    const voices =
                        window.speechSynthesis
                            .getVoices();


                    utterance.voice =
                        voices.find(
                            v =>
                                v.lang
                                    ?.toLowerCase()
                                    .startsWith(
                                        "en-za"
                                    )
                        )
                        ||
                        voices.find(
                            v =>
                                v.lang
                                    ?.toLowerCase()
                                    .startsWith(
                                        "en"
                                    )
                        )
                        ||
                        null;


                    let finished =
                        false;


                    const timeoutMs =
                        Math.min(
                            SPEECH_PLAYBACK_MAXIMUM_MS,
                            Math.max(
                                12000,
                                text.length *
                                110
                            )
                        );


                    let timeout =
                        null;


                    const finish =
                        reason => {

                            if (finished)
                                return;


                            finished =
                                true;


                            if (timeout)
                                clearTimeout(
                                    timeout
                                );


                            resolve(
                                reason
                            );

                        };


                    utterance.onend =
                        () =>
                            finish(
                                "browser-audio-end"
                            );


                    utterance.onerror =
                        () =>
                            finish(
                                "browser-error"
                            );


                    timeout =
                        setTimeout(
                            () =>
                                finish(
                                    "browser-timeout-fallback"
                                ),
                            timeoutMs
                        );


                    try {

                        window.speechSynthesis
                            .speak(
                                utterance
                            );

                    }
                    catch (_) {

                        finish(
                            "browser-exception"
                        );

                    }

                }
            );

        }


        /* ============================================================
           CONTROLLED AZURE PLAYBACK WAIT
           
           THIS IS THE MAIN FIX.

           Azure synthesis completion does NOT necessarily mean
           SpeakerAudioDestination playback has completed.

           Therefore:

               1. Wait for onAudioEnd.
               2. If onAudioEnd never fires, use timeout.
               3. Never leave the interview permanently blocked.
           ============================================================ */

        function waitForSpeakerPlayback(
            speaker,
            text,
            sequence,
            generation
        ) {

            return new Promise(
                resolve => {

                    let settled =
                        false;


                    const estimatedPlaybackMs =
                        Math.min(
                            SPEECH_PLAYBACK_MAXIMUM_MS,
                            Math.max(
                                SPEECH_PLAYBACK_MINIMUM_MS,
                                (
                                    text.length *
                                    SPEECH_PLAYBACK_MS_PER_CHARACTER
                                ) + 1200
                            )
                        );


                    let timeout =
                        null;


                    const finish =
                        reason => {

                            if (settled)
                                return;


                            settled =
                                true;


                            if (timeout) {

                                clearTimeout(
                                    timeout
                                );

                            }


                            console.log(
                                `[SWIFTCARE TTS ${sequence}] ` +
                                `Playback barrier released: ${reason}`
                            );


                            resolve(
                                reason
                            );

                        };


                    if (
                        !speaker ||
                        generation !== speechGeneration
                    ) {

                        finish(
                            "cancelled"
                        );

                        return;

                    }


                    try {

                        speaker.onAudioEnd =
                            () => {

                                console.log(
                                    `[SWIFTCARE TTS ${sequence}] ` +
                                    "Actual speaker playback ended."
                                );


                                finish(
                                    "audio-end"
                                );

                            };

                    }
                    catch (error) {

                        console.warn(
                            `[SWIFTCARE TTS ${sequence}] ` +
                            "Could not attach audio-end callback:",
                            error
                        );

                    }


                    timeout =
                        setTimeout(
                            () => {

                                console.warn(
                                    `[SWIFTCARE TTS ${sequence}] ` +
                                    `Speaker playback callback did not fire. ` +
                                    `Using controlled fallback after ${estimatedPlaybackMs}ms.`
                                );


                                finish(
                                    "timeout-fallback"
                                );

                            },
                            estimatedPlaybackMs
                        );

                }
            );

        }


        /* ============================================================
           SINGLE SERIALIZED SPEECH ENGINE
           ============================================================ */

        async function speakText(
            text,
            createBubble = true,
            options = {}
        ) {

            if (!text?.trim())
                return "empty";


            if (
                typeof options ===
                "string"
            ) {

                options = {

                    allowAfterInterviewCompletion:
                        options === "completion"

                };

            }


            const sequence =
                ++speechSequence;


            const run =
                speechLock.then(
                    async () => {

                        if (
                            (
                                interviewCompleted &&
                                !options.allowAfterInterviewCompletion
                            ) ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return "cancelled";

                        }


                        const generation =
                            speechGeneration;


                        speaking =
                            true;


                        clearSilenceTimer();


                        hideListening();


                        hideThinking();


                        setStatus(
                            "Interviewer is speaking..."
                        );


                        const bubble =
                            createBubble
                                ? addBotVoiceBubble(
                                    text
                                )
                                : null;


                        const wave =
                            bubble?.wave ||
                            null;


                        if (wave) {

                            currentWave =
                                wave;


                            wave.classList.add(
                                "scv-speaking"
                            );

                        }


                        let synthesizer =
                            null;


                        let speaker =
                            null;


                        let playbackResult =
                            "not-started";


                        try {

                            try {

                                window.speechSynthesis
                                    .cancel();

                            }
                            catch (_) {}


                            const data =
                                await getAzureSpeechToken();


                            if (
                                generation !==
                                speechGeneration
                            ) {

                                return "cancelled";

                            }


                            const config =
                                SpeechSDK.SpeechConfig
                                    .fromAuthorizationToken(
                                        data.token,
                                        data.region
                                    );


                            config.speechSynthesisVoiceName =
                                INTERVIEWER_VOICE;


                            /*
                             * IMPORTANT:
                             *
                             * We explicitly create the speaker destination
                             * so that we can monitor playback.
                             */
                            speaker =
                                new SpeechSDK
                                    .SpeakerAudioDestination();


                            activeSpeaker =
                                speaker;


                            const audioConfig =
                                SpeechSDK.AudioConfig
                                    .fromSpeakerOutput(
                                        speaker
                                    );


                            synthesizer =
                                new SpeechSDK
                                    .SpeechSynthesizer(
                                        config,
                                        audioConfig
                                    );


                            activeSpeechSynthesizer =
                                synthesizer;


                            const ssml =
                                buildSpeechSsml(
                                    text,
                                    options
                                );


                            console.log(
                                `[SWIFTCARE TTS ${sequence}] ` +
                                "Starting Azure synthesis."
                            );


                            await new Promise(
                                (
                                    resolve,
                                    reject
                                ) => {

                                    let callbackHandled =
                                        false;


                                    const complete =
                                        result => {

                                            if (
                                                callbackHandled
                                            ) {

                                                return;

                                            }


                                            callbackHandled =
                                                true;


                                            try {

                                                if (
                                                    result.reason ===
                                                    SpeechSDK.ResultReason
                                                        .SynthesizingAudioCompleted
                                                ) {

                                                    resolve(
                                                        result
                                                    );

                                                }
                                                else {

                                                    reject(
                                                        new Error(
                                                            result.errorDetails ||
                                                            "Azure speech failed."
                                                        )
                                                    );

                                                }

                                            }
                                            finally {

                                                try {

                                                    result.close();

                                                }
                                                catch (_) {}

                                            }

                                        };


                                    try {

                                        synthesizer
                                            .speakSsmlAsync(
                                                ssml,
                                                complete,
                                                error => {

                                                    if (
                                                        callbackHandled
                                                    ) {

                                                        return;

                                                    }


                                                    callbackHandled =
                                                        true;


                                                    reject(
                                                        error instanceof Error
                                                            ? error
                                                            : new Error(
                                                                String(
                                                                    error ||
                                                                    "Azure speech synthesis failed."
                                                                )
                                                            )
                                                    );

                                                }
                                            );

                                    }
                                    catch (error) {

                                        reject(
                                            error
                                        );

                                    }

                                }
                            );


                            if (
                                generation !==
                                speechGeneration
                            ) {

                                return "cancelled";

                            }


                            console.log(
                                `[SWIFTCARE TTS ${sequence}] ` +
                                "Synthesis completed; waiting for actual speaker playback."
                            );


                            /*
                             * MAIN PROTECTION:
                             *
                             * If onAudioEnd works:
                             *
                             *     audio-end
                             *
                             * If it stalls:
                             *
                             *     timeout-fallback
                             *
                             * Either way the interview continues.
                             */
                            playbackResult =
                                await waitForSpeakerPlayback(
                                    speaker,
                                    text,
                                    sequence,
                                    generation
                                );


                            if (
                                generation !==
                                speechGeneration
                            ) {

                                return "cancelled";

                            }


                            console.log(
                                `[SWIFTCARE TTS ${sequence}] ` +
                                `Playback COMPLETELY FINISHED: ${playbackResult}`
                            );


                            return playbackResult;

                        }
                        catch (error) {

                            console.error(
                                `[SWIFTCARE TTS ${sequence}] Azure error:`,
                                error
                            );


                            if (
                                generation ===
                                speechGeneration &&
                                !suspiciousActivityHandled &&
                                !terminatingInterview &&
                                (
                                    !interviewCompleted ||
                                    options.allowAfterInterviewCompletion
                                )
                            ) {

                                console.warn(
                                    `[SWIFTCARE TTS ${sequence}] ` +
                                    "Falling back to browser speech."
                                );


                                return await speakTextBrowserFallback(
                                    text,
                                    generation
                                );

                            }


                            return "failed";

                        }
                        finally {

                            if (
                                activeSpeechSynthesizer ===
                                synthesizer
                            ) {

                                activeSpeechSynthesizer =
                                    null;

                            }


                            if (
                                activeSpeaker ===
                                speaker
                            ) {

                                activeSpeaker =
                                    null;

                            }


                            if (speaker) {

                                try {

                                    speaker.close();

                                }
                                catch (_) {}

                            }


                            if (synthesizer) {

                                try {

                                    synthesizer.close();

                                }
                                catch (_) {}

                            }


                            if (wave) {

                                wave.classList.remove(
                                    "scv-speaking"
                                );

                            }


                            if (
                                currentWave ===
                                wave
                            ) {

                                currentWave =
                                    null;

                            }


                            speaking =
                                false;

                        }

                    }
                );


            speechLock =
                run.catch(
                    error =>
                        console.error(
                            "[SWIFTCARE] Speech queue error:",
                            error
                        )
                );


            return run;

        }


        /* ============================================================
           QUESTION NORMALIZATION
           ============================================================ */

        function normalizeQuestion(
            data
        ) {

            if (!data)
                return null;


            const question =
                String(
                    data.question ??
                    data.Question ??
                    data.currentQuestion ??
                    data.CurrentQuestion ??
                    data.questionText ??
                    data.QuestionText ??
                    ""
                ).trim();


            const questionId =
                data.questionId ??
                data.QuestionId ??
                data.currentQuestionId ??
                data.CurrentQuestionId ??
                null;


            const questionNumber =
                Number(
                    data.questionNumber ??
                    data.QuestionNumber ??
                    data.currentQuestionNumber ??
                    data.CurrentQuestionNumber ??
                    0
                );


            const count =
                Number(
                    data.totalQuestions ??
                    data.TotalQuestions ??
                    totalQuestions ??
                    0
                );


            if (!question)
                return null;


            return {

                questionId:
                    questionId,

                questionNumber:
                    questionNumber,

                totalQuestions:
                    count,

                question:
                    question

            };

        }


        /* ============================================================
           QUESTION KEY
           ============================================================ */

        function questionKey(
            data
        ) {

            return data.questionId != null

                ? `id:${data.questionId}`

                : `number:${data.questionNumber}|text:${data.question}`;

        }


        /* ============================================================
           HANDLE QUESTION
           ============================================================ */

        async function handleQuestion(
            data
        ) {

            const item =
                normalizeQuestion(
                    data
                );


            if (
                !item ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            /*
             * The first question may arrive before greeting completes.
             */
            if (!greetingFinished) {

                pendingFirstQuestion =
                    item;


                console.log(
                    "[SWIFTCARE] First question stored until greeting ends:",
                    item
                );


                return;

            }


            const key =
                questionKey(
                    item
                );


            const signature =
                `${item.questionNumber}|${item.question.trim().toLowerCase()}`;


            /*
             * Prevent duplicate SignalR events.
             */
            if (
                key === currentQuestionKey ||
                signature === currentQuestionSignature
            ) {

                console.log(
                    "[SWIFTCARE] Duplicate question ignored:",
                    item
                );


                return;

            }


            currentQuestionSignature =
                signature;


            currentQuestionKey =
                key;


            const generation =
                ++questionGeneration;


            questionProcessing =
                true;


            currentQuestionId =
                item.questionId ??
                `question-${item.questionNumber}`;


            currentQuestionNumber =
                item.questionNumber;


            totalQuestions =
                item.totalQuestions;


            currentQuestionText =
                item.question;


            submittingAnswer =
                false;


            answerParts =
                [];


            clearTextResponse();


            setTextResponseEnabled(
                false
            );


            clearSilenceTimer();


            await stopRecognition();


            if (
                generation !==
                questionGeneration ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                questionProcessing =
                    false;

                return;

            }


            try {

                console.log(
                    "[SWIFTCARE] Speaking question:",
                    {
                        number:
                            item.questionNumber,

                        id:
                            item.questionId,

                        question:
                            item.question
                    }
                );


                const speechResult =
                    await speakText(
                        item.question,
                        true
                    );


                if (
                    speechResult ===
                    "cancelled"
                ) {

                    return;

                }


                if (
                    generation !==
                    questionGeneration ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                /*
                 * Small natural pause after interviewer finishes.
                 */
                await wait(
                    QUESTION_PAUSE
                );


                if (
                    generation !==
                    questionGeneration ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                /*
                 * NOW the candidate is allowed to respond.
                 */
                setTextResponseEnabled(
                    true
                );


                setStatus(
                    "Your turn — speak or type your answer."
                );


                console.log(
                    "[SWIFTCARE] Question complete. " +
                    "Microphone and text response enabled."
                );

            }
            finally {

                if (
                    generation ===
                    questionGeneration
                ) {

                    questionProcessing =
                        false;

                }

            }


            /*
             * Start microphone only AFTER:
             *
             * Question speech
             *      ↓
             * Playback callback OR controlled fallback
             *      ↓
             * Question pause
             *      ↓
             * Listening
             */
            if (
                generation ===
                questionGeneration &&
                !interviewCompleted &&
                !suspiciousActivityHandled &&
                !terminatingInterview
            ) {

                await startListening();

            }

        }


        /* ============================================================
           RELEASE FIRST QUESTION
           ============================================================ */

        async function releaseFirstQuestion() {

            if (
                firstQuestionRequested ||
                !greetingFinished ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            const first =
                pendingFirstQuestion ||
                normalizeQuestion({

                    currentQuestionId:
                        currentQuestionId,

                    currentQuestionNumber:
                        currentQuestionNumber,

                    totalQuestions:
                        totalQuestions,

                    currentQuestion:
                        currentQuestionText

                });


            if (!first) {

                console.warn(
                    "[SWIFTCARE] Greeting ended but no question was supplied by the hub."
                );


                setStatus(
                    "Waiting for your first question..."
                );


                return;

            }


            firstQuestionRequested =
                true;


            pendingFirstQuestion =
                null;


            console.log(
                "[SWIFTCARE] Delivering first question:",
                first
            );


            try {

                await handleQuestion(
                    first
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] First question failed:",
                    error
                );


                firstQuestionRequested =
                    false;


                setStatus(
                    "Unable to play the first question. Please reconnect.",
                    true
                );

            }

        }


        /* ============================================================
           HANDLE INTERVIEW STATE
           ============================================================ */

        async function handleInterviewState(
            state
        ) {

            if (
                !state ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            currentApplicantName =
                String(
                    state.applicantName ??
                    state.ApplicantName ??
                    currentApplicantName ??
                    "Applicant"
                ).trim();


            const incoming =
                normalizeQuestion(
                    state
                );


            /*
             * Store the first question immediately.
             */
            if (incoming) {

                currentQuestionNumber =
                    incoming.questionNumber;


                totalQuestions =
                    incoming.totalQuestions;


                currentQuestionId =
                    incoming.questionId;


                currentQuestionText =
                    incoming.question;


                if (!greetingFinished) {

                    pendingFirstQuestion =
                        pendingFirstQuestion ||
                        incoming;

                }

            }


            /*
             * If greeting already finished, this is a normal
             * question event.
             */
            if (greetingFinished) {

                if (incoming) {

                    await handleQuestion(
                        incoming
                    );

                }


                return;

            }


            /*
             * Do not start greeting twice.
             */
            if (greetingStarted) {

                return;

            }


            greetingStarted =
                true;


            const greeting =
                `Hello ${currentApplicantName}. ` +
                `Welcome to your SwiftCare volunteer interview. ` +
                `I will ask you a few questions. ` +
                `Please answer naturally and honestly. ` +
                `Please take your time to think carefully before you respond because you cannot edit an answer once provided. ` +
                `You can answer using your voice, or you can type your response in the text box below.`;


            greetingPromise =
                (async () => {

                    await stopRecognition();


                    try {

                        console.log(
                            "[SWIFTCARE] Greeting starting."
                        );


                        const greetingResult =
                            await speakText(
                                greeting,
                                true,
                                {

                                    useZuluNameVoice:
                                        currentApplicantName !==
                                        "Applicant",

                                    pronunciationName:
                                        currentApplicantName

                                }
                            );


                        console.log(
                            "[SWIFTCARE] Greeting speech returned:",
                            greetingResult
                        );

                    }
                    catch (error) {

                        console.error(
                            "[SWIFTCARE] Greeting error:",
                            error
                        );

                    }


                    if (
                        interviewCompleted ||
                        suspiciousActivityHandled ||
                        terminatingInterview
                    ) {

                        return;

                    }


                    await wait(
                        GREETING_PAUSE
                    );


                    if (
                        interviewCompleted ||
                        suspiciousActivityHandled ||
                        terminatingInterview
                    ) {

                        return;

                    }


                    /*
                     * THIS IS THE POINT THAT WAS NEVER BEING REACHED
                     * IN YOUR OLD VERSION.
                     */
                    greetingFinished =
                        true;


                    greetingPlayed =
                        true;


                    greetingSpeechFinished =
                        true;


                    console.log(
                        "[SWIFTCARE] GREETING COMPLETE."
                    );


                    console.log(
                        "[SWIFTCARE] Releasing first question."
                    );


                    await releaseFirstQuestion();

                })();


            await greetingPromise;

        }


        /* ============================================================
           SIGNALR: BOT QUESTION
           ============================================================ */

        function registerBotQuestionHandler() {

            connection.on(
                "BotQuestion",
                async data => {

                    console.log(
                        "[SWIFTCARE] BotQuestion:",
                        data
                    );


                    const item =
                        normalizeQuestion(
                            data
                        );


                    if (!item)
                        return;


                    if (!greetingFinished) {

                        /*
                         * Explicit BotQuestion wins over an older
                         * InterviewState snapshot.
                         */
                        pendingFirstQuestion =
                            item;


                        console.log(
                            "[SWIFTCARE] BotQuestion queued behind greeting:",
                            item
                        );


                        return;

                    }


                    await handleQuestion(
                        item
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR: INTERVIEW STATE
           ============================================================ */

        function registerInterviewStateHandler() {

            connection.on(
                "InterviewState",
                state =>
                    handleInterviewState(
                        state
                    )
                    .catch(
                        error =>
                            console.error(
                                "[SWIFTCARE] InterviewState:",
                                error
                            )
                    )
            );

        }


        /* ============================================================
           SIGNALR: APPLICANT MESSAGE
           ============================================================ */

        function registerApplicantMessageHandler() {

            connection.on(
                "ApplicantMessage",
                () => {

                    console.log(
                        "[SWIFTCARE] ApplicantMessage received."
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR: SUSPICIOUS
           ============================================================ */

        function registerSuspiciousHandler() {

            connection.on(
                "InterviewSuspicious",
                data =>
                    handleServerSuspiciousState(
                        data?.message ||
                        data?.Message
                    )
            );

        }


        /* ============================================================
           SIGNALR: COMPLETED
           ============================================================ */

        function registerCompletedHandler() {

            connection.on(
                "InterviewCompleted",
                async () => {

                    if (
                        suspiciousActivityHandled ||
                        interviewCompleted
                    ) {

                        return;

                    }


                    /*
                     * Completion state is set before final speech,
                     * but speakText explicitly allows completion speech.
                     */
                    interviewCompleted =
                        true;


                    questionGeneration++;


                    clearSilenceTimer();


                    await stopRecognition();


                    hideListening();

                    hideThinking();


                    setTextResponseEnabled(
                        false
                    );


                    setStatus(
                        "Saving interview..."
                    );


                    const videoData =
                        await stopVideoRecording()
                            .catch(
                                error => {

                                    console.error(
                                        "[SWIFTCARE] Recording stop error:",
                                        error
                                    );

                                    return null;

                                }
                            );


                    if (videoData) {

                        await uploadInterviewVideo(
                            videoData
                        );

                    }


                    await speakText(
                        "Thank you for completing the interview. Your responses have been recorded successfully.",
                        true,
                        {
                            allowAfterInterviewCompletion:
                                true
                        }
                    );


                    stopCameraTracks();


                    setStatus(
                        "Interview completed"
                    );


                    try {

                        if (
                            document.fullscreenElement &&
                            document.exitFullscreen
                        ) {

                            await document.exitFullscreen();

                        }

                    }
                    catch (_) {}

                }
            );

        }


        /* ============================================================
           CONNECTION
           ============================================================ */

        async function createConnection() {

            connection =
                new signalR.HubConnectionBuilder()
                    .withUrl(
                        "/volunteerInterviewHub"
                    )
                    .withAutomaticReconnect(
                        [
                            0,
                            2000,
                            5000,
                            10000
                        ]
                    )
                    .configureLogging(
                        signalR.LogLevel.Warning
                    )
                    .build();


            /*
             * IMPORTANT:
             *
             * Register every handler BEFORE JoinInterview.
             */
            registerBotQuestionHandler();

            registerInterviewStateHandler();

            registerApplicantMessageHandler();

            registerCompletedHandler();

            registerSuspiciousHandler();


            connection.onreconnecting =
                error => {

                    reconnecting =
                        true;


                    console.warn(
                        "[SWIFTCARE] Reconnecting:",
                        error
                    );


                    setStatus(
                        "Reconnecting..."
                    );


                    stopRecognition()
                        .catch(
                            console.error
                        );

                };


            connection.onreconnected =
                async () => {

                    reconnecting =
                        false;


                    if (
                        interviewCompleted ||
                        suspiciousActivityHandled
                    ) {

                        return;

                    }


                    setStatus(
                        "Connected"
                    );


                    try {

                        await connection.invoke(
                            "JoinInterview",
                            sessionToken
                        );


                        console.log(
                            "[SWIFTCARE] Interview rejoined."
                        );

                    }
                    catch (error) {

                        console.error(
                            "[SWIFTCARE] Rejoin failed:",
                            error
                        );


                        setStatus(
                            "Could not resume interview",
                            true
                        );

                    }

                };


            connection.onclose =
                error => {

                    console.error(
                        "[SWIFTCARE] Connection closed:",
                        error
                    );


                    if (
                        !interviewCompleted &&
                        !suspiciousActivityHandled
                    ) {

                        setStatus(
                            "Connection lost",
                            true
                        );

                    }

                };


            try {

                await connection.start();


                setStatus(
                    "Connected"
                );


                /*
                 * All handlers are already registered.
                 */
                await connection.invoke(
                    "JoinInterview",
                    sessionToken
                );


                interviewStarted =
                    true;


                console.log(
                    "[SWIFTCARE] Joined interview."
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] Connection error:",
                    error
                );


                setStatus(
                    "Unable to connect",
                    true
                );


                stopCameraTracks();

            }

        }


        /* ============================================================
           INITIALIZATION
           ============================================================ */

        async function initializeInterview() {

            if (
                typeof signalR ===
                "undefined"
            ) {

                setStatus(
                    "SignalR unavailable",
                    true
                );


                return;

            }


            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                setStatus(
                    "Speech system unavailable",
                    true
                );


                return;

            }


            if (
                !navigator.mediaDevices?.getUserMedia
            ) {

                setStatus(
                    "Camera access is required",
                    true
                );


                if (recordingStatus) {

                    recordingStatus.textContent =
                        "Camera unavailable";

                }


                return;

            }


            try {

                await startVideoRecording();

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE] Camera initialization failed:",
                    error
                );


                setStatus(
                    "Camera access is required",
                    true
                );


                if (recordingStatus) {

                    recordingStatus.textContent =
                        "Camera unavailable";

                }


                stopCameraTracks();


                return;

            }


            updateProctoringUi();


            try {

                window.speechSynthesis
                    .getVoices();

            }
            catch (_) {}


            await createConnection();

        }


        /* ============================================================
           START
           ============================================================ */

        initializeInterview()
            .catch(
                error => {

                    console.error(
                        "[SWIFTCARE] Initialization failed:",
                        error
                    );


                    setStatus(
                        "Interview could not start",
                        true
                    );


                    stopCameraTracks();

                }
            );

    })();

</script>y