
@{
    ViewData["Title"] = "Admin";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<div class="sc-dashboard">

    <!-- =========================================================
         DASHBOARD HEADER
         ========================================================= -->

    <section class="sc-dashboard-header">

        <div class="sc-header-content">

            <div class="sc-header-left">

                <div class="sc-header-badge">

                    <i class="bi bi-shield-check"></i>

                    Administrator Dashboard

                </div>

                <h1 class="sc-dashboard-title">

                    Welcome back, Administrator

                </h1>

                <p class="sc-dashboard-description">

                    Manage residents, staff, reports, support,
                    equipment and system security from one place.

                </p>

            </div>


            <div class="sc-date-card">

                <div class="sc-date-icon">

                    <i class="bi bi-calendar3"></i>

                </div>

                <div class="sc-date-content">

                    <span class="sc-date-label">

                        Today

                    </span>

                    <span class="sc-date-value">

                        @DateTime.Now.ToString("dddd, dd MMMM yyyy")

                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         QUICK ACTIONS
         ========================================================= -->

    <section class="sc-actions-section">


        <div class="sc-section-header">

            <div>

                <div class="sc-section-label">

                    CONTROL CENTER

                </div>

                <h2 class="sc-section-title">

                    Quick Actions

                </h2>

                <p class="sc-section-description">

                    Select an area below to manage your SwiftCare system.

                </p>

            </div>


            <div class="sc-section-status">

                <span class="sc-status-dot"></span>

                All Systems Operational

            </div>

        </div>


        <!-- =====================================================
             ACTION CARDS
             ===================================================== -->

        <div class="sc-action-grid">


            <!-- STAFF & USERS -->

            <a asp-controller="Users"
               asp-action="Index"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-people-fill"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Staff & Users

                    </h3>

                    <p>

                        Manage staff accounts, users,
                        roles and access permissions.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        Manage Users

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


            <!-- RESIDENTS -->

            <a asp-controller="Residents"
               asp-action="Residents"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-person-heart"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Residents

                    </h3>

                    <p>

                        View resident profiles, information
                        and care-related records.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        View Residents

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


            <!-- REPORTS -->

            <a asp-controller="Reports"
               asp-action="Index"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-bar-chart-fill"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Reports

                    </h3>

                    <p>

                        Review system activity, performance
                        and operational reports.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        View Reports

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


            <!-- SUPPORT -->

            <a asp-controller="Queries"
               asp-action="SupportQueries"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-life-preserver"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Support

                    </h3>

                    <p>

                        Review support queries and assist
                        users with their requests.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        Manage Support

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


            <!-- EQUIPMENT -->

            <a asp-controller="Equipment"
               asp-action="OurEquipment"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-box-seam-fill"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Equipment

                    </h3>

                    <p>

                        Manage facility equipment and keep
                        track of operational resources.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        Manage Equipment

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


            <!-- SECURITY -->

            <a asp-controller="Users"
               asp-action="PasswordAndSecurity"
               class="sc-action-card">

                <div class="sc-action-top">

                    <div class="sc-action-icon">

                        <i class="bi bi-shield-lock-fill"></i>

                    </div>

                    <i class="bi bi-arrow-up-right sc-action-arrow"></i>

                </div>


                <div class="sc-action-body">

                    <h3>

                        Security

                    </h3>

                    <p>

                        Manage account security, passwords
                        and access protection.

                    </p>

                </div>


                <div class="sc-action-footer">

                    <span>

                        Security Settings

                    </span>

                    <i class="bi bi-arrow-right"></i>

                </div>

            </a>


        </div>

    </section>

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const cards =
                    document.querySelectorAll(
                        ".sc-action-card"
                    );


                cards.forEach(
                    function (card, index) {

                        card.style.opacity = "0";

                        card.style.transform =
                            "translateY(20px)";


                        setTimeout(
                            function () {

                                card.style.transition =
                                    "opacity 0.45s ease, transform 0.45s ease";

                                card.style.opacity =
                                    "1";

                                card.style.transform =
                                    "translateY(0)";

                            },
                            index * 90
                        );

                    }
                );

            }
        );

    </script>

}

