@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding

@using SwiftCare.Models.VolunteerOnboarding

@{
    ViewData["Title"] = "Volunteer Onboarding Review";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var onboardingStatus = Model.Status;

    var readyForActivation =
        onboardingStatus == VolunteerOnboardingStatus.ReadyForActivation;

    var onboardingCompleted =
        onboardingStatus == VolunteerOnboardingStatus.Completed;

    var adminVerification =
        onboardingStatus == VolunteerOnboardingStatus.AdminVerification;

    var applicantName =
        $"{Model.Applicant?.FirstName} {Model.Applicant?.LastName}".Trim();

    if (string.IsNullOrWhiteSpace(applicantName))
    {
        applicantName = "Volunteer Applicant";
    }

    var opportunityTitle =
        Model.VolunteerApplication
            ?.VolunteerOpportunity
            ?.Title
        ?? "Volunteer Opportunity";


    // =============================================================
    // REQUIREMENTS
    // =============================================================

    var displayRequirements =
        Model.Requirements?
            .GroupBy(x => x.RequirementType)
            .Select(group =>
                group
                    .OrderByDescending(x => x.IsCompleted)
                    .ThenBy(x => x.DisplayOrder)
                    .ThenBy(x => x.VolunteerOnboardingRequirementId)
                    .First())
            .OrderBy(x => x.DisplayOrder)
            .ToList()
        ?? new List<VolunteerOnboardingRequirement>();

    var totalRequirements =
        displayRequirements.Count;

    var completedRequirements =
        displayRequirements.Count(x => x.IsCompleted);


    // =============================================================
    // DOCUMENTS
    // =============================================================

    var totalDocuments =
        Model.Documents?.Count() ?? 0;

    var verifiedDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Approved)
        ?? 0;

    var pendingDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Uploaded ||
            x.Status == VolunteerOnboardingDocumentStatus.UnderReview)
        ?? 0;

    var rejectedDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Rejected ||
            x.Status == VolunteerOnboardingDocumentStatus.ResubmissionRequired)
        ?? 0;


    // =============================================================
    // IDENTITY DOCUMENTS
    // =============================================================

    var identityDocuments =
        Model.Documents?
            .Where(x =>
                x.DocumentType ==
                VolunteerOnboardingDocumentType.IdentityDocument)
            .OrderByDescending(x => x.UploadedDate)
            .ToList()
        ?? new List<VolunteerOnboardingDocument>();

    var hasIdentityDocument =
        identityDocuments.Any();

    var approvedIdentityDocument =
        identityDocuments.FirstOrDefault(x =>
            x.Status ==
            VolunteerOnboardingDocumentStatus.Approved);

    var pendingIdentityDocument =
        identityDocuments.FirstOrDefault(x =>
            x.Status ==
                VolunteerOnboardingDocumentStatus.Uploaded ||
            x.Status ==
                VolunteerOnboardingDocumentStatus.UnderReview);

    var rejectedIdentityDocument =
        identityDocuments.FirstOrDefault(x =>
            x.Status ==
                VolunteerOnboardingDocumentStatus.Rejected ||
            x.Status ==
                VolunteerOnboardingDocumentStatus.ResubmissionRequired);
}


<div class="onboarding-review-page">


    <!-- =========================================================
         HERO HEADER
         ========================================================= -->

    <section class="review-hero">

        <div class="review-hero-content">

            <div class="review-hero-left">

                <div class="review-eyebrow">
                    <i class="bi bi-person-vcard-fill"></i>
                    SwiftCare Administration
                </div>

                <h1>
                    Volunteer Onboarding Review
                </h1>

                <p class="review-hero-subtitle">
                    Review documents, requirements and verification before
                    activating this volunteer.
                </p>

            </div>


            <div class="review-status-area">

                <a asp-controller="VolunteerOnboardingAdmin"
                       asp-action="Index"
                       class="btn-back-onboarding">

                    <i class="bi bi-arrow-left"></i>

                    <span>
                        Back to Onboarding
                    </span>

                </a>

                <span class="review-status-pill">

                    @if (onboardingCompleted)
                    {
                        <i class="bi bi-check-circle-fill"></i>
                    }
                    else if (readyForActivation)
                    {
                        <i class="bi bi-person-check-fill"></i>
                    }
                    else if (adminVerification)
                    {
                        <i class="bi bi-shield-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-hourglass-split"></i>
                    }

                    @Model.Status.GetDisplayName()

                </span>

            </div>

        </div>

    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4"
             role="alert">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>

                <div class="flex-grow-1">
                    <div class="fw-bold mb-1">
                        Success
                    </div>

                    <div>
                        @TempData["Success"]
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4"
             role="alert">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-shrink-0">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>

                <div class="flex-grow-1">
                    <div class="fw-bold mb-1">
                        Action Required
                    </div>

                    <div>
                        @TempData["Error"]
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        </div>
    }
    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <section class="review-summary-grid">


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Documents
                </span>

                <div class="summary-value">
                    @totalDocuments
                    <small>uploaded</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-patch-check-fill"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Verified
                </span>

                <div class="summary-value">
                    @verifiedDocuments
                    <small>verified</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Requirements
                </span>

                <div class="summary-value">
                    @completedRequirements
                    <small>/ @totalRequirements</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Review State
                </span>

                <div class="summary-value" style="font-size:1rem;">

                    @(adminVerification
                        ? "In Review"
                        : readyForActivation
                            ? "Ready"
                            : onboardingCompleted
                                ? "Complete"
                                : "Pending")

                </div>

            </div>

        </div>


    </section>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="row g-4">


        <!-- =====================================================
             APPLICANT
             ===================================================== -->

        <div class="col-lg-4">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        Applicant

                    </h4>

                </div>


                <div class="applicant-profile">

                    <div class="applicant-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>

                        <div class="applicant-profile-name">
                            @applicantName
                        </div>

                        <div class="applicant-profile-role">
                            Volunteer Applicant
                        </div>

                    </div>

                </div>


                <div class="info-grid">


                    <div class="info-box full-width">

                        <span class="info-label">
                            Email Address
                        </span>

                        <div class="info-value">
                            @(Model.Applicant?.Email ?? "Not provided")
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Application
                        </span>

                        <div class="info-value">
                            #@Model.VolunteerApplication.Reference
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Onboarding
                        </span>

                        <div class="info-value">
                            #@Model.VolunteerOnboardingId
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Current Step
                        </span>

                        <div class="info-value">
                            Step @Model.CurrentStep
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Status
                        </span>

                        <div class="info-value">
                            @Model.Status.GetDisplayName()
                        </div>

                    </div>


                    <div class="info-box full-width">

                        <span class="info-label">
                            Volunteer Opportunity
                        </span>

                        <div class="info-value">
                            @opportunityTitle
                        </div>

                    </div>


                </div>

            </div>

        </div>


        <!-- =====================================================
             REQUIREMENTS
             ===================================================== -->

        <div class="col-lg-8">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-list-check"></i>
                        </span>

                        Requirements

                    </h4>

                    <span class="status-badge">

                        @completedRequirements /
                        @totalRequirements

                    </span>

                </div>


                @if (!displayRequirements.Any())
                {
                    <div class="empty-state">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            No onboarding requirements have been configured.
                        </span>

                    </div>
                }
                else
                {

                    <div class="requirements-progress">

                        <div class="requirements-progress-top">

                            <span class="requirements-progress-label">
                                Completion
                            </span>

                            <span class="requirements-progress-value">

                                @(totalRequirements == 0
                                    ? 0
                                    : (completedRequirements * 100 / totalRequirements))%

                            </span>

                        </div>

                        <div class="requirements-progress-bar">

                            <div class="requirements-progress-fill"
                                 style="width:@(
                                                                 totalRequirements == 0
                                                                     ? 0
                                                                     : (completedRequirements * 100 / totalRequirements)
                                                                                              )%;">
                            </div>

                        </div>

                    </div>


                    foreach (var requirement in displayRequirements)
                    {

                        <div class="requirement-item">


                            <div class="requirement-icon
                                @(requirement.IsCompleted ? "completed" : "")">

                                @if (requirement.IsCompleted)
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle"></i>
                                }

                            </div>


                            <div class="requirement-content">

                                <div class="requirement-title">

                                    @requirement.RequirementType.GetDisplayName()

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.Description))
                                {
                                    <span class="requirement-description">
                                        @requirement.Description
                                    </span>
                                }

                            </div>


                            <span class="status-badge
                                @(requirement.IsCompleted
                                                                      ? "completed"
                                                                      : "pending")">

                                @if (requirement.IsCompleted)
                                {
                                    <i class="bi bi-check-circle-fill"></i>

                                    <span>
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-clock"></i>

                                    <span>
                                        Pending
                                    </span>
                                }

                            </span>

                        </div>

                    }

                }

            </div>

        </div>


        <!-- =====================================================
             DOCUMENTS
             ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-folder-check"></i>
                        </span>

                        Onboarding Documents

                    </h4>


                    <div class="documents-summary">

                        <span class="document-summary-pill">

                            <i class="bi bi-files"></i>

                            <strong>
                                @totalDocuments
                            </strong>

                            Total

                        </span>


                        <span class="document-summary-pill">

                            <i class="bi bi-check-circle"></i>

                            <strong>
                                @verifiedDocuments
                            </strong>

                            Verified

                        </span>


                        @if (pendingDocuments > 0)
                        {
                            <span class="document-summary-pill">

                                <i class="bi bi-clock"></i>

                                <strong>
                                    @pendingDocuments
                                </strong>

                                Pending

                            </span>
                        }


                        @if (rejectedDocuments > 0)
                        {
                            <span class="document-summary-pill"
                                  style="color:#9b3b3b;">

                                <i class="bi bi-exclamation-circle"></i>

                                <strong style="color:#9b3b3b;">
                                    @rejectedDocuments
                                </strong>

                                Attention

                            </span>
                        }

                    </div>

                </div>


                @if (Model.Documents == null ||
                     !Model.Documents.Any())
                {
                    <div class="empty-state">

                        <i class="bi bi-folder2-open"></i>

                        <span>
                            No onboarding documents have been uploaded.
                        </span>

                    </div>
                }
                else
                {

                    foreach (var document in Model.Documents
                        .OrderByDescending(x => x.UploadedDate))
                    {

                        var isIdentityDocument =
                            document.DocumentType ==
                            VolunteerOnboardingDocumentType.IdentityDocument;

                        var documentStatus =
                            document.Status;

                        var documentStatusClass =
                            documentStatus ==
                                VolunteerOnboardingDocumentStatus.Approved
                                    ? "verified"
                                    : documentStatus ==
                                        VolunteerOnboardingDocumentStatus.Rejected ||
                                      documentStatus ==
                                        VolunteerOnboardingDocumentStatus.ResubmissionRequired
                                        ? "rejected"
                                        : "pending";


                        <div class="document-item">

                            <div class="document-row">


                                <!-- DOCUMENT -->

                                <div class="document-main">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="document-icon">

                                            @if (isIdentityDocument)
                                            {
                                                <i class="bi bi-person-vcard-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-text"></i>
                                            }

                                        </div>


                                        <div class="min-w-0">

                                            <div class="document-name">

                                                @document.DocumentName

                                                @if (isIdentityDocument)
                                                {
                                                    <span class="identity-document-label">

                                                        <i class="bi bi-shield-check"></i>

                                                        Identity Document

                                                    </span>
                                                }

                                            </div>


                                            <div class="document-meta">

                                                <i class="bi bi-file-earmark"></i>

                                                @document.DocumentType.GetDisplayName()

                                                <span class="mx-1">
                                                    ·
                                                </span>

                                                @document.FileName

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div>

                                    <span class="status-badge @documentStatusClass">

                                        @if (documentStatus ==
                                            VolunteerOnboardingDocumentStatus.Approved)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                        }
                                        else if (
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.Rejected ||
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.ResubmissionRequired)
                                        {
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock-fill"></i>
                                        }

                                        @documentStatus.GetDisplayName()

                                    </span>

                                </div>


                                <!-- DATE -->

                                <div class="document-date">

                                    <i class="bi bi-calendar3 me-1"></i>

                                    @document.UploadedDate.ToLocalTime().ToString("dd MMM yyyy")

                                </div>


                                <!-- ACTIONS -->

                                <div class="document-actions">


                                    @if (!string.IsNullOrWhiteSpace(
                                        document.FilePath))
                                    {
                                        <a href="@Url.Content("~/" + document.FilePath)"
                                               target="_blank"
                                               class="btn-outline-swift">

                                            <i class="bi bi-eye"></i>

                                            View

                                        </a>
                                    }


                                    <button type="button"
                                            class="btn-swift"
                                            data-bs-toggle="modal"
                                            data-bs-target="#reviewDocumentModal"
                                            data-document-id="@document.VolunteerOnboardingDocumentId">

                                        <i class="bi bi-check2-square"></i>

                                        Review

                                    </button>


                                    @if (isIdentityDocument)
                                    {
                                        <form asp-action="StartIdentityVerification"
                                              method="post"
                                              class="identity-verification-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="onboardingId"
                                                   value="@Model.VolunteerOnboardingId" />

                                            <input type="hidden"
                                                   name="identityDocumentId"
                                                   value="@document.VolunteerOnboardingDocumentId" />


                                            @if (documentStatus ==
                                                VolunteerOnboardingDocumentStatus.Approved)
                                            {
                                                <button type="submit"
                                                        class="btn-didit-verify">

                                                    <i class="bi bi-shield-check"></i>

                                                    <span>
                                                        Start Didit Verification
                                                    </span>

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn-didit-verify disabled"
                                                        disabled>

                                                    <i class="bi bi-shield-lock"></i>

                                                    <span>
                                                        Approve Document First
                                                    </span>

                                                </button>
                                            }

                                        </form>
                                    }


                                </div>


                            </div>


                            <!-- IDENTITY DOCUMENT INFORMATION -->
                            @if (isIdentityDocument)
                            {
                                <div class="identity-document-panel">

                                    <div class="identity-document-panel-icon">

                                        <i class="bi bi-shield-check"></i>

                                    </div>


                                    <div class="identity-document-panel-content">

                                        <div class="identity-document-panel-title">

                                            Identity verification document

                                        </div>

                                        <div class="identity-document-panel-text">

                                            This document is designated as the
                                            applicant's identity document and
                                            can be used to start the Didit
                                            identity verification process.

                                        </div>

                                    </div>


                                    <div class="identity-document-panel-status">

                                        @if (documentStatus ==
                                            VolunteerOnboardingDocumentStatus.Approved)
                                        {
                                            <span class="identity-ready-badge">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Ready for verification

                                            </span>
                                        }
                                        else if (
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.Rejected ||
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.ResubmissionRequired)
                                        {
                                            <span class="identity-rejected-badge">

                                                <i class="bi bi-exclamation-circle-fill"></i>

                                                Document requires attention

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="identity-pending-badge">

                                                <i class="bi bi-clock-fill"></i>

                                                Awaiting document approval

                                            </span>
                                        }

                                    </div>

                                </div>
                            }


                            <!-- REJECTION REASON -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            document.RejectionReason))
                            {
                                <div class="document-rejection">

                                    <strong>

                                        <i class="bi bi-exclamation-triangle me-1"></i>

                                        Review Note:

                                    </strong>

                                    @document.RejectionReason

                                </div>
                            }


                        </div>

                    }

                }

            </div>

        </div>


        <!-- =====================================================
             DIDIT IDENTITY VERIFICATION
             ===================================================== -->

        <div class="col-12">

            <div class="review-card didit-verification-card"
                 id="diditVerificationCard"
                 data-onboarding-id="@Model.VolunteerOnboardingId"
                 data-status-url="@Url.Action(
                                                      "IdentityVerificationStatus",
                                                      "VolunteerOnboardingAdmin")">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">

                            <i class="bi bi-person-vcard-fill"></i>

                        </span>

                        Identity Verification

                    </h4>


                    <span class="didit-header-badge">

                        <i class="bi bi-shield-check"></i>

                        Didit

                    </span>

                </div>


                <div class="didit-verification-content">


                    <div class="didit-verification-icon">

                        <i class="bi bi-person-badge-fill"></i>

                    </div>


                    <div class="didit-verification-information">

                        <h5>
                            Verify Applicant Identity
                        </h5>

                        <p>

                            Start identity verification using the applicant's
                            uploaded
                            <strong>Identity Document</strong>.
                            SwiftCare will associate the Didit verification
                            session with this onboarding record.

                        </p>


                        <div class="didit-verification-steps">

                            <div class="didit-step">

                                <span class="didit-step-number">
                                    1
                                </span>

                                <span>
                                    Identity document
                                </span>

                            </div>


                            <div class="didit-step">

                                <span class="didit-step-number">
                                    2
                                </span>

                                <span>
                                    Liveness
                                </span>

                            </div>


                            <div class="didit-step">

                                <span class="didit-step-number">
                                    3
                                </span>

                                <span>
                                    Face verification
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="didit-verification-action">

                        @if (!hasIdentityDocument)
                        {
                            <div class="didit-not-ready">

                                <i class="bi bi-exclamation-circle"></i>

                                <span>
                                    No Identity Document uploaded
                                </span>

                            </div>
                        }
                        else if (approvedIdentityDocument == null)
                        {
                            <div class="didit-not-ready">

                                <i class="bi bi-clock"></i>

                                <span>
                                    Identity document must be approved first
                                </span>

                            </div>
                        }
                        else
                        {
                            <form asp-action="StartIdentityVerification"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="onboardingId"
                                       value="@Model.VolunteerOnboardingId" />

                                <input type="hidden"
                                       name="identityDocumentId"
                                       value="@approvedIdentityDocument.VolunteerOnboardingDocumentId" />

                                <button type="submit"
                                        class="btn-didit-main">

                                    <i class="bi bi-shield-check"></i>

                                    Start Didit Verification

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </form>
                        }

                    </div>

                </div>


                <!-- =====================================================
                     LIVE DIDIT STATUS
                     ===================================================== -->

                <div id="diditLiveStatus"
                     class="didit-live-status"
                     style="
                    margin-top:1.25rem;
                    padding:1rem 1.15rem;
                    border:1px solid rgba(27,94,32,.14);
                    border-radius:16px;
                    background:rgba(240,253,244,.72);
                    ">

                    <div style="
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        gap:1rem;
                        flex-wrap:wrap;
                        ">

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:.75rem;
                            ">

                            <span id="diditLiveIcon"
                                  style="
                                width:38px;
                                height:38px;
                                border-radius:50%;
                                display:inline-flex;
                                align-items:center;
                                justify-content:center;
                                background:#DCEDC8;
                                color:#1B5E20;
                                ">

                                <i class="bi bi-arrow-repeat"></i>

                            </span>


                            <div>

                                <div style="
                                    font-size:.72rem;
                                    font-weight:800;
                                    letter-spacing:.08em;
                                    color:#5d7561;
                                    text-transform:uppercase;
                                    ">
                                    Live Didit Status
                                </div>

                                <div id="diditLiveStatusText"
                                     style="
                                    font-weight:800;
                                    color:#1B5E20;
                                    ">

                                    Checking verification status...

                                </div>

                            </div>

                        </div>


                        <span id="diditLiveBadge"
                              style="
                            display:inline-flex;
                            align-items:center;
                            gap:.35rem;
                            padding:.45rem .75rem;
                            border-radius:999px;
                            background:#DCEDC8;
                            color:#1B5E20;
                            font-size:.8rem;
                            font-weight:800;
                            ">

                            Checking

                        </span>

                    </div>


                    <div id="diditLiveDetails"
                         style="
                        margin-top:.8rem;
                        color:#5d7561;
                        font-size:.88rem;
                        ">

                        The admin page checks automatically every 3 seconds
                        while verification is active.

                    </div>


                    <div id="diditLiveChecks"
                         style="
                        display:none;
                        margin-top:.85rem;
                        gap:.5rem;
                        flex-wrap:wrap;
                        ">
                    </div>

                </div>


                @if (hasIdentityDocument)
                {
                    <div class="didit-document-reference">

                        <div>

                            <i class="bi bi-file-earmark-person-fill"></i>

                            <span>
                                Selected Identity Document
                            </span>

                        </div>


                        <strong>

                            @(approvedIdentityDocument?.DocumentName
                                ?? identityDocuments.First().DocumentName)

                        </strong>

                    </div>
                }

            </div>

        </div>


        <!-- =====================================================
             VERIFICATION
             ===================================================== -->

        <div class="col-12">

            <div class="review-card verification-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-shield-check"></i>
                        </span>

                        Verification

                    </h4>


                    <span class="status-badge
                        @(adminVerification
                                                      ? "pending"
                                                      : onboardingCompleted || readyForActivation
                                                          ? "verified"
                                                          : "")">

                        @if (adminVerification)
                        {
                            <i class="bi bi-hourglass-split"></i>

                            <span>
                                In Review
                            </span>
                        }
                        else if (onboardingCompleted)
                        {
                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Completed
                            </span>
                        }
                        else if (readyForActivation)
                        {
                            <i class="bi bi-patch-check-fill"></i>

                            <span>
                                Verified
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-clock"></i>

                            <span>
                                Not Started
                            </span>
                        }

                    </span>

                </div>


                <div class="verification-state">

                    <div class="verification-state-icon">

                        @if (onboardingCompleted)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else if (readyForActivation)
                        {
                            <i class="bi bi-person-check-fill"></i>
                        }
                        else if (adminVerification)
                        {
                            <i class="bi bi-shield-check"></i>
                        }
                        else
                        {
                            <i class="bi bi-hourglass-split"></i>
                        }

                    </div>


                    <div>

                        <div class="verification-state-title">

                            @if (onboardingCompleted)
                            {
                                <span>
                                    Verification completed
                                </span>
                            }
                            else if (readyForActivation)
                            {
                                <span>
                                    Verification completed — ready for activation
                                </span>
                            }
                            else if (adminVerification)
                            {
                                <span>
                                    Volunteer onboarding is currently under review
                                </span>
                            }
                            else
                            {
                                <span>
                                    Verification has not started
                                </span>
                            }

                        </div>


                        <div class="verification-state-text">

                            Review all uploaded documents and onboarding
                            requirements before completing verification.

                        </div>

                    </div>

                </div>


                <div class="verification-actions">


                    @if (!adminVerification &&
                         !readyForActivation &&
                         !onboardingCompleted)
                    {
                        <form asp-action="StartVerification"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="onboardingId"
                                   value="@Model.VolunteerOnboardingId" />

                            <button type="submit"
                                    class="btn-outline-swift">

                                <i class="bi bi-play-circle"></i>

                                Start Verification

                            </button>

                        </form>
                    }


                    @if (!onboardingCompleted)
                    {
                        <button type="button"
                                class="btn btn-outline-danger rounded-3 fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#correctionModal">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>

                            Request Correction

                        </button>
                    }


                    @if (adminVerification &&
                         !onboardingCompleted)
                    {
                        <button type="button"
                                class="btn-swift"
                                data-bs-toggle="modal"
                                data-bs-target="#completeVerificationModal">

                            <i class="bi bi-check-circle"></i>

                            Complete Verification

                        </button>
                    }


                </div>

            </div>

        </div>


        <!-- =====================================================
             ACTIVATION
             ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-person-check"></i>
                        </span>

                        Volunteer Activation

                    </h4>

                </div>


                @if (readyForActivation)
                {

                    <div class="activation-panel">

                        <div class="activation-content">

                            <div class="activation-icon">

                                <i class="bi bi-person-check-fill"></i>

                            </div>

                            <h5>
                                Ready for Activation
                            </h5>

                            <p class="mb-3">

                                All required onboarding verification steps
                                have been completed. The volunteer can now
                                be activated and their Volunteer account
                                created.

                            </p>


                            <a asp-controller="VolunteerOnboardingAdmin"
                                   asp-action="Activate"
                                   asp-route-id="@Model.VolunteerOnboardingId"
                                   class="btn-swift">

                                <i class="bi bi-person-check"></i>

                                Activate Volunteer

                            </a>

                        </div>

                    </div>

                }
                else if (onboardingCompleted)
                {

                    <div class="activation-panel">

                        <div class="activation-content">

                            <div class="activation-icon">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>

                            <h5>
                                Volunteer Activated
                            </h5>

                            <p class="mb-3">

                                This onboarding process has been completed
                                and the Volunteer account has been activated.

                            </p>


                            <a asp-controller="VolunteerOnboardingAdmin"
                                   asp-action="ActivatedVolunteer"
                                   asp-route-onboardingId="@Model.VolunteerOnboardingId"
                                   class="btn-swift">

                                <i class="bi bi-person-vcard"></i>

                                View Volunteer

                            </a>

                        </div>

                    </div>

                }
                else
                {

                    <div class="empty-state">

                        <i class="bi bi-hourglass-split"></i>

                        <span>

                            This volunteer is not yet ready for activation.
                            Complete verification before activation becomes
                            available.

                        </span>

                    </div>

                }

            </div>

        </div>


    </div>

</div>


<!-- =============================================================
     REVIEW DOCUMENT MODAL
     ============================================================= -->

<div class="modal fade"
     id="reviewDocumentModal"
     tabindex="-1"
     aria-labelledby="reviewDocumentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content swift-modal">

            <form asp-action="ReviewDocument"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h5 class="modal-title"
                        id="reviewDocumentModalLabel">

                        <i class="bi bi-file-check me-2"></i>

                        Review Document

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="reviewDocumentId"
                           name="documentId" />


                    <div class="mb-3">

                        <label class="swift-form-label">
                            Decision
                        </label>

                        <select name="status"
                                class="form-select swift-form-select"
                                required>

                            <option value="Approved">
                                Approve
                            </option>

                            <option value="Rejected">
                                Reject
