
@model IEnumerable<SwiftCare.Models.Order>
@inject SwiftCare.Interfaces.IEncryptionService encryptionService

@{
    ViewData["Title"] = "My Equipment Orders";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

@functions {
    string GetStatusClass(SwiftCare.Models.OrderStatus status)
    {
        return status switch
        {
            SwiftCare.Models.OrderStatus.Pending => "sc-orders-status-pending",
            SwiftCare.Models.OrderStatus.OnTheWay => "sc-orders-status-ontheway",
            SwiftCare.Models.OrderStatus.Collected => "sc-orders-status-collected",
            _ => ""
        };
    }

    string GetStatusDisplay(SwiftCare.Models.OrderStatus status)
    {
        return status switch
        {
            SwiftCare.Models.OrderStatus.Pending => "Pending",
            SwiftCare.Models.OrderStatus.OnTheWay => "On The Way",
            SwiftCare.Models.OrderStatus.Collected => "Collected",
            _ => status.ToString()
        };
    }
}

<div class="sc-orders-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <section class="sc-orders-header">

        <div class="sc-orders-header-inner">

            <div class="sc-orders-title-section">

                <a asp-controller="Home"
                       asp-action="Index"
                       class="sc-orders-back-button"
                       title="Back to Dashboard">

                    <i class="bi bi-chevron-left"></i>

                </a>

                <div>

                    <h1 class="sc-orders-heading">
                        My Equipment Orders
                    </h1>

                    <p class="sc-orders-subheading">
                        Track your equipment orders and view their current status.
                    </p>

                </div>

            </div>


            <!-- FILTERS -->

            <div class="sc-orders-filter-group">

                <button type="button"
                        class="sc-orders-filter-button"
                        data-filter="Pending">

                    <i class="bi bi-hourglass-split me-1"></i>
                    Pending

                </button>

                <button type="button"
                        class="sc-orders-filter-button"
                        data-filter="OnTheWay">

                    <i class="bi bi-truck me-1"></i>
                    On The Way

                </button>

                <button type="button"
                        class="sc-orders-filter-button"
                        data-filter="Collected">

                    <i class="bi bi-check-circle-fill me-1"></i>
                    Collected

                </button>

            </div>

        </div>

    </section>


    <!-- TEMP MESSAGE -->
    @if (TempData["Message"] != null)
    {
        <div id="scOrdersTempMessage"
             class="alert @(TempData["Message"]!.ToString()!.Contains("successfully")
                                          ? "alert-success"
                                          : "alert-danger")"
             role="alert">

            @TempData["Message"]

        </div>
    }


    <!-- NO FILTER RESULTS -->

    <div class="sc-orders-no-results"
         id="scOrdersNoResults">

        <div class="sc-orders-empty-icon">

            <i class="bi bi-search"></i>

        </div>

        <h5>
            No equipment orders found
        </h5>

        <p class="mb-0">
            You don't have any equipment orders matching this filter.
        </p>

    </div>


    <!-- NO ORDERS -->
    @if (Model == null || !Model.Any())
    {
        <div class="container-fluid">

            <div class="sc-orders-empty-state">

                <div class="sc-orders-empty-icon">

                    <i class="bi bi-box-seam"></i>

                </div>

                <h4>
                    No Equipment Orders Yet
                </h4>

                <p>
                    You haven't placed any equipment orders yet.
                </p>

                <a asp-controller="Equipment"
                       asp-action="Index"
                       class="sc-orders-details-button sc-orders-empty-button">

                    <i class="bi bi-plus-lg"></i>

                    Browse Equipment

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="container-fluid sc-orders-grid">

            <div class="row g-4"
                 id="scOrdersContainer">

                @foreach (var item in Model)
                {
                    var encryptedId =
                        encryptionService.Encrypt(item.OrderId);

                    <div class="col-12 col-md-6 col-xl-4">

                        <article class="sc-orders-card"
                                 data-id="@item.OrderId"
                                 data-status="@item.Status">

                            <div class="sc-orders-card-header">

                                <div class="sc-orders-card-header-content">

                                    <div class="sc-orders-card-label">
                                        Equipment Order
                                    </div>

                                    <div class="sc-orders-card-number">
                                        @item.OrderNumber
                                    </div>

                                </div>

                                <div class="sc-orders-card-header-icon">

                                    <i class="bi bi-box-seam-fill"></i>

                                </div>

                            </div>


                            <div class="sc-orders-card-body">

                                <div class="sc-orders-info-row">

                                    <div class="sc-orders-info-icon">

                                        <i class="bi bi-calendar3"></i>

                                    </div>

                                    <div class="sc-orders-info-content">

                                        <span class="sc-orders-info-label">
                                            Order Date
                                        </span>

                                        <span class="sc-orders-info-value">
                                            @item.OrderDate.ToString("dd MMM yyyy, HH:mm")
                                        </span>

                                    </div>

                                </div>


                                <div class="sc-orders-info-row">

                                    <div class="sc-orders-info-icon">

                                        <i class="bi bi-boxes"></i>

                                    </div>

                                    <div class="sc-orders-info-content">

                                        <span class="sc-orders-info-label">
                                            Equipment Quantity
                                        </span>

                                        <span class="sc-orders-info-value">

                                            @(item.OrderItems?.Sum(x => x.Quantity) ?? 0)
                                            item(s)

                                        </span>

                                    </div>

                                </div>


                                <div class="sc-orders-info-row">

                                    <div class="sc-orders-info-icon">

                                        <i class="bi bi-clock-history"></i>

                                    </div>

                                    <div class="sc-orders-info-content">

                                        <span class="sc-orders-info-label">
                                            Last Updated
                                        </span>

                                        <span class="sc-orders-info-value">
                                            @item.LastUpdated.ToString("dd MMM yyyy, HH:mm")
                                        </span>

                                    </div>

                                </div>


                                <div class="sc-orders-info-row">

                                    <div class="sc-orders-info-icon">

                                        <i class="bi bi-info-circle"></i>

                                    </div>

                                    <div class="sc-orders-info-content">

                                        <span class="sc-orders-info-label">
                                            Order Status
                                        </span>

                                        <span class="sc-orders-status-badge @GetStatusClass(item.Status)">
                                            @GetStatusDisplay(item.Status)
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="sc-orders-card-actions">

                                <a asp-controller="Orders"
                                       asp-action="OrderDetails"
                                       asp-route-orderId="@encryptedId"
                                       class="sc-orders-details-button">

                                    <i class="bi bi-eye-fill"></i>

                                    View Order Details

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </article>

                    </div>
                }

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const cards =
                    document.querySelectorAll(
                        ".sc-orders-card"
                    );

                const filterButtons =
                    document.querySelectorAll(
                        ".sc-orders-filter-button"
                    );

                const noResultsMessage =
                    document.getElementById(
                        "scOrdersNoResults"
                    );


                filterButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                const selectedStatus =
                                    button.getAttribute(
                                        "data-filter"
                                    );


                                filterButtons.forEach(
                                    function (btn) {

                                        btn.classList.remove(
                                            "sc-orders-filter-active"
                                        );

                                    }
                                );


                                button.classList.add(
                                    "sc-orders-filter-active"
                                );


                                let hasVisibleCard = false;


                                cards.forEach(
                                    function (card) {

                                        const colDiv =
                                            card.parentElement;

                                        const cardStatus =
                                            card.getAttribute(
                                                "data-status"
                                            );

                                        const isVisible =
                                            selectedStatus ===
                                            cardStatus;


                                        colDiv.style.display =
                                            isVisible
                                                ? ""
                                                : "none";


                                        if (isVisible) {

                                            hasVisibleCard = true;

                                        }

                                    }
                                );


                                if (noResultsMessage) {

                                    noResultsMessage.style.display =
                                        hasVisibleCard
                                            ? "none"
                                            : "block";

                                }

                            }
                        );

                    }
                );


                const defaultFilter =
                    document.querySelector(
                        '.sc-orders-filter-button[data-filter="Pending"]'
                    );


                if (defaultFilter) {

                    defaultFilter.click();

                }


                cards.forEach(
                    function (card, index) {

                        card.style.opacity = "0";
                        card.style.transform =
                            "translateY(18px)";

                        setTimeout(
                            function () {

                                card.style.transition =
                                    "opacity 0.45s ease, transform 0.45s ease";

                                card.style.opacity = "1";
                                card.style.transform =
                                    "translateY(0)";

                            },
                            index * 80
                        );

                    }
                );


                setTimeout(
                    function () {

                        const tempMessage =
                            document.getElementById(
                                "scOrdersTempMessage"
                            );

                        if (tempMessage) {

                            tempMessage.style.display =
                                "none";

                        }

                    },
                    7000
                );

            }
        );

    </script>

}

