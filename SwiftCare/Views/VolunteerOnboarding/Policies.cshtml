@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding

@{
    ViewData["Title"] = "Volunteer Policies";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var policies =
        ViewBag.Policies as List<SwiftCare.Models.VolunteerOnboarding.VolunteerPolicy>
        ?? new List<SwiftCare.Models.VolunteerOnboarding.VolunteerPolicy>();

    var requiredPolicies =
        policies
            .Where(x => x.IsRequired)
            .ToList();

    var allPoliciesAccepted =
        requiredPolicies.Any() &&
        requiredPolicies.All(policy =>
            Model.PolicyAcceptances.Any(x =>
                x.VolunteerPolicyId == policy.VolunteerPolicyId &&
                x.Accepted &&
                x.PolicyVersion == policy.Version));

    var acceptedCount =
        requiredPolicies.Count(policy =>
            Model.PolicyAcceptances.Any(x =>
                x.VolunteerPolicyId == policy.VolunteerPolicyId &&
                x.Accepted &&
                x.PolicyVersion == policy.Version));

    var totalRequiredPolicies =
        requiredPolicies.Count;

    var progressPercentage =
        totalRequiredPolicies > 0
            ? (acceptedCount * 100) / totalRequiredPolicies
            : 0;
}

<div class="policy-page">

    <!-- =========================================================
         POLICY HEADER
         ========================================================= -->

    <div class="policy-header">

        <div class="policy-header-content">

            <div class="policy-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>

                <h1>
                    Volunteer Policies
                </h1>

                <p>
                    Please review and accept all required SwiftCare
                    volunteer policies before continuing.
                </p>

            </div>

        </div>


        <!-- =====================================================
             POLICY PROGRESS
             ===================================================== -->

        <div class="policy-progress">

            <div class="policy-progress-top">

                <span class="policy-progress-label">
                    Policy Completion
                </span>

                <span class="policy-progress-count">
                    @acceptedCount of @totalRequiredPolicies accepted
                </span>

            </div>

            <div class="policy-progress-track">

                <div class="policy-progress-bar"
                     style="width: @progressPercentage%;">
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         POLICIES
         ========================================================= -->

    <div class="policies-container">

        @if (!policies.Any())
        {
            <div class="policy-card">

                <div class="policy-card-body">

                    <div class="policy-description">

                        <div class="policy-description-intro">

                            <i class="bi bi-info-circle me-2"></i>

                            No active volunteer policies are currently
                            available.

                        </div>

                    </div>

                </div>

            </div>
        }
        else
        {
            var policyNumber = 1;

            foreach (var policy in policies)
            {
                var isAccepted =
                    Model.PolicyAcceptances.Any(x =>
                        x.VolunteerPolicyId == policy.VolunteerPolicyId &&
                        x.Accepted &&
                        x.PolicyVersion == policy.Version);

                var items =
                    policy.Items?
                        .Where(x => x.IsActive)
                        .OrderBy(x => x.DisplayOrder)
                        .ToList()
                    ?? new List<SwiftCare.Models.VolunteerOnboarding.VolunteerPolicyItem>();

                var introItems =
                    items
                        .Where(x =>
                            !x.IsSubheading &&
                            string.IsNullOrWhiteSpace(x.Heading))
                        .ToList();

                var sectionItems =
                    items
                        .Where(x =>
                            x.IsSubheading ||
                            !string.IsNullOrWhiteSpace(x.Heading))
                        .ToList();

                <div class="policy-card"
                     data-policy-id="@policy.VolunteerPolicyId"
                     data-required="@policy.IsRequired.ToString().ToLower()"
                     data-accepted="@isAccepted.ToString().ToLower()">

                    <!-- =================================================
                         POLICY CARD HEADER
                         ================================================= -->

                    <div class="policy-card-header">

                        <div class="policy-title-row">

                            <div class="policy-number">
                                @policyNumber
                            </div>

                            <div>

                                <h2 class="policy-title">
                                    @policy.Title
                                </h2>

                                <div class="policy-meta">

                                    <span class="policy-version">
                                        <i class="bi bi-tag"></i>
                                        Version @policy.Version
                                    </span>

                                    @if (policy.IsRequired)
                                    {
                                        <span class="required-badge">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Required
                                        </span>
                                    }

                                    @if (isAccepted)
                                    {
                                        <span class="policy-status accepted">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Accepted
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         POLICY BODY
                         ================================================= -->

                    <div class="policy-card-body">

                        <div class="policy-description">

                            <!-- =============================================
                                 INTRODUCTION
                                 ============================================= -->
                            @foreach (var intro in introItems)
                            {
                                if (!string.IsNullOrWhiteSpace(intro.Description))
                                {
                                    <div class="policy-description-intro">
                                        @intro.Description
                                    </div>
                                }
                            }


                            <!-- =============================================
                                 POLICY SECTIONS
                                 ============================================= -->
                            @if (sectionItems.Any())
                            {
                                <div class="policy-sections">

                                    @foreach (var item in sectionItems)
                                    {
                                        <div class="policy-section">

                                            @if (!string.IsNullOrWhiteSpace(item.Heading))
                                            {
                                                <div class="policy-section-title">
                                                    @item.Heading
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.Description))
                                            {
                                                <div class="policy-section-text">
                                                    @item.Description
                                                </div>
                                            }

                                        </div>
                                    }

                                </div>
                            }


                            <!-- =============================================
                                 PLAIN TEXT
                                 ============================================= -->
                            @foreach (var item in items.Where(x =>
                                                            !x.IsSubheading &&
                                                            !string.IsNullOrWhiteSpace(x.Heading)))
                            {
                                <div class="policy-plain-text">
                                    @item.Description
                                </div>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         POLICY FOOTER
                         ================================================= -->

                    <div class="policy-card-footer">

                        <div class="policy-actions">

                            @if (!string.IsNullOrWhiteSpace(policy.DocumentPath))
                            {
                                <a href="@policy.DocumentPath"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-policy-view">

                                    <i class="bi bi-file-earmark-text"></i>

                                    View Document

                                </a>
                            }

                        </div>


                        <div class="policy-actions">

                            @if (isAccepted)
                            {
                                <div class="accepted-message">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Policy Accepted

                                </div>
                            }
                            else
                            {
                                <form asp-action="AcceptPolicy"
                                      asp-controller="VolunteerOnboarding"
                                      method="post"
                                      class="accept-policy-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="onboardingId"
                                           value="@Model.VolunteerOnboardingId" />

                                    <input type="hidden"
                                           name="policyId"
                                           value="@policy.VolunteerPolicyId" />

                                    <button type="submit"
                                            class="btn-policy accept-policy-button">

                                        <i class="bi bi-check2-circle"></i>

                                        <span>
                                            Accept Policy
                                        </span>

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>

                policyNumber++;
            }
        }

    </div>


    <!-- =========================================================
         CONTINUE CARD
         ========================================================= -->
    @if (allPoliciesAccepted)
    {
        <div class="continue-card">

            <div class="continue-card-content">

                <div>

                    <h3>
                        All Required Policies Accepted
                    </h3>

                    <p>
                        You have accepted all required SwiftCare
                        volunteer policies. You can now continue
                        to upload your onboarding documents.
                    </p>

                </div>


                <!-- =================================================
                     CONTINUE BUTTON
                     ================================================= -->

                <div class="continue-actions">

                    <a href="@Url.Action("Documents", "VolunteerOnboarding", new { id = Model.VolunteerOnboardingId })"
                           class="btn-continue"
                           id="continueButton">

                        <span>
                            Continue to Documents
                        </span>

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>
    }


    <!-- =========================================================
         POLICY TOAST
         ========================================================= -->

    <div id="policyToast"
         class="policy-toast"
         role="alert"
         aria-live="polite">

        <div class="policy-toast-icon">

            <i class="bi bi-check-circle-fill"></i>

        </div>

        <div class="policy-toast-content">

            <strong id="policyToastTitle">
                Success
            </strong>

            <span id="policyToastMessage">
                Policy accepted successfully.
            </span>

        </div>

        <button type="button"
                class="policy-toast-close"
                id="policyToastClose"
                aria-label="Close">

            <i class="bi bi-x"></i>

        </button>

    </div>

</div>


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const policyCards =
                document.querySelectorAll(".policy-card");

            const progressBar =
                document.querySelector(".policy-progress-bar");

            const progressCount =
                document.querySelector(".policy-progress-count");

            const toast =
                document.getElementById("policyToast");

            const toastTitle =
                document.getElementById("policyToastTitle");

            const toastMessage =
                document.getElementById("policyToastMessage");

            const toastClose =
                document.getElementById("policyToastClose");


            /* =====================================================
               TOAST
               ===================================================== */

            let toastTimer = null;

            function showToast(title, message) {

                if (!toast)
                    return;

                if (toastTitle)
                    toastTitle.textContent = title;

                if (toastMessage)
                    toastMessage.textContent = message;

                toast.classList.add("show");

                clearTimeout(toastTimer);

                toastTimer = setTimeout(function () {

                    toast.classList.remove("show");

                }, 4000);
            }


            if (toastClose) {

                toastClose.addEventListener("click", function () {

                    toast.classList.remove("show");

                });

            }


            /* =====================================================
               UPDATE POLICY PROGRESS
               ===================================================== */

            function updatePolicyProgress() {

                const requiredCards =
                    Array.from(policyCards)
                        .filter(card =>
                            card.dataset.required === "true");

                const acceptedCards =
                    requiredCards.filter(card =>
                        card.dataset.accepted === "true");

                const total =
                    requiredCards.length;

                const accepted =
                    acceptedCards.length;

                const percentage =
                    total > 0
                        ? Math.round((accepted / total) * 100)
                        : 0;

                if (progressBar) {

                    progressBar.style.width =
                        percentage + "%";

                }

                if (progressCount) {

                    progressCount.textContent =
                        `${accepted} of ${total} accepted`;

                }
            }


            /* =====================================================
               ACCEPT POLICY
               ===================================================== */

            document
                .querySelectorAll(".accept-policy-form")
                .forEach(function (form) {

                    form.addEventListener("submit", async function (event) {

                        event.preventDefault();

                        const button =
                            form.querySelector(".accept-policy-button");

                        if (!button)
                            return;

                        if (button.disabled)
                            return;

                        const originalHtml =
                            button.innerHTML;

                        button.disabled = true;

                        button.innerHTML = `
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-hidden="true"></span>
                            <span>Accepting...</span>
                        `;

                        try {

                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method: "POST",
                                        body: new FormData(form),
                                        headers: {
                                            "X-Requested-With": "XMLHttpRequest"
                                        }
                                    });

                            if (!response.ok) {

                                throw new Error(
                                    "Unable to accept the policy."
                                );

                            }

                            let result = null;

                            const contentType =
                                response.headers.get("content-type") || "";

                            if (contentType.includes("application/json")) {

                                result =
                                    await response.json();

                            }


                            /* =============================================
                               UPDATE CARD
                               ============================================= */

                            const card =
                                form.closest(".policy-card");

                            if (card) {

                                card.dataset.accepted = "true";

                                const status =
                                    card.querySelector(".policy-status");

                                if (status) {

                                    status.innerHTML = `
                                        <i class="bi bi-check-circle-fill"></i>
                                        Accepted
                                    `;

                                    status.classList.add("accepted");

                                }


                                const actions =
                                    form.closest(".policy-actions");

                                if (actions) {

                                    actions.innerHTML = `
                                        <div class="accepted-message">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Policy Accepted
                                        </div>
                                    `;

                                }

                            }


                            /* =============================================
                               SHOW SUCCESS
                               ============================================= */

                            showToast(
                                "Policy Accepted",
                                result?.message ||
                                "The policy has been accepted successfully."
                            );


                            /* =============================================
                               UPDATE PROGRESS
                               ============================================= */

                            updatePolicyProgress();


                            /* =============================================
                               RELOAD WHEN ALL REQUIRED POLICIES
                               ARE ACCEPTED
                               ============================================= */

                            const requiredCards =
                                Array.from(policyCards)
                                    .filter(card =>
                                        card.dataset.required === "true");

                            const acceptedCards =
                                requiredCards.filter(card =>
                                    card.dataset.accepted === "true");


                            if (
                                requiredCards.length > 0 &&
                                acceptedCards.length === requiredCards.length
                            ) {

                                setTimeout(function () {

                                    window.location.reload();

                                }, 700);

                            }

                        }
                        catch (error) {

                            console.error(error);

                            button.disabled = false;

                            button.innerHTML =
                                originalHtml;

                            showToast(
                                "Unable to Accept Policy",
                                "Something went wrong while accepting this policy. Please try again."
                            );

                        }

                    });

                });


            /* =====================================================
               INITIAL PROGRESS
               ===================================================== */

            updatePolicyProgress();

        });
    </script>
}