@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding
@using SwiftCare.Helpers

@{
    ViewData["Title"] = "Onboarding Documents";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var documents =
        Model.Documents?
            .OrderByDescending(x => x.UploadedDate)
            .ToList()
        ?? new List<SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocument>();

    var hasDocuments = documents.Any();

    var hasPendingDocuments =
        documents.Any(x =>
            x.Status ==
            SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentStatus.Uploaded ||
            x.Status ==
            SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentStatus.UnderReview);

    var hasRejectedDocuments =
        documents.Any(x =>
            x.Status ==
            SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentStatus.Rejected ||
            x.Status ==
            SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentStatus.ResubmissionRequired);

    var documentsSubmitted =
        Model.DocumentsSubmittedDate.HasValue;
}


<div class="container documents-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="documents-header">

        <h1>
            <i class="bi bi-folder-check me-2"></i>
            Onboarding Documents
        </h1>

        <p class="mb-0 text-muted">
            Upload the documents you want SwiftCare to review as part of
            your volunteer onboarding. Documents will be reviewed before
            you can proceed to the next onboarding stage.
        </p>

    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

        </div>
    }


    <!-- =========================================================
         ERROR MESSAGE
         ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Error"]

        </div>
    }


    <!-- =========================================================
         INFORMATION
         ========================================================= -->

    <div class="documents-info">

        <i class="bi bi-info-circle"></i>

        <div>

            <strong>Document requirements:</strong>

            You do not need to upload every available document type.
            Upload the documents that are applicable to your volunteer
            onboarding. SwiftCare will review the documents after you
            submit them for verification.

        </div>

    </div>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="row g-4">


        <!-- =====================================================
             UPLOAD DOCUMENT
             ===================================================== -->

        <div class="col-lg-5">

            <div class="upload-card">

                <h4 class="mb-4">

                    <i class="bi bi-cloud-arrow-up me-2"></i>

                    Upload Document

                </h4>


                <form asp-action="UploadDocument"
                      asp-controller="VolunteerOnboarding"
                      method="post"
                      enctype="multipart/form-data"
                      id="uploadDocumentForm">

                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         ONBOARDING ID
                         ================================================= -->

                    <input type="hidden"
                           name="onboardingId"
                           value="@Model.VolunteerOnboardingId" />


                    <!-- =================================================
                         DOCUMENT TYPE
                         ================================================= -->

                    <div class="mb-3">

                        <label class="form-label">
                            Document Type
                        </label>

                        <select name="documentType"
                                class="form-select"
                                required>

                            <option value="">
                                Select document type
                            </option>

                            @foreach (var documentType in Enum.GetValues<SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentType>())
                            {
                                <option value="@documentType">
                                    @documentType.GetDisplayName()
                                </option>
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         DOCUMENT NAME
                         ================================================= -->

                    <div class="mb-3">

                        <label class="form-label">
                            Document Name
                        </label>

                        <input type="text"
                               name="documentName"
                               class="form-control"
                               maxlength="200"
                               placeholder="e.g. South African ID"
                               required />

                    </div>


                    <!-- =================================================
                         FILE
                         ================================================= -->

                    <div class="mb-4">

                        <label class="form-label">
                            Document File
                        </label>


                        <label class="document-upload-zone"
                               id="documentUploadZone"
                               for="documentFile">

                            <input type="file"
                                   id="documentFile"
                                   name="file"
                                   class="document-upload-input"
                                   accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                                   required />


                            <div class="document-upload-content">

                                <div class="document-upload-icon">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                </div>


                                <div class="document-upload-title">

                                    Drop your document here

                                </div>


                                <div class="document-upload-subtitle">

                                    or click to browse your computer

                                </div>


                                <div class="document-upload-file-name"
                                     id="selectedFileName">
                                </div>


                                <div class="document-upload-hint">

                                    <i class="bi bi-paperclip"></i>

                                    PDF, JPG, PNG, DOC or DOCX

                                    <span>•</span>

                                    Maximum 50 MB

                                </div>

                            </div>

                        </label>

                    </div>


                    <!-- =================================================
                         UPLOAD BUTTON
                         ================================================= -->

                    <button type="submit"
                            class="btn btn-swift w-100"
                            id="uploadDocumentButton">

                        <i class="bi bi-upload me-2"></i>

                        Upload Document

                    </button>

                </form>

            </div>

        </div>


        <!-- =====================================================
             EXISTING DOCUMENTS
             ===================================================== -->

        <div class="col-lg-7">

            <div class="documents-card">

                <h4 class="mb-0">

                    <i class="bi bi-files me-2"></i>

                    Uploaded Documents

                </h4>


                @if (!documents.Any())
                {
                    <div class="documents-empty">

                        <div class="documents-empty-icon">

                            <i class="bi bi-folder2-open"></i>

                        </div>

                        <p>
                            No documents uploaded yet.
                        </p>

                        <small>
                            Upload the documents applicable to your
                            volunteer onboarding.
                        </small>

                    </div>
                }
                else
                {
                    <div class="document-list">

                        @foreach (var document in documents)
                        {
                            <div class="document-row">

                                <div class="document-row-inner">

                                    <!-- DOCUMENT ICON -->
                                    <div class="document-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>

                                    <!-- DOCUMENT DETAILS -->
                                    <div class="document-details">

                                        <div class="document-name">
                                            @document.DocumentName
                                        </div>

                                        <div class="document-meta document-file-meta">

                                            <span class="document-file-name">
                                                @document.FileName
                                            </span>

                                            <span class="document-separator">•</span>

                                            <span>
                                                @document.DocumentType.GetDisplayName()
                                            </span>

                                            <span class="document-separator">•</span>

                                            <span>
                                                @(document.FileSize < 1024 * 1024
                                                    ? $"{document.FileSize / 1024.0:N1} KB"
                                                    : $"{document.FileSize / (1024.0 * 1024.0):N1} MB")
                                            </span>

                                        </div>

                                        <div class="document-meta document-uploaded-meta">

                                            <i class="bi bi-clock"></i>

                                            <span>
                                                Uploaded
                                            </span>

                                            <span>
                                                @(document.UploadedDate
                                                    .ToLocalTime()
                                                    .ToString("dd MMM yyyy HH:mm"))
                                            </span>

                                        </div>

                                    </div>

                                    <!-- DOCUMENT ACTIONS -->
                                    <div class="document-actions">

                                        <span class="status-badge">
                                            @document.Status
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(document.FilePath))
                                        {
                                            <a href="@Url.Content("~/" + document.FilePath)"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="btn btn-sm btn-outline-success">

                                                <i class="bi bi-eye me-1"></i>
                                                View
                                            </a>
                                        }

                                    </div>

                                </div>

                                <!-- REJECTION / CORRECTION -->
                                @if (!string.IsNullOrWhiteSpace(document.RejectionReason))
                                {
                                    <div class="document-correction">

                                        <div class="alert alert-danger mb-0">

                                            <strong>
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Correction required:
                                            </strong>

                                            <span>
                                                @document.RejectionReason
                                            </span>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         VERIFICATION STATUS
         ========================================================= -->
    @if (documentsSubmitted)
    {
        <div class="verification-card mt-4">

            <div class="d-flex align-items-start gap-3">

                <div class="document-icon">

                    <i class="bi bi-hourglass-split"></i>

                </div>

                <div>

                    <h5>
                        Documents Submitted for Verification
                    </h5>

                    <p>
                        Your uploaded documents have been submitted for
                        SwiftCare administration to review. You will be
                        able to continue once the required verification
                        process has been completed.
                    </p>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- =========================================================
             SUBMIT FOR VERIFICATION
             ========================================================= -->

        <div class="documents-submit-area">

            @if (hasDocuments)
            {
                <form asp-action="SubmitForVerification"
                      asp-controller="VolunteerOnboarding"
                      method="post"
                      id="submitVerificationForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.VolunteerOnboardingId" />

                    <button type="submit"
                            class="btn btn-swift"
                            id="submitVerificationButton">

                        <i class="bi bi-send-check me-2"></i>

                        Submit for Verification

                    </button>

                </form>
            }
            else
            {
                <button type="button"
                        class="btn btn-swift"
                        disabled>

                    <i class="bi bi-send-check me-2"></i>

                    Upload Documents First

                </button>
            }

        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =========================================================
               FILE UPLOAD ZONE
               ========================================================= */

            const uploadZone =
                document.getElementById("documentUploadZone");

            const fileInput =
                document.getElementById("documentFile");

            const selectedFileName =
                document.getElementById("selectedFileName");


            if (uploadZone && fileInput) {

                fileInput.addEventListener("change", function () {

                    if (this.files && this.files.length > 0) {

                        const file = this.files[0];

                        selectedFileName.innerHTML = `
                            <i class="bi bi-check-circle me-1"></i>
                            ${escapeHtml(file.name)}
                        `;

                        uploadZone.classList.add("has-file");

                    }
                    else {

                        selectedFileName.innerHTML = "";

                        uploadZone.classList.remove("has-file");

                    }

                });


                /* =====================================================
                   DRAG OVER
                   ===================================================== */

                uploadZone.addEventListener("dragover", function (event) {

                    event.preventDefault();

                    uploadZone.classList.add("dragover");

                });


                /* =====================================================
                   DRAG LEAVE
                   ===================================================== */

                uploadZone.addEventListener("dragleave", function (event) {

                    event.preventDefault();

                    uploadZone.classList.remove("dragover");

                });


                /* =====================================================
                   DROP
                   ===================================================== */

                uploadZone.addEventListener("drop", function (event) {

                    event.preventDefault();

                    uploadZone.classList.remove("dragover");

                    const files = event.dataTransfer.files;

                    if (!files || files.length === 0) {
                        return;
                    }

                    const dataTransfer = new DataTransfer();

                    dataTransfer.items.add(files[0]);

                    fileInput.files = dataTransfer.files;

                    const file = files[0];

                    selectedFileName.innerHTML = `
                        <i class="bi bi-check-circle me-1"></i>
                        ${escapeHtml(file.name)}
                    `;

                    uploadZone.classList.add("has-file");

                });

            }


            /* =========================================================
               UPLOAD BUTTON
               ========================================================= */

            const uploadForm =
                document.getElementById("uploadDocumentForm");

            const uploadButton =
                document.getElementById("uploadDocumentButton");


            if (uploadForm && uploadButton) {

                uploadForm.addEventListener("submit", function () {

                    uploadButton.disabled = true;

                    uploadButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"
                              aria-hidden="true"></span>
                        Uploading...
                    `;

                });

            }


            /* =========================================================
               SUBMIT FOR VERIFICATION
               ========================================================= */

            const verificationForm =
                document.getElementById("submitVerificationForm");

            const verificationButton =
                document.getElementById("submitVerificationButton");


            if (verificationForm && verificationButton) {

                verificationForm.addEventListener("submit", function (event) {

                    const confirmed =
                        window.confirm(
                            "Are you sure you want to submit your uploaded documents for verification?"
                        );

                    if (!confirmed) {

                        event.preventDefault();

                        return;

                    }

                    verificationButton.disabled = true;

                    verificationButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"
                              aria-hidden="true"></span>
                        Submitting...
                    `;

                });

            }


            /* =========================================================
               HTML ESCAPE
               ========================================================= */

            function escapeHtml(value) {

                const div = document.createElement("div");

                div.textContent = value;

                return div.innerHTML;

            }

        });

    </script>
}