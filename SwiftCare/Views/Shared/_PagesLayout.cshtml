    <!-- =========================================================
         SWIFTCARE SIDEBAR
         ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* =====================================================
               ELEMENTS
               ===================================================== */

            const menuToggle =
                document.getElementById("scx-menu-toggle");

            const sidebarShell =
                document.getElementById("scx-sidebar-shell");

            const sidebarOverlay =
                document.getElementById("scx-sidebar-overlay");


            /* =====================================================
               SIDEBAR TOGGLE
               ===================================================== */

            if (menuToggle && sidebarShell) {

                menuToggle.addEventListener("click", function (event) {

                    event.preventDefault();
                    event.stopPropagation();


                    /* =============================================
                       MOBILE
                       ============================================= */

                    if (window.innerWidth <= 768) {

                        document.body.classList.toggle(
                            "scx-mobile-sidebar-open"
                        );


                        const mobileOpen =
                            document.body.classList.contains(
                                "scx-mobile-sidebar-open"
                            );


                        menuToggle.setAttribute(
                            "aria-expanded",
                            mobileOpen.toString()
                        );


                        return;
                    }


                    /* =============================================
                       DESKTOP
                       ============================================= */

                    const collapsed =
                        document.body.classList.toggle(
                            "scx-sidebar-collapsed"
                        );


                    menuToggle.setAttribute(
                        "aria-expanded",
                        (!collapsed).toString()
                    );


                    const icon =
                        menuToggle.querySelector("i");


                    if (icon) {

                        icon.className = collapsed
                            ? "bi bi-layout-sidebar-inset-reverse"
                            : "bi bi-layout-sidebar-inset";

                    }


                    localStorage.setItem(
                        "scxSidebarCollapsed",
                        collapsed ? "true" : "false"
                    );

                });


                /* =================================================
                   RESTORE SAVED STATE
                   ================================================= */

                const savedState =
                    localStorage.getItem(
                        "scxSidebarCollapsed"
                    );


                if (
                    savedState === "true" &&
                    window.innerWidth > 768
                ) {

                    document.body.classList.add(
                        "scx-sidebar-collapsed"
                    );


                    menuToggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    const icon =
                        menuToggle.querySelector("i");


                    if (icon) {

                        icon.className =
                            "bi bi-layout-sidebar-inset-reverse";

                    }

                }

            }


            /* =====================================================
               MOBILE OVERLAY
               ===================================================== */

            if (sidebarOverlay) {

                sidebarOverlay.addEventListener(
                    "click",
                    function () {

                        document.body.classList.remove(
                            "scx-mobile-sidebar-open"
                        );


                        if (menuToggle) {

                            menuToggle.setAttribute(
                                "aria-expanded",
                                "false"
                            );

                        }

                    }
                );

            }


            /* =====================================================
               SUBMENUS
               ===================================================== */

            const submenuParents =
                document.querySelectorAll(
                    ".scx-nav-parent"
                );


            submenuParents.forEach(function (parent) {

                parent.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();
                        event.stopPropagation();


                        /* =========================================
                           COLLAPSED DESKTOP
                           ========================================= */

                        if (
                            window.innerWidth > 768 &&
                            document.body.classList.contains(
                                "scx-sidebar-collapsed"
                            )
                        ) {

                            return;

                        }


                        const submenuId =
                            parent.getAttribute(
                                "data-submenu"
                            );


                        if (!submenuId) {
                            return;
                        }


                        const submenu =
                            document.getElementById(
                                submenuId
                            );


                        if (!submenu) {
                            return;
                        }


                        const isOpen =
                            submenu.classList.contains(
                                "open"
                            );


                        /* =========================================
                           CLOSE OTHER SUBMENUS
                           ========================================= */

                        document
                            .querySelectorAll(
                                ".scx-submenu.open"
                            )
                            .forEach(function (otherMenu) {

                                if (otherMenu !== submenu) {

                                    otherMenu.classList.remove(
                                        "open"
                                    );


                                    const otherParent =
                                        document.querySelector(
                                            '[data-submenu="' +
                                            otherMenu.id +
                                            '"]'
                                        );


                                    if (otherParent) {

                                        otherParent.classList.remove(
                                            "open"
                                        );

                                    }

                                }

                            });


                        /* =========================================
                           CURRENT SUBMENU
                           ========================================= */

                        if (isOpen) {

                            submenu.classList.remove(
                                "open"
                            );


                            parent.classList.remove(
                                "open"
                            );

                        }
                        else {

                            submenu.classList.add(
                                "open"
                            );


                            parent.classList.add(
                                "open"
                            );

                        }

                    }
                );

            });


            /* =====================================================
               LOADING OVERLAY
               ===================================================== */

            window.addEventListener(
                "load",
                function () {

                    const loader =
                        document.getElementById(
                            "loading-overlay"
                        );


                    if (loader) {

                        loader.style.display = "none";

                    }

                }
            );


            /* =====================================================
               PAGE NAVIGATION LOADING
               ===================================================== */

            document.addEventListener(
                "click",
                function (event) {

                    const link =
                        event.target.closest("a");


                    if (!link) {
                        return;
                    }


                    const href =
                        link.getAttribute("href");


                    if (
                        !href ||
                        href.startsWith("#") ||
                        href.startsWith("javascript:") ||
                        link.target === "_blank"
                    ) {

                        return;

                    }


                    if (
                        link.closest(".scx-nav-parent")
                    ) {

                        return;

                    }


                    if (
                        link.closest("#scx-menu-toggle")
                    ) {

                        return;

                    }


                    const loader =
                        document.getElementById(
                            "loading-overlay"
                        );


                    if (loader) {

                        loader.style.display = "flex";

                    }

                }
            );


            /* =====================================================
               COOKIE FUNCTIONS
               ===================================================== */

            function getCookie(name) {

                const value =
                    `; ${document.cookie}`;


                const parts =
                    value.split(`; ${name}=`);


                if (parts.length === 2) {

                    return parts
                        .pop()
                        .split(";")
                        .shift();

                }


                return null;

            }


            function saveCookiePreferences(accepted) {

                document.cookie =
                    "cookieConsent=" +
                    accepted +
                    "; path=/; max-age=" +
                    (60 * 60 * 24 * 365);


                localStorage.setItem(
                    "cookieConsent",
                    accepted ? "true" : "false"
                );


                $.ajax({

                    url:
                        "/CookiePreferences/SavePreferences",

                    type:
                        "POST",

                    contentType:
                        "application/json",

                    data:
                        JSON.stringify({

                            PerformanceCookies:
                                accepted,

                            FunctionalityCookies:
                                accepted,

                            TargetingCookies:
                                accepted

                        }),

                    success:
                        function (response) {

                            if (
                                response &&
                                response.success
                            ) {

                                $(".cookie-banner").hide();

                            }

                        }

                });

            }


            /* =====================================================
               COOKIE BANNER
               ===================================================== */

            if (!getCookie("cookieConsent")) {

                $(".cookie-banner").show();

            }


            $("#accept-cookies").on(
                "click",
                function () {

                    saveCookiePreferences(true);

                }
            );


            $("#reject-cookies").on(
                "click",
                function () {

                    saveCookiePreferences(false);

                }
            );


            /* =====================================================
               RESIZE
               ===================================================== */

            let resizeTimer;


            window.addEventListener(
                "resize",
                function () {

                    clearTimeout(resizeTimer);


                    resizeTimer = setTimeout(
                        function () {

                            if (window.innerWidth <= 768) {

                                document.body.classList.remove(
                                    "scx-sidebar-collapsed"
                                );

                                return;

                            }


                            document.body.classList.remove(
                                "scx-mobile-sidebar-open"
                            );


                            const savedState =
                                localStorage.getItem(
                                    "scxSidebarCollapsed"
                                );


                            if (savedState === "true") {

                                document.body.classList.add(
                                    "scx-sidebar-collapsed"
                                );

                            }
                            else {

                                document.body.classList.remove(
                                    "scx-sidebar-collapsed"
                                );

                            }

                        },
                        100
                    );

                }
            );


        });

    </script>


    @RenderSection(
        "Scripts",
        required: false
    )

