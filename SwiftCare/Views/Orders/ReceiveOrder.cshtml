
@using System.Text.Json
@model SwiftCare.Models.Order

@{
    ViewData["Title"] = "Receive Equipment Order";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var orderItems = Model?.OrderItems?.ToList()
                     ?? new List<SwiftCare.Models.OrderItem>();

    var packageOrders = Model?.PackageOrders?.ToList()
                        ?? new List<SwiftCare.Models.PackageOrder>();

    // Safely get the encrypted order ID if your GET action originally
    // receives an encrypted value. If you don't use encryption here,
    // the JavaScript will fall back to Model.OrderId.
    var currentOrderId = Model?.OrderId;
}

<div class="sc-receive-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <section class="sc-receive-header">

        <div class="sc-receive-header-inner">

            <a asp-controller="Orders"
                   asp-action="Orders"
                   class="sc-receive-back"
                   title="Back to Orders">

                <i class="bi bi-chevron-left"></i>

            </a>

            <div>

                <h1 class="sc-receive-title">
                    Receive Equipment Order
                </h1>

                <p class="sc-receive-subtitle">
                    Scan the QR code on each package to verify the package
                    and receive the equipment belonging to this order.
                </p>

            </div>

        </div>

    </section>


    <div class="container-fluid px-4">

        @if (Model == null)
        {
            <div class="sc-receive-empty">

                <div class="sc-receive-empty-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h4>Order Not Found</h4>

                <p class="text-muted">
                    The equipment order could not be found.
                </p>

                <a asp-controller="Orders"
                       asp-action="Orders"
                       class="sc-receive-submit-button">

                    Back to Orders

                </a>

            </div>
        }
        else
        {
            <!-- ====================================================
                 ORDER SUMMARY
                 ==================================================== -->

            <div class="sc-receive-summary-card">

                <div class="row g-3">

                    <div class="col-6 col-md-3">

                        <div class="sc-receive-summary-item">

                            <span class="sc-receive-summary-label">
                                Order Number
                            </span>

                            <span class="sc-receive-summary-value">
                                @(Model.OrderNumber ?? "N/A")
                            </span>

                        </div>

                    </div>


                    <div class="col-6 col-md-3">

                        <div class="sc-receive-summary-item">

                            <span class="sc-receive-summary-label">
                                Order ID
                            </span>

                            <span class="sc-receive-summary-value">
                                #@Model.OrderId
                            </span>

                        </div>

                    </div>


                    <div class="col-6 col-md-3">

                        <div class="sc-receive-summary-item">

                            <span class="sc-receive-summary-label">
                                Order Date
                            </span>

                            <span class="sc-receive-summary-value">
                                @Model.OrderDate.ToString("dd MMM yyyy")
                            </span>

                        </div>

                    </div>


                    <div class="col-6 col-md-3">

                        <div class="sc-receive-summary-item">

                            <span class="sc-receive-summary-label">
                                Current Status
                            </span>

                            <span class="sc-receive-summary-value">
                                @Model.Status
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ====================================================
                 INFORMATION
                 ==================================================== -->

            <div class="sc-receive-info-banner">

                <div class="sc-receive-info-icon">
                    <i class="bi bi-info-lg"></i>
                </div>

                <div>

                    <div class="sc-receive-info-title">
                        Scan Package QR Codes
                    </div>

                    <p class="sc-receive-info-text">

                        Each package generated for this order has its own
                        registered QR code. Scan the package QR code to verify
                        the package against the database.

                        The system will identify the package, determine which
                        order item it belongs to, highlight the related
                        equipment, and mark the package as scanned.

                    </p>

                </div>

            </div>


            <!-- ====================================================
                 RECEIVE FORM
                 ==================================================== -->

            <form asp-controller="Orders"
                  asp-action="ReceiveOrder"
                  method="post"
                  id="scReceiveOrderForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderId" />


                <!-- ====================================================
                     SCANNED PACKAGE IDs
                     These are submitted with the final receive action.
                     ==================================================== -->

                <div id="scannedPackagesContainer"></div>


                <div class="row g-4">

                    <!-- ====================================================
                         QR SCANNER
                         ==================================================== -->

                    <div class="col-12 col-lg-4">

                        <div class="sc-receive-scanner-card">

                            <div class="sc-receive-scanner-heading">

                                <div class="sc-receive-scanner-icon">
                                    <i class="bi bi-qr-code-scan"></i>
                                </div>

                                <div>

                                    <h5>
                                        Scan Package QR Code
                                    </h5>

                                    <p>
                                        Scan the QR code attached to the
                                        equipment package.
                                    </p>

                                </div>

                            </div>


                            <div class="sc-receive-scanner-frame">

                                <div id="scanner"></div>

                            </div>


                            <div class="sc-receive-scanner-status"
                                 id="scannerStatus">

                                <i class="bi bi-camera"></i>

                                <span>
                                    Scanner ready
                                </span>

                            </div>


                            <div class="sc-receive-scan-result"
                                 id="scanResult"
                                 style="display:none;">

                                <div class="sc-receive-scan-result-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>

                                <div>

                                    <span class="sc-receive-scan-result-label">
                                        Package Identified
                                    </span>

                                    <strong id="scannedEquipmentName"></strong>

                                </div>

                            </div>


                            <div class="sc-receive-scanner-help">

                                <i class="bi bi-lightbulb"></i>

                                <span>
                                    Scan the QR code printed on a package.
                                    The package will be verified directly
                                    against this order.
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                         EQUIPMENT ITEMS
                         ==================================================== -->

                    <div class="col-12 col-lg-8">

                        <h5 class="sc-receive-section-title">

                            <i class="bi bi-box-seam-fill"></i>

                            Equipment & Packages

                        </h5>


                        @if (orderItems.Any())
                        {
                            foreach (var item in orderItems)
                            {
                                var equipmentName =
                                    item.Equipment?.EquipmentName
                                    ?? "Equipment";

                                var itemPackages =
                                    packageOrders
                                        .Where(p =>
                                            p.OrderItemId == item.OrderItemId)
                                        .ToList();

                                <div class="sc-receive-equipment-card"
                                     data-order-item-id="@item.OrderItemId"
                                     data-expected="@item.Quantity">

                                    <input type="hidden"
                                           name="receivedItems[@item.OrderItemId].OrderItemId"
                                           value="@item.OrderItemId" />


                                    <!-- EQUIPMENT HEADER -->

                                    <div class="d-flex align-items-start gap-3">

                                        <div class="sc-receive-equipment-icon">

                                            <i class="bi bi-boxes"></i>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="sc-receive-equipment-name">

                                                @equipmentName

                                            </div>


                                            <div class="sc-receive-equipment-id">

                                                @if (itemPackages.Any())
                                                {
                                                    <span>

                                                        <span class="package-count">
                                                            @itemPackages.Count
                                                        </span>

                                                        package(s) available

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        No packages created
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <div class="sc-receive-scanned-badge">

                                            <i class="bi bi-qr-code"></i>

                                            Waiting

                                        </div>

                                    </div>


                                    <!-- ====================================================
                                         PACKAGE LIST
                                         ==================================================== -->
                                    @if (itemPackages.Any())
                                    {
                                        <div class="mt-3 d-flex flex-wrap gap-2">

                                            @foreach (var package in itemPackages)
                                            {
                                                var packageDisplay =
                                                    package.PackageNumber?.ToString()
                                                    ?? $"Package #{package.PackageOrderId}";

                                                <span class="badge bg-light text-dark border sc-package-badge"
                                                      data-package-id="@package.PackageOrderId">

                                                    <i class="bi bi-box-seam me-1"></i>

                                                    @packageDisplay

                                                </span>
                                            }

                                        </div>
                                    }


                                    <!-- QUANTITY GRID -->

                                    <div class="sc-receive-quantity-grid">

                                        <div class="sc-receive-quantity-box">

                                            <span class="sc-receive-quantity-label">
                                                Expected / Ordered
                                            </span>

                                            <span class="sc-receive-quantity-value">

                                                @item.Quantity item(s)

                                            </span>

                                        </div>


                                        <div class="sc-receive-quantity-box">

                                            <label class="sc-receive-quantity-label">

                                                Total Received

                                            </label>

                                            <input type="number"
                                                   min="0"
                                                   value="0"
                                                   name="receivedItems[@item.OrderItemId].ReceivedQuantity"
                                                   class="sc-receive-input sc-received-quantity-input"
                                                   data-order-item-id="@item.OrderItemId" />

                                        </div>

                                    </div>


                                    <!-- DIFFERENCE -->

                                    <div class="sc-receive-difference">

                                        <span>

                                            Expected:

                                            <strong>
                                                @item.Quantity
                                            </strong>

                                        </span>


                                        <span class="sc-receive-difference-divider">
                                            |
                                        </span>


                                        <span>

                                            Received:

                                            <strong class="received-display">
                                                0
                                            </strong>

                                        </span>


                                        <span class="sc-receive-difference-divider">
                                            |
                                        </span>


                                        <span>

                                            Difference:

                                            <strong class="difference-display sc-difference-missing">

                                                @item.Quantity missing

                                            </strong>

                                        </span>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="sc-receive-empty">

                                <div class="sc-receive-empty-icon">

                                    <i class="bi bi-box-seam"></i>

                                </div>

                                <h5>
                                    No Equipment Items
                                </h5>

                                <p class="text-muted">
                                    This order does not contain any equipment
                                    items.
                                </p>

                            </div>
                        }

                    </div>

                </div>


                <!-- ====================================================
                     FOOTER
                     ==================================================== -->

                <div class="sc-receive-footer">

                    <div class="container-fluid">

                        <div class="sc-receive-footer-inner">

                            <div class="sc-receive-footer-info">

                                <i class="bi bi-info-circle"></i>

                                <span id="receiveFooterMessage">

                                    Scan packages to verify them before
                                    confirming the received equipment.

                                </span>

                            </div>


                            <button type="submit"
                                    class="sc-receive-submit-button"
                                    id="scReceiveOrderButton">

                                <i class="bi bi-check2-circle"></i>

                                Confirm Received Equipment

                            </button>

                        </div>

                    </div>

                </div>

            </form>
        }

    </div>

</div>


@section Scripts {

    <script src="https://unpkg.com/html5-qrcode"></script>

    <script>

        let html5QrCode = null;
        let scanningPaused = false;
        let scanRequestInProgress = false;

        const orderId = @Model?.OrderId;

        /*
        ============================================================
        BEEP
        ============================================================
        */

        function playBeep() {

        try {

        const AudioContext =
        window.AudioContext ||
        window.webkitAudioContext;

        if (!AudioContext) return;

        const audioContext =
        new AudioContext();

        const oscillator =
        audioContext.createOscillator();

        const gainNode =
        audioContext.createGain();

        oscillator.connect(gainNode);

        gainNode.connect(
        audioContext.destination
        );

        oscillator.type = "sine";

        oscillator.frequency.setValueAtTime(
        1000,
        audioContext.currentTime
        );

        gainNode.gain.setValueAtTime(
        0.15,
        audioContext.currentTime
        );

        oscillator.start();

        oscillator.stop(
        audioContext.currentTime + 0.15
        );

        }
        catch (error) {

        console.log("Beep unavailable.");

        }

        }


        /*
        ============================================================
        GET ANTI FORGERY TOKEN
        ============================================================
        */

        function getAntiForgeryToken() {

        const token =
        document.querySelector(
        '#scReceiveOrderForm input[name="__RequestVerificationToken"]'
        );

        return token
        ? token.value
        : "";

        }


        /*
        ============================================================
        UPDATE SCANNER STATUS
        ============================================================
        */

        function updateScannerStatus(
        message,
        type
        ) {

        const status =
        document.getElementById(
        "scannerStatus"
        );

        if (!status) return;

        let icon =
        "bi-camera";

        status.classList.remove(
        "sc-scanner-success",
        "sc-scanner-warning",
        "sc-scanner-error"
        );


        if (type === "success") {

        icon =
        "bi-check-circle-fill";

        status.classList.add(
        "sc-scanner-success"
        );

        }
        else if (type === "warning") {

        icon =
        "bi-exclamation-triangle-fill";

        status.classList.add(
        "sc-scanner-warning"
        );

        }
        else if (type === "error") {

        icon =
        "bi-x-circle-fill";

        status.classList.add(
        "sc-scanner-error"
        );

        }


        status.innerHTML =
        '<i class="bi ' +
        icon +
        '"></i>' +
        '<span>' +
        message +
        '</span>';

        }


        /*
        ============================================================
        CLEAR EQUIPMENT SELECTION
        ============================================================
        */

        function clearEquipmentSelection() {

        document
        .querySelectorAll(
        ".sc-receive-equipment-card"
        )
        .forEach(
        function (card) {

        card.classList.remove(
        "sc-receive-equipment-selected"
        );

        }
        );

        }


        /*
        ============================================================
        HIGHLIGHT MATCHED EQUIPMENT
        ============================================================
        */

        function highlightEquipment(card) {

        clearEquipmentSelection();

        card.classList.add(
        "sc-receive-equipment-selected"
        );


        const badge =
        card.querySelector(
        ".sc-receive-scanned-badge"
        );

        if (badge) {

        badge.innerHTML =
        '<i class="bi bi-check-circle-fill"></i>' +
        ' Package Verified';

        badge.classList.add(
        "sc-receive-scanned-success"
        );

        }


        card.scrollIntoView({

        behavior: "smooth",

        block: "center"

        });

        }


        /*
        ============================================================
        SHOW SCANNED RESULT
        ============================================================
        */

        function showScanResult(
        equipmentName,
        packageNumber
        ) {

        const result =
        document.getElementById(
        "scanResult"
        );

        const name =
        document.getElementById(
        "scannedEquipmentName"
        );

        if (!result || !name) return;


        name.textContent =
        packageNumber +
        " • " +
        equipmentName;


        result.style.display =
        "flex";

        }


        /*
        ============================================================
        ADD SCANNED PACKAGE TO FORM

        The final ReceiveOrder POST can receive:

        scannedPackageIds = [1, 5, 8]

        ============================================================
        */

        function addScannedPackageToForm(
        packageId
        ) {

        const container =
        document.getElementById(
        "scannedPackagesContainer"
        );

        if (!container) return;


        const existingInput =
        container.querySelector(
        'input[value="' +
        packageId +
        '"]'
        );

        if (existingInput) return;


        const input =
        document.createElement(
        "input"
        );

        input.type =
        "hidden";

        input.name =
        "scannedPackageIds";

        input.value =
        packageId;

        container.appendChild(
        input
        );

        }


        /*
        ============================================================
        MARK PACKAGE BADGE AS SCANNED
        ============================================================
        */

        function markPackageBadgeAsScanned(
        packageId
        ) {

        const badge =
        document.querySelector(
        '.sc-package-badge[data-package-id="' +
        packageId +
        '"]'
        );

        if (!badge) return;

        badge.classList.add(
        "bg-success",
        "text-white"
        );

        badge.classList.remove(
        "bg-light",
        "text-dark"
        );

        badge.innerHTML =
        '<i class="bi bi-check-circle-fill me-1"></i>' +
        badge.textContent.trim();

        }


        /*
        ============================================================
        UPDATE RECEIVED QUANTITY
        ============================================================
        */

        function updateQuantityDisplay(
        input
        ) {

        const card =
        input.closest(
        ".sc-receive-equipment-card"
        );

        if (!card) return;


        const expected =
        parseInt(
        card.getAttribute(
        "data-expected"
        )
        ) || 0;


        let received =
        parseInt(
        input.value
        );


        if (
        isNaN(received) ||
        received < 0
        ) {

        received = 0;

        }


        const difference =
        received - expected;


        const receivedDisplay =
        card.querySelector(
        ".received-display"
        );


        const differenceDisplay =
        card.querySelector(
        ".difference-display"
        );


        if (receivedDisplay) {

        receivedDisplay.textContent =
        received;

        }


        if (differenceDisplay) {

        differenceDisplay.classList.remove(

        "sc-difference-matched",

        "sc-difference-extra",

        "sc-difference-missing"

        );


        if (difference === 0) {

        differenceDisplay.textContent =
        "Matched";

        differenceDisplay.classList.add(
        "sc-difference-matched"
        );

        }
        else if (difference > 0) {

        differenceDisplay.textContent =
        "+" +
        difference +
        " extra";

        differenceDisplay.classList.add(
        "sc-difference-extra"
        );

        }
        else {

        differenceDisplay.textContent =
        Math.abs(
        difference
        ) +
        " missing";

        differenceDisplay.classList.add(
        "sc-difference-missing"
        );

        }

        }

        }


        /*
        ============================================================
        APPLY PACKAGE SCAN RESULT

        The server returns the package and its OrderItemId.
        This updates only the UI.
        ============================================================
        */

        function applyPackageScanResult(result) {

        const orderItemId =
        result.orderItemId;

        const packageId =
        result.packageOrderId ||
        result.packageId;

        const packageNumber =
        result.packageNumber ||
        ("Package #" + packageId);

        const equipmentName =
        result.equipmentName ||
        "Equipment";


        if (!packageId) {

        updateScannerStatus(

        "The package was verified but its package ID was not returned.",

        "error"

        );

        return;

        }


        const matchedCard =
        document.querySelector(
        '.sc-receive-equipment-card[data-order-item-id="' +
        orderItemId +
        '"]'
        );


        if (!matchedCard) {

        updateScannerStatus(

        "Package verified, but the related order item could not be displayed.",

        "error"

        );

        return;

        }


        playBeep();


        highlightEquipment(
        matchedCard
        );


        showScanResult(
        equipmentName,
        packageNumber
        );


        markPackageBadgeAsScanned(
        packageId
        );


        addScannedPackageToForm(
        packageId
        );


        updateScannerStatus(

        packageNumber +
        " verified successfully.",

        "success"

        );


        const quantityInput =
        matchedCard.querySelector(
        ".sc-received-quantity-input"
        );


        if (quantityInput) {

        setTimeout(
        function () {

        quantityInput.focus();

        quantityInput.select();

        },
        400
        );

        }

        }


        /*
        ============================================================
        SCAN PACKAGE ACTION

        Calls:

        POST /Orders/ScanPackage

        Sends:
        - orderId
        - qrCodeValue

        The controller should verify:
        1. The QR code belongs to a PackageOrder.
        2. The package belongs to this order.
        3. The package has not already been received/scanned.
        4. Return package details.
        ============================================================
        */

        async function scanPackage(scannedValue) {

        if (scanRequestInProgress) {
        return;
        }

        scanRequestInProgress = true;

        try {

        const cleanQrValue = scannedValue
        ? scannedValue.trim()
        : "";

        if (!cleanQrValue) {

        updateScannerStatus(
        "No QR code value was detected.",
        "warning"
        );

        return;
        }

        updateScannerStatus(
        "Verifying package...",
        "default"
        );

        console.log("Scanning QR Value:", cleanQrValue);
        console.log("Order ID:", orderId);

        const formData = new FormData();

        formData.append(
        "orderId",
        orderId
        );

        formData.append(
        "qrCodeValue",
        cleanQrValue
        );

        formData.append(
        "__RequestVerificationToken",
        getAntiForgeryToken()
        );

        const response = await fetch(
        '@Url.Action("ScanPackage", "Orders")',
        {
        method: "POST",

        body: formData
        }
        );

        let result = null;

        try {

        result = await response.json();

        }
        catch (jsonError) {

        console.error(
        "Invalid JSON response:",
        jsonError
        );

        throw new Error(
        "The server returned an invalid response."
        );
        }

        console.log(
        "Scan Package Response:",
        result
        );

        if (
        !response.ok ||
        result.success === false
        ) {

        updateScannerStatus(

        result.message ||
        "The package could not be verified for this order.",

        "warning"

        );

        return;
        }

        applyPackageScanResult(
        result
        );

        }
        catch (error) {

        console.error(
        "Package scan error:",
        error
        );

        updateScannerStatus(

        error.message ||
        "Unable to verify the package. Please try again.",

        "error"

        );

        }
        finally {

        scanRequestInProgress = false;

        }

        }


        /*
        ============================================================
        HANDLE QR CODE
        ============================================================
        */

        function handleQrCode(
        decodedText
        ) {

        if (
        scanningPaused ||
        scanRequestInProgress
        ) {
        return;
        }


        const scannedValue =
        decodedText.trim();


        if (!scannedValue) {

        return;

        }


        scanningPaused =
        true;


        scanPackage(
        scannedValue
        )
        .finally(
        function () {

        setTimeout(
        function () {

        scanningPaused =
        false;

        },
        1500
        );

        }
        );

        }


        /*
        ============================================================
        START QR SCANNER
        ============================================================
        */

        function startScanner() {

        const scannerElement =
        document.getElementById(
        "scanner"
        );

        if (!scannerElement) return;


        html5QrCode =
        new Html5Qrcode(
        "scanner"
        );


        html5QrCode.start(

        {

        facingMode:
        "environment"

        },

        {

        fps: 10,

        qrbox: {

        width: 220,

        height: 220

        }

        },


        function (
        decodedText
        ) {

        handleQrCode(
        decodedText
        );

        },


        function (
        errorMessage
        ) {

        // Ignore normal frame scanning errors.

        }

        )
        .catch(

        function (
        error
        ) {

        console.error(
        "Unable to start scanner:",
        error
        );


        updateScannerStatus(

        "Camera could not be started. Please allow camera access.",

        "error"

        );

        }

        );

        }


        /*
        ============================================================
        INITIALIZE QUANTITY INPUTS
        ============================================================
        */

        function initializeQuantityInputs() {

        const quantityInputs =
        document.querySelectorAll(
        ".sc-received-quantity-input"
        );


        quantityInputs.forEach(

        function (
        input
        ) {

        input.addEventListener(

        "input",

        function () {

        updateQuantityDisplay(
        input
        );

        }

        );

        }

        );

        }


        function initializeFormSubmission() {

        const form =
        document.getElementById(
        "scReceiveOrderForm"
        );

        if (!form) return;


        form.addEventListener(
        "submit",
        async function (event) {

        // IMPORTANT:
        // Stop the normal form POST to ReceiveOrder.
        event.preventDefault();


        const button =
        document.getElementById(
        "scReceiveOrderButton"
        );

        const footerMessage =
        document.getElementById(
        "receiveFooterMessage"
        );


        // Prevent double submission
        if (
        button &&
        button.disabled
        ) {
        return;
        }


        // ------------------------------------------------
        // CHECK ORDER ID
        // ------------------------------------------------

        if (!orderId) {

        updateScannerStatus(
        "Order ID could not be found.",
        "error"
        );

        return;
        }


        // ------------------------------------------------
        // DISABLE BUTTON
        // ------------------------------------------------

        if (button) {

        button.disabled = true;

        button.innerHTML =
        '<i class="bi bi-arrow-repeat"></i>' +
        ' Completing Order...';
        }


        if (footerMessage) {

        footerMessage.textContent =
        "Completing the order and adding equipment to your inventory...";
        }


        try {

        // ------------------------------------------------
        // GET ANTI-FORGERY TOKEN
        // ------------------------------------------------

        const token =
        getAntiForgeryToken();


        // ------------------------------------------------
        // CREATE FORM DATA
        // ------------------------------------------------

        const formData =
        new FormData();

        formData.append(
        "orderId",
        orderId
        );

        formData.append(
        "__RequestVerificationToken",
        token
        );


        // ------------------------------------------------
        // CALL COMPLETE ORDER
        // ------------------------------------------------

        const response =
        await fetch(
        '@Url.Action("CompleteOrder", "Orders")',
        {
        method: "POST",
        body: formData
        }
        );


        // ------------------------------------------------
        // READ JSON RESPONSE
        // ------------------------------------------------

        let result = null;

        try {

        result =
        await response.json();

        }
        catch (jsonError) {

        console.error(
        "Invalid CompleteOrder response:",
        jsonError
        );

        throw new Error(
        "The server returned an invalid response."
        );
        }


        console.log(
        "CompleteOrder Response:",
        result
        );


        // ------------------------------------------------
        // CHECK RESPONSE
        // ------------------------------------------------

        if (
        !response.ok ||
        !result.success
        ) {

        const errorMessage =
        result.message ||
        "Unable to complete the order.";

        updateScannerStatus(
        errorMessage,
        "error"
        );


        if (footerMessage) {

        footerMessage.textContent =
        errorMessage;
        }


        // Re-enable button
        if (button) {

        button.disabled =
        false;

        button.innerHTML =
        '<i class="bi bi-check2-circle"></i>' +
        ' Confirm Received Equipment';
        }


        return;
        }


        // ------------------------------------------------
        // SUCCESS
        // ------------------------------------------------

        updateScannerStatus(
        "Order completed successfully.",
        "success"
        );


        if (footerMessage) {

        footerMessage.textContent =
        result.message ||
        "Equipment has been added to your inventory.";
        }


        if (button) {

        button.innerHTML =
        '<i class="bi bi-check-circle-fill"></i>' +
        ' Order Completed';
        }


        // ------------------------------------------------
        // REDIRECT TO OUR EQUIPMENT
        // ------------------------------------------------

        setTimeout(
        function () {

        window.location.href =
        '@Url.Action("OurEquipment", "Equipment")';

        },
        800
        );

        }
        catch (error) {

        console.error(
        "CompleteOrder error:",
        error
        );


        updateScannerStatus(
        error.message ||
        "Unable to complete the order.",
        "error"
        );


        if (footerMessage) {

        footerMessage.textContent =
        error.message ||
        "Something went wrong while completing the order.";
        }


        // ------------------------------------------------
        // RE-ENABLE BUTTON
        // ------------------------------------------------

        if (button) {

        button.disabled =
        false;

        button.innerHTML =
        '<i class="bi bi-check2-circle"></i>' +
        ' Confirm Received Equipment';
        }

        }

        }
        );
        }


        /*
        ============================================================
        INITIALIZE
        ============================================================
        */

        document.addEventListener(

        "DOMContentLoaded",

        function () {

        initializeQuantityInputs();

        initializeFormSubmission();

        startScanner();

        }

        );

    </script>

}

