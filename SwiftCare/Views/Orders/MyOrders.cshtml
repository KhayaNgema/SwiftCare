
@model IEnumerable<SwiftCare.Models.Order>
@inject SwiftCare.Interfaces.IEncryptionService encryptionService

@{
    ViewData["Title"] = "My Equipment Orders";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

@functions {
    string GetStatusClass(SwiftCare.Models.OrderStatus status)
    {
        return status switch
        {
            SwiftCare.Models.OrderStatus.Pending => "status-pending",
            SwiftCare.Models.OrderStatus.OnTheWay => "status-ontheway",
            SwiftCare.Models.OrderStatus.Collected => "status-collected",
            _ => ""
        };
    }

    string GetStatusDisplay(SwiftCare.Models.OrderStatus status)
    {
        return status switch
        {
            SwiftCare.Models.OrderStatus.Pending => "Pending",
            SwiftCare.Models.OrderStatus.OnTheWay => "On The Way",
            SwiftCare.Models.OrderStatus.Collected => "Collected",
            _ => status.ToString()
        };
    }
}

<style>

    /* ============================================================
           MY EQUIPMENT ORDERS
           ============================================================ */

    .swift-orders-page {
        padding-bottom: 40px;
    }

    /* ============================================================
           HEADER
           ============================================================ */

    .swift-orders-header {
        background: linear-gradient(135deg, #071a33, #102b4e);
        padding: 22px 30px;
        margin-bottom: 30px;
        border-radius: 0 0 18px 18px;
    }

    .swift-orders-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .swift-orders-title-section {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .swift-back-link {
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255,255,255,0.12);
        transition: all 0.2s ease;
    }

        .swift-back-link:hover {
            color: white;
            background: rgba(255,255,255,0.22);
            transform: translateX(-2px);
        }

    .swift-orders-title {
        margin: 0;
        color: white;
        font-size: 1.7rem;
        font-weight: 700;
    }

    .swift-orders-subtitle {
        margin: 4px 0 0;
        color: rgba(255,255,255,0.7);
        font-size: 0.92rem;
    }

    /* ============================================================
           FILTERS
           ============================================================ */

    .swift-order-filters {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-btn {
        border: none;
        background: white;
        color: #071a33;
        padding: 9px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.88rem;
        transition: all 0.2s ease;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .filter-btn:hover {
            transform: translateY(-2px);
        }

        .filter-btn.active {
            background: #071a33;
            color: white;
            outline: 2px solid white;
        }

    /* ============================================================
           ORDER CARDS
           ============================================================ */

    .order-card {
        height: 100%;
        background: white;
        border: 1px solid #e7eaf0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(0,0,0,0.06);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.10);
        }

    /* ============================================================
           CARD HEADER
           ============================================================ */

    .order-header {
        background: #071a33;
        color: white;
        padding: 17px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .order-number-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.65;
        margin-bottom: 3px;
    }

    .order-number {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .order-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.12);
        font-size: 1.2rem;
    }

    /* ============================================================
           CARD BODY
           ============================================================ */

    .order-body {
        padding: 20px;
        flex: 1;
    }

    .order-info-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid #f0f1f4;
    }

        .order-info-row:last-child {
            border-bottom: none;
        }

    .order-info-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #071a33;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .order-info-label {
        display: block;
        font-size: 0.75rem;
        color: #8a94a6;
        margin-bottom: 2px;
    }

    .order-info-value {
        color: #1f2937;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* ============================================================
           STATUS
           ============================================================ */

    .status-indicator {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-ontheway {
        background: #cfe2ff;
        color: #084298;
    }

    .status-collected {
        background: #d1e7dd;
        color: #0f5132;
    }

    /* ============================================================
           ACTIONS
           ============================================================ */

    .card-actions {
        padding: 0 20px 20px;
        margin-top: auto;
    }

    .btn-details {
        width: 100%;
        border: none;
        background: #071a33;
        color: white;
        padding: 11px 16px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-details:hover {
            background: #102b4e;
            color: white;
            transform: translateY(-1px);
        }

    /* ============================================================
           EMPTY STATES
           ============================================================ */

    .swift-empty-orders {
        background: white;
        border-radius: 18px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        margin-top: 25px;
    }

    .swift-empty-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #071a33;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 18px;
    }

    .swift-no-results {
        display: none;
        background: #fff;
        border-radius: 14px;
        padding: 35px;
        text-align: center;
        color: #6b7280;
        margin-top: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
    }

    /* ============================================================
           TEMP MESSAGE
           ============================================================ */

    #tempDataMessage {
        margin: 0 20px 25px;
        border-radius: 12px;
    }

    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 768px) {

        .swift-orders-header {
            padding: 20px;
        }

        .swift-orders-header-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .swift-order-filters {
            width: 100%;
        }

        .filter-btn {
            flex: 1;
        }

        .btn-text {
            display: none;
        }

        .swift-orders-title {
            font-size: 1.4rem;
        }
    }

</style>


<div class="swift-orders-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="swift-orders-header">

        <div class="swift-orders-header-inner">

            <div class="swift-orders-title-section">

                <a asp-controller="Home"
                       asp-action="Index"
                       class="swift-back-link">

                    <i class="bi bi-chevron-left"></i>

                </a>

                <div>

                    <h2 class="swift-orders-title">
                        My Equipment Orders
                    </h2>

                    <p class="swift-orders-subtitle">
                        Track and manage your equipment orders
                    </p>

                </div>

            </div>


            <!-- ====================================================
                 FILTERS
                 ==================================================== -->

            <div class="swift-order-filters">

                <button type="button"
                        class="filter-btn"
                        data-filter="Pending">

                    <i class="bi bi-hourglass-split me-1"></i>

                    <span class="btn-text">
                        Pending
                    </span>

                </button>


                <button type="button"
                        class="filter-btn"
                        data-filter="OnTheWay">

                    <i class="bi bi-truck me-1"></i>

                    <span class="btn-text">
                        On The Way
                    </span>

                </button>


                <button type="button"
                        class="filter-btn"
                        data-filter="Collected">

                    <i class="bi bi-check-circle-fill me-1"></i>

                    <span class="btn-text">
                        Collected
                    </span>

                </button>

            </div>

        </div>

    </div>


    <!-- ============================================================
         TEMP MESSAGE
         ============================================================ -->
    @if (TempData["Message"] != null)
    {
        <div id="tempDataMessage"
             class="alert @(TempData["Message"]!.ToString()!.Contains("successfully")
                                          ? "alert-success"
                                          : "alert-danger")"
             role="alert">

            @TempData["Message"]

        </div>
    }


    <!-- ============================================================
         NO FILTER RESULTS
         ============================================================ -->

    <div class="swift-no-results"
         id="noResultsMessage">

        <div class="swift-empty-icon">

            <i class="fas fa-search"></i>

        </div>

        <h5>
            No equipment orders found
        </h5>

        <p class="mb-0">
            You don't have any equipment orders matching this filter.
        </p>

    </div>


    <!-- ============================================================
         NO ORDERS
         ============================================================ -->
    @if (Model == null || !Model.Any())
    {
        <div class="container-fluid">

            <div class="swift-empty-orders">

                <div class="swift-empty-icon">

                    <i class="fas fa-box-open"></i>

                </div>

                <h4>
                    No Equipment Orders Yet
                </h4>

                <p class="text-muted mb-4">
                    You haven't placed any equipment orders yet.
                </p>

                <a asp-controller="Equipment"
                       asp-action="Index"
                       class="btn-details"
                       style="max-width:240px;">

                    <i class="fas fa-plus"></i>

                    Browse Equipment

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- ========================================================
             ORDERS
             ======================================================== -->

        <div class="container-fluid">

            <div class="row g-4"
                 id="ordersContainer">

                @foreach (var item in Model)
                {
                     var encryptedId =
                            encryptionService.Encrypt(item.OrderId);

                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="order-card h-100"
                             data-id="@item.OrderId"
                             data-status="@item.Status">

                            <!-- HEADER -->

                            <div class="order-header">

                                <div>

                                    <div class="order-number-label">
                                        Equipment Order
                                    </div>

                                    <div class="order-number">

                                        @item.OrderNumber

                                    </div>

                                </div>

                                <div class="order-header-icon">

                                    <i class="fas fa-box"></i>

                                </div>

                            </div>


                            <!-- BODY -->

                            <div class="order-body">


                                <!-- DATE -->

                                <div class="order-info-row">

                                    <div class="order-info-icon">

                                        <i class="bi bi-calendar3"></i>

                                    </div>

                                    <div>

                                        <span class="order-info-label">
                                            Order Date
                                        </span>

                                        <span class="order-info-value">

                                            @item.OrderDate.ToString("dd MMM yyyy, HH:mm")

                                        </span>

                                    </div>

                                </div>


                                <!-- EQUIPMENT QUANTITY -->

                                <div class="order-info-row">

                                    <div class="order-info-icon">

                                        <i class="fas fa-boxes"></i>

                                    </div>

                                    <div>

                                        <span class="order-info-label">
                                            Equipment Quantity
                                        </span>

                                        <span class="order-info-value">

                                            @(item.OrderItems?.Sum(x => x.Quantity) ?? 0)
                                            item(s)

                                        </span>

                                    </div>

                                </div>


                                <!-- LAST UPDATED -->

                                <div class="order-info-row">

                                    <div class="order-info-icon">

                                        <i class="bi bi-clock-history"></i>

                                    </div>

                                    <div>

                                        <span class="order-info-label">
                                            Last Updated
                                        </span>

                                        <span class="order-info-value">

                                            @item.LastUpdated.ToString("dd MMM yyyy, HH:mm")

                                        </span>

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div class="order-info-row">

                                    <div class="order-info-icon">

                                        <i class="bi bi-info-circle"></i>

                                    </div>

                                    <div>

                                        <span class="order-info-label">
                                            Order Status
                                        </span>

                                        <span class="status-indicator @GetStatusClass(item.Status)">

                                            @GetStatusDisplay(item.Status)

                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- ACTION -->

                            <div class="card-actions">

                                <a asp-controller="Orders"
                                       asp-action="OrderDetails"
                                       asp-route-orderId="@encryptedId"
                                       class="btn-details">

                                    <i class="fas fa-eye"></i>

                                    View Order Details

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>



    <script>

        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const cards =
                    document.querySelectorAll(
                        '.order-card'
                    );

                const filterButtons =
                    document.querySelectorAll(
                        '.filter-btn'
                    );

                const noResultsMessage =
                    document.getElementById(
                        'noResultsMessage'
                    );


                // ====================================================
                // FILTER ORDERS
                // ====================================================

                filterButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            'click',
                            function () {

                                const selectedStatus =
                                    button.getAttribute(
                                        'data-filter'
                                    );


                                filterButtons.forEach(
                                    function (btn) {

                                        btn.classList.remove(
                                            'active'
                                        );

                                    }
                                );


                                button.classList.add(
                                    'active'
                                );


                                let hasVisibleCard =
                                    false;


                                cards.forEach(
                                    function (card) {

                                        const colDiv =
                                            card.parentElement;


                                        const cardStatus =
                                            card.getAttribute(
                                                'data-status'
                                            );


                                        const isVisible =
                                            selectedStatus ===
                                            cardStatus;


                                        colDiv.style.display =
                                            isVisible
                                                ? ''
                                                : 'none';


                                        if (isVisible) {

                                            hasVisibleCard =
                                                true;

                                        }

                                    }
                                );


                                if (
                                    noResultsMessage
                                ) {

                                    noResultsMessage.style.display =
                                        hasVisibleCard
                                            ? 'none'
                                            : 'block';

                                }

                            }
                        );

                    }
                );


                // ====================================================
                // DEFAULT FILTER
                // ====================================================

                const defaultFilter =
                    document.querySelector(
                        '.filter-btn[data-filter="Pending"]'
                    );


                if (
                    defaultFilter
                ) {

                    defaultFilter.click();

                }


                // ====================================================
                // HIDE TEMP MESSAGE
                // ====================================================

                setTimeout(
                    function () {

                        const tempMessage =
                            document.getElementById(
                                'tempDataMessage'
                            );


                        if (
                            tempMessage
                        ) {

                            tempMessage.style.display =
                                'none';

                        }

                    },
                    7000
                );

            }
        );

    </script>


