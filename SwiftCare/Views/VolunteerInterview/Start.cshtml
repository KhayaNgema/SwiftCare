@model SwiftCare.ViewModels.VolunteerInterviewStartViewModel

@{
    ViewData["Title"] = "Volunteer Voice Interview";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<div class="voice-interview-page">

    <div class="voice-interview-shell">

        <!-- =====================================================
             HERO
             ====================================================== -->

        <section class="voice-interview-hero">

            <div class="voice-interview-hero-content">

                <div class="voice-interview-eyebrow">

                    <span class="voice-interview-eyebrow-dot"></span>

                    Voice Interview

                </div>

                <h1>
                    Welcome to your
                    SwiftCare interview.
                </h1>

                <p>
                    Congratulations on being shortlisted.
                    This voice interview is the next step
                    in your volunteer selection journey.
                </p>

            </div>

        </section>


        <!-- =====================================================
             CONTENT
             ====================================================== -->

        <section class="voice-interview-content">

            <!-- Welcome -->

            <div class="voice-interview-welcome">

                <div class="voice-interview-welcome-icon">
                    👋
                </div>

                <div class="voice-interview-welcome-text">

                    <strong>
                        Hello @Model.ApplicantName
                    </strong>

                    <span>
                        You have been shortlisted for
                        <span class="voice-interview-welcome-opportunity">
                            @Model.OpportunityTitle
                        </span>.
                    </span>

                </div>

            </div>


            <!-- =================================================
                 VIDEO RECORDING NOTICE
                 ================================================== -->

            <div class="voice-interview-video-notice">

                <div class="voice-interview-video-notice-icon">
                    <i class="bi bi-camera-video-fill"></i>
                </div>

                <div class="voice-interview-video-notice-content">

                    <strong>
                        This interview will be video recorded
                    </strong>

                    <span>
                        Your camera will remain on while the
                        interview is taking place. The recording
                        is used to support the integrity and review
                        of your SwiftCare interview.
                    </span>

                    <span>
                        You must allow your browser to access your
                        camera before the interview can begin.
                    </span>

                </div>

            </div>


            <!-- =================================================
                 PROCTORING NOTICE
                 ================================================== -->
            @if (Model.ProctoringEnabled)
            {
                <div class="voice-interview-proctoring-notice">

                    <div class="voice-interview-proctoring-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div class="voice-interview-proctoring-content">

                        <strong>
                            Interview integrity monitoring
                        </strong>

                        <span>
                            SwiftCare will monitor the interview
                            session for events such as leaving the
                            interview tab, changing browser focus,
                            or exiting fullscreen mode.
                        </span>

                        <span>
                            Suspicious activity may cause the
                            interview to be automatically ended
                            and submitted for administrative review.
                        </span>

                    </div>

                </div>
            }


            <!-- =================================================
                 INSTRUCTIONS
                 ================================================== -->

            <h2 class="voice-interview-section-title">
                Before you begin
            </h2>

            <div class="voice-interview-instructions">

                <div class="voice-interview-instruction">

                    <div class="voice-interview-instruction-icon">
                        🔊
                    </div>

                    <div>

                        <strong>
                            Questions will be read aloud
                        </strong>

                        <span>
                            Your SwiftCare interview assistant
                            will guide you through each question.
                        </span>

                    </div>

                </div>


                <div class="voice-interview-instruction">

                    <div class="voice-interview-instruction-icon">
                        🎙
                    </div>

                    <div>

                        <strong>
                            Answer using your voice
                        </strong>

                        <span>
                            Speak naturally and clearly into
                            your microphone.
                        </span>

                    </div>

                </div>


                <div class="voice-interview-instruction">

                    <div class="voice-interview-instruction-icon">
                        🎥
                    </div>

                    <div>

                        <strong>
                            Keep your camera on
                        </strong>

                        <span>
                            Your video will be recorded throughout
                            the interview session.
                        </span>

                    </div>

                </div>


                <div class="voice-interview-instruction">

                    <div class="voice-interview-instruction-icon">
                        💡
                    </div>

                    <div>

                        <strong>
                            Be yourself
                        </strong>

                        <span>
                            Take your time and answer honestly.
                            There are no trick questions.
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 DETAILS
                 ================================================== -->

            <div class="voice-interview-details">

                <div class="voice-interview-detail">

                    <span class="voice-interview-detail-label">
                        Questions
                    </span>

                    <span class="voice-interview-detail-value">
                        @Model.QuestionCount
                    </span>

                </div>


                <div class="voice-interview-detail">

                    <span class="voice-interview-detail-label">
                        Estimated time
                    </span>

                    <span class="voice-interview-detail-value">
                        @Model.EstimatedMinutes minutes
                    </span>

                </div>


                <div class="voice-interview-detail">

                    <span class="voice-interview-detail-label">
                        Interview type
                    </span>

                    <span class="voice-interview-detail-value">
                        Voice + Video
                    </span>

                </div>

            </div>


            <!-- =================================================
                 CAMERA PERMISSION
                 ================================================== -->

            <div class="voice-interview-camera-section">

                <div class="voice-interview-camera-header">

                    <div>

                        <strong>
                            Camera permission required
                        </strong>

                        <span>
                            Please allow your browser to use
                            your camera before continuing.
                        </span>

                    </div>

                    <span id="cameraPermissionStatus"
                          class="voice-interview-camera-status pending">

                        <i class="bi bi-camera-video"></i>

                        Camera not checked

                    </span>

                </div>


                <div class="voice-interview-camera-preview-wrapper">

                    <video id="cameraPreview"
                           class="voice-interview-camera-preview"
                           autoplay
                           muted
                           playsinline>
                    </video>

                    <div id="cameraPreviewPlaceholder"
                         class="voice-interview-camera-placeholder">

                        <i class="bi bi-camera-video"></i>

                        <span>
                            Your camera preview will appear here
                        </span>

                    </div>

                </div>


                <button type="button"
                        id="allowCameraButton"
                        class="voice-interview-camera-button">

                    <i class="bi bi-camera-video"></i>

                    Allow Camera & Continue

                </button>


                <div id="cameraPermissionMessage"
                     class="voice-interview-camera-message">

                    You must allow camera access before
                    the interview can begin.

                </div>

            </div>


            <!-- =================================================
                 AGREEMENT
                 ================================================== -->

            <div class="voice-interview-consent">

                <label class="voice-interview-consent-label">

                    <input type="checkbox"
                           id="interviewConsent" />

                    <span class="voice-interview-consent-check">
                    </span>

                    <span class="voice-interview-consent-text">

                        I understand that this interview will be
                        video recorded and that SwiftCare may monitor
                        the interview session for interview integrity.
                        I understand that I must remain on the
                        interview page while completing the interview.

                    </span>

                </label>

            </div>


            <!-- =================================================
                 ACTION
                 ================================================== -->

            <div class="voice-interview-action">

                <div class="voice-interview-privacy">

                    <strong>
                        🔒 Your information is protected.
                    </strong>

                    <br />

                    Your interview answers and interview recording
                    will be associated with your SwiftCare volunteer
                    application and reviewed as part of the selection
                    process.

                </div>


                <form asp-controller="VolunteerInterview"
                      asp-action="Begin"
                      method="post"
                      id="startInterviewForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="token"
                           value="@Model.Token" />

                    <button type="submit"
                            id="startInterviewButton"
                            class="voice-interview-start-button"
                            disabled>

                        @(Model.IsStarted
                            ? "Continue Interview"
                            : "Start Interview")

                        <span class="voice-interview-start-arrow">
                            →
                        </span>

                    </button>

                </form>

            </div>

        </section>

    </div>

</div>

<!-- ================================================================
     CAMERA PERMISSION
     ================================================================ -->

<script>

    (() => {

        "use strict";

        const consent =
            document.getElementById("interviewConsent");

        const allowCameraButton =
            document.getElementById("allowCameraButton");

        const startInterviewButton =
            document.getElementById("startInterviewButton");

        const cameraPreview =
            document.getElementById("cameraPreview");

        const cameraPlaceholder =
            document.getElementById("cameraPreviewPlaceholder");

        const cameraStatus =
            document.getElementById("cameraPermissionStatus");

        const cameraMessage =
            document.getElementById("cameraPermissionMessage");

        const form =
            document.getElementById("startInterviewForm");


        let cameraStream =
            null;

        let cameraAllowed =
            false;


        function updateStartButton() {

            startInterviewButton.disabled =
                !cameraAllowed ||
                !consent.checked;

        }


        function setCameraStatus(
            text,
            type
        ) {

            cameraStatus.className =
                "voice-interview-camera-status " +
                type;

            cameraStatus.innerHTML =
                type === "success"
                    ? '<i class="bi bi-check-circle-fill"></i> ' + text
                    : type === "error"
                        ? '<i class="bi bi-exclamation-circle-fill"></i> ' + text
                        : '<i class="bi bi-camera-video"></i> ' + text;
        }


        function stopPreviewStream() {

            if (!cameraStream)
                return;

            cameraStream
                .getTracks()
                .forEach(track => {

                    try {
                        track.stop();
                    }
                    catch (_) {}

                });

            cameraStream =
                null;
        }


        async function requestCameraPermission() {

            if (
                !navigator.mediaDevices ||
                !navigator.mediaDevices.getUserMedia
            ) {

                setCameraStatus(
                    "Camera unavailable",
                    "error"
                );

                cameraMessage.textContent =
                    "Your browser does not support camera access. " +
                    "Please use a modern browser such as Chrome or Edge.";

                return;
            }


            allowCameraButton.disabled =
                true;

            allowCameraButton.innerHTML =
                '<i class="bi bi-camera-video"></i> Requesting camera...';


            try {

                stopPreviewStream();


                cameraStream =
                    await navigator.mediaDevices.getUserMedia({
                        video: {
                            facingMode: "user"
                        },
                        audio: false
                    });


                cameraPreview.srcObject =
                    cameraStream;


                cameraPreview.style.display =
                    "block";

                cameraPlaceholder.style.display =
                    "none";


                cameraAllowed =
                    true;


                setCameraStatus(
                    "Camera ready",
                    "success"
                );


                cameraMessage.textContent =
                    "Camera access has been granted. " +
                    "Please confirm the recording notice below " +
                    "to continue.";


                allowCameraButton.innerHTML =
                    '<i class="bi bi-check-circle-fill"></i> Camera Allowed';


                updateStartButton();

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE CAMERA] Permission error:",
                    error
                );


                cameraAllowed =
                    false;


                setCameraStatus(
                    "Camera permission required",
                    "error"
                );


                if (
                    error &&
                    error.name === "NotAllowedError"
                ) {

                    cameraMessage.textContent =
                        "Camera access was denied. " +
                        "Please click the camera icon in your " +
                        "browser address bar, allow camera access, " +
                        "and try again.";

                }
                else if (
                    error &&
                    error.name === "NotFoundError"
                ) {

                    cameraMessage.textContent =
                        "No camera was found on this device. " +
                        "A working camera is required to complete " +
                        "the interview.";

                }
                else {

                    cameraMessage.textContent =
                        "We could not access your camera. " +
                        "Please check your browser permissions and try again.";

                }


                allowCameraButton.innerHTML =
                    '<i class="bi bi-camera-video"></i> Allow Camera & Continue';


                updateStartButton();

            }
            finally {

                allowCameraButton.disabled =
                    false;

            }

        }


        consent.addEventListener(
            "change",
            updateStartButton
        );


        allowCameraButton.addEventListener(
            "click",
            requestCameraPermission
        );


        /*
         * Do not allow the form to submit unless the applicant
         * has both granted camera access and acknowledged
         * the video recording notice.
         */

        form.addEventListener(
            "submit",
            event => {

                if (
                    !cameraAllowed ||
                    !consent.checked
                ) {

                    event.preventDefault();

                    return;
                }


                /*
                 * Stop the preview stream before navigating
                 * to the actual interview page.
                 */

                stopPreviewStream();

                startInterviewButton.disabled =
                    true;

                startInterviewButton.innerHTML =
                    'Preparing Interview <i class="bi bi-hourglass-split"></i>';

            }
        );


        /*
         * If the applicant leaves the page before submitting,
         * clean up the temporary preview stream.
         */

        window.addEventListener(
            "beforeunload",
            () => {

                stopPreviewStream();

            }
        );


        updateStartButton();

    })();

</script>