@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding
@using SwiftCare.Helpers
@{
    ViewData["Title"] = "Volunteer Onboarding";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var status = Model.Status.ToString();

    var statusClass = Model.Status switch
    {
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.Completed
            => "status-success",

        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ReadyForActivation
            => "status-success",

        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.RejectedForCorrection
            => "status-danger",

        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferDeclined
            => "status-danger",

        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.AdminVerification
            => "status-warning",

        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ContractPending
            => "status-info",

        _ => "status-info"
    };

    var progress = Model.CurrentStep switch
    {
        1 => 16,
        2 => 33,
        3 => 50,
        4 => 66,
        5 => 83,
        6 => 100,
        _ => 0
    };

    var offerCompleted =
        Model.Status !=
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferPending &&
        Model.Status !=
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferDeclined;

    var policiesAvailable =
        Model.CurrentStep >= 2 &&
        Model.Status !=
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferDeclined;

    var documentsAvailable =
        Model.CurrentStep >= 3 &&
        Model.Status !=
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferDeclined;

    var verificationActive =
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.AdminVerification;

    var contractPending =
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ContractPending;

    /*
     * CONTRACT IS NOW AVAILABLE AFTER IDENTITY VERIFICATION.
     *
     * It must NOT wait for ReadyForActivation.
     *
     * Once the onboarding reaches ContractPending, the applicant
     * can open and complete the existing contract workflow.
     *
     * We also keep it available during later stages so that a
     * completed/generated contract can still be viewed.
     */
    var contractAvailable =
        contractPending ||
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.AdminVerification ||
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ReadyForActivation ||
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.Completed;

    var readyForActivation =
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ReadyForActivation;

    var onboardingCompleted =
        Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.Completed;
}

<div class="container onboarding-page">

    <!-- ============================================================
         HERO
         ============================================================ -->

    <div class="onboarding-hero">

        <div class="hero-content">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">

                <div class="d-flex align-items-start gap-3">

                    <div class="hero-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>

                        <h1>Volunteer Onboarding</h1>

                        <p>
                            Complete each stage below to become an active
                            SwiftCare volunteer.
                        </p>

                    </div>

                </div>

                <div>

                    <span class="status-pill @statusClass">

                        <i class="bi bi-circle-fill"></i>

                        @status

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         PROGRESS
         ============================================================ -->

    <div class="progress-card">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <span class="progress-heading">

                <i class="bi bi-bar-chart-steps me-1"></i>

                Onboarding Progress

            </span>

            <span class="progress-step">

                Step @Model.CurrentStep of 6

            </span>

        </div>

        <div class="progress">

            <div class="progress-bar"
                 role="progressbar"
                 style="width:@progress%"
                 aria-valuenow="@progress"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>

    </div>


    <!-- ============================================================
         APPLICATION SUMMARY
         ============================================================ -->

    <div class="application-box">

        <div class="row g-2">

            <div class="col-md-4">

                <div class="application-item">

                    <span class="application-label">
                        Application
                    </span>

                    <span class="application-value">
                        #@Model.VolunteerApplication.Reference
                    </span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="application-item">

                    <span class="application-label">
                        Offer Sent
                    </span>

                    <span class="application-value">
                        @(Model.OfferSentDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Pending")
                    </span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="application-item">

                    <span class="application-label">
                        Last Updated
                    </span>

                    <span class="application-value">
                        @Model.ModifiedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         STEPS HEADING
         ============================================================ -->

    <div class="steps-heading">

        <h3>
            Your Onboarding Journey
        </h3>

        <p>
            Follow the stages in order. Some stages will become available
            after the previous stage has been completed.
        </p>

    </div>


    <!-- ============================================================
         STEPS
         ============================================================ -->

    <div class="row g-4">


        <!-- ========================================================
             STEP 1 — OFFER
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card @(offerCompleted ? "completed" : "")">

                <span class="step-number">1</span>

                <div class="step-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>

                <h5>
                    Volunteer Offer
                </h5>

                <p>
                    Review the volunteer opportunity and formally accept
                    or decline your SwiftCare volunteer offer.
                </p>

                @if (Model.Status ==
                    SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferPending)
                {
                    <a asp-action="Offer"
                           asp-route-id="@Model.VolunteerOnboardingId"
                           class="btn btn-swift">

                        <span>Review Offer</span>

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }
                else if (Model.Status ==
                    SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.OfferDeclined)
                {
                    <span class="step-state">

                        <i class="bi bi-x-circle-fill"></i>

                        Offer Declined

                    </span>
                }
                else
                {
                    <span class="step-state completed-state">

                        <i class="bi bi-check-circle-fill"></i>

                        Offer Accepted

                    </span>
                }

            </div>

        </div>


        <!-- ========================================================
             STEP 2 — POLICIES
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card @(policiesAvailable ? "" : "locked")">

                <span class="step-number">2</span>

                <div class="step-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h5>
                    Policies & Code of Conduct
                </h5>

                <p>
                    Read and accept the required SwiftCare policies,
                    safeguarding requirements and volunteer code of conduct.
                </p>

                @if (policiesAvailable)
                {
                    <a asp-action="Policies"
                           asp-route-id="@Model.VolunteerOnboardingId"
                           class="btn btn-swift">

                        <span>Review Policies</span>

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }
                else
                {
                    <span class="step-state locked-state">

                        <i class="bi bi-lock-fill"></i>

                        Complete the offer first

                    </span>
                }

            </div>

        </div>


        <!-- ========================================================
             STEP 3 — DOCUMENTS
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card @(documentsAvailable ? "" : "locked")">

                <span class="step-number">3</span>

                <div class="step-icon">
                    <i class="bi bi-folder-check"></i>
                </div>

                <h5>
                    Onboarding Documents
                </h5>

                <p>
                    Upload the applicable identification, qualification
                    and supporting documents required for your onboarding.
                </p>

                @if (documentsAvailable)
                {
                    <a asp-action="Documents"
                           asp-route-id="@Model.VolunteerOnboardingId"
                           class="btn btn-swift">

                        <span>Manage Documents</span>

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }
                else
                {
                    <span class="step-state locked-state">

                        <i class="bi bi-lock-fill"></i>

                        Complete previous stages

                    </span>
                }

            </div>

        </div>


        <!-- ========================================================
             STEP 4 — IDENTITY / ADMIN VERIFICATION
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card
                @(verificationActive ? "completed" : "")
                @(documentsAvailable ? "" : "locked")">

                <span class="step-number">4</span>

                <div class="step-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <h5>
                    Identity Verification
                </h5>

                <p>
                    SwiftCare administrators will review your submitted
                    documents and complete your identity verification,
                    including document, liveness and face verification.
                </p>

                @if (verificationActive)
                {
                    <span class="status-pill status-warning">

                        <i class="bi bi-hourglass-split"></i>

                        Under Review

                    </span>
                }
                else if (contractPending ||
                         readyForActivation ||
                         onboardingCompleted)
                {
                    <span class="step-state completed-state">

                        <i class="bi bi-check-circle-fill"></i>

                        Identity Verification Complete

                    </span>
                }
                else
                {
                    <span class="step-state locked-state">

                        <i class="bi bi-lock-fill"></i>

                        Awaiting verification

                    </span>
                }

            </div>

        </div>


        <!-- ========================================================
             STEP 5 — CONTRACT
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card
                @(contractPending ? "completed" : "")
                @(contractAvailable ? "" : "locked")">

                <span class="step-number">5</span>

                <div class="step-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <h5>
                    Volunteer Service Agreement
                </h5>

                <p>
                    After your identity verification is completed,
                    review your SwiftCare Volunteer Service Agreement
                    and complete the contract stage.
                </p>

                @if (contractAvailable)
                {
                    <a asp-action="Contract"
                           asp-route-id="@Model.VolunteerOnboardingId"
                           class="btn btn-swift">

                        <span>Open Contract</span>

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }
                else
                {
                    <span class="step-state locked-state">

                        <i class="bi bi-lock-fill"></i>

                        Available after identity verification

                    </span>
                }

            </div>

        </div>


        <!-- ========================================================
             STEP 6 — ACTIVATION
             ======================================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="step-card
                @(onboardingCompleted ? "completed" : "")
                @(!readyForActivation && !onboardingCompleted ? "locked" : "")">

                <span class="step-number">6</span>

                <div class="step-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <h5>
                    Volunteer Activation
                </h5>

                <p>
                    After verification and completion of the contract stage,
                    your SwiftCare volunteer profile can be activated.
                </p>

                @if (onboardingCompleted)
                {
                    <span class="status-pill status-success">

                        <i class="bi bi-check-circle-fill"></i>

                        Volunteer Activated

                    </span>
                }
                else if (readyForActivation)
                {
                    <span class="status-pill status-success">

                        <i class="bi bi-check-circle"></i>

                        Ready for Activation

                    </span>
                }
                else
                {
                    <span class="step-state locked-state">

                        <i class="bi bi-lock-fill"></i>

                        Awaiting previous stages

                    </span>
                }

            </div>

        </div>

    </div>


    <!-- ============================================================
         STATUS MESSAGE
         ============================================================ -->
    @if (Model.Status ==
                SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.AdminVerification)
    {
        <div class="onboarding-message warning-message">

            <div class="d-flex align-items-start gap-3">

                <div class="message-icon">

                    <i class="bi bi-hourglass-split"></i>

                </div>

                <div>

                    <h6>
                        Your identity verification is being completed
                    </h6>

                    <p>
                        SwiftCare is reviewing your submitted information
                        and completing the required identity verification.
                        Once identity verification is complete, your
                        Volunteer Service Agreement will become available.
                    </p>

                </div>

            </div>

        </div>
    }
    else if (Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ContractPending)
    {
        <div class="onboarding-message success-message">

            <div class="d-flex align-items-start gap-3">

                <div class="message-icon">

                    <i class="bi bi-file-earmark-check"></i>

                </div>

                <div>

                    <h6>
                        Identity verification completed
                    </h6>

                    <p>
                        Your identity verification has been completed
                        successfully. Your SwiftCare Volunteer Service
                        Agreement is now available for review and completion.
                    </p>

                </div>

            </div>

        </div>
    }
    else if (Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ReadyForActivation)
    {
        <div class="onboarding-message success-message">

            <div class="d-flex align-items-start gap-3">

                <div class="message-icon">

                    <i class="bi bi-check-circle"></i>

                </div>

                <div>

                    <h6>
                        Your onboarding is ready for activation
                    </h6>

                    <p>
                        Your identity verification and Volunteer Service
                        Agreement have been completed successfully.
                        Your volunteer profile is now ready for activation
                        by SwiftCare.
                    </p>

                </div>

            </div>

        </div>
    }
    else if (Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.Completed)
    {
        <div class="onboarding-message success-message">

            <div class="d-flex align-items-start gap-3">

                <div class="message-icon">

                    <i class="bi bi-person-check-fill"></i>

                </div>

                <div>

                    <h6>
                        Welcome to SwiftCare
                    </h6>

                    <p>
                        Your volunteer onboarding has been completed
                        successfully and your volunteer profile has been
                        activated.
                    </p>

                </div>

            </div>

        </div>
    }
    else if (Model.Status ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.RejectedForCorrection)
    {
        <div class="onboarding-message danger-message">

            <div class="d-flex align-items-start gap-3">

                <div class="message-icon">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>

                <div>

                    <h6>
                        Action required
                    </h6>

                    <p>
                        SwiftCare has requested corrections to your
                        onboarding information. Please review the relevant
                        onboarding stage and make the requested changes.
                    </p>

                </div>

            </div>

        </div>
    }

</div>