                    </button>

                    <button type="submit"
                            id="vpAssignButton"
                            class="vp-modal-submit">

                        <i class="bi bi-check-lg"></i>

                        Assign Task

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     TASK DETAILS MODAL
