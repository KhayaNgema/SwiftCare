
@model SwiftCare.ViewModels.RequestViewModel

@{
    ViewData["Title"] = "Request Transport";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var profileImage = string.IsNullOrWhiteSpace(Model.ProfilePicture)
        ? Url.Content("~/Images/default_profile_image.jpg")
        : Url.Content("~/" + Model.ProfilePicture.TrimStart('/'));
}

<link rel="stylesheet" href="~/css/request-transport.css" />

<div class="sc-transport-page">

    <!-- ============================================================
         HERO HEADER
         ============================================================ -->

    <div class="sc-transport-hero">

        <div class="sc-transport-hero-content">

            <a asp-controller="Residents"
                   asp-action="ResidentDetails"
                   asp-route-id="@Model.RequestedForId"
                   class="sc-transport-back">

                <i class="bi bi-arrow-left"></i>

                <span>Back to Resident</span>

            </a>

            <div class="sc-transport-heading">

                <div class="sc-transport-heading-icon">

                    <i class="bi bi-truck"></i>

                </div>

                <div>

                    <span class="sc-transport-eyebrow">
                        SWIFTCARE TRANSPORT
                    </span>

                    <h1>
                        Request Transport
                    </h1>

                    <p>
                        Schedule a safe and convenient transport request
                        for this resident.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="container-fluid sc-transport-container">


        <!-- ========================================================
             RESIDENT SUMMARY
             ======================================================== -->

        <div class="sc-resident-summary">

            <div class="sc-resident-image-wrap">

                <img src="@profileImage"
                     class="sc-resident-image"
                     alt="@Model.FirstName @Model.LastName"
                     onerror="this.src='@Url.Content("~/Images/default_profile_image.jpg")'" />

                <div class="sc-resident-online"></div>

            </div>


            <div class="sc-resident-summary-content">

                <span class="sc-resident-label">
                    TRANSPORT REQUEST FOR
                </span>

                <h2>
                    @Model.FirstName @Model.LastName
                </h2>


                <div class="sc-resident-meta">

                    <div class="sc-resident-meta-item">

                        <div class="sc-resident-meta-icon">

                            <i class="bi bi-door-open"></i>

                        </div>

                        <div>

                            <span>Room</span>

                            <strong>
                                @(Model.RoomNo != null
                                    ? Model.RoomNo.ToString()
                                    : "Not Assigned")
                            </strong>

                        </div>

                    </div>


                    <div class="sc-resident-meta-item">

                        <div class="sc-resident-meta-icon">

                            <i class="bi bi-telephone"></i>

                        </div>

                        <div>

                            <span>Contact</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                    ? "Not provided"
                                    : Model.PhoneNumber)
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <div class="sc-resident-status">

                <i class="bi bi-person-check-fill"></i>

                <span>Resident Selected</span>

            </div>

        </div>


        <!-- ========================================================
             FORM
             ======================================================== -->

        <form id="transportRequestForm"
              asp-controller="TransportRequests"
              asp-action="RequestTransport"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="All"
                 class="sc-transport-validation"
                 style="white-space: pre-wrap;">
            </div>


            <!-- ====================================================
                 HIDDEN VALUES
                 ==================================================== -->

            <input asp-for="RequestedForId"
                   type="hidden"
                   id="RequestedForId" />

            <input asp-for="PickUpAddress"
                   type="hidden"
                   id="pickupAddress" />

            <input asp-for="DestinationAddress"
                   type="hidden"
                   id="destinationAddress" />

            <input asp-for="PickUpLatitude"
                   type="hidden"
                   id="pickupLatitude" />

            <input asp-for="PickUpLongitude"
                   type="hidden"
                   id="pickupLongitude" />

            <input asp-for="DestinationLatitude"
                   type="hidden"
                   id="destinationLatitude" />

            <input asp-for="DestinationLongitude"
                   type="hidden"
                   id="destinationLongitude" />


            <!-- ====================================================
                 MAIN FORM CARD
                 ==================================================== -->

            <div class="sc-transport-form-card">


                <!-- =================================================
                     CARD HEADER
                     ================================================= -->

                <div class="sc-transport-form-top">

                    <div>

                        <span class="sc-form-step">
                            STEP 1 OF 2
                        </span>

                        <h3>

                            <i class="bi bi-clipboard2-check"></i>

                            Transport Details

                        </h3>

                        <p>
                            Provide the transport schedule and reason
                            for the request.
                        </p>

                    </div>


                    <div class="sc-form-header-badge">

                        <i class="bi bi-shield-check"></i>

                        <span>Secure Request</span>

                    </div>

                </div>


                <div class="sc-transport-form-body">


                    <!-- =============================================
                         REQUEST INFORMATION
                         ============================================= -->

                    <div class="sc-form-section">

                        <div class="sc-form-section-heading">

                            <div class="sc-form-section-icon">

                                <i class="bi bi-card-text"></i>

                            </div>

                            <div>

                                <h4>
                                    Request Information
                                </h4>

                                <p>
                                    Tell us why and when transport is needed.
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- REQUEST REASON -->

                            <div class="col-12">

                                <div class="sc-field-group">

                                    <label asp-for="RequestReason">

                                        <i class="bi bi-chat-left-text"></i>

                                        Reason for Transport

                                    </label>


                                    <textarea asp-for="RequestReason"
                                              class="form-control sc-transport-input sc-transport-textarea"
                                              placeholder="Describe why transport is required..."></textarea>


                                    <span asp-validation-for="RequestReason"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- TRANSPORT DATE -->

                            <div class="col-12 col-md-6">

                                <div class="sc-field-group">

                                    <label asp-for="RequestedForDate">

                                        <i class="bi bi-calendar-event"></i>

                                        Transport Date

                                    </label>


                                    <input asp-for="RequestedForDate"
                                           type="date"
                                           class="form-control sc-transport-input" />


                                    <span asp-validation-for="RequestedForDate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- TRANSPORT TIME -->

                            <div class="col-12 col-md-6">

                                <div class="sc-field-group">

                                    <label asp-for="RequestedForTime">

                                        <i class="bi bi-clock"></i>

                                        Transport Time

                                    </label>


                                    <input asp-for="RequestedForTime"
                                           type="time"
                                           class="form-control sc-transport-input" />


                                    <span asp-validation-for="RequestedForTime"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ROUTE DIVIDER
                         ================================================= -->

                    <div class="sc-route-divider">

                        <div></div>

                        <span>

                            <i class="bi bi-arrow-down"></i>

                        </span>

                        <div></div>

                    </div>


                    <!-- =================================================
                         TRANSPORT LOCATIONS
                         ================================================= -->

                    <div class="sc-form-section">

                        <div class="sc-form-section-heading">

                            <div class="sc-form-section-icon sc-location-icon">

                                <i class="bi bi-geo-alt"></i>

                            </div>

                            <div>

                                <h4>
                                    Transport Locations
                                </h4>

                                <p>
                                    Select the pickup point and destination.
                                </p>

                            </div>

                        </div>


                        <div class="row g-4">


                            <!-- PICKUP -->

                            <div class="col-12 col-lg-6">

                                <div class="sc-location-card sc-pickup-card">

                                    <div class="sc-location-card-top">

                                        <div class="sc-location-marker">

                                            <i class="bi bi-record-circle"></i>

                                        </div>

                                        <div>

                                            <span>
                                                STARTING POINT
                                            </span>

                                            <h5>
                                                Pickup Location
                                            </h5>

                                        </div>

                                    </div>


                                    <div class="sc-place-container">

                                        <div class="sc-places-wrapper"
                                             id="pickupAutocompleteContainer">
                                        </div>

                                    </div>


                                    <div id="pickupStatus"
                                         class="sc-location-status">
                                    </div>

                                </div>

                            </div>


                            <!-- DESTINATION -->

                            <div class="col-12 col-lg-6">

                                <div class="sc-location-card sc-destination-card">

                                    <div class="sc-location-card-top">

                                        <div class="sc-location-marker sc-destination-marker">

                                            <i class="bi bi-geo-alt-fill"></i>

                                        </div>

                                        <div>

                                            <span>
                                                FINAL DESTINATION
                                            </span>

                                            <h5>
                                                Destination
                                            </h5>

                                        </div>

                                    </div>


                                    <div class="sc-place-container">

                                        <div class="sc-places-wrapper"
                                             id="destinationAutocompleteContainer">
                                        </div>

                                    </div>


                                    <div id="destinationStatus"
                                         class="sc-location-status">
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTIONS
                         ================================================= -->

                    <div class="sc-transport-actions">

                        <a asp-controller="Residents"
                               asp-action="ResidentDetails"
                               asp-route-id="@Model.RequestedForId"
                               class="btn sc-cancel-transport">

                            <i class="bi bi-x-lg"></i>

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn sc-submit-transport">

                            <span>

                                <i class="bi bi-send-check-fill"></i>

                                Submit Transport Request

                            </span>

                            <i class="bi bi-arrow-right sc-submit-arrow"></i>

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


<partial name="_ValidationScriptsPartial" />


<!-- ============================================================
     GOOGLE MAPS JAVASCRIPT API
     ============================================================ -->

<script async
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyALpC7dYMbE_U4L7EE6EKE3Kct_7MlM7x0&libraries=places&loading=async&callback=initGooglePlaces">
</script>


<script>

    // ============================================================
    // FORMAT COORDINATES
    // ============================================================

    function formatCoordinate(value) {

        return value
            .toString()
            .replace(".", ",");

    }


    // ============================================================
    // GOOGLE PLACES
    // ============================================================

    async function initGooglePlaces() {

        try {

            const { PlaceAutocompleteElement } =
                await google.maps.importLibrary("places");


            // ====================================================
            // PICKUP
            // ====================================================

            const pickupAutocomplete =
                new PlaceAutocompleteElement();


            pickupAutocomplete.includedRegionCodes =
                ["za"];


            pickupAutocomplete.style.width =
                "100%";


            document
                .getElementById(
                    "pickupAutocompleteContainer"
                )
                .appendChild(
                    pickupAutocomplete
                );


            pickupAutocomplete.addEventListener(
                "gmp-select",
                async function (event) {

                    try {

                        const place =
                            event.placePrediction.toPlace();


                        await place.fetchFields({
                            fields: [
                                "formattedAddress",
                                "location"
                            ]
                        });


                        if (!place.location) {

                            showLocationStatus(
                                "pickupStatus",
                                "Please select a valid address.",
                                false
                            );

                            return;

                        }


                        document
                            .getElementById(
                                "pickupAddress"
                            )
                            .value =
                            place.formattedAddress;


                        document
                            .getElementById(
                                "pickupLatitude"
                            )
                            .value =
                            formatCoordinate(
                                place.location.lat()
                            );


                        document
                            .getElementById(
                                "pickupLongitude"
                            )
                            .value =
                            formatCoordinate(
                                place.location.lng()
                            );


                        showLocationStatus(
                            "pickupStatus",
                            "Pickup location selected successfully.",
                            true
                        );

                    }
                    catch (error) {

                        console.error(error);

                        showLocationStatus(
                            "pickupStatus",
                            "Unable to retrieve pickup location details.",
                            false
                        );

                    }

                }
            );


            // ====================================================
            // DESTINATION
            // ====================================================

            const destinationAutocomplete =
                new PlaceAutocompleteElement();


            destinationAutocomplete.includedRegionCodes =
                ["za"];


            destinationAutocomplete.style.width =
                "100%";


            document
                .getElementById(
                    "destinationAutocompleteContainer"
                )
                .appendChild(
                    destinationAutocomplete
                );


            destinationAutocomplete.addEventListener(
                "gmp-select",
                async function (event) {

                    try {

                        const place =
                            event.placePrediction.toPlace();


                        await place.fetchFields({
                            fields: [
                                "formattedAddress",
                                "location"
                            ]
                        });


                        if (!place.location) {

                            showLocationStatus(
                                "destinationStatus",
                                "Please select a valid address.",
                                false
                            );

                            return;

                        }


                        document
                            .getElementById(
                                "destinationAddress"
                            )
                            .value =
                            place.formattedAddress;


                        document
                            .getElementById(
                                "destinationLatitude"
                            )
                            .value =
                            formatCoordinate(
                                place.location.lat()
                            );


                        document
                            .getElementById(
                                "destinationLongitude"
                            )
                            .value =
                            formatCoordinate(
                                place.location.lng()
                            );


                        showLocationStatus(
                            "destinationStatus",
                            "Destination selected successfully.",
                            true
                        );

                    }
                    catch (error) {

                        console.error(error);

                        showLocationStatus(
                            "destinationStatus",
                            "Unable to retrieve destination location details.",
                            false
                        );

                    }

                }
            );

        }
        catch (error) {

            console.error(
                "Google Places loading error:",
                error
            );


            showLocationStatus(
                "pickupStatus",
                "Google Places could not be loaded.",
                false
            );


            showLocationStatus(
                "destinationStatus",
                "Google Places could not be loaded.",
                false
            );

        }

    }


    // ============================================================
    // LOCATION STATUS
    // ============================================================

    function showLocationStatus(
        elementId,
        message,
        success
    ) {

        const element =
            document.getElementById(elementId);


        if (!element) return;


        element.textContent =
            message;


        element.classList.remove(
            "success",
            "error"
        );


        element.classList.add(
            success
                ? "success"
                : "error"
        );

    }


    // ============================================================
    // DEFAULT DATE
    // ============================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const dateInput =
                document.querySelector(
                    'input[name="RequestedForDate"]'
                );


            if (dateInput) {

                const today =
                    new Date()
                        .toISOString()
                        .split("T")[0];


                if (!dateInput.value) {

                    dateInput.value =
                        today;

                }


                dateInput.min =
                    today;

            }

        }
    );


    // ============================================================
    // VALIDATE FORM
    // ============================================================

    document
        .getElementById(
            "transportRequestForm"
        )
        .addEventListener(
            "submit",
            function (event) {

                const residentId =
                    document
                        .getElementById(
                            "RequestedForId"
                        )
                        .value;


                const pickupAddress =
                    document
                        .getElementById(
                            "pickupAddress"
                        )
                        .value;


                const pickupLatitude =
                    document
                        .getElementById(
                            "pickupLatitude"
                        )
                        .value;


                const pickupLongitude =
                    document
                        .getElementById(
                            "pickupLongitude"
                        )
                        .value;


                const destinationAddress =
                    document
                        .getElementById(
                            "destinationAddress"
                        )
                        .value;


                const destinationLatitude =
                    document
                        .getElementById(
                            "destinationLatitude"
                        )
                        .value;


                const destinationLongitude =
                    document
                        .getElementById(
                            "destinationLongitude"
                        )
                        .value;


                let isValid = true;


                if (!residentId) {

                    isValid = false;

                    alert(
                        "A resident could not be identified."
                    );

                }


                if (
                    !pickupAddress ||
                    !pickupLatitude ||
                    !pickupLongitude
                ) {

                    showLocationStatus(
                        "pickupStatus",
                        "Please select a pickup address from the suggestions.",
                        false
                    );

                    isValid = false;

                }


                if (
                    !destinationAddress ||
                    !destinationLatitude ||
                    !destinationLongitude
                ) {

                    showLocationStatus(
                        "destinationStatus",
                        "Please select a destination from the suggestions.",
                        false
                    );

                    isValid = false;

                }


                if (!isValid) {

                    event.preventDefault();

                }

            }
        );

</script>
