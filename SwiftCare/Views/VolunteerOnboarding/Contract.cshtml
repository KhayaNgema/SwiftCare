@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding

@{
    ViewData["Title"] = "Volunteer Contract";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var contract =
        ViewBag.Contract
        as SwiftCare.Models.VolunteerOnboarding.VolunteerContract;

    var hasGeneratedContract = contract != null;

    var contractStatus =
        contract?.Status;

    var isAwaitingApplicant =
        contractStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerContractStatus.AwaitingApplicant;

    var isSubmitted =
        contractStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerContractStatus.Submitted;

    var isUnderReview =
        contractStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerContractStatus.UnderReview;

    var isCorrectionRequired =
        contractStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerContractStatus.CorrectionRequired;

    var isApproved =
        contractStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerContractStatus.Approved;
}


<div class="container contract-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <div class="contract-hero">

        <div class="contract-hero-content">

            <div class="contract-hero-top">

                <div>

                    <div class="contract-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <h1>
                        Volunteer Contract
                    </h1>

                    <p class="contract-description">
                        Your SwiftCare volunteer service agreement is managed
                        here. Download your agreement, sign it, and submit the
                        completed document for administrator review.
                    </p>

                </div>


                @if (isApproved)
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-check-circle-fill"></i>

                        Contract Approved

                    </div>
                }
                else if (isCorrectionRequired)
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        Correction Required

                    </div>
                }
                else if (isSubmitted || isUnderReview)
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-hourglass-split"></i>

                        Awaiting Review

                    </div>
                }
                else if (isAwaitingApplicant)
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-pencil-square"></i>

                        Action Required

                    </div>
                }
                else if (hasGeneratedContract)
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-check-circle-fill"></i>

                        Contract Generated

                    </div>
                }
                else
                {
                    <div class="contract-status-pill">

                        <i class="bi bi-clock"></i>

                        Awaiting Contract

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONTRACT CARD
         ========================================================= -->

    <div class="contract-card">

        @if (!hasGeneratedContract)
        {
            <!-- =====================================================
                 CONTRACT NOT GENERATED
                 ===================================================== -->

            <div class="contract-warning">

                <div class="contract-warning-icon">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>

                <div>

                    <strong>
                        Your contract is not ready yet
                    </strong>

                    <span>
                        SwiftCare has not generated your volunteer
                        contract yet. Please check again later.
                    </span>

                </div>

            </div>
        }
        else
        {
            <!-- =====================================================
                 CONTRACT CONTENT
                 ===================================================== -->

            <div class="contract-content">

                <!-- =================================================
                     CONTRACT DETAILS
                     ================================================= -->

                <div class="section-heading">

                    <div class="section-heading-icon">

                        <i class="bi bi-file-earmark-check"></i>

                    </div>

                    <h5>
                        Contract Details
                    </h5>

                </div>


                <div class="contract-details">

                    <!-- Contract -->

                    <div class="contract-detail-row">

                        <div class="contract-detail-label">

                            <i class="bi bi-file-earmark me-2"></i>

                            Contract

                        </div>

                        <div class="contract-detail-value">

                            SwiftCare Volunteer Service Agreement

                        </div>

                    </div>


                    <!-- Generated -->

                    <div class="contract-detail-row">

                        <div class="contract-detail-label">

                            <i class="bi bi-calendar-check me-2"></i>

                            Generated

                        </div>

                        <div class="contract-detail-value">

                            @(contract.CreatedDate.ToLocalTime()
                                .ToString("dd MMMM yyyy HH:mm"))

                        </div>

                    </div>


                    <!-- Status -->

                    <div class="contract-detail-row">

                        <div class="contract-detail-label">

                            <i class="bi bi-info-circle me-2"></i>

                            Status

                        </div>

                        <div class="contract-detail-value">

                            <span class="contract-status-value">

                                @if (isApproved)
                                {
                                    <i class="bi bi-check-circle-fill"></i>
                                }
                                else if (isCorrectionRequired)
                                {
                                    <i class="bi bi-exclamation-circle-fill"></i>
                                }
                                else if (isSubmitted || isUnderReview)
                                {
                                    <i class="bi bi-hourglass-split"></i>
                                }
                                else
                                {
                                    <i class="bi bi-clock"></i>
                                }

                                @contract.Status.GetDisplayName()

                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     APPROVED STATE
                     ================================================= -->
                @if (isApproved)
                {
                    <div class="uploaded-contract">

                        <div class="uploaded-contract-inner">

                            <div class="uploaded-contract-icon">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>

                            <div class="flex-grow-1">

                                <div class="uploaded-contract-title">

                                    Volunteer Contract Approved

                                </div>

                                <div class="uploaded-contract-file">

                                    Your signed volunteer service agreement
                                    has been reviewed and approved by
                                    SwiftCare.

                                </div>

                                <div class="uploaded-contract-status">

                                    <i class="bi bi-shield-check"></i>

                                    <span>
                                        Status:
                                    </span>

                                    <strong>
                                        @contract.Status.GetDisplayName()
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>
                }


                <!-- =================================================
                     CORRECTION REQUIRED
                     ================================================= -->
                @if (isCorrectionRequired)
                {
                    <div class="contract-correction">

                        <div class="contract-correction-header">

                            <div class="contract-correction-icon">

                                <i class="bi bi-exclamation-triangle"></i>

                            </div>

                            <div>

                                <h5>
                                    Correction Required
                                </h5>

                                <p>
                                    SwiftCare has reviewed your submitted
                                    contract and requires you to make a
                                    correction before it can be approved.
                                </p>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            contract.RejectionReason))
                        {
                            <div class="contract-correction-reason">

                                <div class="contract-correction-reason-title">

                                    <i class="bi bi-chat-left-text"></i>

                                    Administrator feedback

                                </div>

                                <div class="contract-correction-reason-text">

                                    @contract.RejectionReason

                                </div>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         RESUBMIT CONTRACT
                         ================================================= -->

                    <div class="contract-upload-section">

                        <div class="section-heading">

                            <div class="section-heading-icon">

                                <i class="bi bi-arrow-repeat"></i>

                            </div>

                            <h5>
                                Upload Corrected Contract
                            </h5>

                        </div>


                        <p class="contract-upload-description">

                            Make the requested corrections, sign the
                            agreement again if necessary, and upload the
                            corrected PDF below.

                        </p>


                        <form asp-action="ResubmitSignedContract"
                              asp-controller="VolunteerOnboarding"
                              method="post"
                              enctype="multipart/form-data"
                              class="contract-upload-form"
                              id="resubmitContractForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="onboardingId"
                                   value="@Model.VolunteerOnboardingId" />


                            <div class="contract-file-upload">

                                <input type="file"
                                       id="resubmitSignedContract"
                                       name="signedContract"
                                       accept=".pdf,application/pdf"
                                       class="contract-file-input"
                                       required />

                                <label for="resubmitSignedContract"
                                       class="contract-file-label">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                    <span>
                                        Select corrected signed PDF
                                    </span>

                                    <small>
                                        PDF files only
                                    </small>

                                </label>

                            </div>


                            <div class="contract-selected-file"
                                 id="resubmitSelectedFile">

                                <i class="bi bi-file-earmark-pdf"></i>

                                <span>
                                    No file selected
                                </span>

                            </div>


                            <button type="submit"
                                    class="btn-contract btn-upload">

                                <i class="bi bi-cloud-arrow-up-fill"></i>

                                Resubmit Corrected Contract

                            </button>

                        </form>

                    </div>
                }


                <!-- =================================================
                     AWAITING APPLICANT
                     ================================================= -->
                @if (isAwaitingApplicant)
                {
                    <div class="instructions">

                        <div class="instructions-heading">

                            <div class="instructions-heading-icon">

                                <i class="bi bi-list-check"></i>

                            </div>

                            <h5>
                                What you need to do
                            </h5>

                        </div>


                        <ol class="instructions-list">

                            <li>
                                Download your generated volunteer
                                service agreement.
                            </li>

                            <li>
                                Review the agreement carefully and make
                                sure your personal and volunteer information
                                is correct.
                            </li>

                            <li>
                                Complete any sections that require your
                                input.
                            </li>

                            <li>
                                Sign the agreement where indicated.
                            </li>

                            <li>
                                Upload the completed and signed PDF
                                directly below.
                            </li>

                        </ol>

                    </div>
                }


                <!-- =================================================
                     DOWNLOAD + FIRST UPLOAD
                     ================================================= -->
                @if (isAwaitingApplicant)
                {
                    <div class="contract-actions">

                        <a asp-controller="VolunteerOnboarding"
                               asp-action="DownloadContract"
                               asp-route-id="@Model.VolunteerOnboardingId"
                               class="btn-contract btn-download">

                            <i class="bi bi-download"></i>

                            Download Contract

                        </a>

                    </div>


                    <div class="contract-upload-section">

                        <div class="section-heading">

                            <div class="section-heading-icon">

                                <i class="bi bi-cloud-arrow-up"></i>

                            </div>

                            <h5>
                                Upload Signed Contract
                            </h5>

                        </div>


                        <p class="contract-upload-description">

                            Once you have signed the agreement, upload the
                            completed PDF here. Your contract will then be
                            submitted directly to SwiftCare for review.

                        </p>


                        <form asp-action="UploadSignedContract"
                              asp-controller="VolunteerOnboarding"
                              method="post"
                              enctype="multipart/form-data"
                              class="contract-upload-form"
                              id="uploadContractForm">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="onboardingId"
                                   value="@Model.VolunteerOnboardingId" />


                            <div class="contract-file-upload">

                                <input type="file"
                                       id="signedContract"
                                       name="signedContract"
                                       accept=".pdf,application/pdf"
                                       class="contract-file-input"
                                       required />

                                <label for="signedContract"
                                       class="contract-file-label">

                                    <i class="bi bi-cloud-arrow-up"></i>

                                    <span>
                                        Select signed PDF
                                    </span>

                                    <small>
                                        PDF files only
                                    </small>

                                </label>

                            </div>


                            <div class="contract-selected-file"
                                 id="selectedContractFile">

                                <i class="bi bi-file-earmark-pdf"></i>

                                <span>
                                    No file selected
                                </span>

                            </div>


                            <button type="submit"
                                    class="btn-contract btn-upload">

                                <i class="bi bi-cloud-arrow-up-fill"></i>

                                Submit Signed Contract

                            </button>

                        </form>

                    </div>
                }


                <!-- =================================================
                     SUBMITTED / UNDER REVIEW
                     ================================================= -->
                @if (isSubmitted || isUnderReview)
                {
                    <div class="uploaded-contract">

                        <div class="uploaded-contract-inner">

                            <div class="uploaded-contract-icon">

                                <i class="bi bi-hourglass-split"></i>

                            </div>

                            <div class="flex-grow-1">

                                <div class="uploaded-contract-title">

                                    Signed Contract Submitted

                                </div>

                                <div class="uploaded-contract-file">

                                    Your signed contract has been
                                    successfully submitted to SwiftCare.

                                </div>

                                <div class="uploaded-contract-status">

                                    <i class="bi bi-info-circle"></i>

                                    <span>
                                        Status:
                                    </span>

                                    <strong>
                                        @contract.Status.GetDisplayName()
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="contract-review-message">

                        <i class="bi bi-shield-check"></i>

                        <div>

                            <strong>
                                Awaiting administrator review
                            </strong>

                            <span>
                                SwiftCare will review your signed agreement.
                                If a correction is required, you will be
                                notified here and will be able to resubmit
                                the corrected contract.
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         SUBMITTED CONTRACT DOWNLOAD
                         ================================================= -->

                    <div class="contract-actions">

                        <a asp-controller="VolunteerOnboarding"
                               asp-action="DownloadContract"
                               asp-route-id="@Model.VolunteerOnboardingId"
                               class="btn-contract btn-download">

                            <i class="bi bi-file-earmark-arrow-down"></i>

                            Download Submitted Contract

                        </a>

                    </div>
                }


                <!-- =================================================
                     CONTRACT ACTIONS
                     ================================================= -->
                @if (!isApproved && !isSubmitted && !isUnderReview)
                {
                    @if (!isAwaitingApplicant && !isCorrectionRequired)
                    {
                        <div class="contract-actions">

                            <a asp-controller="VolunteerOnboarding"
                                   asp-action="DownloadContract"
                                   asp-route-id="@Model.VolunteerOnboardingId"
                                   class="btn-contract btn-download">

                                <i class="bi bi-file-earmark-arrow-down"></i>

                                Download Generated Contract

                            </a>

                        </div>
                    }
                }


                <!-- =================================================
                     SECURITY NOTE
                     ================================================= -->

                <div class="download-note">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Your contract is securely managed by SwiftCare.
                        Only your authorised onboarding account can access
                        and submit your volunteer agreement.
                    </span>

                </div>

            </div>


            <!-- =====================================================
                 FOOTER
                 ===================================================== -->

            <div class="contract-footer">

                <i class="bi bi-lock-fill"></i>

                <span>
                    SwiftCare securely manages your volunteer onboarding
                    documents and contract records.
                </span>

            </div>
        }

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // ========================================================
            // FIRST CONTRACT UPLOAD
            // ========================================================

            const uploadInput =
                document.getElementById("signedContract");

            const selectedFile =
                document.getElementById("selectedContractFile");

            const uploadForm =
                document.getElementById("uploadContractForm");


            if (uploadInput && selectedFile) {

                uploadInput.addEventListener("change", function () {

                    if (!this.files || this.files.length === 0) {

                        selectedFile.innerHTML = `
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>No file selected</span>
                        `;

                        return;
                    }

                    const file = this.files[0];

                    selectedFile.innerHTML = `
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>${escapeHtml(file.name)}</span>
                    `;
                });
            }


            if (uploadForm) {

                uploadForm.addEventListener("submit", function (event) {

                    if (!uploadInput ||
                        !uploadInput.files ||
                        uploadInput.files.length === 0) {

                        event.preventDefault();

                        alert(
                            "Please select your signed contract PDF."
                        );

                        return;
                    }

                    const file =
                        uploadInput.files[0];

                    const extension =
                        file.name
                            .split(".")
                            .pop()
                            .toLowerCase();

                    if (extension !== "pdf") {

                        event.preventDefault();

                        alert(
                            "Only PDF files can be uploaded."
                        );

                        uploadInput.value = "";

                        return;
                    }
                });
            }


            // ========================================================
            // RESUBMIT CONTRACT
            // ========================================================

            const resubmitInput =
                document.getElementById(
                    "resubmitSignedContract"
                );

            const resubmitSelectedFile =
                document.getElementById(
                    "resubmitSelectedFile"
                );

            const resubmitForm =
                document.getElementById(
                    "resubmitContractForm"
                );


            if (resubmitInput && resubmitSelectedFile) {

                resubmitInput.addEventListener(
                    "change",
                    function () {

                        if (!this.files ||
                            this.files.length === 0) {

                            resubmitSelectedFile.innerHTML = `
                                <i class="bi bi-file-earmark-pdf"></i>
                                <span>No file selected</span>
                            `;

                            return;
                        }

                        const file = this.files[0];

                        resubmitSelectedFile.innerHTML = `
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>${escapeHtml(file.name)}</span>
                        `;
                    }
                );
            }


            if (resubmitForm) {

                resubmitForm.addEventListener(
                    "submit",
                    function (event) {

                        if (!resubmitInput ||
                            !resubmitInput.files ||
                            resubmitInput.files.length === 0) {

                            event.preventDefault();

                            alert(
                                "Please select the corrected signed contract PDF."
                            );

                            return;
                        }

                        const file =
                            resubmitInput.files[0];

                        const extension =
                            file.name
                                .split(".")
                                .pop()
                                .toLowerCase();

                        if (extension !== "pdf") {

                            event.preventDefault();

                            alert(
                                "Only PDF files can be uploaded."
                            );

                            resubmitInput.value = "";

                            return;
                        }
                    }
                );
            }


            // ========================================================
            // SIMPLE HTML ESCAPE
            // ========================================================

            function escapeHtml(value) {

                return value
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

        });

    </script>
}