@{
    ViewData["Title"] = "Volunteer Offer Error";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var errorMessage =
        TempData["Error"]?.ToString()
        ?? "This volunteer offer link is invalid, expired, or is no longer available.";
}

<div class="container offer-error-page">

    <div class="offer-error-card">

        <!-- =========================================================
             ICON
             ========================================================= -->

        <div class="offer-error-icon">

            <i class="bi bi-shield-exclamation"></i>

        </div>


        <!-- =========================================================
             TITLE
             ========================================================= -->

        <h1>
            Volunteer Offer Unavailable
        </h1>


        <!-- =========================================================
             MESSAGE
             ========================================================= -->

        <p class="offer-error-message">
            @errorMessage
        </p>


        <!-- =========================================================
             INFORMATION
             ========================================================= -->

        <div class="offer-error-info">

            <div class="d-flex align-items-start gap-3">

                <i class="bi bi-info-circle-fill"></i>

                <div>

                    <strong>
                        What can you do?
                    </strong>

                    <p class="mb-0 mt-1">
                        Please make sure you are using the latest
                        volunteer offer link sent to your email.
                        If the problem continues, contact SwiftCare
                        for assistance.
                    </p>

                </div>

            </div>

        </div>


        <!-- =========================================================
             ACTIONS
             ========================================================= -->

        <div class="offer-error-actions">

            <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary">

                <i class="bi bi-house-door me-2"></i>

                Return to SwiftCare

            </a>

        </div>

    </div>

</div>

