@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =============================================================
            // REVIEW DOCUMENT MODAL
            // =============================================================

            const reviewDocumentModal =
                document.getElementById("reviewDocumentModal");

            if (reviewDocumentModal) {

                reviewDocumentModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button) {
                            return;
                        }

                        const documentId =
                            button.getAttribute(
                                "data-document-id"
                            );

                        const hiddenInput =
                            document.getElementById(
                                "reviewDocumentId"
                            );

                        if (hiddenInput) {

                            hiddenInput.value =
                                documentId || "";

                        }

                    }
                );

            }


            // =============================================================
            // DIDIT START BUTTON PROTECTION
            // =============================================================

            const diditForms =
                document.querySelectorAll(
                    ".identity-verification-form, .main-identity-verification-form"
                );

            diditForms.forEach(function (form) {

                form.addEventListener(
                    "submit",
                    function () {

                        const button =
                            form.querySelector(
                                "button[type='submit']"
                            );

                        if (!button) {
                            return;
                        }

                        const originalHtml =
                            button.innerHTML;

                        button.disabled = true;

                        button.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-1" ' +
                            'role="status" aria-hidden="true"></span>' +
                            ' Starting Didit...';

                        setTimeout(function () {

                            if (document.body.contains(button)) {

                                button.disabled = false;

                                button.innerHTML =
                                    originalHtml;

                            }

                        }, 10000);

                    }
                );

            });


            // =============================================================
            // DIDIT LIVE POLLING
            // =============================================================

            const diditCard =
                document.getElementById(
                    "diditVerificationCard"
                );

            if (!diditCard) {
                return;
            }


            const statusText =
                document.getElementById(
                    "diditLiveStatusText"
                );

            const statusBadge =
                document.getElementById(
                    "diditLiveBadge"
                );

            const statusIcon =
                document.getElementById(
                    "diditLiveIcon"
                );

            const statusDetails =
                document.getElementById(
                    "diditLiveDetails"
                );

            const checksContainer =
                document.getElementById(
                    "diditLiveChecks"
                );

            const diditActionArea =
                document.getElementById(
                    "diditActionArea"
                );

            const workflowActionContent =
                document.getElementById(
                    "workflowActionContent"
                );

            const workflowStageBadge =
                document.getElementById(
                    "workflowStageBadge"
                );


            const onboardingId =
                diditCard.getAttribute(
                    "data-onboarding-id"
                );

            const statusUrl =
                diditCard.getAttribute(
                    "data-status-url"
                );


            let pollingTimer = null;

            let requestInProgress = false;

            let pollingStopped = false;


            // =============================================================
            // STATUS TEXT
            // =============================================================

            function humanizeStatus(status) {

                if (!status) {
                    return "Not Started";
                }

                const names = {

                    Pending:
                        "Pending",

                    InProgress:
                        "In Progress",

                    AwaitingUser:
                        "Awaiting Applicant",

                    DocumentVerified:
                        "Document Verified",

                    FaceVerificationInProgress:
                        "Face Verification In Progress",

                    Verified:
                        "Verified",

                    Failed:
                        "Failed",

                    Rejected:
                        "Rejected",

                    RequiresReview:
                        "Requires Review",

                    Expired:
                        "Expired",

                    Cancelled:
                        "Cancelled"

                };

                return names[status] || status;

            }


            // =============================================================
            // TERMINAL DIDIT STATUS
            // =============================================================

            function isTerminalStatus(status) {

                return [

                    "Verified",
                    "Failed",
                    "Rejected",
                    "RequiresReview",
                    "Expired",
                    "Cancelled"

                ].includes(status);

            }


            // =============================================================
            // UPDATE DIDIT ACTION AREA
            // =============================================================

            function renderDiditAction(result) {

                if (!diditActionArea) {
                    return;
                }


                const status =
                    result?.status;


                // ---------------------------------------------------------
                // VERIFIED
                // ---------------------------------------------------------

                if (status === "Verified") {

                    diditActionArea.innerHTML =

                        '<div class="didit-not-ready" ' +
                        'style="background:#DCFCE7;color:#166534;">' +

                            '<i class="bi bi-check-circle-fill"></i>' +

                            '<span>' +

                                '<strong>Identity Verification Complete</strong>' +
                                '<br>' +
                                '<small>' +
                                    'Document, liveness and face verification passed. ' +
                                    'The onboarding can now proceed to the contract stage.' +
                                '</small>' +

                            '</span>' +

                        '</div>';

                    return;

                }


                // ---------------------------------------------------------
                // FAILED / REJECTED
                // ---------------------------------------------------------

                if (
                    status === "Failed" ||
                    status === "Rejected" ||
                    status === "Expired" ||
                    status === "Cancelled"
                ) {

                    diditActionArea.innerHTML =

                        '<div class="didit-not-ready" ' +
                        'style="background:#FEE2E2;color:#991B1B;">' +

                            '<i class="bi bi-exclamation-circle-fill"></i>' +

                            '<span>' +

                                '<strong>' +
                                    humanizeStatus(status) +
                                '</strong>' +

                                '<br>' +

                                '<small>' +
                                    'Review the verification result and determine whether ' +
                                    'the applicant needs to resubmit or be reviewed.' +
                                '</small>' +

                            '</span>' +

                        '</div>';

                    return;

                }


                // ---------------------------------------------------------
                // REQUIRES REVIEW
                // ---------------------------------------------------------

                if (status === "RequiresReview") {

                    diditActionArea.innerHTML =

                        '<div class="didit-not-ready" ' +
                        'style="background:#FEF3C7;color:#92400E;">' +

                            '<i class="bi bi-person-exclamation"></i>' +

                            '<span>' +

                                '<strong>Manual Review Required</strong>' +

                                '<br>' +

                                '<small>' +
                                    'Didit has placed this verification under review.' +
                                '</small>' +

                            '</span>' +

                        '</div>';

                    return;

                }


                // ---------------------------------------------------------
                // ACTIVE / AWAITING APPLICANT
                // ---------------------------------------------------------

                if (
                    status === "AwaitingUser" ||
                    status === "InProgress" ||
                    status === "DocumentVerified" ||
                    status === "FaceVerificationInProgress"
                ) {

                    diditActionArea.innerHTML =

                        '<div class="didit-not-ready" ' +
                        'style="background:#FEF3C7;color:#92400E;">' +

                            '<i class="bi bi-hourglass-split"></i>' +

                            '<span>' +

                                '<strong>' +
                                    humanizeStatus(status) +
                                '</strong>' +

                                '<br>' +

                                '<small>' +
                                    'Do not start another verification session. ' +
                                    'The current Didit verification is already active.' +
                                '</small>' +

                            '</span>' +

                        '</div>';

                    return;

                }

            }


            // =============================================================
            // UPDATE WORKFLOW AFTER DIDIT
            // =============================================================

            function updateWorkflowAfterDidit(result) {

                if (!result) {
                    return;
                }

                if (result.status !== "Verified") {
                    return;
                }

            }


            // =============================================================
            // LIVE STATUS VISUAL
            // =============================================================

            function setLiveVisual(status) {

                const verified =
                    status === "Verified";

                const negative =
                    [
                        "Failed",
                        "Rejected",
                        "Expired",
                        "Cancelled"
                    ].includes(status);

                const review =
                    status === "RequiresReview";


                const badgeBackground =
                    verified
                        ? "#DCFCE7"
                        : negative
                            ? "#FEE2E2"
                            : review
                                ? "#FEF3C7"
                                : "#DCEDC8";


                const badgeColor =
                    verified
                        ? "#166534"
                        : negative
                            ? "#991B1B"
                            : review
                                ? "#92400E"
                                : "#1B5E20";


                // ---------------------------------------------------------
                // BADGE
                // ---------------------------------------------------------

                if (statusBadge) {

                    statusBadge.textContent =
                        humanizeStatus(status);

                    statusBadge.style.background =
                        badgeBackground;

                    statusBadge.style.color =
                        badgeColor;

                }


                // ---------------------------------------------------------
                // ICON
                // ---------------------------------------------------------

                if (statusIcon) {

                    statusIcon.style.background =
                        badgeBackground;

                    statusIcon.style.color =
                        badgeColor;


                    if (verified) {

                        statusIcon.innerHTML =
                            '<i class="bi bi-check-circle-fill"></i>';

                    }
                    else if (negative) {

                        statusIcon.innerHTML =
                            '<i class="bi bi-exclamation-circle-fill"></i>';

                    }
                    else if (review) {

                        statusIcon.innerHTML =
                            '<i class="bi bi-person-exclamation"></i>';

                    }
                    else {

                        statusIcon.innerHTML =
                            '<i class="bi bi-arrow-repeat"></i>';

                    }

                }


                // ---------------------------------------------------------
                // MAIN STATUS TEXT
                // ---------------------------------------------------------

                if (statusText) {

                    if (verified) {

                        statusText.textContent =
                            "Applicant identity verified successfully";

                    }
                    else if (negative) {

                        statusText.textContent =
                            "Applicant identity verification requires attention";

                    }
                    else if (review) {

                        statusText.textContent =
                            "Didit has placed this verification under review";

                    }
                    else if (status === "AwaitingUser") {

                        statusText.textContent =
                            "Waiting for the applicant to complete verification";

                    }
                    else {

                        statusText.textContent =
                            "Applicant identity verification is in progress";

                    }


                    statusText.style.color =
                        badgeColor;

                }


                return isTerminalStatus(status);

            }


            // =============================================================
            // CHECK BADGES
            // =============================================================

            function renderChecks(result) {

                if (!checksContainer) {
                    return;
                }


                const checks = [

                    {
                        label: "Document",
                        value: result.documentVerified === true
                    },

                    {
                        label: "Liveness",
                        value: result.livenessVerified === true
                    },

                    {
                        label: "Face Match",
                        value: result.faceMatchVerified === true
                    }

                ];


                checksContainer.style.display =
                    "flex";


                checksContainer.innerHTML =
                    checks.map(function (check) {

                        const background =
                            check.value
                                ? "#DCFCE7"
                                : "#F3F4F6";

                        const color =
                            check.value
                                ? "#166534"
                                : "#64748B";

                        const icon =
                            check.value
                                ? "bi-check-circle-fill"
                                : "bi-clock";


                        return (

                            '<span style="' +
                                'display:inline-flex;' +
                                'align-items:center;' +
                                'gap:.35rem;' +
                                'padding:.35rem .6rem;' +
                                'border-radius:999px;' +
                                'background:' + background + ';' +
                                'color:' + color + ';' +
                                'font-size:.76rem;' +
                                'font-weight:800;' +
                            '">' +

                                '<i class="bi ' +
                                    icon +
                                '"></i>' +

                                check.label +

                            '</span>'

                        );

                    }).join("");

            }


            // =============================================================
            // NO VERIFICATION
            // =============================================================

            function renderNotStarted() {

                if (statusBadge) {

                    statusBadge.textContent =
                        "Not Started";

                    statusBadge.style.background =
                        "#DCEDC8";

                    statusBadge.style.color =
                        "#1B5E20";

                }


                if (statusIcon) {

                    statusIcon.style.background =
                        "#DCEDC8";

                    statusIcon.style.color =
                        "#1B5E20";

                    statusIcon.innerHTML =
                        '<i class="bi bi-shield-check"></i>';

                }


                if (statusText) {

                    statusText.textContent =
                        "No Didit verification session has been created yet";

                    statusText.style.color =
                        "#1B5E20";

                }


                if (statusDetails) {

                    statusDetails.textContent =
                        "Start Didit Verification after the applicant's identity document has been approved.";

                }


                if (checksContainer) {

                    checksContainer.style.display =
                        "none";

                    checksContainer.innerHTML =
                        "";

                }

            }


            // =============================================================
            // POLL DIDIT STATUS
            // =============================================================

            async function pollDiditStatus() {

                if (
                    requestInProgress ||
                    pollingStopped ||
                    !statusUrl ||
                    !onboardingId
                ) {
                    return;
                }


                requestInProgress = true;


                try {

                    const separator =
                        statusUrl.includes("?")
                            ? "&"
                            : "?";


                    const requestUrl =
                        statusUrl +
                        separator +
                        "onboardingId=" +
                        encodeURIComponent(onboardingId) +
                        "&_=" +
                        Date.now();


                    const response =
                        await fetch(
                            requestUrl,
                            {
                                method: "GET",

                                headers: {
                                    "Accept":
                                        "application/json",

                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                },

                                cache: "no-store",

                                credentials:
                                    "same-origin"
                            }
                        );


                    // -----------------------------------------------------
                    // AUTHENTICATION
                    // -----------------------------------------------------

                    if (
                        response.status === 401 ||
                        response.status === 403
                    ) {

                        if (statusDetails) {

                            statusDetails.textContent =
                                "Your administrator session has expired. Please sign in again.";

                        }

                        pollingStopped = true;

                        return;

                    }


                    // -----------------------------------------------------
                    // SERVER ERROR
                    // -----------------------------------------------------

                    if (!response.ok) {

                        throw new Error(
                            "Status endpoint returned HTTP " +
                            response.status
                        );

                    }


                    // -----------------------------------------------------
                    // JSON
                    // -----------------------------------------------------

                    const result =
                        await response.json();


                    // -----------------------------------------------------
                    // NO SESSION
                    // -----------------------------------------------------

                    if (!result.exists) {

                        renderNotStarted();

                        return;

                    }


                    // -----------------------------------------------------
                    // LIVE STATUS
                    // -----------------------------------------------------

                    const isTerminal =
                        setLiveVisual(
                            result.status
                        );


                    // -----------------------------------------------------
                    // UPDATE ACTIONS
                    // -----------------------------------------------------

                    renderDiditAction(result);


                    // -----------------------------------------------------
                    // DIDIT VERIFIED
                    // -----------------------------------------------------

                    updateWorkflowAfterDidit(result);


                    // -----------------------------------------------------
                    // CHECKS
                    // -----------------------------------------------------

                    renderChecks(
                        result
                    );


                    // -----------------------------------------------------
                    // DETAILS
                    // -----------------------------------------------------

                    if (statusDetails) {

                        if (result.status === "Verified") {

                            statusDetails.textContent =
                                "Verification completed successfully. " +
                                "The next onboarding stage is the Volunteer Service Agreement.";

                        }
                        else if (result.failureReason) {

                            statusDetails.textContent =
                                result.failureReason;

                        }
                        else if (result.status === "AwaitingUser") {

                            statusDetails.textContent =
                                "The verification invitation has been sent. " +
                                "Waiting for the applicant to complete Didit.";

                        }
                        else if (result.modifiedDate) {

                            const modified =
                                new Date(
                                    result.modifiedDate
                                );


                            if (!isNaN(modified.getTime())) {

                                statusDetails.textContent =
                                    "Last updated " +
                                    modified.toLocaleTimeString(
                                        [],
                                        {
                                            hour:
                                                "2-digit",

                                            minute:
                                                "2-digit",

                                            second:
                                                "2-digit"
                                        }
                                    );

                            }
                            else {

                                statusDetails.textContent =
                                    "Waiting for the latest verification update...";

                            }

                        }
                        else {

                            statusDetails.textContent =
                                "Waiting for the latest verification update...";

                        }

                    }


                    // -----------------------------------------------------
                    // STOP ON TERMINAL STATUS
                    // -----------------------------------------------------

                    if (isTerminal) {

                        pollingStopped = true;


                        if (pollingTimer) {

                            clearInterval(
                                pollingTimer
                            );

                            pollingTimer =
                                null;

                        }

                    }

                }
                catch (error) {

                    console.warn(
                        "[SwiftCare] Didit status polling failed:",
                        error
                    );


                    if (statusDetails) {

                        statusDetails.textContent =
                            "Waiting for the latest verification update...";

                    }

                }
                finally {

                    requestInProgress =
                        false;

                }

            }


            // =============================================================
            // INITIAL CHECK
            // =============================================================

            pollDiditStatus();


            // =============================================================
            // CONTINUOUS POLLING
            // =============================================================

            pollingTimer =
                window.setInterval(
                    function () {

                        pollDiditStatus();

                    },
                    3000
                );


            // =============================================================
            // CLEANUP
            // =============================================================

            window.addEventListener(
                "beforeunload",
                function () {

                    pollingStopped =
                        true;


                    if (pollingTimer) {

                        clearInterval(
                            pollingTimer
                        );

                        pollingTimer =
                            null;

                    }

                }
            );

        });

    </script>

}