
@model IEnumerable<SwiftCare.Models.Order>
@inject SwiftCare.Interfaces.IEncryptionService encryptionService

@{
    ViewData["Title"] = "Equipment Orders";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<div class="sc-orders-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <section class="sc-orders-header">

        <div class="sc-orders-header-inner">

            <a asp-controller="Home"
                   asp-action="Index"
                   class="sc-orders-back"
                   title="Back to Dashboard">

                <i class="bi bi-chevron-left"></i>

            </a>


            <div>

                <h1 class="sc-orders-header-title">
                    Equipment Orders
                </h1>

                <p class="sc-orders-header-subtitle">
                    Manage, package, track and receive equipment orders.
                </p>

            </div>

        </div>

    </section>


    <!-- ============================================================
         TOOLBAR
         ============================================================ -->

    <div class="sc-orders-toolbar">

        <div class="sc-orders-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   class="sc-orders-search-input"
                   placeholder="Search by order number, equipment or status..."
                   id="orderSearchInput" />

        </div>


        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Equipment"
                   asp-action="EquipmentList"
                   class="sc-orders-primary-button">

                <i class="bi bi-plus-circle"></i>

                New Order

            </a>
        }

    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->
    @if (TempData["Message"] != null)
    {
        <div id="tempDataMessage"
             class="sc-orders-alert sc-orders-alert-success">

            <div>

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["Message"]

            </div>


            <button type="button"
                    class="sc-orders-alert-close">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->
    @if (TempData["Error"] != null)
    {
        <div id="tempDataError"
             class="sc-orders-alert sc-orders-alert-error">

            <div>

                <i class="bi bi-exclamation-circle-fill me-2"></i>

                @TempData["Error"]

            </div>


            <button type="button"
                    class="sc-orders-alert-close">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>
    }


    <!-- ============================================================
         EMPTY STATE
         ============================================================ -->
    @if (Model == null || !Model.Any())
    {
        <div class="sc-orders-empty">

            <div class="sc-orders-empty-icon">

                <i class="bi bi-box-seam"></i>

            </div>


            <h4>
                No Equipment Orders
            </h4>


            <p>
                There are currently no equipment orders to display.
            </p>

        </div>
    }
    else
    {

        <!-- ========================================================
             ORDERS TABLE
             ======================================================== -->

        <div class="sc-orders-table-card">

            <div class="table-responsive">

                <table class="sc-orders-table"
                       id="ordersTable">

                    <thead>

                        <tr>

                            <th>
                                Order Number
                            </th>

                            <th>
                                Equipment
                            </th>

                            <th>
                                Total Quantity
                            </th>

                            <th>
                                Order Date
                            </th>

                            <th>
                                Last Updated
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            var encryptedId =
                                encryptionService.Encrypt(
                                    item.OrderId
                                );

                            var equipmentCount =
                                item.OrderItems?.Count ?? 0;

                            var totalQuantity =
                                item.OrderItems?.Sum(
                                    orderItem =>
                                        orderItem.Quantity
                                ) ?? 0;


                            <tr>

                                <!-- ORDER NUMBER -->

                                <td>

                                    <div class="sc-orders-number">

                                        <div class="sc-orders-number-icon">

                                            <i class="bi bi-receipt"></i>

                                        </div>


                                        <span>

                                            @item.OrderNumber

                                        </span>

                                    </div>

                                </td>


                                <!-- EQUIPMENT TYPES -->

                                <td>

                                    <div class="sc-orders-equipment">

                                        <span class="sc-orders-count-badge">

                                            @equipmentCount

                                        </span>


                                        <span>

                                            @(equipmentCount == 1
                                                ? "Equipment Type"
                                                : "Equipment Types")

                                        </span>

                                    </div>

                                </td>


                                <!-- TOTAL QUANTITY -->

                                <td>

                                    <span class="sc-orders-quantity">

                                        @totalQuantity item(s)

                                    </span>

                                </td>


                                <!-- ORDER DATE -->

                                <td>

                                    <span class="sc-orders-date">

                                        <i class="bi bi-calendar3 me-1"></i>

                                        @item.OrderDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- LAST UPDATED -->

                                <td>

                                    <span class="sc-orders-date">

                                        <i class="bi bi-clock-history me-1"></i>

                                        @item.LastUpdated.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.Status == SwiftCare.Models.OrderStatus.Pending)
                                    {
                                        <span class="sc-orders-status sc-orders-status-pending">

                                            <i class="bi bi-hourglass-split"></i>

                                            Pending

                                        </span>
                                    }
                                    else if (item.Status == SwiftCare.Models.OrderStatus.Packaged)
                                    {
                                        <span class="sc-orders-status sc-orders-status-packaged">

                                            <i class="bi bi-box-seam-fill"></i>

                                            Packaged

                                        </span>
                                    }
                                    else if (item.Status == SwiftCare.Models.OrderStatus.OnTheWay)
                                    {
                                        <span class="sc-orders-status sc-orders-status-way">

                                            <i class="bi bi-truck"></i>

                                            On The Way

                                        </span>
                                    }
                                    else if (item.Status == SwiftCare.Models.OrderStatus.Collected)
                                    {
                                        <span class="sc-orders-status sc-orders-status-collected">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Collected

                                        </span>
                                    }
                                    else if (item.Status == SwiftCare.Models.OrderStatus.Cancelled)
                                    {
                                        <span class="sc-orders-status sc-orders-status-cancelled">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="sc-orders-status">

                                            @item.Status

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <button class="btn btn-primary btn-sm action-button"
                                            type="button"
                                            data-order-id="@encryptedId"
                                            data-details-url="@Url.Action(
                                                    "OrderDetails",
                                                    "Orders",
                                                    new { orderId = encryptedId })"
                                            data-receive-url="@Url.Action(
                                                    "ReceiveOrder",
                                                    "Orders",
                                                    new { orderId = encryptedId })"
                                            data-ready-url="@Url.Action(
                                                    "MarkAsReady",
                                                    "Orders",
                                                    new { orderId = item.OrderId })"
                                            data-on-the-way-url="@Url.Action(
                                                    "MarkAsOnTheWay",
                                                    "Orders",
                                                    new { orderId = item.OrderId })">

                                        <i class="bi bi-three-dots-vertical"></i>

                                        Actions

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    }

</div>


<!-- ================================================================
     FLOATING ACTION MENU
     ================================================================ -->

<div id="floatingActionTab"
     class="sc-orders-floating-menu">

    <div class="list-group list-group-flush">


        <!-- ORDER DETAILS -->

        <a href="#"
               id="detailsLink"
               class="list-group-item list-group-item-action">

            <i class="bi bi-info-circle"
               style="color:#1f5c3a;"></i>

            Order Details

        </a>


        <!-- PACKAGE ORDER -->
        @if (User.IsInRole("Administrator"))
        {
            <a href="#"
                   id="packageLink"
                   class="list-group-item list-group-item-action sc-orders-package-action">

                <i class="bi bi-box-seam"></i>

                Package Order

            </a>
        }


        <!-- MARK AS READY -->
        @if (User.IsInRole("Administrator"))
        {
            <a href="#"
                   id="readyLink"
                   class="list-group-item list-group-item-action">

                <i class="bi bi-check-circle"
                   style="color:#2f7a4f;"></i>

                Mark As Ready

            </a>
        }


        <!-- MARK AS ON THE WAY -->
        @if (User.IsInRole("Administrator") ||
                     User.IsInRole("Supplier Driver"))
        {
            <a href="#"
                   id="onTheWayLink"
                   class="list-group-item list-group-item-action">

                <i class="bi bi-truck"
                   style="color:#27659c;"></i>

                Mark As On The Way

            </a>
        }


        <!-- RECEIVE ORDER -->
        @if (User.IsInRole("Administrator") ||
                     User.IsInRole("Supplier Driver"))
        {
            <a href="#"
                   id="receiveLink"
                   class="list-group-item list-group-item-action">

                <i class="bi bi-box-arrow-in-down"
                   style="color:#2f7a4f;"></i>

                Receive Order

            </a>
        }

    </div>

</div>


@section Scripts {

    <script>

        $(document).ready(function () {


            /* ============================================================
               TEMP DATA MESSAGES
               ============================================================ */

            setTimeout(function () {

                $("#tempDataMessage").fadeOut();

                $("#tempDataError").fadeOut();

            }, 7000);


            $(document).on(
                "click",
                ".sc-orders-alert-close",
                function () {

                    $(this)
                        .closest(".sc-orders-alert")
                        .fadeOut();

                }
            );


            /* ============================================================
               ACTION BUTTON
               ============================================================ */

            $(document).on(
                "click",
                ".action-button",
                function (e) {

                    e.stopPropagation();


                    const button = $(this)[0];

                    const tab =
                        $("#floatingActionTab");


                    const detailsUrl =
                        $(this).data("details-url");

                    const packageUrl =
                        $(this).data("package-url");

                    const receiveUrl =
                        $(this).data("receive-url");

                    const readyUrl =
                        $(this).data("ready-url");

                    const onTheWayUrl =
                        $(this).data("on-the-way-url");


                    /* ====================================================
                       SET LINKS
                       ==================================================== */

                    $("#detailsLink")
                        .attr(
                            "href",
                            detailsUrl
                        );


                    $("#packageLink")
                        .attr(
                            "href",
                            packageUrl
                        );


                    $("#receiveLink")
                        .attr(
                            "href",
                            receiveUrl
                        );


                    $("#readyLink")
                        .attr(
                            "data-url",
                            readyUrl
                        );


                    $("#onTheWayLink")
                        .attr(
                            "data-url",
                            onTheWayUrl
                        );


                    /* ====================================================
                       POSITION MENU
                       ==================================================== */

                    const rect =
                        button.getBoundingClientRect();


                    tab.css({

                        display: "block",
                        visibility: "hidden"

                    });


                    const tabWidth =
                        tab.outerWidth();


                    const tabHeight =
                        tab.outerHeight();


                    const offsetX = 10;

                    const offsetY = 8;


                    let left =
                        rect.right + offsetX;


                    let top =
                        rect.top + offsetY;


                    if (
                        left + tabWidth >
                        window.innerWidth
                    ) {

                        left =
                            rect.left -
                            tabWidth -
                            offsetX;

                    }


                    if (
                        top + tabHeight >
                        window.innerHeight
                    ) {

                        top =
                            window.innerHeight -
                            tabHeight -
                            offsetY;

                    }


                    if (top < 10) {

                        top = 10;

                    }


                    tab.css({

                        position: "fixed",

                        left:
                            left + "px",

                        top:
                            top + "px",

                        visibility: "visible"

                    });


                    tab.hide()
                        .fadeIn(150);

                }
            );


            /* ============================================================
               CLOSE FLOATING MENU
               ============================================================ */

            $(document).on(
                "click",
                function (e) {

                    if (

                        !$(e.target)
                            .closest("#floatingActionTab")
                            .length &&

                        !$(e.target)
                            .closest(".action-button")
                            .length

                    ) {

                        $("#floatingActionTab")
                            .fadeOut(100);

                    }

                }
            );


            /* ============================================================
               SEARCH
               ============================================================ */

            $("#orderSearchInput").on(
                "input",
                function () {

                    const value =
                        $(this)
                            .val()
                            .toLowerCase()
                            .trim();


                    $("#ordersTable tbody tr")
                        .each(function () {

                            const rowText =
                                $(this)
                                    .text()
                                    .toLowerCase();


                            $(this).toggle(

                                rowText.indexOf(value) > -1

                            );

                        });

                }
            );


            /* ============================================================
               MARK AS READY
               ============================================================ */

            $(document).on(
                "click",
                "#readyLink",
                function (e) {

                    e.preventDefault();


                    const url =
                        $(this).attr("data-url");


                    if (!url) {

                        return;

                    }


                    if (
                        !confirm(
                            "Mark this equipment order as ready?"
                        )
                    ) {

                        return;

                    }


                    submitOrderAction(
                        url,
                        "Equipment order marked as ready."
                    );

                }
            );


            /* ============================================================
               MARK AS ON THE WAY
               ============================================================ */

            $(document).on(
                "click",
                "#onTheWayLink",
                function (e) {

                    e.preventDefault();


                    const url =
                        $(this).attr("data-url");


                    if (!url) {

                        return;

                    }


                    if (
                        !confirm(
                            "Mark this equipment order as on the way?"
                        )
                    ) {

                        return;

                    }


                    submitOrderAction(
                        url,
                        "Equipment order is now on the way."
                    );

                }
            );


            /* ============================================================
               POST ORDER ACTION
               ============================================================ */

            function submitOrderAction(
                url,
                successMessage
            ) {

                const token =
                    $('input[name="__RequestVerificationToken"]')
                        .val();


                $.ajax({

                    url: url,

                    type: "POST",

                    headers: {

                        "RequestVerificationToken":
                            token

                    },


                    success: function (response) {

                        if (
                            response &&
                            response.success
                        ) {

                            location.reload();

                        }
                        else {

                            alert(
                                response?.message ||
                                "Unable to update the equipment order."
                            );

                        }

                    },


                    error: function (xhr) {

                        console.error(
                            xhr.responseText
                        );


                        alert(
                            "Unable to update the equipment order. Please try again."
                        );

                    }

                });

            }

        });

    </script>

}

