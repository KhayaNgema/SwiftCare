@model SwiftCare.ViewModels.ResidentDetailsViewModel

@{
    ViewData["Title"] = "Resident Details";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var resident = Model.Resident;

    var age = 0;

    if (resident.DateOfBirth != default)
    {
        age = DateTime.Today.Year - resident.DateOfBirth.Year;

        if (resident.DateOfBirth.Date > DateTime.Today.AddYears(-age))
        {
            age--;
        }
    }

    var profileImage =
        string.IsNullOrWhiteSpace(resident.ProfilePicture)
        ? Url.Content("~/Images/default_profile_image.jpg")
        : Url.Content("~/" + resident.ProfilePicture.TrimStart('/'));
}

<div class="sc-resident-details-page">

    <!-- ============================================================
         HERO / HEADER
    ============================================================ -->

    <div class="sc-resident-hero">

        <div class="sc-resident-hero-top">

            <a asp-controller="Residents"
                   asp-action="Residents"
                   class="sc-resident-back-btn">

                <i class="bi bi-arrow-left"></i>

                <span>Back to Residents</span>

            </a>


            <div class="sc-resident-id">

                <i class="bi bi-person-vcard"></i>

                Resident #@resident.Id

            </div>

        </div>


        <div class="sc-resident-hero-content">

            <div class="sc-resident-image-wrap">

                <img src="@profileImage"
                     alt="@resident.FirstName @resident.LastName"
                     class="sc-resident-main-image"
                     onerror="this.src='@Url.Content("~/Images/default_profile_image.jpg")'" />

                <div class="sc-resident-online-dot"></div>

            </div>


            <div class="sc-resident-main-info">

                <div class="sc-resident-role">

                    <i class="bi bi-person-heart"></i>

                    Resident Profile

                </div>


                <h1>

                    @resident.FirstName @resident.LastName

                </h1>


                <p>

                    <i class="bi bi-house-door"></i>

                    @if (resident.RoomNumber != null)
                    {
                        <span>
                            Room @resident.RoomNumber
                        </span>
                    }
                    else
                    {
                        <span>
                            No room assigned
                        </span>
                    }

                </p>

            </div>

        </div>

    </div>


    <!-- ============================================================
         PAGE CONTENT
    ============================================================ -->

    <div class="sc-resident-content">


        <!-- ========================================================
             QUICK STATS
        ======================================================== -->

        <div class="row g-4 sc-resident-stats">


            <!-- DATE OF BIRTH -->

            <div class="col-12 col-sm-6 col-lg-3">

                <div class="sc-resident-stat-card">

                    <div class="sc-resident-stat-icon sc-stat-green">

                        <i class="bi bi-calendar-heart"></i>

                    </div>


                    <div>

                        <span>
                            Date of Birth
                        </span>


                        <strong>

                            @(resident.DateOfBirth == default
                                ? "Not provided"
                                : resident.DateOfBirth.ToString("dd MMM yyyy"))

                        </strong>

                    </div>

                </div>

            </div>


            <!-- AGE -->

            <div class="col-12 col-sm-6 col-lg-3">

                <div class="sc-resident-stat-card">

                    <div class="sc-resident-stat-icon sc-stat-lime">

                        <i class="bi bi-person-badge"></i>

                    </div>


                    <div>

                        <span>
                            Age
                        </span>


                        <strong>

                            @(resident.DateOfBirth == default
                                ? "Not provided"
                                : $"{age} years")

                        </strong>

                    </div>

                </div>

            </div>


            <!-- ROOM -->

            <div class="col-12 col-sm-6 col-lg-3">

                <div class="sc-resident-stat-card">

                    <div class="sc-resident-stat-icon sc-stat-soft">

                        <i class="bi bi-door-open"></i>

                    </div>


                    <div>

                        <span>
                            Assigned Room
                        </span>


                        <strong>

                            @(resident.RoomNumber != null
                                ? $"Room {resident.RoomNumber}"
                                : "Not assigned")

                        </strong>

                    </div>

                </div>

            </div>


            <!-- STATUS -->

            <div class="col-12 col-sm-6 col-lg-3">

                <div class="sc-resident-stat-card">

                    <div class="sc-resident-stat-icon sc-stat-dark">

                        <i class="bi bi-person-check"></i>

                    </div>


                    <div>

                        <span>
                            Status
                        </span>


                        <strong class="sc-resident-active">

                            Active

                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             INFORMATION CARDS
        ======================================================== -->

        <div class="row g-4">


            <!-- ====================================================
                 PERSONAL INFORMATION
            ==================================================== -->

            <div class="col-12 col-lg-7">

                <div class="sc-resident-info-card">

                    <div class="sc-resident-card-heading">

                        <div class="sc-resident-heading-icon">

                            <i class="bi bi-person-lines-fill"></i>

                        </div>


                        <div>

                            <h4>
                                Personal Information
                            </h4>

                            <p>
                                Contact and personal details for this resident.
                            </p>

                        </div>

                    </div>


                    <div class="sc-resident-info-list">


                        <!-- EMAIL -->

                        <div class="sc-resident-info-item">

                            <div class="sc-resident-info-icon">

                                <i class="bi bi-envelope"></i>

                            </div>


                            <div>

                                <span>
                                    Email Address
                                </span>


                                <strong>

                                    @(string.IsNullOrWhiteSpace(resident.Email)
                                        ? "Not provided"
                                        : resident.Email)

                                </strong>

                            </div>

                        </div>


                        <div class="sc-resident-divider"></div>


                        <!-- PHONE -->

                        <div class="sc-resident-info-item">

                            <div class="sc-resident-info-icon">

                                <i class="bi bi-telephone"></i>

                            </div>


                            <div>

                                <span>
                                    Phone Number
                                </span>


                                <strong>

                                    @(string.IsNullOrWhiteSpace(resident.PhoneNumber)
                                        ? "Not provided"
                                        : resident.PhoneNumber)

                                </strong>

                            </div>

                        </div>


                        <div class="sc-resident-divider"></div>


                        <!-- DATE OF BIRTH -->

                        <div class="sc-resident-info-item">

                            <div class="sc-resident-info-icon">

                                <i class="bi bi-calendar-event"></i>

                            </div>


                            <div>

                                <span>
                                    Date of Birth
                                </span>


                                <strong>

                                    @(resident.DateOfBirth == default
                                        ? "Not provided"
                                        : resident.DateOfBirth.ToString("dd MMMM yyyy"))

                                </strong>

                            </div>

                        </div>


                        <div class="sc-resident-divider"></div>


                        <!-- AGE -->

                        <div class="sc-resident-info-item">

                            <div class="sc-resident-info-icon">

                                <i class="bi bi-person"></i>

                            </div>


                            <div>

                                <span>
                                    Age
                                </span>


                                <strong>

                                    @(resident.DateOfBirth == default
                                        ? "Not provided"
                                        : $"{age} years old")

                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ====================================================
                 ACCOMMODATION
            ==================================================== -->

            <div class="col-12 col-lg-5">

                <div class="sc-resident-info-card sc-resident-accommodation-card">

                    <div class="sc-resident-card-heading">

                        <div class="sc-resident-heading-icon sc-accommodation-icon">

                            <i class="bi bi-house-heart"></i>

                        </div>


                        <div>

                            <h4>
                                Accommodation
                            </h4>

                            <p>
                                Current room assignment.
                            </p>

                        </div>

                    </div>


                    <div class="sc-resident-room-display">

                        <div class="sc-resident-room-icon">

                            <i class="bi bi-door-open-fill"></i>

                        </div>


                        <div>

                            <span>
                                Assigned Room
                            </span>


                            <strong>

                                @(resident.RoomNumber != null
                                    ? resident.RoomNumber.ToString()
                                    : "Not Assigned")

                            </strong>

                        </div>

                    </div>


                    @if (resident.RoomNumber != null)
                    {
                        <div class="sc-resident-room-status">

                            <i class="bi bi-check-circle-fill"></i>

                            Currently assigned to accommodation

                        </div>
                    }
                    else
                    {
                        <div class="sc-resident-room-status sc-room-unassigned">

                            <i class="bi bi-exclamation-circle-fill"></i>

                            No accommodation assigned

                        </div>
                    }

                </div>

            </div>


            <!-- ====================================================
                 ASSIGNED EQUIPMENT
            ==================================================== -->

            <div class="col-12">

                <div class="sc-resident-info-card sc-resident-equipment-card">


                    <!-- HEADER -->

                    <div class="sc-resident-equipment-header">

                        <div class="sc-resident-card-heading">

                            <div class="sc-resident-heading-icon sc-equipment-icon">

                                <i class="bi bi-box-seam"></i>

                            </div>


                            <div>

                                <span class="sc-equipment-eyebrow">

                                    RESIDENT EQUIPMENT

                                </span>


                                <h4>

                                    Assigned Equipment

                                </h4>


                                <p>

                                    Equipment currently assigned
                                    to this resident.

                                </p>

                            </div>

                        </div>


                        <!-- COUNT -->

                        <div class="sc-equipment-count">

                            <i class="bi bi-boxes"></i>

                            <span>

                                @(Model.AssignedEquipment?.Count ?? 0)

                            </span>

                            <small>

                                Assigned

                            </small>

                        </div>

                    </div>


                    <!-- ====================================================
                         EQUIPMENT LIST
                    ==================================================== -->
                    @if (Model.AssignedEquipment != null &&
                                             Model.AssignedEquipment.Any())
                    {

                        <div class="sc-assigned-equipment-list">


                            @foreach (var equipment in Model.AssignedEquipment)
                            {

                                var equipmentImage =
                                    string.IsNullOrWhiteSpace(
                                        equipment.ImageUrl
                                    )
                                    ? Url.Content(
                                        "~/Images/default_equipment.png"
                                    )
                                    : Url.Content(
                                        "~/" +
                                        equipment.ImageUrl.TrimStart('/')
                                    );


                                <div class="sc-assigned-equipment-item">


                                    <!-- IMAGE -->

                                    <div class="sc-assigned-equipment-image-wrapper">

                                        <img src="@equipmentImage"
                                             alt="@equipment.EquipmentName"
                                             class="sc-assigned-equipment-image"
                                             onerror="this.src='@Url.Content("~/Images/default_equipment.png")'" />

                                    </div>


                                    <!-- DETAILS -->

                                    <div class="sc-assigned-equipment-main">


                                        <div class="sc-equipment-name-row">

                                            <div>

                                                <span class="sc-equipment-item-label">

                                                    MEDICAL EQUIPMENT

                                                </span>


                                                <h5>

                                                    @equipment.EquipmentName

                                                </h5>

                                            </div>


                                            <!-- STATUS -->

                                            <span class="sc-equipment-status
                                                @(equipment.Status == EquipmentStatus.InUse
                                                                                                      ? "sc-status-inuse"
                                                                                                      : equipment.Status == EquipmentStatus.Available
                                                                                                          ? "sc-status-available"
                                                                                                          : equipment.Status == EquipmentStatus.UnderMaintenance
                                                                                                              ? "sc-status-maintenance"
                                                                                                              : "sc-status-retired")">

                                                <i class="bi bi-circle-fill"></i>

                                                @equipment.Status

                                            </span>

                                        </div>


                                        <!-- DESCRIPTION -->
                                        @if (!string.IsNullOrWhiteSpace(
                                                                                    equipment.Description))
                                        {

                                            <p class="sc-assigned-equipment-description">

                                                @equipment.Description

                                            </p>

                                        }


                                        <!-- META -->

                                        <div class="sc-assigned-equipment-meta">


                                            <!-- BARCODE -->

                                            <div class="sc-assigned-equipment-meta-item">

                                                <div class="sc-equipment-meta-icon">

                                                    <i class="bi bi-upc"></i>

                                                </div>


                                                <div>

                                                    <span>
                                                        Barcode
                                                    </span>


                                                    <strong>

                                                        @(string.IsNullOrWhiteSpace(
                                                            equipment.BarcodeValue)
                                                            ? "Not available"
                                                            : equipment.BarcodeValue)

                                                    </strong>

                                                </div>

                                            </div>


                                            <!-- ASSIGNED DATE -->

                                            <div class="sc-assigned-equipment-meta-item">

                                                <div class="sc-equipment-meta-icon">

                                                    <i class="bi bi-calendar-check"></i>

                                                </div>


                                                <div>

                                                    <span>
                                                        Assigned On
                                                    </span>


                                                    <strong>

                                                        @(equipment.AssignedAt.HasValue
                                                            ? equipment.AssignedAt.Value
                                                                .ToString("dd MMM yyyy")
                                                            : "Not available")

                                                    </strong>

                                                </div>

                                            </div>


                                            <!-- ASSIGNED BY -->

                                            <div class="sc-assigned-equipment-meta-item">

                                                <div class="sc-equipment-meta-icon">

                                                    <i class="bi bi-person-check"></i>

                                                </div>


                                                <div>

                                                    <span>
                                                        Assigned By
                                                    </span>


                                                    <strong>

                                                        @(equipment.AssignedBy != null
                                                            ? $"{equipment.AssignedBy.FirstName} {equipment.AssignedBy.LastName}"
                                                            : "Not available")

                                                    </strong>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- ASSIGNMENT NOTES -->
                                        @if (!string.IsNullOrWhiteSpace(
                                                                                    equipment.AssignmentNotes))
                                        {

                                            <div class="sc-equipment-assignment-notes">

                                                <div class="sc-equipment-notes-icon">

                                                    <i class="bi bi-chat-left-text"></i>

                                                </div>


                                                <div>

                                                    <span>
                                                        Assignment Notes
                                                    </span>


                                                    <p>

                                                        @equipment.AssignmentNotes

                                                    </p>

                                                </div>

                                            </div>

                                        }

                                        <!-- ============================================================
     EQUIPMENT ACTIONS
============================================================ -->

                                        <div class="sc-assigned-equipment-actions">

                                            <a asp-controller="MaintenanceRequests"
                                                   asp-action="RequestMaintenance"
                                                   asp-route-equipmentId="@equipment.EquipmentId"
                                                   class="sc-request-maintenance-btn">

                                                <span class="sc-request-maintenance-btn-icon">

                                                    <i class="bi bi-tools"></i>

                                                </span>

                                                <span class="sc-request-maintenance-btn-content">

                                                    <strong>
                                                        Request Maintenance
                                                    </strong>

                                                    <small>
                                                        Report an issue or request equipment servicing
                                                    </small>

                                                </span>

                                                <i class="bi bi-arrow-right sc-request-maintenance-arrow"></i>

                                            </a>

                                        </div>

                                    </div>



                                   


                                </div>

                            }

                        </div>

                    }
                    else
                    {

                        <!-- EMPTY STATE -->

                        <div class="sc-resident-equipment-empty">

                            <div class="sc-resident-empty-icon">

                                <i class="bi bi-box"></i>

                            </div>


                            <h5>
                                No Equipment Assigned
                            </h5>


                            <p>
                                This resident currently has no medical
                                equipment assigned.
                            </p>


                            <a asp-controller="Equipment"
                                   asp-action="AssignEquipment"
                                   asp-route-residentId="@resident.Id"
                                   class="sc-empty-assign-equipment-btn">

                                <i class="bi bi-plus-circle"></i>

                                Assign Equipment

                            </a>

                        </div>

                    }

                </div>

            </div>

        </div>


        <!-- ========================================================
             ACTION CENTER
        ======================================================== -->

        <div class="sc-resident-action-section">

            <div class="sc-resident-action-heading">

                <div>

                    <h4>
                        Resident Actions
                    </h4>

                    <p>
                        Manage equipment and transport services.
                    </p>

                </div>

            </div>


            <div class="row g-4">


                <!-- ASSIGN EQUIPMENT -->

                <div class="col-12 col-md-6">

                    <a asp-controller="Equipment"
                           asp-action="AssignEquipment"
                           asp-route-residentId="@resident.Id"
                           class="sc-resident-action-btn sc-action-equipment">

                        <div class="sc-resident-action-icon">

                            <i class="bi bi-box-seam-fill"></i>

                        </div>


                        <div class="sc-resident-action-text">

                            <strong>
                                Assign Equipment
                            </strong>

                            <span>
                                Assign equipment to this resident
                            </span>

                        </div>


                        <i class="bi bi-arrow-right sc-resident-action-arrow"></i>

                    </a>

                </div>


                <!-- REQUEST TRANSPORT -->

                <div class="col-12 col-md-6">

                    <a asp-controller="TransportRequests"
                           asp-action="RequestTransport"
                           asp-route-residentId="@resident.Id"
                           class="sc-resident-action-btn sc-action-transport">

                        <div class="sc-resident-action-icon">

                            <i class="bi bi-truck"></i>

                        </div>


                        <div class="sc-resident-action-text">

                            <strong>
                                Request Transport
                            </strong>

                            <span>
                                Create a transport request
                            </span>

                        </div>


                        <i class="bi bi-arrow-right sc-resident-action-arrow"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>