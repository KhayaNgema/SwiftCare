                        Request Correction

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     COMPLETE VERIFICATION MODAL
     ============================================================= -->

<div class="modal fade"
     id="completeVerificationModal"
     tabindex="-1"
     aria-labelledby="completeVerificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content swift-modal">

            <form asp-action="CompleteVerification"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h5 class="modal-title"
                        id="completeVerificationModalLabel">

                        <i class="bi bi-shield-check me-2"></i>

                        Complete Verification

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           name="onboardingId"
