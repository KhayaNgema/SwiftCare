        /* ============================================================
           DURATION
           ============================================================ */

        function formatDuration(
            seconds
        ) {

            if (
                !seconds ||
                seconds < 1
            ) {

                return "Voice";

            }


            const rounded =
                Math.max(
                    1,
                    Math.round(seconds)
                );


            const minutes =
                Math.floor(
                    rounded / 60
                );


            const secs =
                rounded % 60;


            if (
                minutes > 0
            ) {

                return (
                    minutes +
                    ":" +
                    String(
                        secs
                    ).padStart(
                        2,
                        "0"
                    )
                );

            }


            return `${secs}s`;

        }


        /* ============================================================
           AZURE SPEECH TOKEN
           ============================================================ */

        async function getAzureSpeechToken() {

            const now =
                Date.now();


            if (
                speechTokenPromise &&
                speechTokenExpiresAt >
                now + 30000
            ) {

                return speechTokenPromise;

            }


            speechTokenPromise =
                fetch(
                    "/VolunteerInterview/SpeechToken?token=" +
                    encodeURIComponent(
                        sessionToken
                    ),
                    {

                        method:
                            "GET",

                        headers: {

                            "Accept":
                                "application/json"

                        },

                        cache:
                            "no-store"

                    }
                )
                .then(
                    async response => {

                        const data =
                            await response
                                .json()
                                .catch(
                                    () => null
                                );


                        if (
                            !response.ok ||
                            !data ||
                            !data.success ||
                            !data.token
                        ) {

                            throw new Error(
                                "Could not obtain Azure Speech token."
                            );

                        }


                        speechTokenExpiresAt =
                            Date.now() +
                            (
                                9 *
                                60 *
                                1000
                            );


                        return data;

                    }
                )
                .catch(
                    error => {

                        speechTokenPromise =
                            null;

                        speechTokenExpiresAt =
                            0;

                        throw error;

                    }
                );


            return speechTokenPromise;

        }


        /* ============================================================
           CREATE AZURE RECOGNIZER
           ============================================================ */

        async function createRecognizer() {

            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                throw new Error(
                    "Azure Speech SDK is not loaded."
                );

            }


            const speech =
                await getAzureSpeechToken();


            const speechConfig =
                SpeechSDK.SpeechConfig
                    .fromAuthorizationToken(
                        speech.token,
                        speech.region
                    );


            speechConfig.speechRecognitionLanguage =
                "en-ZA";


            try {

                speechConfig.setProperty(
                    SpeechSDK.PropertyId
                        .SpeechServiceConnection_EndSilenceTimeoutMs,
                    "1500"
                );

            }
            catch (_) {}


            const audioConfig =
                SpeechSDK.AudioConfig
                    .fromDefaultMicrophoneInput();


            return new SpeechSDK.SpeechRecognizer(
                speechConfig,
                audioConfig
            );

        }


        /* ============================================================
           CLEAR SILENCE TIMER
           ============================================================ */

        function clearSilenceTimer() {

            if (silenceTimer) {

                clearTimeout(
                    silenceTimer
                );

                silenceTimer =
                    null;

            }

        }


        /* ============================================================
           ARM SILENCE TIMER
           ============================================================ */

        function armSilenceTimer() {

            clearSilenceTimer();


            if (
                !listeningNow ||
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            silenceTimer =
                setTimeout(
                    () => {

                        if (
                            !suspiciousActivityHandled &&
                            !terminatingInterview &&
                            !interviewCompleted
                        ) {

                            finishListeningAndSubmit();

                        }

                    },
                    ANSWER_SILENCE
                );

        }


        /* ============================================================
           START LISTENING
           ============================================================ */

        async function startListening() {

            /*
             * HARD PROTECTION:
             *
             * Never start recognition while TTS is speaking.
             */
            if (
                speaking
            ) {

                console.log(
                    "[SWIFTCARE SPEECH] Listening request ignored because interviewer is still speaking."
                );

                return;

            }


            if (
                interviewCompleted ||
                submittingAnswer ||
                listeningNow ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            if (!currentQuestionId) {

                return;

            }


            answerParts =
                [];


            speechStartedAt =
                Date.now();


            recognitionStopping =
                false;


            hideThinking();


            setStatus(
                "Listening..."
            );


            try {

                const stream =
                    await navigator.mediaDevices
                        .getUserMedia({

                            audio: {

                                echoCancellation:
                                    true,

                                noiseSuppression:
                                    true,

                                autoGainControl:
                                    true

                            }

                        });


                stream
                    .getTracks()
                    .forEach(
                        track =>
                            track.stop()
                    );


                if (
                    suspiciousActivityHandled ||
                    terminatingInterview ||
                    interviewCompleted ||
                    speaking
                ) {

                    return;

                }


                speechRecognizer =
                    await createRecognizer();


                /*
                 * Another TTS protection check after token/recognizer
                 * creation.
                 */
                if (
                    speaking ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    try {

                        speechRecognizer.close();

                    }
                    catch (_) {}

                    speechRecognizer =
                        null;

                    return;

                }


                speechRecognizer.recognizing =
                    (sender, event) => {

                        if (
                            suspiciousActivityHandled ||
                            terminatingInterview ||
                            interviewCompleted
                        ) {

                            return;

                        }


                        const text =
                            event?.result?.text ||
                            "";


                        if (
                            text.trim().length >
                            MINIMUM_ANSWER_LENGTH
                        ) {

                            clearSilenceTimer();

                        }

                    };


                speechRecognizer.recognized =
                    (sender, event) => {

                        if (
                            suspiciousActivityHandled ||
                            terminatingInterview ||
                            interviewCompleted
                        ) {

                            return;

                        }


                        if (
                            !event ||
                            !event.result
                        ) {

                            return;

                        }


                        if (
                            event.result.reason !==
                            SpeechSDK.ResultReason
                                .RecognizedSpeech
                        ) {

                            return;

                        }


                        const text =
                            (
                                event.result.text ||
                                ""
                            ).trim();


                        if (!text) {

                            return;

                        }


                        answerParts.push(
                            text
                        );


                        armSilenceTimer();

                    };


                speechRecognizer.canceled =
                    () => {

                        if (
                            submittingAnswer ||
                            interviewCompleted ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return;

                        }


                        listeningNow =
                            false;


                        hideListening();


                        try {

                            speechRecognizer.close();

                        }
                        catch (_) {}


                        speechRecognizer =
                            null;


                        setStatus(
                            "Reconnecting microphone..."
                        );


                        setTimeout(
                            () => {

                                if (
                                    !interviewCompleted &&
                                    !speaking &&
                                    !submittingAnswer &&
                                    !suspiciousActivityHandled &&
                                    !terminatingInterview
                                ) {

                                    startListening()
                                        .catch(
                                            () => {}
                                        );

                                }

                            },
                            900
                        );

                    };


                speechRecognizer.sessionStopped =
                    () => {

                        if (
                            submittingAnswer ||
                            interviewCompleted ||
                            suspiciousActivityHandled ||
                            terminatingInterview
                        ) {

                            return;

                        }


                        listeningNow =
                            false;


                        hideListening();


                        if (
                            answerParts.length > 0
                        ) {

                            submitCollectedAnswer();

                        }

                    };


                speechRecognizer.sessionStarted =
                    () => {

                        if (
                            suspiciousActivityHandled ||
                            terminatingInterview ||
                            interviewCompleted ||
                            speaking
                        ) {

                            return;

                        }


                        console.log(
                            "[SWIFTCARE SPEECH] Recognition started."
                        );

                    };


                await new Promise(
                    (
                        resolve,
                        reject
                    ) => {

                        speechRecognizer
                            .startContinuousRecognitionAsync(

                                () => {

                                    if (
                                        suspiciousActivityHandled ||
                                        terminatingInterview ||
                                        interviewCompleted ||
                                        speaking
                                    ) {

                                        resolve();

                                        return;

                                    }


                                    listeningNow =
                                        true;


                                    showListening();


                                    setStatus(
                                        "Listening..."
                                    );


                                    resolve();

                                },

                                error => {

                                    reject(
                                        error
                                    );

                                }

                            );

                    }
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE SPEECH] Start listening error:",
                    error
                );


                listeningNow =
                    false;


                hideListening();


                if (
                    speechRecognizer
                ) {

                    try {

                        speechRecognizer.close();

                    }
                    catch (_) {}


                    speechRecognizer =
                        null;

                }


                if (
                    suspiciousActivityHandled ||
                    terminatingInterview ||
                    interviewCompleted
                ) {

                    return;

                }


                setStatus(
                    "Microphone unavailable",
                    true
                );


                setTimeout(
                    () => {

                        if (
                            !interviewCompleted &&
                            !speaking &&
                            !submittingAnswer &&
                            !suspiciousActivityHandled &&
                            !terminatingInterview
                        ) {

                            startListening()
                                .catch(
                                    () => {}
                                );

                        }

                    },
                    1800
                );

            }

        }


        /* ============================================================
           STOP RECOGNITION
           ============================================================ */

        async function stopRecognition() {

            clearSilenceTimer();


            if (!speechRecognizer) {

                listeningNow =
                    false;

                hideListening();

                return;

            }


            const recognizer =
                speechRecognizer;


            speechRecognizer =
                null;


            listeningNow =
                false;


            recognitionStopping =
                true;


            hideListening();


            try {

                await new Promise(
                    resolve => {

                        recognizer
                            .stopContinuousRecognitionAsync(
                                () =>
                                    resolve(),

                                () =>
                                    resolve()
                            );

                    }
                );

            }
            catch (_) {}


            try {

                recognizer.close();

            }
            catch (_) {}


            recognitionStopping =
                false;

        }


        /* ============================================================
           FINISH LISTENING
           ============================================================ */

        async function finishListeningAndSubmit() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            if (
                answerParts.length === 0
            ) {

                armSilenceTimer();

                return;

            }


            await submitCollectedAnswer();

        }


        /* ============================================================
           HANDLE SERVER-SIDE SUSPICIOUS ERROR
           ============================================================ */

        async function handleServerSuspiciousState(
            message
        ) {

            if (
                suspiciousActivityHandled ||
                interviewCompleted
            ) {

                return;

            }


            suspiciousActivityHandled =
                true;


            interviewCompleted =
                true;


            cancelActiveSpeech();


            clearSilenceTimer();


            setTextResponseEnabled(
                false
            );


            await stopRecognition();


            hideListening();

            hideThinking();


            speaking =
                false;


            if (suspiciousOverlay) {

                suspiciousOverlay.classList.add(
                    "scv-visible"
                );

            }


            if (suspiciousStatus) {

                suspiciousStatus.textContent =
                    message ||
                    "This interview has already been submitted for administrative review.";

            }


            setStatus(
                "Interview ended",
                true
            );


            stopCameraTracks();

        }


        /* ============================================================
           SUBMIT VOICE ANSWER
           ============================================================ */

        async function submitCollectedAnswer() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            const answer =
                answerParts
                    .join(" ")
                    .trim();


            if (
                answer.length <
                MINIMUM_ANSWER_LENGTH
            ) {

                armSilenceTimer();

                return;

            }


            submittingAnswer =
                true;


            clearSilenceTimer();


            const duration =
                speechStartedAt
                    ? (
                        Date.now() -
                        speechStartedAt
                    ) / 1000
                    : 0;


            await stopRecognition();


            if (
                suspiciousActivityHandled ||
                terminatingInterview ||
                interviewCompleted
            ) {

                submittingAnswer =
                    false;

                return;

            }


            addApplicantVoiceBubble(
                duration
            );


            answerParts =
                [];


            setStatus(
                "Interviewer is thinking..."
            );


            showThinking();


            try {

                if (!connection) {

                    throw new Error(
                        "Interview connection is unavailable."
                    );

                }


                await connection.invoke(
                    "SubmitAnswer",
                    sessionToken,
                    answer
                );


            }
            catch (error) {

                console.error(
                    "[SWIFTCARE INTERVIEW] SubmitAnswer failed:",
                    error
                );


                const errorText =
                    error?.message ||
                    String(error);


                if (
                    errorText
                        .toLowerCase()
                        .includes(
                            "administrative review"
                        )
                    ||
                    errorText
                        .toLowerCase()
                        .includes(
                            "ended and submitted"
                        )
                ) {

                    await handleServerSuspiciousState(
                        "This interview has already been submitted for administrative review."
                    );

                    return;

                }


                submittingAnswer =
                    false;


                hideThinking();


                setStatus(
                    "Could not submit answer",
                    true
                );


                answerParts =
                    [];


                setTimeout(
                    () => {

                        if (
                            !interviewCompleted &&
                            !speaking &&
                            !submittingAnswer &&
                            !suspiciousActivityHandled &&
                            !terminatingInterview
                        ) {

                            startListening()
                                .catch(
                                    () => {}
                                );

                        }

                    },
                    1000
                );

            }

        }


        /* ============================================================
           SUBMIT TEXT ANSWER
           ============================================================ */

        async function submitTextAnswer() {

            if (
                submittingAnswer ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            if (!currentQuestionId) {

                setStatus(
                    "Please wait for the interview question.",
                    true
                );


                focusTextResponse();


                return;

            }


            const answer =
                (
                    textResponse
                        ? textResponse.value
                        : ""
                ).trim();


            if (
                answer.length <
                MINIMUM_ANSWER_LENGTH
            ) {

                setStatus(
                    "Please enter an answer before sending.",
                    true
                );


                focusTextResponse();


                return;

            }


            if (
                answer.length >
                MAX_TEXT_RESPONSE_LENGTH
            ) {

                setStatus(
                    "Your answer is too long.",
                    true
                );


                focusTextResponse();


                return;

            }


            submittingAnswer =
                true;


            clearSilenceTimer();


            await stopRecognition();


            if (
                suspiciousActivityHandled ||
                terminatingInterview ||
                interviewCompleted
            ) {

                submittingAnswer =
                    false;

                return;

            }


            addApplicantTextBubble(
                answer
            );


            clearTextResponse();


            setStatus(
                "Interviewer is thinking..."
            );


            showThinking();


            setTextResponseEnabled(
                false
            );


            try {

                if (!connection) {

                    throw new Error(
                        "Interview connection is unavailable."
                    );

                }


                await connection.invoke(
                    "SubmitAnswer",
                    sessionToken,
                    answer
                );


            }
            catch (error) {

                console.error(
                    "[SWIFTCARE INTERVIEW] Text SubmitAnswer failed:",
                    error
                );


                const errorText =
                    error?.message ||
                    String(error);


                if (
                    errorText
                        .toLowerCase()
                        .includes(
                            "administrative review"
                        )
                    ||
                    errorText
                        .toLowerCase()
                        .includes(
                            "ended and submitted"
                        )
                ) {

                    await handleServerSuspiciousState(
                        "This interview has already been submitted for administrative review."
                    );

                    return;

                }


                submittingAnswer =
                    false;


                hideThinking();


                setTextResponseEnabled(
                    true
                );


                setStatus(
                    "Could not submit your answer. Please try again.",
                    true
                );


                focusTextResponse();

            }

        }


        /* ============================================================
           TEXT RESPONSE EVENTS
           ============================================================ */

        if (textResponse) {

            textResponse.addEventListener(
                "input",
                () => {

                    if (
                        textResponse.value.length >
                        MAX_TEXT_RESPONSE_LENGTH
                    ) {

                        textResponse.value =
                            textResponse.value.substring(
                                0,
                                MAX_TEXT_RESPONSE_LENGTH
                            );

                    }


                    updateTextResponseCount();

                }
            );


            textResponse.addEventListener(
                "keydown",
                event => {

                    if (
                        event.key === "Enter" &&
                        (
                            event.ctrlKey ||
                            event.metaKey
                        )
                    ) {

                        event.preventDefault();

                        submitTextAnswer();

                    }

                }
            );

        }


        if (sendTextResponse) {

            sendTextResponse.addEventListener(
                "click",
                () => {

                    submitTextAnswer();

                }
            );

        }


        updateTextResponseCount();


        /* ============================================================
           XML ESCAPING
           ============================================================ */

        function escapeXml(
            value
        ) {

            return String(value)
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&apos;"
                );

        }


        /* ============================================================
           BUILD GREETING SSML
           
           IMPORTANT:
           
           The applicant's actual name is preserved exactly.
           
           Example:
           
               Khayalethu Xoliswa Ngema
           
           becomes:
           
               Leah: "Hello"
               Thando: "Khayalethu Xoliswa Ngema"
               Leah: "Welcome..."
           
           This lets Azure use the isiZulu voice for the name
           instead of forcing the English voice to guess the
           pronunciation.
           ============================================================ */

        function buildGreetingSsml(
            applicantName
        ) {

            const safeName =
                escapeXml(
                    applicantName ||
                    "Applicant"
                );


            const beforeName =
                escapeXml(
                    "Hello"
                );


            const afterName =
                escapeXml(
                    ". Welcome to your SwiftCare volunteer interview. " +
                    "I will ask you a few questions. " +
                    "Please answer naturally and honestly. " +
                    "Please take your time to think carefully before you respond " +
                    "because you cannot edit an answer once provided. " +
                    "You can answer using your voice, or you can type your response " +
                    "in the text box below."
                );


            /*
             * Azure Speech supports multiple voices in one SSML
             * document.
             *
             * The Zulu voice is used only for the applicant's name.
             */
            return `
                <speak
                    version="1.0"
                    xmlns="http://www.w3.org/2001/10/synthesis"
                    xmlns:mstts="http://www.w3.org/2001/mstts"
                    xml:lang="en-ZA">

                    <voice name="${INTERVIEWER_VOICE}">

                        <prosody
                            rate="-6%"
                            pitch="0%"
                            volume="100%">

                            ${beforeName}

                        </prosody>

                    </voice>

                    <voice name="${ZULU_NAME_VOICE}">

                        <prosody
                            rate="-4%"
                            pitch="0%"
                            volume="100%">

                            ${safeName}

                        </prosody>

                    </voice>

                    <voice name="${INTERVIEWER_VOICE}">

                        <prosody
                            rate="-6%"
                            pitch="0%"
                            volume="100%">

                            ${afterName}

                        </prosody>

                    </voice>

                </speak>
            `;

        }


        /* ============================================================
           BUILD NORMAL QUESTION SSML
           ============================================================ */

        function buildQuestionSsml(
            text
        ) {

            const escapedText =
                escapeXml(text);


            return `
                <speak
                    version="1.0"
                    xmlns="http://www.w3.org/2001/10/synthesis"
                    xmlns:mstts="http://www.w3.org/2001/mstts"
                    xml:lang="en-ZA">

                    <voice name="${INTERVIEWER_VOICE}">

                        <prosody
                            rate="-6%"
                            pitch="0%"
                            volume="100%">

                            ${escapedText}

                        </prosody>

                    </voice>

                </speak>
            `;

        }


        /* ============================================================
           BUILD NORMAL TEXT SSML
           ============================================================ */

        function buildTextSsml(
            text
        ) {

            return buildQuestionSsml(
                text
            );

        }


        /* ============================================================
           BROWSER TTS FALLBACK
           ============================================================ */

        function speakTextBrowserFallback(
            text
        ) {

            return new Promise(
                resolve => {

                    try {

                        window.speechSynthesis.cancel();

                    }
                    catch (_) {}


                    const utterance =
                        new SpeechSynthesisUtterance(
                            text
                        );


                    utterance.lang =
                        "en-ZA";


                    utterance.rate =
                        0.94;


                    utterance.pitch =
                        1.0;


                    utterance.volume =
                        1.0;


                    const voices =
                        window.speechSynthesis
                            .getVoices();


                    const preferredVoice =
                        voices.find(
                            voice =>
                                voice.lang &&
                                voice.lang
                                    .toLowerCase()
                                    .startsWith(
                                        "en-za"
                                    )
                        )
                        ||
                        voices.find(
                            voice =>
                                voice.lang &&
                                voice.lang
                                    .toLowerCase()
                                    .startsWith(
                                        "en"
                                    )
                        );


                    if (preferredVoice) {

                        utterance.voice =
                            preferredVoice;

                    }


                    utterance.onend =
                        () => {

                            resolve();

                        };


                    utterance.onerror =
                        () => {

                            resolve();

                        };


                    window.speechSynthesis.speak(
                        utterance
                    );

                }
            );

        }


        /* ============================================================
           ACTUAL AZURE SPEECH IMPLEMENTATION

           IMPORTANT:
           This function is NOT called directly by speakText().

           speakText() places it into the queue.
           ============================================================ */

        async function speakTextNow(
            text,
            createBubble = true,
            speechType = "normal"
        ) {

            if (
                !text ||
                !text.trim()
            ) {

                return;

            }


            const myGeneration =
                speechGeneration;


            speaking =
                true;


            clearSilenceTimer();

            hideListening();

            hideThinking();


            setStatus(
                "Interviewer is speaking..."
            );


            if (createBubble) {

                currentVoiceBubble =
                    addBotVoiceBubble(
                        text
                    );

            }


            if (currentVoiceBubble) {

                currentWave =
                    currentVoiceBubble.wave;

            }
            else {

                currentWave =
                    null;

            }


            if (currentWave) {

                currentWave.classList.add(
                    "scv-speaking"
                );

            }


            let synthesizer =
                null;


            try {

                const speechData =
                    await getAzureSpeechToken();


                if (
                    myGeneration !==
                    speechGeneration
                ) {

                    return;

                }


                console.log(
                    "[SWIFTCARE TTS] SPEAKING ENGINE: AZURE SPEECH"
                );


                console.log(
                    "[SWIFTCARE TTS] Azure region:",
                    speechData.region
                );


                if (
                    !speechData ||
                    !speechData.token ||
                    !speechData.region
                ) {

                    throw new Error(
                        "Azure Speech token information is unavailable."
                    );

                }


                const speechConfig =
                    SpeechSDK.SpeechConfig
                        .fromAuthorizationToken(
                            speechData.token,
                            speechData.region
                        );


                speechConfig.speechSynthesisVoiceName =
                    INTERVIEWER_VOICE;


                synthesizer =
                    new SpeechSDK.SpeechSynthesizer(
                        speechConfig
                    );


                activeSpeechSynthesizer =
                    synthesizer;


                let ssml;


                /*
                 * Greeting gets the special multilingual SSML.
                 */
                if (
                    speechType === "greeting"
                ) {

                    ssml =
                        buildGreetingSsml(
                            currentApplicantName
                        );

                }
                else {

                    ssml =
                        buildTextSsml(
                            text
                        );

                }


                console.log(
                    "[SWIFTCARE TTS] Using Azure voice:",
                    INTERVIEWER_VOICE
                );


                if (
                    speechType === "greeting"
                ) {

                    console.log(
                        "[SWIFTCARE TTS] Using isiZulu voice for applicant name:",
                        ZULU_NAME_VOICE
                    );

                }


                console.log(
                    "[SWIFTCARE TTS] Sending SSML to Azure..."
                );


                await new Promise(
                    (
                        resolve,
                        reject
                    ) => {

                        synthesizer.speakSsmlAsync(

                            ssml,

                            result => {

                                try {

                                    if (
                                        result.reason ===
                                        SpeechSDK.ResultReason
                                            .SynthesizingAudioCompleted
                                    ) {

                                        resolve();

                                    }
                                    else {

                                        console.error(
                                            "[SWIFTCARE SPEECH] Azure TTS failed:",
                                            result.errorDetails
                                        );


                                        reject(
                                            new Error(
                                                result.errorDetails ||
                                                "Azure Speech synthesis failed."
                                            )
                                        );

                                    }

                                }
                                finally {

                                    try {

                                        result.close();

                                    }
                                    catch (_) {}

                                }

                            },

                            error => {

                                console.error(
                                    "[SWIFTCARE SPEECH] Azure TTS error:",
                                    error
                                );


                                reject(
                                    error instanceof Error
                                        ? error
                                        : new Error(
                                            String(error)
                                        )
                                );

                            }

                        );

                    }
                );


                /*
                 * If another event cancelled this speech while Azure
                 * was talking, do not continue to listening.
                 */
                if (
                    myGeneration !==
                    speechGeneration
                ) {

                    return;

                }


                console.log(
                    "[SWIFTCARE TTS] Azure speech completed."
                );


            }
            catch (error) {

                console.error(
                    "[SWIFTCARE SPEECH] Azure TTS failed:",
                    error
                );


                /*
                 * If speech was intentionally cancelled, do not
                 * trigger browser fallback.
                 */
                if (
                    myGeneration !==
                    speechGeneration
                ) {

                    return;

                }


                /*
                 * Browser fallback.
                 *
                 * This is only used when Azure itself fails.
                 */
                try {

                    await speakTextBrowserFallback(
                        text
                    );

                }
                catch (fallbackError) {

                    console.error(
                        "[SWIFTCARE SPEECH] Browser TTS fallback failed:",
                        fallbackError
                    );

                }

            }
            finally {

                if (
                    activeSpeechSynthesizer ===
                    synthesizer
                ) {

                    activeSpeechSynthesizer =
                        null;

                }


                if (synthesizer) {

                    try {

                        synthesizer.close();

                    }
                    catch (_) {}

                }


                speaking =
                    false;


                if (currentWave) {

                    currentWave.classList.remove(
                        "scv-speaking"
                    );

                }

            }

        }
            // ============================================================
    // BUILD AZURE SSML
    // ============================================================

    function buildSpeechSsml(text, speechOptions = {}) {

        const safeText = escapeXml(text);

        const applicantName =
            (
                speechOptions.pronunciationName ||
                ""
            ).trim();

        const useZuluNameVoice =
            speechOptions.useZuluNameVoice &&
            applicantName &&
            text.includes(applicantName);

        // ============================================================
        // NORMAL EN-ZA SPEECH
        // ============================================================

        if (!useZuluNameVoice) {

            return `
                <speak
                    version="1.0"
                    xmlns="http://www.w3.org/2001/10/synthesis"
                    xmlns:mstts="http://www.w3.org/2001/mstts"
                    xml:lang="en-ZA">

                    <voice name="en-ZA-LeahNeural">

                        <prosody
                            rate="-6%"
                            pitch="0%"
                            volume="100%">

                            ${safeText}

                        </prosody>

                    </voice>

                </speak>
            `;
        }

        // ============================================================
        // GREETING WITH ZULU NAME PRONUNCIATION
        // ============================================================

        const nameIndex =
            text.indexOf(applicantName);

        if (nameIndex < 0) {

            return `
                <speak
                    version="1.0"
                    xmlns="http://www.w3.org/2001/10/synthesis"
                    xml:lang="en-ZA">

                    <voice name="en-ZA-LeahNeural">
                        <prosody rate="-6%">
                            ${safeText}
                        </prosody>
                    </voice>

                </speak>
            `;
        }

        const before =
            text.substring(
                0,
                nameIndex
            );

        const after =
            text.substring(
                nameIndex + applicantName.length
            );

        return `
            <speak
                version="1.0"
                xmlns="http://www.w3.org/2001/10/synthesis"
                xmlns:mstts="http://www.w3.org/2001/mstts"
                xml:lang="en-ZA">

                ${
                    before
                        ? `
                        <voice name="en-ZA-LeahNeural">
                            <prosody
                                rate="-6%"
                                pitch="0%"
                                volume="100%">
                                ${escapeXml(before)}
                            </prosody>
                        </voice>
                        `
                        : ""
                }

                <voice name="zu-ZA-ThandoNeural">
                    <prosody
                        rate="-4%"
                        pitch="0%"
                        volume="100%">
                        ${escapeXml(applicantName)}
                    </prosody>
                </voice>

                ${
                    after
                        ? `
                        <voice name="en-ZA-LeahNeural">
                            <prosody
                                rate="-6%"
                                pitch="0%"
                                volume="100%">
                                ${escapeXml(after)}
                            </prosody>
                        </voice>
                        `
                        : ""
                }

            </speak>
        `;
    }

        /* ============================================================
           QUEUED SPEECH

           THIS IS THE MAIN OVERLAP FIX.

           If greeting is speaking and SignalR sends BotQuestion:

               speakText(greeting)
                     ↓
               speechQueue
                     ↓
               speakText(question)

           The question waits until the greeting has completely
           finished.
           ============================================================ */
    // ============================================================
    // SWIFTCARE SPEECH ENGINE
    // ONE SPEECH AT A TIME
    // ============================================================

    let activeSpeechSynthesizer = null;
    let speechSequence = 0;
    let speechLock = Promise.resolve();

    async function speakText(text, createBubble = true, speechOptions = {}) {

        if (!text || !text.trim()) {
            return;
        }

        const mySpeechId = ++speechSequence;

        console.log(
            `[SWIFTCARE TTS ${mySpeechId}] REQUESTED:`,
            text
        );

        // ============================================================
        // DO NOT ALLOW NORMAL SPEECH AFTER TERMINATION
        // ============================================================

        if (
            interviewCompleted &&
            !speechOptions.allowAfterInterviewCompletion
        ) {
            console.log(
                `[SWIFTCARE TTS ${mySpeechId}] BLOCKED - interview completed.`
            );

            return;
        }

        if (
            suspiciousActivityHandled ||
            terminatingInterview
        ) {
            console.log(
                `[SWIFTCARE TTS ${mySpeechId}] BLOCKED - interview terminating.`
            );

            return;
        }

        // ============================================================
        // HARD SERIALIZATION
        // ============================================================

        const runSpeech = speechLock.then(async () => {

            if (
                interviewCompleted &&
                !speechOptions.allowAfterInterviewCompletion
            ) {
                return;
            }

            if (
                suspiciousActivityHandled ||
                terminatingInterview
            ) {
                return;
            }

            console.log(
                `[SWIFTCARE TTS ${mySpeechId}] ACQUIRED SPEECH LOCK`
            );

            speaking = true;

            clearSilenceTimer();
            hideListening();
            hideThinking();

            setStatus("Interviewer is speaking...");

            if (createBubble) {
                currentVoiceBubble = addBotVoiceBubble(text);
            }

            if (currentVoiceBubble) {
                currentWave = currentVoiceBubble.wave;
            } else {
                currentWave = null;
            }

            if (currentWave) {
                currentWave.classList.add("scv-speaking");
            }

            let synthesizer = null;

            try {

                // ====================================================
                // MAKE ABSOLUTELY SURE BROWSER SPEECH IS NOT PLAYING
                // ====================================================

                try {
                    window.speechSynthesis.cancel();
                } catch (_) {}

                // ====================================================
                // GET AZURE TOKEN
                // ====================================================

                const speechData = await getAzureSpeechToken();

                if (
                    !speechData ||
                    !speechData.token ||
                    !speechData.region
                ) {
                    throw new Error(
                        "Azure Speech token information is unavailable."
                    );
                }

                console.log(
                    `[SWIFTCARE TTS ${mySpeechId}] Azure region:`,
                    speechData.region
                );

                // ====================================================
                // CREATE SPEECH CONFIG
                // ====================================================

                const speechConfig =
                    SpeechSDK.SpeechConfig.fromAuthorizationToken(
                        speechData.token,
                        speechData.region
                    );

                speechConfig.speechSynthesisVoiceName =
                    "en-ZA-LeahNeural";

                // ====================================================
                // CREATE ONLY ONE ACTIVE SYNTHESIZER
                // ====================================================

                synthesizer =
                    new SpeechSDK.SpeechSynthesizer(
                        speechConfig
                    );

                activeSpeechSynthesizer = synthesizer;

                console.log(
                    `[SWIFTCARE TTS ${mySpeechId}] Synthesizer created.`
                );

                // ====================================================
                // BUILD SSML
                // ====================================================

                const ssml =
                    buildSpeechSsml(
                        text,
                        speechOptions
                    );

                console.log(
                    `[SWIFTCARE TTS ${mySpeechId}] Sending SSML...`
                );

                // ====================================================
                // WAIT UNTIL AZURE HAS COMPLETELY FINISHED
                // ====================================================

                await new Promise((resolve, reject) => {

                    synthesizer.speakSsmlAsync(

                        ssml,

                        result => {

                            try {

                                if (
                                    result.reason ===
                                    SpeechSDK.ResultReason
                                        .SynthesizingAudioCompleted
                                ) {

                                    console.log(
                                        `[SWIFTCARE TTS ${mySpeechId}] ` +
                                        `AZURE AUDIO COMPLETELY FINISHED`
                                    );

                                    resolve();

                                } else {

                                    console.error(
                                        `[SWIFTCARE TTS ${mySpeechId}] ` +
                                        `Azure failed:`,
                                        result.errorDetails
                                    );

                                    reject(
                                        new Error(
                                            result.errorDetails ||
                                            "Azure Speech synthesis failed."
                                        )
                                    );
                                }

                            } finally {

                                try {
                                    result.close();
                                } catch (_) {}
                            }
                        },

                        error => {

                            console.error(
                                `[SWIFTCARE TTS ${mySpeechId}] ` +
                                `Azure error:`,
                                error
                            );

                            reject(
                                error instanceof Error
                                    ? error
                                    : new Error(String(error))
                            );
                        }
                    );
                });

                console.log(
                    `[SWIFTCARE TTS ${mySpeechId}] ` +
                    `AZURE PLAYBACK PROMISE RESOLVED`
                );

            } catch (error) {

                console.error(
                    `[SWIFTCARE TTS ${mySpeechId}] Azure TTS failed:`,
                    error
                );

                // ====================================================
                // BROWSER FALLBACK
                // ====================================================

                if (
                    !interviewCompleted &&
                    !suspiciousActivityHandled &&
                    !terminatingInterview
                ) {

                    console.log(
                        `[SWIFTCARE TTS ${mySpeechId}] ` +
                        `Using browser fallback.`
                    );

                    await speakTextBrowserFallback(text);
                }

            } finally {

                // ====================================================
                // CLOSE AZURE SYNTHESIZER
                // ====================================================

                if (synthesizer) {

                    try {
                        synthesizer.close();
                    } catch (_) {}

                }

                if (
                    activeSpeechSynthesizer ===
                    synthesizer
                ) {
                    activeSpeechSynthesizer = null;
                }

                speaking = false;

                if (currentWave) {
                    currentWave.classList.remove(
                        "scv-speaking"
                    );
                }

                console.log(
                    `[SWIFTCARE TTS ${mySpeechId}] ` +
                    `SPEECH ENGINE RELEASED`
                );
            }
        });

        // ============================================================
        // IMPORTANT:
        // NEVER LET A FAILED SPEECH BREAK THE QUEUE
        // ============================================================

        speechLock =
            runSpeech.catch(error => {

                console.error(
                    `[SWIFTCARE TTS ${mySpeechId}] ` +
                    `Speech lock error:`,
                    error
                );

            });

        await runSpeech;
    }

        /* ============================================================
           INTERVIEW STATE
           ============================================================ */

         async function handleInterviewState(state) {

        if (
            !state ||
            interviewCompleted ||
            suspiciousActivityHandled ||
            terminatingInterview
        ) {
            return;
        }

        currentApplicantName =
            (
                state.applicantName ||
                state.ApplicantName ||
                "Applicant"
            ).trim();

        currentQuestionNumber =
            Number(
                state.currentQuestionNumber ??
                state.CurrentQuestionNumber ??
                0
            );

        totalQuestions =
            Number(
                state.totalQuestions ??
                state.TotalQuestions ??
                0
            );

        currentQuestionId =
            state.currentQuestionId ??
            state.CurrentQuestionId ??
            null;

        currentQuestionText =
            state.currentQuestion ||
            state.CurrentQuestion ||
            "";

        // ============================================================
        // IF GREETING HAS ALREADY FINISHED
        // ============================================================

        if (greetingFinished) {

            if (currentQuestionText) {

                console.log(
                    "[SWIFTCARE] InterviewState question received after greeting."
                );

                await handleQuestion({
                    questionId: currentQuestionId,
                    questionNumber: currentQuestionNumber,
                    totalQuestions: totalQuestions,
                    question: currentQuestionText
                }, false);
            }

            return;
        }

        // ============================================================
        // GREETING ALREADY STARTED
        // ============================================================

        if (greetingStarted) {

            console.log(
                "[SWIFTCARE] Greeting already running. " +
                "Question will wait."
            );

            if (currentQuestionText) {

                pendingFirstQuestion = {
                    questionId: currentQuestionId,
                    questionNumber: currentQuestionNumber,
                    totalQuestions: totalQuestions,
                    question: currentQuestionText
                };
            }

            return;
        }

        // ============================================================
        // START GREETING EXACTLY ONCE
        // ============================================================

        greetingStarted = true;

        console.log(
            "[SWIFTCARE] ========================================"
        );

        console.log(
            "[SWIFTCARE] STARTING INTERVIEW GREETING"
        );

        console.log(
            "[SWIFTCARE] ========================================"
        );

        const greeting =
            `Hello ${currentApplicantName}. ` +
            `Welcome to your SwiftCare volunteer interview. ` +
            `I will ask you a few questions. ` +
            `Please answer naturally and honestly. ` +
            `Please take your time to think carefully before you respond because you cannot edit an answer once provided. ` +
            `You can answer using your voice, or you can type your response in the text box below.`;

        // ============================================================
        // CREATE ONE PROMISE FOR THE ENTIRE GREETING
        // ============================================================

        greetingPromise = (async () => {

            try {

                // Make absolutely sure nothing is currently listening.
                if (speechRecognizer) {
                    try {
                        await stopRecognition();
                    } catch (_) {}
                }

                listeningNow = false;
                hideListening();

                if (
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {
                    return;
                }

                // ====================================================
                // GREETING SPEECH
                // ====================================================

                await speakText(
                    greeting,
                    true,
                    {
                        useZuluNameVoice: true,
                        pronunciationName:
                            currentApplicantName !== "Applicant"
                                ? currentApplicantName
                                : null
                    }
                );

                if (
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {
                    return;
                }

                console.log(
                    "[SWIFTCARE] GREETING SPEECH COMPLETELY FINISHED."
                );

                // ====================================================
                // PAUSE AFTER GREETING
                // ====================================================

                await wait(1200);

                if (
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {
                    return;
                }

                // ====================================================
                // THIS IS THE ONLY PLACE WHERE THE FIRST QUESTION
                // IS RELEASED AFTER THE GREETING.
                // ====================================================

                greetingFinished = true;

                console.log(
                    "[SWIFTCARE] ========================================"
                );

                console.log(
                    "[SWIFTCARE] GREETING FINISHED."
                );

                console.log(
                    "[SWIFTCARE] FIRST QUESTION IS NOW UNLOCKED."
                );

                console.log(
                    "[SWIFTCARE] ========================================"
                );

            } catch (error) {

                console.error(
                    "[SWIFTCARE] Greeting failed:",
                    error
                );

                // Even if TTS fails, don't deadlock the interview.
                greetingFinished = true;
            }

        })();

        await greetingPromise;

        if (
            interviewCompleted ||
            suspiciousActivityHandled ||
            terminatingInterview
        ) {
            return;
        }

        // ============================================================
        // RELEASE THE QUESTION ONLY AFTER GREETING FINISHED
        // ============================================================

        if (pendingFirstQuestion) {

            const firstQuestion = pendingFirstQuestion;

            pendingFirstQuestion = null;

            console.log(
                "[SWIFTCARE] Releasing held first question."
            );

            await handleQuestion(firstQuestion, false);

            return;
        }

        // ============================================================
        // FALLBACK:
        // INTERVIEW STATE ITSELF CONTAINED THE QUESTION
        // ============================================================

        if (currentQuestionText) {

            console.log(
                "[SWIFTCARE] Starting InterviewState first question."
            );

            await handleQuestion({
                questionId: currentQuestionId,
                questionNumber: currentQuestionNumber,
                totalQuestions: totalQuestions,
                question: currentQuestionText
            }, false);
        }
    }


        /* ============================================================
           SIGNALR BOT QUESTION
           ============================================================ */

            function registerBotQuestionHandler() {

        connection.on("BotQuestion", async questionData => {

            console.log(
                "[SWIFTCARE] BotQuestion received:",
                questionData
            );

            clearSilenceTimer();

            if (speechRecognizer) {

                try {
                    await stopRecognition();
                } catch (_) {}
            }

            listeningNow = false;
            hideListening();

            submittingAnswer = false;
            answerParts = [];

            // ========================================================
            // IMPORTANT:
            // IF GREETING IS NOT FINISHED, STORE THE QUESTION.
            // DO NOT SPEAK IT.
            // ========================================================

            if (!greetingFinished) {

                console.log(
                    "[SWIFTCARE] BotQuestion arrived during greeting."
                );

                console.log(
                    "[SWIFTCARE] Holding BotQuestion until greeting finishes."
                );

                pendingFirstQuestion = {
                    questionId:
                        questionData.questionId ??
                        questionData.QuestionId ??
                        questionData.currentQuestionId ??
                        questionData.CurrentQuestionId ??
                        null,

                    questionNumber:
                        questionData.questionNumber ??
                        questionData.QuestionNumber ??
                        questionData.currentQuestionNumber ??
                        questionData.CurrentQuestionNumber ??
                        0,

                    totalQuestions:
                        questionData.totalQuestions ??
                        questionData.TotalQuestions ??
                        0,

                    question:
                        questionData.question ??
                        questionData.Question ??
                        questionData.currentQuestion ??
                        questionData.CurrentQuestion ??
                        ""
                };

                return;
            }

            // ========================================================
            // GREETING HAS FINISHED — NOW QUESTION IS ALLOWED.
            // ========================================================

            await handleQuestion(
                questionData,
                true
            );
        });
    }

        /* ============================================================
           SIGNALR INTERVIEW STATE
           ============================================================ */

        function registerInterviewStateHandler() {

            connection.on(
                "InterviewState",
                async state => {

                    await handleInterviewState(
                        state
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR APPLICANT MESSAGE
           ============================================================ */

        function registerApplicantMessageHandler() {

            connection.on(
                "ApplicantMessage",
                () => {

                    console.log(
                        "[SWIFTCARE INTERVIEW] ApplicantMessage received."
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR SUSPICIOUS
           ============================================================ */

        function registerSuspiciousHandler() {

            connection.on(
                "InterviewSuspicious",
                async data => {

                    await handleServerSuspiciousState(
                        data?.message ||
                        data?.Message ||
                        "This interview has already been submitted for administrative review."
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR COMPLETED
           ============================================================ */

        function registerCompletedHandler() {

            connection.on(
                "InterviewCompleted",
                async message => {

                    if (
                        suspiciousActivityHandled ||
                        interviewCompleted
                    ) {

                        return;

                    }


                    /*
                     * Mark terminal state immediately so no new
                     * question can start.
                     */
                    interviewCompleted =
                        true;


                    clearSilenceTimer();


                    await stopRecognition();


                    hideListening();

                    hideThinking();


                    setTextResponseEnabled(
                        false
                    );


                    try {

                        window.speechSynthesis.cancel();

                    }
                    catch (_) {}


                    setStatus(
                        "Saving interview..."
                    );


                    const videoData =
                        await stopVideoRecording();


                    if (videoData) {

                        await uploadInterviewVideo(
                            videoData
                        );

                    }


                    /*
                     * Completion message must still be allowed even
                     * though interviewCompleted is true.
                     */
                    await speakText(
                        "Thank you for completing the interview. " +
                        "Your responses have been recorded successfully.",
                        true,
                        "completion"
                    );


                    stopCameraTracks();


                    setStatus(
                        "Interview completed"
                    );


                    try {

                        if (
                            document.fullscreenElement &&
                            document.exitFullscreen
                        ) {

                            await document.exitFullscreen();

                        }

                    }
                    catch (_) {}

                }
            );

        }


        /* ============================================================
           SIGNALR CONNECTION
           ============================================================ */

        async function createConnection() {

            connection =
                new signalR.HubConnectionBuilder()

                    .withUrl(
                        "/volunteerInterviewHub"
                    )

                    .withAutomaticReconnect(
                        [
                            0,
                            2000,
                            5000,
                            10000
                        ]
                    )

                    .configureLogging(
                        signalR.LogLevel.Warning
                    )

                    .build();


            registerBotQuestionHandler();

            registerInterviewStateHandler();

            registerApplicantMessageHandler();

            registerCompletedHandler();

            registerSuspiciousHandler();


            connection.onreconnecting(
                error => {

                    reconnecting =
                        true;


                    console.warn(
                        "[SWIFTCARE SIGNALR] Reconnecting:",
                        error
                    );


                    setStatus(
                        "Reconnecting..."
                    );


                    hideListening();

                }
            );


            connection.onreconnected(
                async connectionId => {

                    reconnecting =
                        false;


                    console.log(
                        "[SWIFTCARE SIGNALR] Reconnected:",
                        connectionId
                    );


                    if (
                        interviewCompleted ||
                        suspiciousActivityHandled
                    ) {

                        return;

                    }


                    setStatus(
                        "Connected"
                    );


                    try {

                        await connection.invoke(
                            "JoinInterview",
                            sessionToken
                        );

                    }
                    catch (error) {

                        console.error(
                            "[SWIFTCARE SIGNALR] Rejoin failed:",
                            error
                        );


                        setStatus(
                            "Could not resume interview",
                            true
                        );

                    }

                }
            );


            connection.onclose(
                error => {

                    console.error(
                        "[SWIFTCARE SIGNALR] Connection closed:",
                        error
                    );


                    if (
                        !interviewCompleted &&
                        !suspiciousActivityHandled
                    ) {

                        setStatus(
                            "Connection lost",
                            true
                        );

                    }

                }
            );


            try {

                await connection.start();


                setStatus(
                    "Connected"
                );


                await connection.invoke(
                    "JoinInterview",
                    sessionToken
                );


                interviewStarted =
                    true;


                /*
                 * IMPORTANT:
                 *
                 * We DO NOT call requestFullscreen() here.
                 *
                 * Browsers reject automatic fullscreen because it is
                 * not initiated by a user gesture.
                 */


                console.log(
                    "[SWIFTCARE INTERVIEW] Joined interview."
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE SIGNALR] Connection/start error:",
                    error
                );


                setStatus(
                    "Unable to connect",
                    true
                );


                stopCameraTracks();

            }

        }


        /* ============================================================
           INITIALIZE INTERVIEW
           ============================================================ */

        async function initializeInterview() {

            if (
                typeof signalR ===
                "undefined"
            ) {

                setStatus(
                    "SignalR unavailable",
                    true
                );

                return;

            }


            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                setStatus(
                    "Speech system unavailable",
                    true
                );

                return;

            }


            if (
                !navigator.mediaDevices ||
                !navigator.mediaDevices.getUserMedia
            ) {

                setStatus(
                    "Camera access is required",
                    true
                );


                if (recordingStatus) {

                    recordingStatus.textContent =
                        "Camera unavailable";

                }


                return;

            }


            try {

                await startVideoRecording();

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE VIDEO] Camera initialization failed:",
                    error
                );


                setStatus(
                    "Camera access is required",
                    true
                );


                if (recordingStatus) {

                    recordingStatus.textContent =
                        "Camera unavailable";

                }


                stopCameraTracks();


                return;

            }


            updateProctoringUi();


            /*
             * Browser voices are only needed for the emergency
             * fallback.
             */
            try {

                window.speechSynthesis.getVoices();

            }
            catch (_) {}


            if (
                "onvoiceschanged" in
                window.speechSynthesis
            ) {

                window.speechSynthesis
                    .onvoiceschanged =
                    () => {

                        try {

                            window.speechSynthesis
                                .getVoices();

                        }
                        catch (_) {}

                    };

            }


            await createConnection();

        }


        /* ============================================================
           START
           ============================================================ */

        initializeInterview()
            .catch(
                error => {

                    console.error(
                        "[SWIFTCARE INTERVIEW] Initialization failed:",
                        error
                    );


                    setStatus(
                        "Interview could not start",
                        true
                    );


                    stopCameraTracks();

                }
            );

    })();

</script>