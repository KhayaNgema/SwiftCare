@using SwiftCare.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@model SwiftCare.Models.TransportRequest?

@{
    ViewData["Title"] = "Transport Request Details";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";


    // ============================================================
    // NULL SAFE REQUEST
    // ============================================================

    var request = Model;


    // ============================================================
    // STATUS
    // ============================================================

    var statusClass = "sc-transport-status-pending";
    var statusText = "Unknown";
    var statusIcon = "bi-question-circle";


    if (request != null)
    {
        switch (request.Status)
        {
            case RequestStatus.Pending:

                statusClass =
                    "sc-transport-status-pending";

                statusText =
                    "Pending";

                statusIcon =
                    "bi-hourglass-split";

                break;


            case RequestStatus.Driver_Assigned:

                statusClass =
                    "sc-transport-status-assigned";

                statusText =
                    "Driver Assigned";

                statusIcon =
                    "bi-person-check-fill";

                break;


            case RequestStatus.Completed:

                statusClass =
                    "sc-transport-status-completed";

                statusText =
                    "Completed";

                statusIcon =
                    "bi-check-circle-fill";

                break;


            case RequestStatus.Rejected:

                statusClass =
                    "sc-transport-status-rejected";

                statusText =
                    "Rejected";

                statusIcon =
                    "bi-x-circle-fill";

                break;
        }
    }


    // ============================================================
    // RESIDENT PROFILE IMAGE
    // ============================================================

    var defaultProfileImage =
        Url.Content(
            "~/Images/default_profile_image.jpg"
        );


    var profileImage =
        defaultProfileImage;


    if (!string.IsNullOrWhiteSpace(
        request?.Resident?.ProfilePicture
    ))
    {
        var residentImagePath =
            request.Resident.ProfilePicture
                .Trim();


        if (
            Uri.TryCreate(
                residentImagePath,
                UriKind.Absolute,
                out var absoluteImageUri
            )
            &&
            (
                absoluteImageUri.Scheme == Uri.UriSchemeHttp
                ||
                absoluteImageUri.Scheme == Uri.UriSchemeHttps
            )
        )
        {
            profileImage =
                residentImagePath;
        }
        else
        {
            residentImagePath =
                residentImagePath
                    .TrimStart('~')
                    .TrimStart('/');


            profileImage =
                Url.Content(
                    "~/" +
                    residentImagePath
                );
        }
    }


    // ============================================================
    // RESIDENT NAME
    // ============================================================

    var residentName =
        "Resident Not Available";


    if (request?.Resident != null)
    {
        var firstName =
            request.Resident.FirstName ?? "";

        var lastName =
            request.Resident.LastName ?? "";


        var fullName =
            $"{firstName} {lastName}"
                .Trim();


        if (!string.IsNullOrWhiteSpace(
            fullName
        ))
        {
            residentName =
                fullName;
        }
    }


    // ============================================================
    // NURSE NAME
    // ============================================================

    var nurseName =
        "Not Available";


    if (request?.Nurse != null)
    {
        var firstName =
            request.Nurse.FirstName ?? "";

        var lastName =
            request.Nurse.LastName ?? "";


        var fullName =
            $"{firstName} {lastName}"
                .Trim();


        if (!string.IsNullOrWhiteSpace(
            fullName
        ))
        {
            nurseName =
                fullName;
        }
    }


    // ============================================================
    // DRIVER NAME
    // ============================================================

    var driverName =
        "Not Assigned";


    if (request?.Driver != null)
    {
        var firstName =
            request.Driver.FirstName ?? "";

        var lastName =
            request.Driver.LastName ?? "";


        var fullName =
            $"{firstName} {lastName}"
                .Trim();


        if (!string.IsNullOrWhiteSpace(
            fullName
        ))
        {
            driverName =
                fullName;
        }
    }


    // ============================================================
    // DRIVERS LIST
    // ============================================================

    var drivers =
        ViewBag.Drivers
        as IEnumerable<Driver>
        ?? Enumerable.Empty<Driver>();


    // ============================================================
    // VEHICLES LIST
    // ============================================================

    var vehicles =
        ViewBag.Vehicles
        as IEnumerable<Vehicle>
        ?? Enumerable.Empty<Vehicle>();


    // ============================================================
    // RESIDENT INITIAL
    // ============================================================

    var residentInitial =
        !string.IsNullOrWhiteSpace(
            residentName
        )
        ? residentName
            .Substring(0, 1)
            .ToUpper()
        : "R";
}


@if (ViewBag.ErrorMessage != null)
{
    <div class="sc-transport-details-page">

        <section class="sc-transport-error-card">

            <div class="sc-transport-error-icon">

                <i class="bi bi-exclamation-triangle-fill"></i>

            </div>


            <h2>
                Unable to Load Request
            </h2>


            <p>
                @ViewBag.ErrorMessage
            </p>


            <a asp-controller="TransportRequests"
                   asp-action="TransportRequests"
                   class="sc-transport-primary-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Requests

            </a>

        </section>

    </div>

    return;
}


@if (request == null)
{
    <div class="sc-transport-details-page">

        <section class="sc-transport-error-card">

            <div class="sc-transport-error-icon">

                <i class="bi bi-truck"></i>

            </div>


            <h2>
                Transport Request Not Found
            </h2>


            <p>
                The requested transport request could not be found.
            </p>


            <a asp-controller="TransportRequests"
                   asp-action="TransportRequests"
                   class="sc-transport-primary-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Requests

            </a>

        </section>

    </div>

    return;
}


<div class="sc-transport-details-page">


    <!-- ============================================================
         PAGE HEADER
    ============================================================= -->

    <section class="sc-transport-details-hero">


        <div class="sc-transport-hero-content">


            <a asp-controller="TransportRequests"
                   asp-action="TransportRequests"
                   class="sc-transport-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Requests

            </a>


            <div class="sc-transport-hero-heading">


                <div class="sc-transport-hero-icon">

                    <i class="bi bi-truck-front-fill"></i>

                </div>


                <div>

                    <span class="sc-transport-eyebrow">

                        TRANSPORT MANAGEMENT

                    </span>


                    <h1>
                        Transport Request Details
                    </h1>


                    <p>

                        Request #@request.RequestId

                        <span class="sc-transport-header-dot">
                            •
                        </span>

                        Created
                        @request.RequestedAt.ToString("dd MMM yyyy")

                    </p>

                </div>

            </div>

        </div>


        <div class="sc-transport-status @statusClass">

            <i class="bi @statusIcon"></i>

            @statusText

        </div>


    </section>



    <!-- ============================================================
         SUCCESS MESSAGE
    ============================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sc-transport-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
    ============================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="sc-transport-alert-error">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }



    <!-- ============================================================
         OVERVIEW CARDS
    ============================================================= -->

    <section class="sc-transport-overview-grid">


        <div class="sc-transport-overview-card">

            <div class="sc-overview-icon">

                <i class="bi bi-hash"></i>

            </div>


            <div>

                <span>
                    Request Number
                </span>

                <strong>
                    #@request.RequestId
                </strong>

            </div>

        </div>



        <div class="sc-transport-overview-card">

            <div class="sc-overview-icon">

                <i class="bi bi-calendar-event"></i>

            </div>


            <div>

                <span>
                    Transport Date
                </span>

                <strong>
                    @request.RequestedForDate.ToString("dd MMM yyyy")
                </strong>

            </div>

        </div>



        <div class="sc-transport-overview-card">

            <div class="sc-overview-icon">

                <i class="bi bi-clock-fill"></i>

            </div>


            <div>

                <span>
                    Departure Time
                </span>

                <strong>
                    @request.RequestedForTime.ToString("HH:mm")
                </strong>

            </div>

        </div>



        <div class="sc-transport-overview-card">

            <div class="sc-overview-icon">

                <i class="bi bi-signpost-split-fill"></i>

            </div>


            <div>

                <span>
                    Travel Distance
                </span>

                <strong>

                    @(string.IsNullOrWhiteSpace(
                        request.TravelDistance
                    )
                        ? "Not calculated"
                        : request.TravelDistance)

                </strong>

            </div>

        </div>


    </section>



    <!-- ============================================================
         MAIN GRID
    ============================================================= -->

    <div class="sc-transport-main-grid">


        <!-- ========================================================
             LEFT COLUMN
        ========================================================= -->

        <div class="sc-transport-left-column">


            <!-- ====================================================
                 RESIDENT INFORMATION
            ===================================================== -->

            <section class="sc-transport-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            RESIDENT
                        </span>

                        <h2>

                            <i class="bi bi-person-heart"></i>

                            Resident Information

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    <div class="sc-resident-profile">


                        <div class="sc-resident-image-wrapper">


                            <img src="@profileImage"
                                 class="sc-resident-profile-image"
                                 alt="@residentName"
                                 onerror="
                            this.style.display='none';
                            document.getElementById('residentFallback').style.display='flex';
                            " />


                            <div id="residentFallback"
                                 class="sc-resident-profile-fallback"
                                 style="display:none;">

                                @residentInitial

                            </div>


                        </div>


                        <div class="sc-resident-profile-content">

                            <h3>
                                @residentName
                            </h3>


                            <span>

                                <i class="bi bi-person-vcard"></i>

                                Resident ID:
                                @request.RequestedForId

                            </span>

                        </div>


                    </div>



                    <div class="sc-detail-grid">


                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-door-open-fill"></i>

                                Room

                            </span>

                            <strong>

                                @(request.Resident?.RoomNumber != null
                                    ? request.Resident.RoomNumber.ToString()
                                    : "Not assigned")

                            </strong>

                        </div>



                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-telephone-fill"></i>

                                Phone Number

                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(
                                    request.Resident?.PhoneNumber
                                )
                                    ? "Not available"
                                    : request.Resident.PhoneNumber)

                            </strong>

                        </div>


                    </div>


                </div>


            </section>



            <!-- ====================================================
                 TRANSPORT INFORMATION
            ===================================================== -->

            <section class="sc-transport-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            REQUEST DETAILS
                        </span>

                        <h2>

                            <i class="bi bi-clipboard2-check-fill"></i>

                            Transport Information

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    <div class="sc-transport-reason">

                        <span>

                            <i class="bi bi-chat-square-text-fill"></i>

                            Reason for Transport

                        </span>


                        <p>

                            @(string.IsNullOrWhiteSpace(
                                request.RequestReason
                            )
                                ? "No reason was provided."
                                : request.RequestReason)

                        </p>

                    </div>



                    <div class="sc-detail-grid">


                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-person-badge-fill"></i>

                                Requested By

                            </span>

                            <strong>
                                @nurseName
                            </strong>

                        </div>



                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-clock-history"></i>

                                Request Created

                            </span>

                            <strong>
                                @request.RequestedAt.ToString("dd MMM yyyy HH:mm")
                            </strong>

                        </div>


                    </div>


                </div>


            </section>



            <!-- ====================================================
                 ROUTE INFORMATION
            ===================================================== -->

            <section class="sc-transport-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            JOURNEY
                        </span>

                        <h2>

                            <i class="bi bi-map-fill"></i>

                            Route Information

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    <div class="sc-route-container">


                        <div class="sc-route-location">


                            <div class="sc-route-location-icon sc-route-pickup">

                                <i class="bi bi-geo-alt-fill"></i>

                            </div>


                            <div>

                                <span>
                                    PICKUP LOCATION
                                </span>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(
                                        request.PickUpAddress
                                    )
                                        ? "Pickup address unavailable"
                                        : request.PickUpAddress)

                                </strong>

                            </div>

                        </div>



                        <div class="sc-route-connector">

                            <span></span>

                            <i class="bi bi-arrow-down"></i>

                        </div>



                        <div class="sc-route-location">


                            <div class="sc-route-location-icon sc-route-destination">

                                <i class="bi bi-geo-alt-fill"></i>

                            </div>


                            <div>

                                <span>
                                    DESTINATION
                                </span>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(
                                        request.DestinationAddress
                                    )
                                        ? "Destination unavailable"
                                        : request.DestinationAddress)

                                </strong>

                            </div>

                        </div>


                    </div>



                    <div class="sc-detail-grid sc-route-details">


                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-signpost-split-fill"></i>

                                Travel Distance

                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(
                                    request.TravelDistance
                                )
                                    ? "Not calculated"
                                    : request.TravelDistance)

                            </strong>

                        </div>



                        <div class="sc-detail-box">

                            <span>

                                <i class="bi bi-stopwatch-fill"></i>

                                Estimated Duration

                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(
                                    request.TravelTime
                                )
                                    ? "Not calculated"
                                    : request.TravelTime)

                            </strong>

                        </div>


                    </div>


                </div>


            </section>


        </div>



        <!-- ========================================================
             RIGHT COLUMN
        ========================================================= -->

        <div class="sc-transport-right-column">


            <!-- ====================================================
                 DRIVER ASSIGNMENT
            ===================================================== -->

            <section class="sc-transport-card sc-assignment-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            DRIVER
                        </span>

                        <h2>

                            <i class="bi bi-person-check-fill"></i>

                            Driver Assignment

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    @if (request.Driver != null)
                    {
                        <div class="sc-assigned-resource">

                            <div class="sc-assigned-resource-icon">

                                <i class="bi bi-person-fill"></i>

                            </div>


                            <div>

                                <span>
                                    ASSIGNED DRIVER
                                </span>

                                <strong>
                                    @driverName
                                </strong>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="sc-unassigned-resource">

                            <i class="bi bi-person-x-fill"></i>


                            <div>

                                <strong>
                                    No Driver Assigned
                                </strong>

                                <p>
                                    This transport request is still
                                    waiting for a driver assignment.
                                </p>

                            </div>

                        </div>
                    }



                    <!-- ADMIN DRIVER ASSIGNMENT -->
                    @if (User.IsInRole("Administrator"))
                    {
                        <form asp-controller="TransportRequests"
                              asp-action="AssignDriver"
                              method="post"
                              class="sc-driver-assignment-form">


                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="requestId"
                                   value="@request.RequestId" />


                            <label for="driverId">

                                <i class="bi bi-person-plus-fill"></i>

                                @(request.Driver != null
                                    ? "Change Driver"
                                    : "Assign Driver")

                            </label>


                            <select id="driverId"
                                    name="driverId"
                                    required>

                                <option value="">
                                    -- Select a Driver --
                                </option>


                                @foreach (var driver in drivers)
                                {
                                    var fullDriverName =
                                        $"{driver.FirstName ?? ""} {driver.LastName ?? ""}"
                                        .Trim();


                                    var isSelected =
                                        !string.IsNullOrWhiteSpace(
                                            request.AssignedToId
                                        )
                                        &&
                                        driver.Id ==
                                        request.AssignedToId;


                                    if (isSelected)
                                    {
                                        <option value="@driver.Id"
                                                selected="selected">

                                            @fullDriverName

                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@driver.Id">

                                            @fullDriverName

                                        </option>
                                    }
                                }

                            </select>


                            @if (!drivers.Any())
                            {
                                <div class="sc-no-resource-warning">

                                    <i class="bi bi-exclamation-triangle-fill"></i>

                                    <span>
                                        No drivers were found in the system.
                                    </span>

                                </div>
                            }


                            <button type="submit"
                                    class="sc-assign-driver-btn"
                                    disabled="@(!drivers.Any())">

                                <i class="bi bi-person-check-fill"></i>

                                @(request.Driver != null
                                    ? "Update Driver"
                                    : "Assign Driver")

                            </button>


                        </form>
                    }


                </div>


            </section>



            <!-- ====================================================
                 VEHICLE ASSIGNMENT
            ===================================================== -->

            <section class="sc-transport-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            VEHICLE
                        </span>

                        <h2>

                            <i class="bi bi-car-front-fill"></i>

                            Vehicle Assignment

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    @if (request.Vehicle != null)
                    {
                        <div class="sc-assigned-resource">

                            <div class="sc-assigned-resource-icon">

                                <i class="bi bi-car-front-fill"></i>

                            </div>


                            <div>

                                <span>
                                    ASSIGNED VEHICLE
                                </span>

                                <strong>
                                    @request.Vehicle.VehicleName
                                </strong>

                                <small>
                                    @request.Vehicle.RegNumber
                                </small>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="sc-unassigned-resource">

                            <i class="bi bi-car-front-fill"></i>


                            <div>

                                <strong>
                                    No Vehicle Assigned
                                </strong>

                                <p>
                                    A vehicle has not yet been assigned
                                    to this transport request.
                                </p>

                            </div>

                        </div>
                    }



                    <!-- ADMIN VEHICLE ASSIGNMENT -->
                    @if (User.IsInRole("Administrator"))
                    {
                        <form asp-controller="TransportRequests"
                              asp-action="AssignVehicle"
                              method="post"
                              class="sc-driver-assignment-form">


                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="requestId"
                                   value="@request.RequestId" />


                            <label for="vehicleId">

                                <i class="bi bi-car-front-fill"></i>

                                @(request.Vehicle != null
                                    ? "Change Vehicle"
                                    : "Assign Vehicle")

                            </label>


                            <select id="vehicleId"
                                    name="vehicleId"
                                    required>

                                <option value="">
                                    -- Select a Vehicle --
                                </option>


                                @foreach (var vehicle in vehicles)
                                {
                                    var isSelected =
                                        request.VehicleId.HasValue
                                        &&
                                        vehicle.VehicleId ==
                                        request.VehicleId.Value;


                                    if (isSelected)
                                    {
                                        <option value="@vehicle.VehicleId"
                                                selected="selected">

                                            @vehicle.VehicleName
                                            -
                                            @vehicle.RegNumber

                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@vehicle.VehicleId">

                                            @vehicle.VehicleName
                                            -
                                            @vehicle.RegNumber

                                        </option>
                                    }
                                }

                            </select>


                            @if (!vehicles.Any())
                            {
                                <div class="sc-no-resource-warning">

                                    <i class="bi bi-exclamation-triangle-fill"></i>

                                    <span>
                                        No available vehicles were found.
                                    </span>

                                </div>
                            }


                            <button type="submit"
                                    class="sc-assign-driver-btn"
                                    disabled="@(!vehicles.Any())">

                                <i class="bi bi-car-front-fill"></i>

                                @(request.Vehicle != null
                                    ? "Update Vehicle"
                                    : "Assign Vehicle")

                            </button>


                        </form>
                    }


                </div>


            </section>



            <!-- ====================================================
                 TRIP INFORMATION
            ===================================================== -->

            <section class="sc-transport-card">


                <div class="sc-transport-card-header">

                    <div>

                        <span class="sc-transport-section-eyebrow">
                            TRIP
                        </span>

                        <h2>

                            <i class="bi bi-map-fill"></i>

                            Trip Information

                        </h2>

                    </div>

                </div>


                <div class="sc-transport-card-body">


                    @if (request.Trip != null)
                    {
                        <div class="sc-trip-info-list">


                            <div class="sc-trip-info-item">

                                <span>

                                    <i class="bi bi-activity"></i>

                                    Current Status

                                </span>

                                <strong>

                                    @request.Trip.Status
                                    .ToString()
                                    .Replace("_", " ")

                                </strong>

                            </div>



                            <div class="sc-trip-info-item">

                                <span>

                                    <i class="bi bi-play-circle-fill"></i>

                                    Started At

                                </span>

                                <strong>

                                    @(request.Trip.StartedAt.HasValue
                                        ? request.Trip.StartedAt.Value
                                            .ToString("dd MMM yyyy HH:mm")
                                        : "Not started")

                                </strong>

                            </div>



                            <div class="sc-trip-info-item">

                                <span>

                                    <i class="bi bi-stop-circle-fill"></i>

                                    Ended At

                                </span>

                                <strong>

                                    @(request.Trip.EndedAt.HasValue
                                        ? request.Trip.EndedAt.Value
                                            .ToString("dd MMM yyyy HH:mm")
                                        : "Not ended")

                                </strong>

                            </div>


                        </div>
                    }
                    else
                    {
                        <div class="sc-unassigned-resource">

                            <i class="bi bi-map"></i>


                            <div>

                                <strong>
                                    Trip Not Started
                                </strong>

                                <p>
                                    A trip has not yet been created
                                    for this transport request.
                                </p>

                            </div>

                        </div>
                    }


                </div>


            </section>


        </div>


    </div>


</div>