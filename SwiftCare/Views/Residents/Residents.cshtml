@model IEnumerable<SwiftCare.Models.Resident>

@{
    ViewData["Title"] = "Residents";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}


<div class="container-fluid residents-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="residents-header d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">

            <a asp-controller="Home"
                   asp-action="Index"
                   class="text-white text-decoration-none me-3">

                <i class="bi bi-chevron-left fs-4"></i>

            </a>

            <div>
                <h2>
                    <i class="bi bi-people-fill me-2"></i>
                    Residents
                </h2>

                <p>Manage and view all registered residents.</p>
            </div>

        </div>

        <div class="d-none d-md-block">

            <span class="badge bg-light text-dark fs-6">
                @Model.Count() Residents
            </span>

        </div>

    </div>


    <!-- ============================================================
         SEARCH
         ============================================================ -->

    <div class="resident-search-container">

        <div class="row">

            <div class="col-md-6">

                <div class="input-group">

                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>

                    <input type="text"
                           id="residentSearch"
                           class="form-control resident-search border-start-0"
                           placeholder="Search by name, email, phone number or room..." />

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         RESIDENTS TABLE
         ============================================================ -->
    @if (Model == null || !Model.Any())
    {
        <div class="empty-residents">

            <i class="bi bi-people"></i>

            <h4>No Residents Found</h4>

            <p class="text-muted mb-0">
                There are currently no residents registered in the system.
            </p>

        </div>
    }
    else
    {
        <div class="residents-table-container">

            <div class="table-responsive">

                <table class="table residents-table" id="residentsTable">

                    <thead>

                        <tr>

                            <th>Profile</th>

                            <th>Resident Name</th>

                            <th>Email Address</th>

                            <th>Phone Number</th>

                            <th>Date of Birth</th>

                            <th>Room</th>

                            <th class="text-end">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var resident in Model)
                        {
                            var profileImage = string.IsNullOrWhiteSpace(resident.ProfilePicture)
                                ? Url.Content("~/Images/default_profile_image.jpg")
                                : Url.Content("~/" + resident.ProfilePicture.TrimStart('/'));

                            <tr>

                                <!-- PROFILE IMAGE -->

                                <td>

                                    <img src="@profileImage"
                                         alt="@resident.FirstName @resident.LastName"
                                         class="resident-profile"
                                         onerror="this.src='@Url.Content("~/Images/default_profile_image.jpg")'" />

                                </td>


                                <!-- NAME -->

                                <td>

                                    <div class="resident-name">

                                        @resident.FirstName @resident.LastName

                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(resident.Email))
                                    {
                                        <span>
                                            <i class="bi bi-envelope me-1 text-muted"></i>
                                            @resident.Email
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }

                                </td>


                                <!-- PHONE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(resident.PhoneNumber))
                                    {
                                        <span>
                                            <i class="bi bi-telephone me-1 text-muted"></i>
                                            @resident.PhoneNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }

                                </td>


                                <!-- DATE OF BIRTH -->

                                <td>

                                    @resident.DateOfBirth.ToString("dd MMM yyyy")

                                </td>


                                <!-- ROOM -->

                                <td>

                                    @if (resident.RoomNumber != null)
                                    {
                                        <span class="room-badge">

                                            <i class="bi bi-door-open"></i>

                                            @resident.RoomNumber

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not assigned
                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->

                                <td class="text-end">

                                    <a asp-controller="Residents"
                                           asp-action="ResidentDetails"
                                           asp-route-id="@resident.Id"
                                           class="btn btn-resident-details">

                                        <i class="bi bi-person-lines-fill me-1"></i>

                                        View Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("residentSearch");

            const table =
                document.getElementById("residentsTable");

            if (!searchInput || !table) return;

            searchInput.addEventListener("keyup", function () {

                const searchValue =
                    this.value.toLowerCase();

                const rows =
                    table.querySelectorAll("tbody tr");

                rows.forEach(function (row) {

                    const rowText =
                        row.textContent.toLowerCase();

                    if (rowText.includes(searchValue)) {

                        row.style.display = "";

                    }
                    else {

                        row.style.display = "none";

                    }

                });

            });

        });

    </script>

}