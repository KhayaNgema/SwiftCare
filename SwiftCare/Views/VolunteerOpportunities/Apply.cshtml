@using SwiftCare.ViewModels
@using SwiftCare.Models

@model VolunteerApplicationViewModel

@{
    ViewData["Title"] = "Apply for Volunteer Opportunity";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<div class="sc-application-page">

    <!-- =========================================================
         BACKGROUND
         ========================================================= -->

    <div class="sc-application-background">
        <div class="sc-application-hero-glow sc-application-hero-glow-one"></div>
        <div class="sc-application-hero-glow sc-application-hero-glow-two"></div>
        <div class="sc-application-hero-pattern"></div>
    </div>


    <!-- =========================================================
         BACK BUTTON
         ========================================================= -->

    <div class="sc-application-back-wrapper">

        <a asp-controller="VolunteerOpportunities"
               asp-action="Opportunity"
               asp-route-opportunityId="@Model.VolunteerOpportunityId"
               class="sc-op-back-btn">

            <i class="bi bi-arrow-left"></i>

            <span>Back to Opportunity</span>

        </a>

    </div>


    <!-- =========================================================
         MAIN CARD
         ========================================================= -->

    <div class="sc-application-card">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="sc-application-header">

            <div class="sc-application-header-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>

            <div>

                <span class="sc-application-eyebrow">
                    SWIFTCARE VOLUNTEER
                </span>

                <h1>
                    Apply Now
                </h1>

                <p>
                    Complete your application below and take the
                    next step toward making a difference with SwiftCare.
                </p>

            </div>

        </div>


        <!-- =====================================================
             VALIDATION / ERROR SUMMARY
             ===================================================== -->

        <div id="applicationErrorBox"
             class="sc-application-error-box"
             style="display:none;">

            <div class="sc-application-error-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="sc-application-error-content">

                <strong>
                    Please check your application
                </strong>

                <p id="applicationErrorMessage">
                    Some required information is missing or invalid.
                </p>

                <ul id="applicationErrorList"></ul>

            </div>

        </div>


        <!-- =====================================================
             SERVER-SIDE VALIDATION
             ===================================================== -->

        <div class="sc-server-validation-summary">

            <div asp-validation-summary="All"
                 class="sc-application-validation-summary">
            </div>

        </div>


        <!-- =====================================================
             FORM
             ===================================================== -->

        <form asp-controller="VolunteerOpportunities"
              asp-action="Apply"
              method="post"
              enctype="multipart/form-data"
              class="sc-application-form"
              id="applicationForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="VolunteerOpportunityId" />


            <!-- =================================================
                 OPPORTUNITY
                 ================================================= -->

            <div class="sc-application-opportunity">

                <div class="sc-application-opportunity-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>

                <div class="sc-application-opportunity-content">

                    <span>
                        YOU ARE APPLYING FOR
                    </span>

                    <h2>
                        @Model.OpportunityTitle
                    </h2>

                </div>

            </div>


            <!-- =================================================
                 CV UPLOAD
                 ================================================= -->

            <section class="sc-application-section">

                <div class="sc-application-section-heading">

                    <div class="sc-application-section-icon">
                        <i class="bi bi-file-earmark-person-fill"></i>
                    </div>

                    <div>

                        <span class="sc-application-section-number">
                            01
                        </span>

                        <h2>
                            Upload Your CV
                        </h2>

                        <p>
                            Upload your latest CV.
                            Your CV is required for this application.
                        </p>

                    </div>

                </div>


                <div class="sc-cv-upload-wrapper">

                    <input asp-for="CV"
                           type="file"
                           id="cvFile"
                           class="sc-cv-file-input"
                           accept=".pdf,.docx" />


                    <label for="cvFile"
                           class="sc-cv-upload-area"
                           id="cvUploadArea">

                        <div class="sc-cv-upload-icon">

                            <i class="bi bi-cloud-arrow-up-fill"
                               id="cvUploadIcon"></i>

                        </div>


                        <div class="sc-cv-upload-content">

                            <strong id="cvUploadTitle">
                                Drop your CV here
                            </strong>

                            <span id="cvUploadSubtitle">
                                or click to browse your files
                            </span>

                            <small>
                                PDF or DOCX
                                <span>•</span>
                                Maximum 5 MB
                            </small>

                        </div>


                        <div class="sc-cv-upload-arrow">

                            <i class="bi bi-arrow-up-right"></i>

                        </div>

                    </label>


                    <!-- FILE PREVIEW -->

                    <div class="sc-cv-file-preview"
                         id="cvFilePreview">

                        <div class="sc-cv-file-preview-icon">

                            <i class="bi bi-file-earmark-text-fill"></i>

                        </div>

                        <div class="sc-cv-file-details">

                            <strong id="cvFileName">
                                CV.pdf
                            </strong>

                            <span id="cvFileSize">
                                0 KB
                            </span>

                        </div>

                        <button type="button"
                                class="sc-cv-remove-button"
                                id="removeCvButton">

                            <i class="bi bi-trash3-fill"></i>

                        </button>

                    </div>


                    <span asp-validation-for="CV"
                          class="sc-application-validation">
                    </span>


                    <!-- =================================================
                         CV STATUS
                         ================================================= -->

                    <div id="cvExtractionStatus"
                         class="sc-cv-extraction-status"
                         style="display:none;">

                        <div id="cvExtractionLoading"
                             class="sc-extraction-message"
                             style="display:none;">

                            <div class="sc-extraction-spinner">
                                <i class="bi bi-stars"></i>
                            </div>

                            <div>

                                <strong>
                                    Analysing your CV...
                                </strong>

                                <span>
                                    SwiftCare is extracting your
                                    professional information.
                                </span>

                            </div>

                        </div>


                        <div id="cvExtractionSuccess"
                             class="sc-extraction-message"
                             style="display:none;">

                            <div class="sc-extraction-success-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>

                            <div>

                                <strong>
                                    CV analysed successfully
                                </strong>

                                <span>
                                    Your profile fields have been
                                    populated. Please review them.
                                </span>

                            </div>

                        </div>


                        <div id="cvExtractionError"
                             class="sc-extraction-message"
                             style="display:none;">

                            <div class="sc-extraction-error-icon">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>

                            <div>

                                <strong>
                                    CV analysis failed
                                </strong>

                                <span id="cvExtractionErrorMessage">
                                    We could not analyse your CV.
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 PERSONAL DETAILS
                 ================================================= -->

            <section class="sc-application-section">

                <div class="sc-application-section-heading">

                    <div class="sc-application-section-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>

                    <div>

                        <span class="sc-application-section-number">
                            02
                        </span>

                        <h2>
                            Personal Details
                        </h2>

                        <p>
                            Please provide your personal information.
                            Fields marked as required must be completed.
                        </p>

                    </div>

                </div>


                <div class="sc-profile-fields-card">


                    <!-- FIRST NAME -->

                    <div class="sc-profile-field">

                        <label asp-for="FirstName"
                               class="sc-profile-label">

                            <i class="bi bi-person"></i>

                            First Name
                            <span class="sc-required">*</span>

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-person"></i>

                            <input asp-for="FirstName"
                                   id="FirstName"
                                   class="sc-profile-input"
                                   placeholder="First name"
                                   autocomplete="given-name"
                                   required />

                        </div>

                        <span asp-validation-for="FirstName"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- LAST NAME -->

                    <div class="sc-profile-field">

                        <label asp-for="LastName"
                               class="sc-profile-label">

                            <i class="bi bi-person"></i>

                            Last Name
                            <span class="sc-required">*</span>

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-person"></i>

                            <input asp-for="LastName"
                                   id="LastName"
                                   class="sc-profile-input"
                                   placeholder="Last name"
                                   autocomplete="family-name"
                                   required />

                        </div>

                        <span asp-validation-for="LastName"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- EMAIL -->

                    <div class="sc-profile-field">

                        <label asp-for="Email"
                               class="sc-profile-label">

                            <i class="bi bi-envelope"></i>

                            Email Address
                            <span class="sc-required">*</span>

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   id="Email"
                                   type="email"
                                   class="sc-profile-input"
                                   placeholder="you@example.com"
                                   autocomplete="email"
                                   required />

                        </div>

                        <span asp-validation-for="Email"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="sc-profile-field">

                        <label asp-for="PhoneNumber"
                               class="sc-profile-label">

                            <i class="bi bi-telephone"></i>

                            Phone Number
                            <span class="sc-required">*</span>

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <input asp-for="PhoneNumber"
                                   id="PhoneNumber"
                                   type="tel"
                                   class="sc-profile-input"
                                   placeholder="071 234 5678"
                                   autocomplete="tel"
                                   required />

                        </div>

                        <span asp-validation-for="PhoneNumber"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- DATE OF BIRTH -->

                    <div class="sc-profile-field">

                        <label asp-for="DateOfBirth"
                               class="sc-profile-label">

                            <i class="bi bi-calendar3"></i>

                            Date of Birth
                            <span class="sc-required">*</span>

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-calendar3"></i>

                            <input asp-for="DateOfBirth"
                                   id="DateOfBirth"
                                   type="date"
                                   class="sc-profile-input"
                                   autocomplete="bday"
                                   required />

                        </div>

                        <span asp-validation-for="DateOfBirth"
                              class="sc-profile-validation">
                        </span>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 PROFESSIONAL PROFILE
                 ================================================= -->

            <section class="sc-application-section">

                <div class="sc-application-section-heading">

                    <div class="sc-application-section-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>

                        <span class="sc-application-section-number">
                            03
                        </span>

                        <h2>
                            Professional Profile
                        </h2>

                        <p>
                            These fields can be populated from your CV.
                            Everything remains editable.
                        </p>

                    </div>

                </div>


                <div class="sc-profile-fields-card">


                    <!-- PROFESSIONAL TITLE -->

                    <div class="sc-profile-field sc-profile-field-full">

                        <label asp-for="ProfessionalTitle"
                               class="sc-profile-label">

                            <i class="bi bi-person-badge"></i>

                            Professional Title

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-person-badge"></i>

                            <input asp-for="ProfessionalTitle"
                                   id="ProfessionalTitle"
                                   class="sc-profile-input"
                                   placeholder="e.g. Community Development Volunteer" />

                        </div>

                        <span asp-validation-for="ProfessionalTitle"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- PROFESSIONAL SUMMARY -->

                    <div class="sc-profile-field sc-profile-field-full">

                        <label asp-for="ProfessionalSummary"
                               class="sc-profile-label">

                            <i class="bi bi-file-person"></i>

                            Professional Summary

                        </label>

                        <div class="sc-profile-textarea-wrapper">

                            <i class="bi bi-file-person"></i>

                            <textarea asp-for="ProfessionalSummary"
                                      id="ProfessionalSummary"
                                      class="sc-profile-textarea"
                                      rows="6"
                                      maxlength="3000"
                                      placeholder="Your professional summary..."></textarea>

                        </div>

                        <span asp-validation-for="ProfessionalSummary"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- CAREER OBJECTIVE -->

                    <div class="sc-profile-field sc-profile-field-full">

                        <label asp-for="CareerObjective"
                               class="sc-profile-label">

                            <i class="bi bi-bullseye"></i>

                            Career Objective

                        </label>

                        <div class="sc-profile-textarea-wrapper">

                            <i class="bi bi-bullseye"></i>

                            <textarea asp-for="CareerObjective"
                                      id="CareerObjective"
                                      class="sc-profile-textarea"
                                      rows="5"
                                      maxlength="3000"
                                      placeholder="Your career objective..."></textarea>

                        </div>

                        <span asp-validation-for="CareerObjective"
                              class="sc-profile-validation">
                        </span>

                    </div>


                    <!-- ADDRESS -->

                    <div class="sc-profile-field sc-profile-field-full">

                        <label asp-for="Address"
                               class="sc-profile-label">

                            <i class="bi bi-house"></i>

                            Address

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-house"></i>

                            <input asp-for="Address"
                                   id="Address"
                                   class="sc-profile-input"
                                   placeholder="Street address" />

                        </div>

                    </div>


                    <!-- CITY -->

                    <div class="sc-profile-field">

                        <label asp-for="City"
                               class="sc-profile-label">

                            <i class="bi bi-geo-alt"></i>

                            City

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-geo-alt"></i>

                            <input asp-for="City"
                                   id="City"
                                   class="sc-profile-input"
                                   placeholder="e.g. Durban" />

                        </div>

                    </div>


                    <!-- PROVINCE -->

                    <div class="sc-profile-field">

                        <label asp-for="Province"
                               class="sc-profile-label">

                            <i class="bi bi-map"></i>

                            Province

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-map"></i>

                            <input asp-for="Province"
                                   id="Province"
                                   class="sc-profile-input"
                                   placeholder="e.g. KwaZulu-Natal" />

                        </div>

                    </div>


                    <!-- COUNTRY -->

                    <div class="sc-profile-field">

                        <label asp-for="Country"
                               class="sc-profile-label">

                            <i class="bi bi-globe2"></i>

                            Country

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-globe2"></i>

                            <input asp-for="Country"
                                   id="Country"
                                   class="sc-profile-input"
                                   placeholder="e.g. South Africa" />

                        </div>

                    </div>


                    <!-- POSTAL CODE -->

                    <div class="sc-profile-field">

                        <label asp-for="PostalCode"
                               class="sc-profile-label">

                            <i class="bi bi-mailbox"></i>

                            Postal Code

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-mailbox"></i>

                            <input asp-for="PostalCode"
                                   id="PostalCode"
                                   class="sc-profile-input"
                                   placeholder="Postal code" />

                        </div>

                    </div>


                    <!-- PREFERRED WORK TYPE -->

                    <div class="sc-profile-field">

                        <label asp-for="PreferredWorkType"
                               class="sc-profile-label">

                            <i class="bi bi-briefcase"></i>

                            Preferred Work Type

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-briefcase"></i>

                            <input asp-for="PreferredWorkType"
                                   id="PreferredWorkType"
                                   class="sc-profile-input"
                                   placeholder="e.g. Volunteer / Part-time" />

                        </div>

                    </div>


                    <!-- PREFERRED LOCATION -->

                    <div class="sc-profile-field">

                        <label asp-for="PreferredLocation"
                               class="sc-profile-label">

                            <i class="bi bi-pin-map"></i>

                            Preferred Location

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-pin-map"></i>

                            <input asp-for="PreferredLocation"
                                   id="PreferredLocation"
                                   class="sc-profile-input"
                                   placeholder="e.g. Durban" />

                        </div>

                    </div>


                    <!-- LINKEDIN -->

                    <div class="sc-profile-field">

                        <label asp-for="LinkedInUrl"
                               class="sc-profile-label">

                            <i class="bi bi-linkedin"></i>

                            LinkedIn

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-linkedin"></i>

                            <input asp-for="LinkedInUrl"
                                   id="LinkedInUrl"
                                   type="url"
                                   class="sc-profile-input"
                                   placeholder="https://linkedin.com/in/..." />

                        </div>

                    </div>


                    <!-- PORTFOLIO -->

                    <div class="sc-profile-field">

                        <label asp-for="PortfolioUrl"
                               class="sc-profile-label">

                            <i class="bi bi-globe"></i>

                            Portfolio

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-globe"></i>

                            <input asp-for="PortfolioUrl"
                                   id="PortfolioUrl"
                                   type="url"
                                   class="sc-profile-input"
                                   placeholder="https://..." />

                        </div>

                    </div>


                    <!-- GITHUB -->

                    <div class="sc-profile-field">

                        <label asp-for="GitHubUrl"
                               class="sc-profile-label">

                            <i class="bi bi-github"></i>

                            GitHub

                        </label>

                        <div class="sc-profile-input-wrapper">

                            <i class="bi bi-github"></i>

                            <input asp-for="GitHubUrl"
                                   id="GitHubUrl"
                                   type="url"
                                   class="sc-profile-input"
                                   placeholder="https://github.com/..." />

                        </div>

                    </div>


                    <!-- =================================================
                         WILLING TO RELOCATE
                         ================================================= -->

                    <div class="sc-profile-toggle-card">

                        <div class="sc-profile-toggle-icon">
                            <i class="bi bi-arrows-move"></i>
                        </div>

                        <div class="sc-profile-toggle-content">

                            <strong>
                                Willing to Relocate
                            </strong>

                            <span>
                                Allow SwiftCare to consider you for
                                opportunities in other locations.
                            </span>

                        </div>

                        <label class="sc-profile-switch">

                            <input asp-for="WillingToRelocate" />

                            <span class="sc-profile-slider"></span>

                        </label>

                    </div>


                    <!-- =================================================
                         AVAILABLE FOR VOLUNTEER WORK
                         ================================================= -->

                    <div class="sc-profile-toggle-card">

                        <div class="sc-profile-toggle-icon">
                            <i class="bi bi-heart-pulse"></i>
                        </div>

                        <div class="sc-profile-toggle-content">

                            <strong>
                                Available for Volunteer Work
                            </strong>

                            <span>
                                Let SwiftCare know that you are
                                interested in volunteer opportunities.
                            </span>

                        </div>

                        <label class="sc-profile-switch">

                            <input asp-for="AvailableForVolunteerWork" />

                            <span class="sc-profile-slider"></span>

                        </label>

                    </div>

                </div>


                <!-- AI NOTICE -->

                <div class="sc-profile-ai-notice">

                    <div class="sc-profile-ai-notice-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>

                        <strong>
                            CV Profile Extraction
                        </strong>

                        <p>
                            SwiftCare uses your uploaded CV to
                            automatically populate available profile
                            fields. You can edit any information before
                            submitting your application.
                        </p>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 COVER MESSAGE
                 ================================================= -->

            <section class="sc-application-section">

                <div class="sc-application-section-heading">

                    <div class="sc-application-section-icon">
                        <i class="bi bi-chat-heart-fill"></i>
                    </div>

                    <div>

                        <span class="sc-application-section-number">
                            04
                        </span>

                        <h2>
                            Why Would You Like to Volunteer?
                        </h2>

                        <p>
                            Tell us about your interest in this
                            volunteer opportunity.
                        </p>

                    </div>

                </div>


                <div class="sc-application-field">

                    <label asp-for="CoverMessage"
                           class="sc-application-label">

                        Cover Message

                        <span class="sc-required">*</span>

                    </label>


                    <div class="sc-application-textarea-wrapper">

                        <i class="bi bi-pencil-square"></i>

                        <textarea asp-for="CoverMessage"
                                  id="CoverMessage"
                                  class="sc-application-textarea"
                                  rows="8"
                                  maxlength="2000"
                                  minlength="20"
                                  required
                                  placeholder="Tell us why you would like to volunteer with SwiftCare..."></textarea>

                    </div>


                    <div class="sc-application-field-footer">

                        <span>
                            Minimum 20 characters
                        </span>

                        <span id="coverMessageCounter">
                            0 / 2000
                        </span>

                    </div>


                    <span asp-validation-for="CoverMessage"
                          class="sc-application-validation">
                    </span>

                </div>

            </section>


            <!-- =================================================
                 SECURITY NOTICE
                 ================================================= -->

            <div class="sc-application-notice">

                <div class="sc-application-notice-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>

                    <strong>
                        Your application is secure
                    </strong>

                    <p>
                        Your CV and personal information will only
                        be used by the SwiftCare team to review your
                        volunteer application.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 SUBMIT STATUS
                 ================================================= -->

            <div id="submitStatus"
                 class="sc-submit-status"
                 style="display:none;">

                <div class="sc-submit-status-spinner">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>

                    <strong>
                        Submitting your application...
                    </strong>

                    <span>
                        Please wait. Do not close or refresh this page.
                    </span>

                </div>

            </div>


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <div class="sc-application-footer">

                <a asp-controller="VolunteerOpportunities"
                       asp-action="OpportunityDetails"
                       asp-route-opportunityId="@Model.VolunteerOpportunityId"
                       class="sc-application-cancel-button">

                    <i class="bi bi-arrow-left"></i>

                    BACK

                </a>


                <button type="submit"
                        class="sc-application-submit-button"
                        id="submitApplicationButton">

                    <span id="submitButtonText">
                        SUBMIT APPLICATION
                    </span>

                    <i class="bi bi-send-fill"
                       id="submitButtonIcon"></i>

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /* =====================================================
                   ELEMENTS
                   ===================================================== */

                const form =
                    document.getElementById(
                        "applicationForm"
                    );

                const fileInput =
                    document.getElementById(
                        "cvFile"
                    );

                const uploadArea =
                    document.getElementById(
                        "cvUploadArea"
                    );

                const uploadIcon =
                    document.getElementById(
                        "cvUploadIcon"
                    );

                const uploadTitle =
                    document.getElementById(
                        "cvUploadTitle"
                    );

                const uploadSubtitle =
                    document.getElementById(
                        "cvUploadSubtitle"
                    );

                const filePreview =
                    document.getElementById(
                        "cvFilePreview"
                    );

                const fileName =
                    document.getElementById(
                        "cvFileName"
                    );

                const fileSize =
                    document.getElementById(
                        "cvFileSize"
                    );

                const removeButton =
                    document.getElementById(
                        "removeCvButton"
                    );

                const extractionStatus =
                    document.getElementById(
                        "cvExtractionStatus"
                    );

                const extractionLoading =
                    document.getElementById(
                        "cvExtractionLoading"
                    );

                const extractionSuccess =
                    document.getElementById(
                        "cvExtractionSuccess"
                    );

                const extractionError =
                    document.getElementById(
                        "cvExtractionError"
                    );

                const extractionErrorMessage =
                    document.getElementById(
                        "cvExtractionErrorMessage"
                    );

                const coverMessage =
                    document.getElementById(
                        "CoverMessage"
                    );

                const coverCounter =
                    document.getElementById(
                        "coverMessageCounter"
                    );

                const errorBox =
                    document.getElementById(
                        "applicationErrorBox"
                    );

                const errorMessage =
                    document.getElementById(
                        "applicationErrorMessage"
                    );

                const errorList =
                    document.getElementById(
                        "applicationErrorList"
                    );

                const submitStatus =
                    document.getElementById(
                        "submitStatus"
                    );

                const submitButton =
                    document.getElementById(
                        "submitApplicationButton"
                    );

                const submitButtonText =
                    document.getElementById(
                        "submitButtonText"
                    );

                const submitButtonIcon =
                    document.getElementById(
                        "submitButtonIcon"
                    );


                /* =====================================================
                   ERROR DISPLAY
                   ===================================================== */

                function showErrorBox(
                    message,
                    errors = []
                ) {

                    if (!errorBox)
                        return;

                    errorBox.style.display = "flex";

                    if (errorMessage) {

                        errorMessage.textContent =
                            message ||
                            "Please correct the highlighted information before submitting.";

                    }

                    if (errorList) {

                        errorList.innerHTML = "";

                        errors.forEach(
                            function (error) {

                                if (!error)
                                    return;

                                const li =
                                    document.createElement("li");

                                li.textContent =
                                    error;

                                errorList.appendChild(li);

                            }
                        );

                    }

                    errorBox.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                }


                function hideErrorBox() {

                    if (!errorBox)
                        return;

                    errorBox.style.display = "none";

                    if (errorList)
                        errorList.innerHTML = "";

                }


                /* =====================================================
                   FORMAT FILE SIZE
                   ===================================================== */

                function formatFileSize(bytes) {

                    if (bytes === 0)
                        return "0 KB";

                    const units = [
                        "Bytes",
                        "KB",
                        "MB"
                    ];

                    const i =
                        Math.floor(
                            Math.log(bytes) /
                            Math.log(1024)
                        );

                    return (
                        parseFloat(
                            (
                                bytes /
                                Math.pow(1024, i)
                            ).toFixed(2)
                        )
                        + " "
                        + units[i]
                    );

                }


                /* =====================================================
                   DISPLAY FILE
                   ===================================================== */

                function displayFile(file) {

                    if (!file)
                        return false;


                    const extension =
                        file.name
                            .substring(
                                file.name.lastIndexOf(".")
                            )
                            .toLowerCase();


                    const allowedExtensions = [
                        ".pdf",
                        ".docx"
                    ];


                    if (
                        !allowedExtensions.includes(
                            extension
                        )
                    ) {

                        showErrorBox(
                            "The CV file type is not supported.",
                            [
                                "Please upload a PDF or DOCX file."
                            ]
                        );

                        fileInput.value = "";

                        return false;

                    }


                    if (
                        file.size >
                        5 * 1024 * 1024
                    ) {

                        showErrorBox(
                            "Your CV is too large.",
                            [
                                "The maximum allowed CV size is 5 MB."
                            ]
                        );

                        fileInput.value = "";

                        return false;

                    }


                    fileName.textContent =
                        file.name;


                    fileSize.textContent =
                        formatFileSize(
                            file.size
                        );


                    uploadArea.classList.add(
                        "sc-cv-upload-selected"
                    );


                    uploadIcon.className =
                        "bi bi-check-circle-fill";


                    uploadTitle.textContent =
                        "CV selected successfully";


                    uploadSubtitle.textContent =
                        "Analysing your CV now...";


                    filePreview.classList.add(
                        "sc-cv-file-preview-visible"
                    );


                    hideErrorBox();

                    return true;

                }


                /* =====================================================
                   SET FIELD VALUE
                   ===================================================== */

                function setFieldValue(
                    fieldId,
                    value
                ) {

                    const field =
                        document.getElementById(
                            fieldId
                        );


                    if (!field)
                        return;


                    if (
                        value !== null &&
                        value !== undefined &&
                        String(value).trim() !== ""
                    ) {

                        field.value =
                            value;


                        field.dispatchEvent(
                            new Event(
                                "input",
                                {
                                    bubbles: true
                                }
                            )
                        );


                        field.dispatchEvent(
                            new Event(
                                "change",
                                {
                                    bubbles: true
                                }
                            )
                        );

                    }

                }


                /* =====================================================
                   POPULATE EXTRACTED FIELDS
                   ===================================================== */

                function populateExtractedFields(
                    result
                ) {

                    if (!result)
                        return;


                    setFieldValue(
                        "Email",
                        result.email
                    );


                    setFieldValue(
                        "PhoneNumber",
                        result.phoneNumber
                    );


                    if (result.fullName) {

                        const fullName =
                            String(
                                result.fullName
                            ).trim();


                        const parts =
                            fullName
                                .split(/\s+/)
                                .filter(Boolean);


                        if (parts.length > 0) {

                            setFieldValue(
                                "FirstName",
                                parts[0]
                            );

                        }


                        if (parts.length > 1) {

                            setFieldValue(
                                "LastName",
                                parts
                                    .slice(1)
                                    .join(" ")
                            );

                        }

                    }


                    setFieldValue(
                        "ProfessionalTitle",
                        result.professionalTitle
                    );


                    setFieldValue(
                        "ProfessionalSummary",
                        result.professionalSummary
                    );


                    setFieldValue(
                        "CareerObjective",
                        result.careerObjective
                    );


                    setFieldValue(
                        "Address",
                        result.address
                    );


                    setFieldValue(
                        "City",
                        result.city
                    );


                    setFieldValue(
                        "Province",
                        result.province
                    );


                    setFieldValue(
                        "Country",
                        result.country
                    );


                    setFieldValue(
                        "LinkedInUrl",
                        result.linkedInUrl
                    );


                    setFieldValue(
                        "PortfolioUrl",
                        result.portfolioUrl
                    );


                    setFieldValue(
                        "GitHubUrl",
                        result.gitHubUrl
                    );

                }


                /* =====================================================
                   ANALYSE CV
                   ===================================================== */

                async function analyzeCv(file) {

                    if (!file)
                        return;


                    if (extractionStatus)
                        extractionStatus.style.display =
                            "block";


                    if (extractionLoading)
                        extractionLoading.style.display =
                            "flex";


                    if (extractionSuccess)
                        extractionSuccess.style.display =
                            "none";


                    if (extractionError)
                        extractionError.style.display =
                            "none";


                    const formData =
                        new FormData();


                    formData.append(
                        "CV",
                        file
                    );


                    const antiForgeryToken =
                        form.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        );


                    if (antiForgeryToken) {

                        formData.append(
                            "__RequestVerificationToken",
                            antiForgeryToken.value
                        );

                    }


                    try {

                        const response =
                            await fetch(
                                '@Url.Action("AnalyzeCv", "VolunteerOpportunities")',
                                {
                                    method: "POST",
                                    body: formData
                                }
                            );


                        let result;


                        try {

                            result =
                                await response.json();

                        }
                        catch {

                            throw new Error(
                                "The server returned an invalid response while analysing the CV."
                            );

                        }


                        if (
                            !response.ok ||
                            !result.success
                        ) {

                            throw new Error(
                                result.message ||
                                "The CV could not be analysed."
                            );

                        }


                        populateExtractedFields(
                            result
                        );


                        if (extractionLoading)
                            extractionLoading.style.display =
                                "none";


                        if (extractionSuccess)
                            extractionSuccess.style.display =
                                "flex";


                        if (uploadSubtitle)
                            uploadSubtitle.textContent =
                                "CV analysed successfully. Click to replace it.";

                    }
                    catch (error) {

                        console.error(
                            "CV extraction failed:",
                            error
                        );


                        if (extractionLoading)
                            extractionLoading.style.display =
                                "none";


                        if (extractionError)
                            extractionError.style.display =
                                "flex";


                        if (extractionErrorMessage) {

                            extractionErrorMessage.textContent =
                                error.message ||
                                "Unable to analyse your CV.";

                        }


                        if (uploadSubtitle)
                            uploadSubtitle.textContent =
                                "CV selected. Analysis failed.";

                        /*
                         * IMPORTANT:
                         * CV extraction failing does NOT prevent
                         * the application from being submitted.
                         */

                    }

                }


                /* =====================================================
                   FILE SELECT
                   ===================================================== */

                if (fileInput) {

                    fileInput.addEventListener(
                        "change",
                        async function () {

                            hideErrorBox();

                            if (
                                this.files &&
                                this.files.length > 0
                            ) {

                                const file =
                                    this.files[0];


                                const valid =
                                    displayFile(
                                        file
                                    );


                                if (!valid)
                                    return;


                                await analyzeCv(
                                    file
                                );

                            }

                        }
                    );

                }


                /* =====================================================
                   DRAG AND DROP
                   ===================================================== */

                if (uploadArea) {

                    uploadArea.addEventListener(
                        "dragover",
                        function (event) {

                            event.preventDefault();

                            uploadArea.classList.add(
                                "sc-cv-upload-dragover"
                            );

                        }
                    );


                    uploadArea.addEventListener(
                        "dragleave",
                        function () {

                            uploadArea.classList.remove(
                                "sc-cv-upload-dragover"
                            );

                        }
                    );


                    uploadArea.addEventListener(
                        "drop",
                        async function (event) {

                            event.preventDefault();


                            uploadArea.classList.remove(
                                "sc-cv-upload-dragover"
                            );


                            const files =
                                event.dataTransfer.files;


                            if (
                                !files ||
                                files.length === 0
                            )
                                return;


                            const file =
                                files[0];


                            const extension =
                                file.name
                                    .substring(
                                        file.name.lastIndexOf(".")
                                    )
                                    .toLowerCase();


                            if (
                                ![
                                    ".pdf",
                                    ".docx"
                                ].includes(
                                    extension
                                )
                            ) {

                                showErrorBox(
                                    "The CV file type is not supported.",
                                    [
                                        "Please upload a PDF or DOCX file."
                                    ]
                                );

                                return;

                            }


                            if (
                                file.size >
                                5 * 1024 * 1024
                            ) {

                                showErrorBox(
                                    "Your CV is too large.",
                                    [
                                        "The maximum allowed CV size is 5 MB."
                                    ]
                                );

                                return;

                            }


                            try {

                                const dataTransfer =
                                    new DataTransfer();


                                dataTransfer.items.add(
                                    file
                                );


                                fileInput.files =
                                    dataTransfer.files;

                            }
                            catch (error) {

                                console.warn(
                                    "Unable to assign dropped file.",
                                    error
                                );

                            }


                            const valid =
                                displayFile(
                                    file
                                );


                            if (valid) {

                                await analyzeCv(
                                    file
                                );

                            }

                        }
                    );

                }


                /* =====================================================
                   REMOVE CV
                   ===================================================== */

                if (removeButton) {

                    removeButton.addEventListener(
                        "click",
                        function () {

                            if (fileInput)
                                fileInput.value = "";


                            if (filePreview) {

                                filePreview.classList.remove(
                                    "sc-cv-file-preview-visible"
                                );

                            }


                            if (uploadArea) {

                                uploadArea.classList.remove(
                                    "sc-cv-upload-selected"
                                );

                            }


                            if (uploadIcon) {

                                uploadIcon.className =
                                    "bi bi-cloud-arrow-up-fill";

                            }


                            if (uploadTitle) {

                                uploadTitle.textContent =
                                    "Drop your CV here";

                            }


                            if (uploadSubtitle) {

                                uploadSubtitle.textContent =
                                    "or click to browse your files";

                            }


                            if (extractionStatus) {

                                extractionStatus.style.display =
                                    "none";

                            }


                            [
                                "ProfessionalTitle",
                                "ProfessionalSummary",
                                "CareerObjective",
                                "Address",
                                "City",
                                "Province",
                                "Country",
                                "PostalCode",
                                "PreferredWorkType",
                                "PreferredLocation",
                                "LinkedInUrl",
                                "PortfolioUrl",
                                "GitHubUrl"
                            ]
                            .forEach(
                                function (id) {

                                    const field =
                                        document.getElementById(
                                            id
                                        );


                                    if (field)
                                        field.value = "";

                                }
                            );

                        }
                    );

                }


                /* =====================================================
                   COVER MESSAGE COUNTER
                   ===================================================== */

                if (
                    coverMessage &&
                    coverCounter
                ) {

                    function updateCoverCounter() {

                        coverCounter.textContent =
                            coverMessage.value.length +
                            " / 2000";

                    }


                    coverMessage.addEventListener(
                        "input",
                        updateCoverCounter
                    );


                    updateCoverCounter();

                }


                /* =====================================================
                   VALIDATE APPLICATION
                   ===================================================== */

                function validateApplication() {

                    const errors = [];


                    hideErrorBox();


                    /* =================================================
                       CV
                       ================================================= */

                    if (
                        !fileInput ||
                        !fileInput.files ||
                        fileInput.files.length === 0
                    ) {

                        errors.push(
                            "Please upload your CV."
                        );

                    }
                    else {

                        const file =
                            fileInput.files[0];


                        const extension =
                            file.name
                                .substring(
                                    file.name.lastIndexOf(".")
                                )
                                .toLowerCase();


                        if (
                            ![
                                ".pdf",
                                ".docx"
                            ].includes(
                                extension
                            )
                        ) {

                            errors.push(
                                "Your CV must be a PDF or DOCX file."
                            );

                        }


                        if (
                            file.size >
                            5 * 1024 * 1024
                        ) {

                            errors.push(
                                "Your CV must be smaller than 5 MB."
                            );

                        }

                    }


                    /* =================================================
                       REQUIRED FIELDS
                       ================================================= */

                    const requiredFields =
                        form.querySelectorAll(
                            "input[required], textarea[required], select[required]"
                        );


                    requiredFields.forEach(
                        function (field) {

                            if (
                                field === fileInput
                            ) {
                                return;
                            }


                            if (
                                field.type === "checkbox" ||
                                field.type === "radio"
                            ) {
                                return;
                            }


                            if (
                                String(
                                    field.value || ""
                                ).trim() === ""
                            ) {

                                const label =
                                    form.querySelector(
                                        'label[for="' +
                                        field.id +
                                        '"]'
                                    );


                                let fieldName =
                                    field.name ||
                                    field.id ||
                                    "This field";


                                if (label) {

                                    fieldName =
                                        label.textContent
                                            .replace(/\*/g, "")
                                            .trim();

                                }


                                errors.push(
                                    fieldName +
                                    " is required."
                                );


                                field.classList.add(
                                    "sc-field-invalid"
                                );

                            }

                        }
                    );


                    /* =================================================
                       EMAIL
                       ================================================= */

                    const email =
                        document.getElementById(
                            "Email"
                        );


                    if (
                        email &&
                        email.value.trim() !== "" &&
                        !email.checkValidity()
                    ) {

                        errors.push(
                            "Please enter a valid email address."
                        );

                        email.classList.add(
                            "sc-field-invalid"
                        );

                    }


                    /* =================================================
                       URL FIELDS
                       ================================================= */

                    [
                        "LinkedInUrl",
                        "PortfolioUrl",
                        "GitHubUrl"
                    ]
                    .forEach(
                        function (id) {

                            const field =
                                document.getElementById(
                                    id
                                );


                            if (
                                field &&
                                field.value.trim() !== "" &&
                                !field.checkValidity()
                            ) {

                                errors.push(
                                    fieldNameFor(
                                        field
                                    ) +
                                    " must contain a valid URL."
                                );

                                field.classList.add(
                                    "sc-field-invalid"
                                );

                            }

                        }
                    );


                    /* =================================================
                       COVER MESSAGE
                       ================================================= */

                    if (coverMessage) {

                        const message =
                            coverMessage.value.trim();


                        if (message.length === 0) {

                            errors.push(
                                "Cover Message is required."
                            );

                            coverMessage.classList.add(
                                "sc-field-invalid"
                            );

                        }
                        else if (
                            message.length < 20
                        ) {

                            errors.push(
                                "Cover Message must contain at least 20 characters."
                            );

                            coverMessage.classList.add(
                                "sc-field-invalid"
                            );

                        }

                    }


                    /* =================================================
                       DATE OF BIRTH
                       ================================================= */

                    const dateOfBirth =
                        document.getElementById(
                            "DateOfBirth"
                        );


                    if (
                        dateOfBirth &&
                        dateOfBirth.value
                    ) {

                        const selectedDate =
                            new Date(
                                dateOfBirth.value
                            );


                        const today =
                            new Date();


                        if (
                            selectedDate > today
                        ) {

                            errors.push(
                                "Date of Birth cannot be in the future."
                            );

                            dateOfBirth.classList.add(
                                "sc-field-invalid"
                            );

                        }

                    }


                    /* =================================================
                       SHOW RESULT
                       ================================================= */

                    if (errors.length > 0) {

                        showErrorBox(
                            "Your application cannot be submitted yet. Please fix the following:",
                            errors
                        );


                        /*
                         * Move to first invalid field.
                         */

                        const firstInvalid =
                            form.querySelector(
                                ".sc-field-invalid"
                            );


                        if (firstInvalid) {

                            setTimeout(
                                function () {

                                    firstInvalid.focus();

                                },
                                400
                            );

                        }


                        return false;

                    }


                    return true;

                }


                /* =====================================================
                   FIELD NAME
                   ===================================================== */

                function fieldNameFor(field) {

                    if (!field)
                        return "This field";


                    const label =
                        form.querySelector(
                            'label[for="' +
                            field.id +
                            '"]'
                        );


                    if (label) {

                        return label.textContent
                            .replace(/\*/g, "")
                            .trim();

                    }


                    return field.name ||
                           field.id ||
                           "This field";

                }


                /* =====================================================
                   CLEAR INVALID STATE
                   ===================================================== */

                form.querySelectorAll(
                    "input, textarea, select"
                )
                .forEach(
                    function (field) {

                        field.addEventListener(
                            "input",
                            function () {

                                this.classList.remove(
                                    "sc-field-invalid"
                                );

                                hideErrorBox();

                            }
                        );


                        field.addEventListener(
                            "change",
                            function () {

                                this.classList.remove(
                                    "sc-field-invalid"
                                );

                            }
                        );

                    }
                );


                /* =====================================================
                   FORM SUBMIT
                   ===================================================== */

                if (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            /*
                             * Always stop the browser's default
                             * silent behaviour while we validate.
                             */

                            hideErrorBox();


                            const valid =
                                validateApplication();


                            if (!valid) {

                                event.preventDefault();

                                return;

                            }


                            /*
                             * Application is valid.
                             */

                            if (submitStatus) {

                                submitStatus.style.display =
                                    "flex";

                            }


                            if (submitButton) {

                                submitButton.disabled =
                                    true;

                            }


                            if (submitButtonText) {

                                submitButtonText.textContent =
                                    "SUBMITTING...";

                            }


                            if (submitButtonIcon) {

                                submitButtonIcon.className =
                                    "bi bi-arrow-repeat";

                            }

                        }
                    );

                }


                /* =====================================================
                   INITIAL STATE
                   ===================================================== */

                if (coverMessage) {

                    coverMessage.dispatchEvent(
                        new Event(
                            "input"
                        )
                    );

                }


                /*
                 * Remove any stale invalid styles when
                 * the page initially loads.
                 */

                form.querySelectorAll(
                    ".sc-field-invalid"
                )
                .forEach(
                    function (field) {

                        field.classList.remove(
                            "sc-field-invalid"
                        );

                    }
                );

            }
        );

    </script>
}