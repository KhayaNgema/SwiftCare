@{
    ViewData["Title"] = "Nurse";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<div class="nurse-dashboard">

    <div class="nurse-dashboard-container">

        <!-- =====================================================
             WELCOME
             ===================================================== -->

        <section class="nurse-welcome">

            <div class="nurse-welcome-content">

                <h1>
                    Nurse Dashboard
                </h1>

                <p>
                    Manage resident care and your daily nursing tasks.
                </p>

                <div class="nurse-status">

                    <span class="nurse-status-dot"></span>

                    On duty

                </div>

            </div>

        </section>


        <!-- =====================================================
             MAIN ACTIONS
             ===================================================== -->

        <section class="nurse-actions">

            <!-- RESIDENTS -->

            <a asp-controller="Residents"
                   asp-action="Residents"
                   class="nurse-action-card">

                <div class="nurse-action-icon">

                    <i class="bi bi-person-heart"></i>

                </div>

                <div class="nurse-action-content">

                    <div class="nurse-action-title">
                        Residents
                    </div>

                    <div class="nurse-action-description">
                        View residents and access their care information.
                    </div>

                </div>

                <i class="bi bi-chevron-right nurse-action-arrow"></i>

            </a>


            <!-- DAILY CARE -->

            <a asp-controller="Home"
                   asp-action="Index"
                   class="nurse-action-card">

                <div class="nurse-action-icon">

                    <i class="bi bi-heart-pulse-fill"></i>

                </div>

                <div class="nurse-action-content">

                    <div class="nurse-action-title">
                        Daily Care
                    </div>

                    <div class="nurse-action-description">
                        Record and manage today's resident care activities.
                    </div>

                </div>

                <i class="bi bi-chevron-right nurse-action-arrow"></i>

            </a>


            <!-- CARE RECORDS -->

            <a asp-controller="Home"
                   asp-action="Index"
                   class="nurse-action-card">

                <div class="nurse-action-icon">

                    <i class="bi bi-clipboard2-pulse-fill"></i>

                </div>

                <div class="nurse-action-content">

                    <div class="nurse-action-title">
                        Care Records
                    </div>

                    <div class="nurse-action-description">
                        Review resident care records and previous entries.
                    </div>

                </div>

                <i class="bi bi-chevron-right nurse-action-arrow"></i>

            </a>


            <!-- EQUIPMENT -->

            <a asp-controller="Equipment"
                   asp-action="OurEquipment"
                   class="nurse-action-card">

                <div class="nurse-action-icon">

                    <i class="bi bi-box-seam-fill"></i>

                </div>

                <div class="nurse-action-content">

                    <div class="nurse-action-title">
                        Equipment
                    </div>

                    <div class="nurse-action-description">
                        View equipment available for resident care.
                    </div>

                </div>

                <i class="bi bi-chevron-right nurse-action-arrow"></i>

            </a>

        </section>


        <!-- =====================================================
             TODAY'S CARE
             ===================================================== -->

        <section class="nurse-section">

            <div class="nurse-section-header">

                <div class="nurse-section-title">

                    <i class="bi bi-calendar-check-fill"></i>

                    Today's Care

                </div>

                <div class="nurse-date">

                    @DateTime.Now.ToString("dd MMM yyyy")

                </div>

            </div>


            <div class="nurse-empty-state">

                <div class="nurse-empty-icon">

                    <i class="bi bi-heart-pulse"></i>

                </div>

                <h3>
                    No care tasks assigned
                </h3>

                <p>
                    Your assigned care activities for today will appear here.
                </p>

            </div>


            <!-- =================================================
                 QUICK INFORMATION
                 ================================================= -->

            <div class="nurse-info">

                <div class="nurse-info-item">

                    <div class="nurse-info-label">
                        Residents
                    </div>

                    <div class="nurse-info-value">
                        0 assigned
                    </div>

                </div>


                <div class="nurse-info-item">

                    <div class="nurse-info-label">
                        Care Tasks
                    </div>

                    <div class="nurse-info-value">
                        0 pending
                    </div>

                </div>


                <div class="nurse-info-item">

                    <div class="nurse-info-label">
                        Status
                    </div>

                    <div class="nurse-info-value">
                        On duty
                    </div>

                </div>

            </div>

        </section>

    </div>

</div>