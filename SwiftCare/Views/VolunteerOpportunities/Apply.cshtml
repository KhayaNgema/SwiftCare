@using SwiftCare.ViewModels
@using SwiftCare.Models

@model VolunteerApplicationViewModel

@{
    ViewData["Title"] = "Apply for Volunteer Opportunity";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var applicationQuestions = Model.ApplicationQuestions?
        .OrderBy(q => q.DisplayOrder)
        .ToList()
        ?? new List<VolunteerQuestionSelectionViewModel>();
}

<div class="sc-application-page">

    <!-- =========================================================
         BACKGROUND
         ========================================================= -->

    <div class="sc-application-background">
        <div class="sc-application-hero-glow sc-application-hero-glow-one"></div>
        <div class="sc-application-hero-glow sc-application-hero-glow-two"></div>
        <div class="sc-application-hero-pattern"></div>
    </div>


    <!-- =========================================================
         BACK BUTTON
         ========================================================= -->

    <div class="sc-application-back-wrapper">

        <a asp-controller="VolunteerOpportunities"
               asp-action="Opportunity"
               asp-route-opportunityId="@Model.VolunteerOpportunityId"
               class="sc-op-back-btn">

            <i class="bi bi-arrow-left"></i>

            <span>Back to Opportunity</span>

        </a>

    </div>


    <!-- =========================================================
         MAIN CARD
         ========================================================= -->

    <div class="sc-application-card">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="sc-application-header">

            <div class="sc-application-header-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>

            <div>

                <span class="sc-application-eyebrow">
                    SWIFTCARE VOLUNTEER
                </span>

                <h1>
                    Apply Now
                </h1>

                <p>
                    Complete your application below and take the
                    next step toward making a difference with SwiftCare.
                </p>

            </div>

        </div>


        <!-- =====================================================
             PROGRESS
             ===================================================== -->

        <div class="sc-application-progress">

            <div class="sc-application-progress-step active"
                 id="applicationProgressStep1">

                <div class="sc-progress-number">
                    01
                </div>

                <div class="sc-progress-text">
                    <strong>Application Details</strong>
                    <span>Personal information</span>
                </div>

            </div>


            <div class="sc-progress-line"></div>


            <div class="sc-application-progress-step"
                 id="applicationProgressStep2">

                <div class="sc-progress-number">
                    02
                </div>

                <div class="sc-progress-text">
                    <strong>Application Questions</strong>
                    <span>Tell us more about you</span>
                </div>

            </div>

        </div>


        <!-- =====================================================
             FORM
             ===================================================== -->

        <form asp-controller="VolunteerOpportunities"
              asp-action="Apply"
              method="post"
              enctype="multipart/form-data"
              class="sc-application-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="VolunteerOpportunityId" />


            <!-- =================================================
                 STEP 1
                 ================================================= -->

            <div id="applicationStep1"
                 class="sc-application-step sc-application-step-active">


                <!-- =================================================
                     OPPORTUNITY
                     ================================================= -->

                <div class="sc-application-opportunity">

                    <div class="sc-application-opportunity-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>

                    <div class="sc-application-opportunity-content">

                        <span>
                            YOU ARE APPLYING FOR
                        </span>

                        <h2>
                            @Model.OpportunityTitle
                        </h2>

                    </div>

                </div>


                <!-- =================================================
                     CV UPLOAD
                     ================================================= -->

                <section class="sc-application-section">

                    <div class="sc-application-section-heading">

                        <div class="sc-application-section-icon">
                            <i class="bi bi-file-earmark-person-fill"></i>
                        </div>

                        <div>

                            <span class="sc-application-section-number">
                                01
                            </span>

                            <h2>
                                Upload Your CV
                            </h2>

                            <p>
                                Upload your latest CV and SwiftCare will
                                automatically extract your professional
                                information.
                            </p>

                        </div>

                    </div>


                    <div class="sc-cv-upload-wrapper">

                        <input asp-for="CV"
                               type="file"
                               id="cvFile"
                               class="sc-cv-file-input"
                               accept=".pdf,.docx"
                               required />


                        <label for="cvFile"
                               class="sc-cv-upload-area"
                               id="cvUploadArea">

                            <div class="sc-cv-upload-icon">

                                <i class="bi bi-cloud-arrow-up-fill"
                                   id="cvUploadIcon"></i>

                            </div>


                            <div class="sc-cv-upload-content">

                                <strong id="cvUploadTitle">
                                    Drop your CV here
                                </strong>

                                <span id="cvUploadSubtitle">
                                    or click to browse your files
                                </span>

                                <small>
                                    PDF or DOCX
                                    <span>•</span>
                                    Maximum 5 MB
                                </small>

                            </div>


                            <div class="sc-cv-upload-arrow">

                                <i class="bi bi-arrow-up-right"></i>

                            </div>

                        </label>


                        <!-- FILE PREVIEW -->

                        <div class="sc-cv-file-preview"
                             id="cvFilePreview">

                            <div class="sc-cv-file-preview-icon">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>

                            <div class="sc-cv-file-details">

                                <strong id="cvFileName">
                                    CV.pdf
                                </strong>

                                <span id="cvFileSize">
                                    0 KB
                                </span>

                            </div>

                            <button type="button"
                                    class="sc-cv-remove-button"
                                    id="removeCvButton">

                                <i class="bi bi-trash3-fill"></i>

                            </button>

                        </div>


                        <span asp-validation-for="CV"
                              class="sc-application-validation">
                        </span>


                        <!-- =================================================
                             AZURE EXTRACTION STATUS
                             ================================================= -->

                        <div id="cvExtractionStatus"
                             class="sc-cv-extraction-status"
                             style="display:none;">

                            <div id="cvExtractionLoading"
                                 class="sc-extraction-message"
                                 style="display:none;">

                                <div class="sc-extraction-spinner">
                                    <i class="bi bi-stars"></i>
                                </div>

                                <div>

                                    <strong>
                                        Analysing your CV...
                                    </strong>

                                    <span>
                                        SwiftCare is extracting your
                                        professional information.
                                    </span>

                                </div>

                            </div>


                            <div id="cvExtractionSuccess"
                                 class="sc-extraction-message"
                                 style="display:none;">

                                <div class="sc-extraction-success-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>

                                <div>

                                    <strong>
                                        CV analysed successfully
                                    </strong>

                                    <span>
                                        Your profile fields have been
                                        populated. Please review them
                                        before continuing.
                                    </span>

                                </div>

                            </div>


                            <div id="cvExtractionError"
                                 class="sc-extraction-message"
                                 style="display:none;">

                                <div class="sc-extraction-error-icon">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </div>

                                <div>

                                    <strong>
                                        CV analysis failed
                                    </strong>

                                    <span id="cvExtractionErrorMessage">
                                        We could not analyse your CV.
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     PERSONAL DETAILS
                     ================================================= -->

                <section class="sc-application-section">

                    <div class="sc-application-section-heading">

                        <div class="sc-application-section-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>

                        <div>

                            <span class="sc-application-section-number">
                                02
                            </span>

                            <h2>
                                Personal Details
                            </h2>

                            <p>
                                Review the information extracted from your
                                CV and correct anything that is inaccurate.
                            </p>

                        </div>

                    </div>


                    <div class="sc-profile-fields-card">


                        <!-- FIRST NAME -->

                        <div class="sc-profile-field">

                            <label asp-for="FirstName"
                                   class="sc-profile-label">

                                <i class="bi bi-person"></i>

                                First Name

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-person"></i>

                                <input asp-for="FirstName"
                                       id="FirstName"
                                       class="sc-profile-input"
                                       placeholder="First name"
                                       autocomplete="given-name"
                                       required />

                            </div>

                            <span asp-validation-for="FirstName"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- LAST NAME -->

                        <div class="sc-profile-field">

                            <label asp-for="LastName"
                                   class="sc-profile-label">

                                <i class="bi bi-person"></i>

                                Last Name

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-person"></i>

                                <input asp-for="LastName"
                                       id="LastName"
                                       class="sc-profile-input"
                                       placeholder="Last name"
                                       autocomplete="family-name"
                                       required />

                            </div>

                            <span asp-validation-for="LastName"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="sc-profile-field">

                            <label asp-for="Email"
                                   class="sc-profile-label">

                                <i class="bi bi-envelope"></i>

                                Email Address

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <input asp-for="Email"
                                       id="Email"
                                       type="email"
                                       class="sc-profile-input"
                                       placeholder="you@example.com"
                                       autocomplete="email"
                                       required />

                            </div>

                            <span asp-validation-for="Email"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- PHONE -->

                        <div class="sc-profile-field">

                            <label asp-for="PhoneNumber"
                                   class="sc-profile-label">

                                <i class="bi bi-telephone"></i>

                                Phone Number

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-telephone"></i>

                                <input asp-for="PhoneNumber"
                                       id="PhoneNumber"
                                       type="tel"
                                       class="sc-profile-input"
                                       placeholder="071 234 5678"
                                       autocomplete="tel"
                                       required />

                            </div>

                            <span asp-validation-for="PhoneNumber"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- DATE OF BIRTH -->

                        <div class="sc-profile-field">

                            <label asp-for="DateOfBirth"
                                   class="sc-profile-label">

                                <i class="bi bi-calendar3"></i>

                                Date of Birth

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-calendar3"></i>

                                <input asp-for="DateOfBirth"
                                       id="DateOfBirth"
                                       type="date"
                                       class="sc-profile-input"
                                       autocomplete="bday"
                                       required />

                            </div>

                            <span asp-validation-for="DateOfBirth"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                    </div>

                </section>


                <!-- =================================================
                     PROFESSIONAL PROFILE
                     ================================================= -->

                <section class="sc-application-section">

                    <div class="sc-application-section-heading">

                        <div class="sc-application-section-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>

                            <span class="sc-application-section-number">
                                03
                            </span>

                            <h2>
                                Professional Profile
                            </h2>

                            <p>
                                These fields are populated from your CV.
                                Everything remains editable.
                            </p>

                        </div>

                    </div>


                    <div class="sc-profile-fields-card">


                        <!-- PROFESSIONAL TITLE -->

                        <div class="sc-profile-field sc-profile-field-full">

                            <label asp-for="ProfessionalTitle"
                                   class="sc-profile-label">

                                <i class="bi bi-person-badge"></i>

                                Professional Title

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-person-badge"></i>

                                <input asp-for="ProfessionalTitle"
                                       id="ProfessionalTitle"
                                       class="sc-profile-input"
                                       placeholder="e.g. Community Development Graduate" />

                            </div>

                            <span asp-validation-for="ProfessionalTitle"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- PROFESSIONAL SUMMARY -->

                        <div class="sc-profile-field sc-profile-field-full">

                            <label asp-for="ProfessionalSummary"
                                   class="sc-profile-label">

                                <i class="bi bi-file-person"></i>

                                Professional Summary

                            </label>

                            <div class="sc-profile-textarea-wrapper">

                                <i class="bi bi-file-person"></i>

                                <textarea asp-for="ProfessionalSummary"
                                          id="ProfessionalSummary"
                                          class="sc-profile-textarea"
                                          rows="6"
                                          maxlength="3000"
                                          placeholder="Your professional summary..."></textarea>

                            </div>

                            <span asp-validation-for="ProfessionalSummary"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- CAREER OBJECTIVE -->

                        <div class="sc-profile-field sc-profile-field-full">

                            <label asp-for="CareerObjective"
                                   class="sc-profile-label">

                                <i class="bi bi-bullseye"></i>

                                Career Objective

                            </label>

                            <div class="sc-profile-textarea-wrapper">

                                <i class="bi bi-bullseye"></i>

                                <textarea asp-for="CareerObjective"
                                          id="CareerObjective"
                                          class="sc-profile-textarea"
                                          rows="5"
                                          maxlength="3000"
                                          placeholder="Your career objective..."></textarea>

                            </div>

                            <span asp-validation-for="CareerObjective"
                                  class="sc-profile-validation">
                            </span>

                        </div>


                        <!-- ADDRESS -->

                        <div class="sc-profile-field sc-profile-field-full">

                            <label asp-for="Address"
                                   class="sc-profile-label">

                                <i class="bi bi-house"></i>

                                Address

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-house"></i>

                                <input asp-for="Address"
                                       id="Address"
                                       class="sc-profile-input"
                                       placeholder="Street address" />

                            </div>

                        </div>


                        <!-- CITY -->

                        <div class="sc-profile-field">

                            <label asp-for="City"
                                   class="sc-profile-label">

                                <i class="bi bi-geo-alt"></i>

                                City

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-geo-alt"></i>

                                <input asp-for="City"
                                       id="City"
                                       class="sc-profile-input"
                                       placeholder="e.g. Durban" />

                            </div>

                        </div>


                        <!-- PROVINCE -->

                        <div class="sc-profile-field">

                            <label asp-for="Province"
                                   class="sc-profile-label">

                                <i class="bi bi-map"></i>

                                Province

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-map"></i>

                                <input asp-for="Province"
                                       id="Province"
                                       class="sc-profile-input"
                                       placeholder="e.g. KwaZulu-Natal" />

                            </div>

                        </div>


                        <!-- COUNTRY -->

                        <div class="sc-profile-field">

                            <label asp-for="Country"
                                   class="sc-profile-label">

                                <i class="bi bi-globe2"></i>

                                Country

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-globe2"></i>

                                <input asp-for="Country"
                                       id="Country"
                                       class="sc-profile-input"
                                       placeholder="e.g. South Africa" />

                            </div>

                        </div>


                        <!-- POSTAL CODE -->

                        <div class="sc-profile-field">

                            <label asp-for="PostalCode"
                                   class="sc-profile-label">

                                <i class="bi bi-mailbox"></i>

                                Postal Code

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-mailbox"></i>

                                <input asp-for="PostalCode"
                                       id="PostalCode"
                                       class="sc-profile-input"
                                       placeholder="Postal code" />

                            </div>

                        </div>


                        <!-- PREFERRED WORK TYPE -->

                        <div class="sc-profile-field">

                            <label asp-for="PreferredWorkType"
                                   class="sc-profile-label">

                                <i class="bi bi-briefcase"></i>

                                Preferred Work Type

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-briefcase"></i>

                                <input asp-for="PreferredWorkType"
                                       id="PreferredWorkType"
                                       class="sc-profile-input"
                                       placeholder="e.g. Volunteer / Part-time" />

                            </div>

                        </div>


                        <!-- PREFERRED LOCATION -->

                        <div class="sc-profile-field">

                            <label asp-for="PreferredLocation"
                                   class="sc-profile-label">

                                <i class="bi bi-pin-map"></i>

                                Preferred Location

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-pin-map"></i>

                                <input asp-for="PreferredLocation"
                                       id="PreferredLocation"
                                       class="sc-profile-input"
                                       placeholder="e.g. Durban" />

                            </div>

                        </div>


                        <!-- LINKEDIN -->

                        <div class="sc-profile-field">

                            <label asp-for="LinkedInUrl"
                                   class="sc-profile-label">

                                <i class="bi bi-linkedin"></i>

                                LinkedIn

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-linkedin"></i>

                                <input asp-for="LinkedInUrl"
                                       id="LinkedInUrl"
                                       type="url"
                                       class="sc-profile-input"
                                       placeholder="https://linkedin.com/in/..." />

                            </div>

                        </div>


                        <!-- PORTFOLIO -->

                        <div class="sc-profile-field">

                            <label asp-for="PortfolioUrl"
                                   class="sc-profile-label">

                                <i class="bi bi-globe"></i>

                                Portfolio

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-globe"></i>

                                <input asp-for="PortfolioUrl"
                                       id="PortfolioUrl"
                                       type="url"
                                       class="sc-profile-input"
                                       placeholder="https://..." />

                            </div>

                        </div>


                        <!-- GITHUB -->

                        <div class="sc-profile-field">

                            <label asp-for="GitHubUrl"
                                   class="sc-profile-label">

                                <i class="bi bi-github"></i>

                                GitHub

                            </label>

                            <div class="sc-profile-input-wrapper">

                                <i class="bi bi-github"></i>

                                <input asp-for="GitHubUrl"
                                       id="GitHubUrl"
                                       type="url"
                                       class="sc-profile-input"
                                       placeholder="https://github.com/..." />

                            </div>

                        </div>


                        <!-- =================================================
                             TOGGLES
                             ================================================= -->

                        <div class="sc-profile-toggle-card">

                            <div class="sc-profile-toggle-icon">
                                <i class="bi bi-arrows-move"></i>
                            </div>

                            <div class="sc-profile-toggle-content">

                                <strong>
                                    Willing to Relocate
                                </strong>

                                <span>
                                    Allow SwiftCare to consider you for
                                    opportunities in other locations.
                                </span>

                            </div>

                            <label class="sc-profile-switch">

                                <input asp-for="WillingToRelocate" />

                                <span class="sc-profile-slider"></span>

                            </label>

                        </div>


                        <div class="sc-profile-toggle-card">

                            <div class="sc-profile-toggle-icon">
                                <i class="bi bi-heart-pulse"></i>
                            </div>

                            <div class="sc-profile-toggle-content">

                                <strong>
                                    Available for Volunteer Work
                                </strong>

                                <span>
                                    Let SwiftCare know that you are
                                    interested in volunteer opportunities.
                                </span>

                            </div>

                            <label class="sc-profile-switch">

                                <input asp-for="AvailableForVolunteerWork" />

                                <span class="sc-profile-slider"></span>

                            </label>

                        </div>

                    </div>


                    <!-- AI NOTICE -->

                    <div class="sc-profile-ai-notice">

                        <div class="sc-profile-ai-notice-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>

                            <strong>
                                CV Profile Extraction
                            </strong>

                            <p>
                                SwiftCare uses your uploaded CV to
                                automatically populate these fields.
                                You can edit any information before
                                submitting your application.
                            </p>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     COVER MESSAGE
                     ================================================= -->

                <section class="sc-application-section">

                    <div class="sc-application-section-heading">

                        <div class="sc-application-section-icon">
                            <i class="bi bi-chat-heart-fill"></i>
                        </div>

                        <div>

                            <span class="sc-application-section-number">
                                04
                            </span>

                            <h2>
                                Why Would You Like to Volunteer?
                            </h2>

                            <p>
                                Tell us about your interest in this
                                volunteer opportunity.
                            </p>

                        </div>

                    </div>


                    <div class="sc-application-field">

                        <label asp-for="CoverMessage"
                               class="sc-application-label">

                            Cover Message

                        </label>


                        <div class="sc-application-textarea-wrapper">

                            <i class="bi bi-pencil-square"></i>

                            <textarea asp-for="CoverMessage"
                                      id="CoverMessage"
                                      class="sc-application-textarea"
                                      rows="8"
                                      maxlength="2000"
                                      minlength="20"
                                      required
                                      placeholder="Tell us why you would like to volunteer with SwiftCare..."></textarea>

                        </div>


                        <div class="sc-application-field-footer">

                            <span>
                                Minimum 20 characters
                            </span>

                            <span id="coverMessageCounter">
                                0 / 2000
                            </span>

                        </div>


                        <span asp-validation-for="CoverMessage"
                              class="sc-application-validation">
                        </span>

                    </div>

                </section>


                <!-- =================================================
                     SECURITY
                     ================================================= -->

                <div class="sc-application-notice">

                    <div class="sc-application-notice-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>

                        <strong>
                            Your application is secure
                        </strong>

                        <p>
                            Your CV and personal information will only
                            be used by the SwiftCare team to review your
                            volunteer application.
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     STEP 1 FOOTER
                     ================================================= -->

                <div class="sc-application-footer">

                    <a asp-controller="VolunteerOpportunities"
                           asp-action="OpportunityDetails"
                           asp-route-opportunityId="@Model.VolunteerOpportunityId"
                           class="sc-application-cancel-button">

                        <i class="bi bi-arrow-left"></i>

                        BACK

                    </a>


                    <button type="button"
                            id="nextApplicationStep"
                            class="sc-application-next-button">

                        NEXT

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </div>

            </div>


            <!-- =====================================================
                 STEP 2
                 ===================================================== -->

            <div id="applicationStep2"
                 class="sc-application-step sc-application-step-hidden">


                <!-- HEADER -->

                <div class="sc-questions-intro-card">

                    <div class="sc-questions-intro-icon">
                        <i class="bi bi-chat-square-heart-fill"></i>
                    </div>

                    <div>

                        <span>
                            STEP 02
                        </span>

                        <h2>
                            Application Questions
                        </h2>

                        <p>
                            Help us get to know you a little better.
                            Please answer the questions below as honestly
                            and completely as possible.
                        </p>

                    </div>

                </div>


                <!-- QUESTIONS -->
                @if (applicationQuestions.Any())
                {

                    <div class="sc-application-questions-container">

                        @{
                            var questionNumber = 1;
                        }

                        @foreach (var question in applicationQuestions)
                        {

                            <div class="sc-application-question-card">

                                <div class="sc-application-question-number">
                                    @questionNumber.ToString("00")
                                </div>

                                <div class="sc-application-question-body">

                                    <div class="sc-application-question-header">

                                        <div>

                                            <span class="sc-application-question-label">
                                                QUESTION @questionNumber
                                            </span>

                                            <h3>
                                                @question.Question
                                            </h3>

                                        </div>

                                        <div class="sc-application-question-badges">

                                            @if (question.IsRequired)
                                            {
                                                <span class="sc-question-required-badge">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="sc-question-optional-badge">
                                                    Optional
                                                </span>
                                            }

                                            <span class="sc-question-type-badge">

                                                @if (question.QuestionType == VolunteerQuestionType.ShortAnswer)
                                                {
                                                    <i class="bi bi-input-cursor-text"></i>
                                                    <span>Short Answer</span>
                                                }
                                                else if (question.QuestionType == VolunteerQuestionType.LongAnswer)
                                                {
                                                    <i class="bi bi-text-paragraph"></i>
                                                    <span>Long Answer</span>
                                                }
                                                else if (question.QuestionType == VolunteerQuestionType.YesNo)
                                                {
                                                    <i class="bi bi-toggle-on"></i>
                                                    <span>Yes / No</span>
                                                }

                                            </span>

                                        </div>

                                    </div>


                                    @if (question.QuestionType == VolunteerQuestionType.ShortAnswer)
                                    {

                                        <div class="sc-question-answer-wrapper">

                                            <i class="bi bi-pencil"></i>

                                            <input type="text"
                                                   name="QuestionAnswers[@question.VolunteerQuestionId]"
                                                   class="sc-question-answer-input"
                                                   maxlength="1000"
                                                   placeholder="Type your answer here..."
                                            @(question.IsRequired ? "required" : "") />

                                        </div>

                                        <span class="sc-application-validation"
                                              data-question-validation="@question.VolunteerQuestionId">
                                        </span>

                                    }
                                    else if (question.QuestionType == VolunteerQuestionType.LongAnswer)
                                    {

                                        <div class="sc-question-answer-wrapper sc-question-answer-textarea-wrapper">

                                            <i class="bi bi-pencil-square"></i>

                                            <textarea name="QuestionAnswers[@question.VolunteerQuestionId]"
                                                      class="sc-question-answer-textarea"
                                                      rows="6"
                                                      maxlength="3000"
                                                      placeholder="Write your answer here..."
                                            @(question.IsRequired ? "required" : "")></textarea>

                                            <div class="sc-question-answer-footer">

                                                <span>
                                                    Your response
                                                </span>

                                                <span class="sc-question-character-counter">
                                                    0 / 3000
                                                </span>

                                            </div>

                                        </div>

                                        <span class="sc-application-validation"
                                              data-question-validation="@question.VolunteerQuestionId">
                                        </span>

                                    }
                                    else if (question.QuestionType == VolunteerQuestionType.YesNo)
                                    {

                                        <div class="sc-question-yes-no">

                                            <label class="sc-question-choice">

                                                <input type="radio"
                                                       name="QuestionAnswers[@question.VolunteerQuestionId]"
                                                       value="Yes"
                                                @(question.IsRequired ? "required" : "") />

                                                <span class="sc-question-choice-box">

                                                    <span class="sc-question-choice-icon">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    </span>

                                                    <span>
                                                        Yes
                                                    </span>

                                                </span>

                                            </label>


                                            <label class="sc-question-choice">

                                                <input type="radio"
                                                       name="QuestionAnswers[@question.VolunteerQuestionId]"
                                                       value="No"
                                                @(question.IsRequired ? "required" : "") />

                                                <span class="sc-question-choice-box">

                                                    <span class="sc-question-choice-icon">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </span>

                                                    <span>
                                                        No
                                                    </span>

                                                </span>

                                            </label>

                                        </div>

                                        <span class="sc-application-validation"
                                              data-question-validation="@question.VolunteerQuestionId">
                                        </span>

                                    }

                                </div>

                            </div>

                            questionNumber++;
                        }

                    </div>

                }
                else
                {

                    <div class="sc-no-application-questions">

                        <div class="sc-no-questions-icon">
                            <i class="bi bi-chat-square-text-fill"></i>
                        </div>

                        <div>

                            <h3>
                                No additional questions
                            </h3>

                            <p>
                                There are no additional questions for
                                this volunteer opportunity.
                            </p>

                        </div>

                    </div>

                }


                <!-- FINAL NOTICE -->

                <div class="sc-final-application-notice">

                    <div class="sc-final-application-notice-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Almost there!
                        </strong>

                        <p>
                            Review your answers before submitting your
                            volunteer application.
                        </p>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="sc-application-footer sc-step-two-footer">

                    <button type="button"
                            id="previousApplicationStep"
                            class="sc-application-cancel-button">

                        <i class="bi bi-arrow-left"></i>

                        BACK

                    </button>


                    <button type="submit"
                            class="sc-application-submit-button">

                        SUBMIT APPLICATION

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


@section Scripts
{

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                /* =====================================================
                   ELEMENTS
                   ===================================================== */

                const form =
                    document.querySelector(
                        ".sc-application-form"
                    );


                const fileInput =
                    document.getElementById(
                        "cvFile"
                    );


                const uploadArea =
                    document.getElementById(
                        "cvUploadArea"
                    );


                const uploadIcon =
                    document.getElementById(
                        "cvUploadIcon"
                    );


                const uploadTitle =
                    document.getElementById(
                        "cvUploadTitle"
                    );


                const uploadSubtitle =
                    document.getElementById(
                        "cvUploadSubtitle"
                    );


                const filePreview =
                    document.getElementById(
                        "cvFilePreview"
                    );


                const fileName =
                    document.getElementById(
                        "cvFileName"
                    );


                const fileSize =
                    document.getElementById(
                        "cvFileSize"
                    );


                const removeButton =
                    document.getElementById(
                        "removeCvButton"
                    );


                const extractionStatus =
                    document.getElementById(
                        "cvExtractionStatus"
                    );


                const extractionLoading =
                    document.getElementById(
                        "cvExtractionLoading"
                    );


                const extractionSuccess =
                    document.getElementById(
                        "cvExtractionSuccess"
                    );


                const extractionError =
                    document.getElementById(
                        "cvExtractionError"
                    );


                const extractionErrorMessage =
                    document.getElementById(
                        "cvExtractionErrorMessage"
                    );


                const coverMessage =
                    document.getElementById(
                        "CoverMessage"
                    );


                const coverCounter =
                    document.getElementById(
                        "coverMessageCounter"
                    );


                /* =====================================================
                   STEP ELEMENTS
                   ===================================================== */

                const step1 =
                    document.getElementById(
                        "applicationStep1"
                    );


                const step2 =
                    document.getElementById(
                        "applicationStep2"
                    );


                const progressStep1 =
                    document.getElementById(
                        "applicationProgressStep1"
                    );


                const progressStep2 =
                    document.getElementById(
                        "applicationProgressStep2"
                    );


                const nextButton =
                    document.getElementById(
                        "nextApplicationStep"
                    );


                const previousButton =
                    document.getElementById(
                        "previousApplicationStep"
                    );


                /* =====================================================
                   FILE SIZE
                   ===================================================== */

                function formatFileSize(bytes) {

                    if (bytes === 0)
                        return "0 KB";


                    const units = [
                        "Bytes",
                        "KB",
                        "MB"
                    ];


                    const i =
                        Math.floor(
                            Math.log(bytes) /
                            Math.log(1024)
                        );


                    return (
                        parseFloat(
                            (
                                bytes /
                                Math.pow(1024, i)
                            ).toFixed(2)
                        )
                        + " "
                        + units[i]
                    );

                }


                /* =====================================================
                   DISPLAY FILE
                   ===================================================== */

                function displayFile(file) {

                    if (!file)
                        return;


                    const extension =
                        file.name
                            .substring(
                                file.name.lastIndexOf(".")
                            )
                            .toLowerCase();


                    const allowedExtensions = [
                        ".pdf",
                        ".docx"
                    ];


                    if (
                        !allowedExtensions.includes(
                            extension
                        )
                    ) {

                        alert(
                            "Please upload a PDF or DOCX file."
                        );

                        fileInput.value = "";

                        return false;

                    }


                    if (
                        file.size >
                        5 * 1024 * 1024
                    ) {

                        alert(
                            "Your CV must be smaller than 5 MB."
                        );

                        fileInput.value = "";

                        return false;

                    }


                    fileName.textContent =
                        file.name;


                    fileSize.textContent =
                        formatFileSize(
                            file.size
                        );


                    uploadArea.classList.add(
                        "sc-cv-upload-selected"
                    );


                    uploadIcon.className =
                        "bi bi-check-circle-fill";


                    uploadTitle.textContent =
                        "CV selected successfully";


                    uploadSubtitle.textContent =
                        "Analysing your CV now...";


                    filePreview.classList.add(
                        "sc-cv-file-preview-visible"
                    );


                    return true;

                }


                /* =====================================================
                   SET FIELD
                   ===================================================== */

                function setFieldValue(
                    fieldId,
                    value
                ) {

                    const field =
                        document.getElementById(
                            fieldId
                        );


                    if (!field)
                        return;


                    if (
                        value !== null &&
                        value !== undefined &&
                        String(value).trim() !== ""
                    ) {

                        field.value =
                            value;


                        field.dispatchEvent(
                            new Event(
                                "input",
                                {
                                    bubbles: true
                                }
                            )
                        );


                        field.dispatchEvent(
                            new Event(
                                "change",
                                {
                                    bubbles: true
                                }
                            )
                        );

                    }

                }


                /* =====================================================
                   POPULATE PROFILE
                   ===================================================== */

                function populateExtractedFields(
                    result
                ) {

                    /*
                     * -----------------------------------------------
                     * PERSONAL INFORMATION
                     * -----------------------------------------------
                     */

                    setFieldValue(
                        "Email",
                        result.email
                    );


                    setFieldValue(
                        "PhoneNumber",
                        result.phoneNumber
                    );


                    /*
                     * -----------------------------------------------
                     * FULL NAME
                     * -----------------------------------------------
                     */

                    if (result.fullName) {

                        const fullName =
                            String(
                                result.fullName
                            ).trim();


                        const parts =
                            fullName
                                .split(/\s+/)
                                .filter(Boolean);


                        if (parts.length > 0) {

                            setFieldValue(
                                "FirstName",
                                parts[0]
                            );

                        }


                        if (parts.length > 1) {

                            setFieldValue(
                                "LastName",
                                parts
                                    .slice(1)
                                    .join(" ")
                            );

                        }

                    }


                    /*
                     * -----------------------------------------------
                     * PROFESSIONAL INFORMATION
                     * -----------------------------------------------
                     */

                    setFieldValue(
                        "ProfessionalTitle",
                        result.professionalTitle
                    );


                    setFieldValue(
                        "ProfessionalSummary",
                        result.professionalSummary
                    );


                    setFieldValue(
                        "CareerObjective",
                        result.careerObjective
                    );


                    /*
                     * -----------------------------------------------
                     * LOCATION
                     * -----------------------------------------------
                     */

                    setFieldValue(
                        "Address",
                        result.address
                    );


                    setFieldValue(
                        "City",
                        result.city
                    );


                    setFieldValue(
                        "Province",
                        result.province
                    );


                    setFieldValue(
                        "Country",
                        result.country
                    );


                    /*
                     * -----------------------------------------------
                     * SOCIAL / PROFESSIONAL LINKS
                     * -----------------------------------------------
                     */

                    setFieldValue(
                        "LinkedInUrl",
                        result.linkedInUrl
                    );


                    setFieldValue(
                        "PortfolioUrl",
                        result.portfolioUrl
                    );


                    setFieldValue(
                        "GitHubUrl",
                        result.gitHubUrl
                    );

                }


                /* =====================================================
                   ANALYSE CV
                   ===================================================== */

                async function analyzeCv(file) {

                    if (!file)
                        return;


                    if (extractionStatus)
                        extractionStatus.style.display =
                            "block";


                    if (extractionLoading)
                        extractionLoading.style.display =
                            "flex";


                    if (extractionSuccess)
                        extractionSuccess.style.display =
                            "none";


                    if (extractionError)
                        extractionError.style.display =
                            "none";


                    const formData =
                        new FormData();


                    formData.append(
                        "CV",
                        file
                    );


                    const antiForgeryToken =
                        form.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        );


                    if (antiForgeryToken) {

                        formData.append(
                            "__RequestVerificationToken",
                            antiForgeryToken.value
                        );

                    }


                    try {

                        const response =
                            await fetch(
                                '@Url.Action("AnalyzeCv", "VolunteerOpportunities")',
                                {
                                    method: "POST",
                                    body: formData
                                }
                            );


                        let result;


                        try {

                            result =
                                await response.json();

                        }
                        catch {

                            throw new Error(
                                "The server returned an invalid response."
                            );

                        }


                        if (
                            !response.ok ||
                            !result.success
                        ) {

                            throw new Error(
                                result.message ||
                                "The CV could not be analysed."
                            );

                        }


                        /*
                         * Populate all extracted fields.
                         */

                        populateExtractedFields(
                            result
                        );


                        /*
                         * Success UI.
                         */

                        if (extractionLoading)
                            extractionLoading.style.display =
                                "none";


                        if (extractionSuccess)
                            extractionSuccess.style.display =
                                "flex";


                        if (uploadSubtitle)
                            uploadSubtitle.textContent =
                                "CV analysed successfully. Click to replace it.";


                    }
                    catch (error) {

                        console.error(
                            "CV extraction failed:",
                            error
                        );


                        if (extractionLoading)
                            extractionLoading.style.display =
                                "none";


                        if (extractionError)
                            extractionError.style.display =
                                "flex";


                        if (extractionErrorMessage) {

                            extractionErrorMessage.textContent =
                                error.message ||
                                "Unable to analyse your CV.";

                        }


                        if (uploadSubtitle)
                            uploadSubtitle.textContent =
                                "CV selected. Analysis failed.";

                    }

                }


                /* =====================================================
                   FILE SELECT
                   ===================================================== */

                if (fileInput) {

                    fileInput.addEventListener(
                        "change",
                        async function () {

                            if (
                                this.files &&
                                this.files.length > 0
                            ) {

                                const file =
                                    this.files[0];


                                const valid =
                                    displayFile(
                                        file
                                    );


                                if (!valid)
                                    return;


                                await analyzeCv(
                                    file
                                );

                            }

                        }
                    );

                }


                /* =====================================================
                   DRAG AND DROP
                   ===================================================== */

                if (uploadArea) {

                    uploadArea.addEventListener(
                        "dragover",
                        function (event) {

                            event.preventDefault();

                            uploadArea.classList.add(
                                "sc-cv-upload-dragover"
                            );

                        }
                    );


                    uploadArea.addEventListener(
                        "dragleave",
                        function () {

                            uploadArea.classList.remove(
                                "sc-cv-upload-dragover"
                            );

                        }
                    );


                    uploadArea.addEventListener(
                        "drop",
                        async function (event) {

                            event.preventDefault();


                            uploadArea.classList.remove(
                                "sc-cv-upload-dragover"
                            );


                            const files =
                                event.dataTransfer.files;


                            if (
                                !files ||
                                files.length === 0
                            )
                                return;


                            const file =
                                files[0];


                            const extension =
                                file.name
                                    .substring(
                                        file.name.lastIndexOf(".")
                                    )
                                    .toLowerCase();


                            if (
                                ![
                                    ".pdf",
                                    ".docx"
                                ].includes(
                                    extension
                                )
                            ) {

                                alert(
                                    "Please upload a PDF or DOCX file."
                                );

                                return;

                            }


                            if (
                                file.size >
                                5 * 1024 * 1024
                            ) {

                                alert(
                                    "Your CV must be smaller than 5 MB."
                                );

                                return;

                            }


                            try {

                                const dataTransfer =
                                    new DataTransfer();


                                dataTransfer.items.add(
                                    file
                                );


                                fileInput.files =
                                    dataTransfer.files;

                            }
                            catch (error) {

                                console.warn(
                                    "Unable to assign dropped file.",
                                    error
                                );

                            }


                            const valid =
                                displayFile(
                                    file
                                );


                            if (valid) {

                                await analyzeCv(
                                    file
                                );

                            }

                        }
                    );

                }


                /* =====================================================
                   REMOVE CV
                   ===================================================== */

                if (removeButton) {

                    removeButton.addEventListener(
                        "click",
                        function () {

                            if (fileInput)
                                fileInput.value = "";


                            if (filePreview) {

                                filePreview.classList.remove(
                                    "sc-cv-file-preview-visible"
                                );

                            }


                            if (uploadArea) {

                                uploadArea.classList.remove(
                                    "sc-cv-upload-selected"
                                );

                            }


                            if (uploadIcon) {

                                uploadIcon.className =
                                    "bi bi-cloud-arrow-up-fill";

                            }


                            if (uploadTitle) {

                                uploadTitle.textContent =
                                    "Drop your CV here";

                            }


                            if (uploadSubtitle) {

                                uploadSubtitle.textContent =
                                    "or click to browse your files";

                            }


                            if (extractionStatus) {

                                extractionStatus.style.display =
                                    "none";

                            }


                            /*
                             * Clear extracted fields.
                             */

                            [
                                "ProfessionalTitle",
                                "ProfessionalSummary",
                                "CareerObjective",
                                "Address",
                                "City",
                                "Province",
                                "Country",
                                "PostalCode",
                                "PreferredWorkType",
                                "PreferredLocation",
                                "LinkedInUrl",
                                "PortfolioUrl",
                                "GitHubUrl"
                            ]
                            .forEach(
                                function (id) {

                                    const field =
                                        document.getElementById(
                                            id
                                        );

                                    if (field)
                                        field.value = "";

                                }
                            );

                        }
                    );

                }


                /* =====================================================
                   COVER COUNTER
                   ===================================================== */

                if (
                    coverMessage &&
                    coverCounter
                ) {

                    function updateCoverCounter() {

                        coverCounter.textContent =
                            coverMessage.value.length +
                            " / 2000";

                    }


                    coverMessage.addEventListener(
                        "input",
                        updateCoverCounter
                    );


                    updateCoverCounter();

                }


                /* =====================================================
                   STEP 1 VALIDATION
                   ===================================================== */

                function validateStepOne() {

                    if (!step1)
                        return false;


                    if (coverMessage) {

                        coverMessage.setCustomValidity(
                            ""
                        );

                    }


                    /*
                     * CV
                     */

                    if (
                        fileInput &&
                        (
                            !fileInput.files ||
                            fileInput.files.length === 0
                        )
                    ) {

                        fileInput.setCustomValidity(
                            "Please upload your CV before continuing."
                        );


                        fileInput.reportValidity();

                        return false;

                    }


                    if (fileInput) {

                        fileInput.setCustomValidity(
                            ""
                        );

                    }


                    /*
                     * Required fields.
                     */

                    const requiredFields =
                        step1.querySelectorAll(
                            "input[required], textarea[required], select[required]"
                        );


                    for (
                        const field of requiredFields
                    ) {

                        if (
                            field === fileInput
                        ) {

                            continue;

                        }


                        if (
                            field.type === "checkbox" ||
                            field.type === "radio"
                        ) {

                            continue;

                        }


                        if (
                            field.value.trim() === ""
                        ) {

                            field.setCustomValidity(
                                "This field is required."
                            );


                            field.reportValidity();

                            field.focus();

                            return false;

                        }


                        if (
                            !field.checkValidity()
                        ) {

                            field.reportValidity();

                            field.focus();

                            return false;

                        }

                    }


                    /*
                     * Cover message.
                     */

                    if (coverMessage) {

                        const message =
                            coverMessage.value.trim();


                        if (
                            message.length < 20
                        ) {

                            coverMessage.setCustomValidity(
                                "Your cover message must contain at least 20 characters."
                            );


                            coverMessage.reportValidity();

                            coverMessage.focus();

                            return false;

                        }


                        coverMessage.setCustomValidity(
                            ""
                        );

                    }


                    return true;

                }


                /* =====================================================
                   STEP 2
                   ===================================================== */

                function showStepTwo() {

                    if (!validateStepOne())
                        return;


                    if (!step1 || !step2)
                        return;


                    step1.classList.remove(
                        "sc-application-step-active"
                    );


                    step1.classList.add(
                        "sc-application-step-hidden"
                    );


                    step2.classList.remove(
                        "sc-application-step-hidden"
                    );


                    step2.classList.add(
                        "sc-application-step-active"
                    );


                    if (progressStep1) {

                        progressStep1.classList.remove(
                            "active"
                        );


                        progressStep1.classList.add(
                            "completed"
                        );

                    }


                    if (progressStep2) {

                        progressStep2.classList.add(
                            "active"
                        );

                    }


                    document
                        .querySelector(
                            ".sc-application-card"
                        )
                        ?.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                }


                /* =====================================================
                   STEP 1
                   ===================================================== */

                function showStepOne() {

                    if (!step1 || !step2)
                        return;


                    step2.classList.remove(
                        "sc-application-step-active"
                    );


                    step2.classList.add(
                        "sc-application-step-hidden"
                    );


                    step1.classList.remove(
                        "sc-application-step-hidden"
                    );


                    step1.classList.add(
                        "sc-application-step-active"
                    );


                    if (progressStep2) {

                        progressStep2.classList.remove(
                            "active"
                        );

                    }


                    if (progressStep1) {

                        progressStep1.classList.remove(
                            "completed"
                        );


                        progressStep1.classList.add(
                            "active"
                        );

                    }


                    document
                        .querySelector(
                            ".sc-application-card"
                        )
                        ?.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                }


                /* =====================================================
                   NEXT
                   ===================================================== */

                if (nextButton) {

                    nextButton.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();

                            showStepTwo();

                        }
                    );

                }


                /* =====================================================
                   PREVIOUS
                   ===================================================== */

                if (previousButton) {

                    previousButton.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();

                            showStepOne();

                        }
                    );

                }


                /* =====================================================
                   QUESTION COUNTERS
                   ===================================================== */

                document
                    .querySelectorAll(
                        ".sc-question-answer-textarea"
                    )
                    .forEach(
                        function (textarea) {

                            const wrapper =
                                textarea.closest(
                                    ".sc-question-answer-textarea-wrapper"
                                );


                            if (!wrapper)
                                return;


                            const counter =
                                wrapper.querySelector(
                                    ".sc-question-character-counter"
                                );


                            if (!counter)
                                return;


                            function updateCounter() {

                                counter.textContent =
                                    textarea.value.length +
                                    " / 3000";

                            }


                            textarea.addEventListener(
                                "input",
                                updateCounter
                            );


                            updateCounter();

                        }
                    );


                /* =====================================================
                   QUESTION VALIDATION
                   ===================================================== */

                function validateApplicationQuestions() {

                    if (!step2)
                        return true;


                    const requiredFields =
                        step2.querySelectorAll(
                            "input[required], textarea[required]"
                        );


                    for (
                        const field of requiredFields
                    ) {

                        if (
                            field.type === "radio"
                        ) {

                            const group =
                                step2.querySelectorAll(
                                    `input[type="radio"][name="${CSS.escape(field.name)}"]`
                                );


                            const checked =
                                Array.from(group)
                                    .some(
                                        radio =>
                                            radio.checked
                                    );


                            if (!checked) {

                                const questionId =
                                    field.name.match(
                                        /\[(\d+)\]/
                                    )?.[1];


                                const validation =
                                    step2.querySelector(
                                        `[data-question-validation="${questionId}"]`
                                    );


                                if (validation) {

                                    validation.textContent =
                                        "Please select Yes or No.";

                                }


                                field.focus();

                                return false;

                            }


                            continue;

                        }


                        if (
                            field.value.trim() === ""
                        ) {

                            const questionId =
                                field.name.match(
                                    /\[(\d+)\]/
                                )?.[1];


                            const validation =
                                step2.querySelector(
                                    `[data-question-validation="${questionId}"]`
                                );


                            if (validation) {

                                validation.textContent =
                                    "This question is required.";

                            }


                            field.setCustomValidity(
                                "This question is required."
                            );


                            field.reportValidity();

                            field.focus();

                            return false;

                        }


                        field.setCustomValidity("");

                    }


                    return true;

                }


                /* =====================================================
                   FORM SUBMIT
                   ===================================================== */

                if (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            if (!validateStepOne()) {

                                event.preventDefault();

                                showStepOne();

                                return;

                            }


                            if (
                                !validateApplicationQuestions()
                            ) {

                                event.preventDefault();

                                return;

                            }

                        }
                    );

                }


                /* =====================================================
                   PREVENT ENTER
                   ===================================================== */

                document
                    .querySelectorAll(
                        ".sc-question-answer-input"
                    )
                    .forEach(
                        function (input) {

                            input.addEventListener(
                                "keydown",
                                function (event) {

                                    if (
                                        event.key === "Enter"
                                    ) {

                                        event.preventDefault();

                                    }

                                }
                            );

                        }
                    );


                /* =====================================================
                   CLEAR VALIDATION
                   ===================================================== */

                if (form) {

                    form
                        .querySelectorAll(
                            "input, textarea, select"
                        )
                        .forEach(
                            function (field) {

                                field.addEventListener(
                                    "input",
                                    function () {

                                        if (
                                            this.value.trim() !== ""
                                        ) {

                                            this.setCustomValidity(
                                                ""
                                            );

                                        }

                                    }
                                );


                                field.addEventListener(
                                    "change",
                                    function () {

                                        this.setCustomValidity(
                                            ""
                                        );

                                    }
                                );

                            }
                        );

                }


                /* =====================================================
                   INITIAL STATE
                   ===================================================== */

                if (step1) {

                    step1.classList.add(
                        "sc-application-step-active"
                    );

                    step1.classList.remove(
                        "sc-application-step-hidden"
                    );

                }


                if (step2) {

                    step2.classList.add(
                        "sc-application-step-hidden"
                    );

                    step2.classList.remove(
                        "sc-application-step-active"
                    );

                }


                if (progressStep1) {

                    progressStep1.classList.add(
                        "active"
                    );

                    progressStep1.classList.remove(
                        "completed"
                    );

                }


                if (progressStep2) {

                    progressStep2.classList.remove(
                        "active"
                    );

                }

            }

        );

    </script>

}