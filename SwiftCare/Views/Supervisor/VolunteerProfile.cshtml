@using SwiftCare.Models
@using SwiftCare.Helpers
@using System.Linq
@model SwiftCare.ViewModels.VolunteerProfileViewModel

@{
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
    ViewData["Title"] = "Volunteer Profile";

var todaysStatus =
        ViewBag.TodaysStatus?.ToString()
        ?? "No Shift Today";

    var statusClass = todaysStatus switch
    {
        "No Shift Today" =>
            "vp-status-pending",

        "Shift Not Started" =>
            "vp-status-shift-not-started",

        "Not Checked In" =>
            "vp-status-not-checked-in",

        "Checked In" =>
            "vp-status-completed",

        "Present" =>
            "vp-status-completed",

        "Late" =>
            "vp-status-late",

        "Checked Out" =>
            "vp-status-checked-out",

        "Absent" =>
            "vp-status-absent",

        _ =>
            "vp-status-pending"
    };

    var statusIcon = todaysStatus switch
    {
        "No Shift Today" =>
            "bi-calendar-x",

        "Shift Not Started" =>
            "bi-clock",

        "Not Checked In" =>
            "bi-box-arrow-in-right",

        "Checked In" =>
            "bi-check-circle-fill",

        "Present" =>
            "bi-check-circle-fill",

        "Late" =>
            "bi-clock-history",

        "Checked Out" =>
            "bi-box-arrow-right",

        "Absent" =>
            "bi-person-x-fill",

        _ =>
            "bi-info-circle"
    };

    var completedCount =
        Model.CurrentWeekAssignments.Count(x =>
            x.Status == VolunteerTaskAssignmentStatus.Completed)
        +
        Model.UpcomingWeekAssignments.Count(x =>
            x.Status == VolunteerTaskAssignmentStatus.Completed);

    var inProgressCount =
        Model.CurrentWeekAssignments.Count(x =>
            x.Status == VolunteerTaskAssignmentStatus.InProgress)
        +
        Model.UpcomingWeekAssignments.Count(x =>
            x.Status == VolunteerTaskAssignmentStatus.InProgress);

    var volunteerInitials =
        $"{Model.Volunteer.FirstName?.Trim().FirstOrDefault()}{Model.Volunteer.LastName?.Trim().FirstOrDefault()}"
            .ToUpperInvariant();

    var defaultAssignmentDate = Model.CurrentWeekStart;

    if (DateTime.Today >= Model.CurrentWeekStart &&
        DateTime.Today <= Model.CurrentWeekEnd)
    {
        defaultAssignmentDate = DateTime.Today;

        if (defaultAssignmentDate.DayOfWeek == DayOfWeek.Saturday)
        {
            defaultAssignmentDate = defaultAssignmentDate.AddDays(-1);
        }
        else if (defaultAssignmentDate.DayOfWeek == DayOfWeek.Sunday)
        {
            defaultAssignmentDate = defaultAssignmentDate.AddDays(-2);
        }
    }
    else
    {
        defaultAssignmentDate = Model.UpcomingWeekStart;
    }

    TimeZoneInfo attendanceTimeZone;
    try
    {
        attendanceTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Africa/Johannesburg");
    }
    catch (TimeZoneNotFoundException)
    {
        attendanceTimeZone = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
    }

    var calendarWeeks = new[]
    {
        new
        {
            WeekType = "current",
            Label = "Current Week",
            Kicker = "THIS WEEK",
            Start = Model.CurrentWeekStart,
            End = Model.CurrentWeekEnd,
            Roster = Model.CurrentRoster,
            Shifts = Model.CurrentWeekShifts,
            Assignments = Model.CurrentWeekAssignments
        },
        new
        {
            WeekType = "upcoming",
            Label = "Upcoming Week",
            Kicker = "NEXT WEEK",
            Start = Model.UpcomingWeekStart,
            End = Model.UpcomingWeekEnd,
            Roster = Model.UpcomingRoster,
            Shifts = Model.UpcomingWeekShifts,
            Assignments = Model.UpcomingWeekAssignments
        }
    };
}

<div class="vp-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->
    <section class="vp-page-header">

        <div>
            <span class="vp-eyebrow">
                VOLUNTEER MANAGEMENT
            </span>

            <h1>
                Volunteer Profile
            </h1>

            <p>
                Manage volunteer information, weekly schedules and assigned tasks.
            </p>
        </div>

        <div class="vp-page-header-actions">

            <div class="vp-header-badge">
                <span class="vp-header-dot"></span>
                Volunteer Profile
            </div>

        </div>

    </section>


    <!-- =========================================================
         AJAX MESSAGE
         ========================================================= -->
    <div id="vpAjaxMessage"
         class="vp-ajax-message"
         role="alert">
    </div>


    <!-- =========================================================
         PROFILE
         ========================================================= -->
    <section class="vp-profile-card">

        <div class="vp-profile-main">

            <div class="vp-avatar-wrap">

                <div class="vp-avatar">
                    @volunteerInitials
                </div>

                <span class="vp-avatar-status"></span>

            </div>


            <div class="vp-profile-information">

                <div class="vp-profile-name-row">

                    <div>

                        <h2>
                            @Model.Volunteer.FirstName
                            @Model.Volunteer.LastName
                        </h2>

                        <p class="vp-profile-subtitle">
                            Volunteer

                            @if (!string.IsNullOrWhiteSpace(Model.AreaName))
                            {
                                <span>
                                    • @Model.AreaName
                                </span>
                            }
                        </p>

                    </div>

                    <span class="vp-status-pill @statusClass">
                        <i class="bi @statusIcon"></i>
                        @todaysStatus
                    </span>

                </div>


                <div class="vp-profile-details">

                    <div class="vp-detail-item">

                        <span class="vp-detail-label">
                            Email
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Volunteer.Email)
                                ? "Not provided"
                                : Model.Volunteer.Email)
                        </strong>

                    </div>


                    <div class="vp-detail-item">

                        <span class="vp-detail-label">
                            Phone
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Volunteer.PhoneNumber)
                                ? "Not provided"
                                : Model.Volunteer.PhoneNumber)
                        </strong>

                    </div>


                    <div class="vp-detail-item">

                        <span class="vp-detail-label">
                            Area
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.AreaName)
                                ? "Not assigned"
                                : Model.AreaName)
                        </strong>

                    </div>


                    <div class="vp-detail-item">

                        <span class="vp-detail-label">
                            Volunteer number
                        </span>

                        <strong>
                            @(Model.Volunteer == null
                                ? "Not assigned"
                                : $"{Model.Volunteer.VolunteerNumber}")
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         STATISTICS
         ========================================================= -->
    <section class="vp-stat-grid">

        <div class="vp-stat-card">

            <div class="vp-stat-icon">
                <i class="bi bi-calendar-week"></i>
            </div>

            <div>

                <span class="vp-stat-label">
                    Current Week Tasks
                </span>

                <strong>
                    @Model.CurrentWeekAssignments.Count
                </strong>

            </div>

        </div>


        <div class="vp-stat-card">

            <div class="vp-stat-icon">
                <i class="bi bi-calendar2-week"></i>
            </div>

            <div>

                <span class="vp-stat-label">
                    Next Week Tasks
                </span>

                <strong>
                    @Model.UpcomingWeekAssignments.Count
                </strong>

            </div>

        </div>


        <div class="vp-stat-card">

            <div class="vp-stat-icon vp-stat-icon-completed">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>

                <span class="vp-stat-label">
                    Completed
                </span>

                <strong id="vpCompletedCount">
                    @completedCount
                </strong>

            </div>

        </div>


        <div class="vp-stat-card">

            <div class="vp-stat-icon vp-stat-icon-progress">
                <i class="bi bi-arrow-repeat"></i>
            </div>

            <div>

                <span class="vp-stat-label">
                    In Progress
                </span>

                <strong id="vpInProgressCount">
                    @inProgressCount
                </strong>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CALENDAR
         ========================================================= -->
    <section class="vp-calendar-section">

        <div class="vp-section-card vp-calendar-card">

            <div class="vp-section-header">

                <div>

                    <span class="vp-section-kicker">
                        VOLUNTEER SCHEDULE
                    </span>

                    <h3>
                        Weekly Calendar
                    </h3>

                    <p>
                        View rosters, shifts and assigned volunteer tasks by day.
                    </p>

                </div>


                <div class="vp-calendar-legend">

                    <span class="vp-calendar-legend-item">

                        <span class="vp-calendar-legend-dot vp-calendar-legend-task"></span>

                        Assigned task

                    </span>


                    <span class="vp-calendar-legend-item">

                        <span class="vp-calendar-legend-dot vp-calendar-legend-weekend"></span>

                        Weekend

                    </span>

                </div>

            </div>


            <!-- =================================================
                 CALENDAR
                 ================================================= -->
            <div class="vp-calendar-wrapper">

                @foreach (var calendarWeek in calendarWeeks)
                {
                    var weekAssignments = calendarWeek.Assignments
                        .OrderBy(x => x.TaskDate)
                        .ThenBy(x => x.StartTime)
                        .ToList();

                    var weekShifts = calendarWeek.Shifts
                        .OrderBy(x => x.ShiftDate)
                        .ThenBy(x => x.StartTime)
                        .ToList();

                    <div class="vp-calendar-week"
                         data-calendar-week="@calendarWeek.Start.ToString("yyyy-MM-dd")">

                        <!-- =====================================
                             WEEK HEADER
                             ===================================== -->
                        <div class="vp-calendar-week-header">

                            <div>

                                <span class="vp-calendar-week-kicker">
                                    @calendarWeek.Kicker
                                </span>

                                <h4>
                                    @calendarWeek.Label
                                </h4>

                                <p class="vp-calendar-week-dates">

                                    @calendarWeek.Start.ToString("dd MMM yyyy")
                                    -
                                    @calendarWeek.End.ToString("dd MMM yyyy")

                                </p>

                            </div>


                            <div class="vp-calendar-week-summary">

                                @if (calendarWeek.Roster != null)
                                {
                                    var rosterStatusClass =
                                        calendarWeek.Roster.Status
                                            .ToString()
                                            .ToLowerInvariant();

                                    <span class="vp-calendar-roster-badge vp-calendar-roster-@rosterStatusClass">

                                        <i class="bi bi-calendar-check"></i>

                                        <span class="vp-calendar-roster-status-text">
                                            @calendarWeek.Roster.Status.GetDisplayName()
                                        </span>

                                    </span>
                                }
                                else
                                {
                                    <span class="vp-calendar-roster-badge vp-calendar-roster-none">

                                        <i class="bi bi-calendar-x"></i>

                                        No roster

                                    </span>
                                }


                                <span class="vp-calendar-task-count">

                                    <i class="bi bi-list-check"></i>

                                    <span class="vp-calendar-task-count-value">
                                        @weekAssignments.Count
                                    </span>

                                    tasks

                                </span>


                                @if (calendarWeek.Roster == null)
                                {
                                    <button type="button"
                                            class="vp-assign-button vp-create-roster-trigger"
                                            data-week="@calendarWeek.WeekType">

                                        <i class="bi bi-calendar-plus"></i>

                                        @if (calendarWeek.WeekType == "current")
                                        {
                                            <span>
                                                Create Roster
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Create Next Roster
                                            </span>
                                        }

                                    </button>
                                }

                            </div>

                        </div>


                        <!-- =====================================
                             DAYS
                             ===================================== -->
                        <div class="vp-calendar-grid">

                            @for (var dayOffset = 0; dayOffset < 7; dayOffset++)
                            {
                                var calendarDate =
                                    calendarWeek.Start.AddDays(dayOffset);

                                var dayAssignments = weekAssignments
                                    .Where(x =>
                                        x.TaskDate.Date ==
                                        calendarDate.Date)
                                    .OrderBy(x => x.StartTime)
                                    .ThenBy(x => x.EndTime)
                                    .ToList();

                                var dayShifts = weekShifts
                                    .Where(x =>
                                        x.ShiftDate.Date ==
                                        calendarDate.Date)
                                    .OrderBy(x => x.StartTime)
                                    .ThenBy(x => x.EndTime)
                                    .ToList();

                                var isToday =
                                    calendarDate.Date ==
                                    DateTime.Today;

                                var isWeekend =
                                    calendarDate.DayOfWeek ==
                                        DayOfWeek.Saturday ||
                                    calendarDate.DayOfWeek ==
                                        DayOfWeek.Sunday;

                                var hasTasks =
                                    dayAssignments.Any();

                                var hasShifts =
                                    dayShifts.Any();

                                var dayClasses =
                                    "vp-calendar-day" +
                                    (isWeekend
                                        ? " vp-calendar-day-weekend"
                                        : "") +
                                    (isToday
                                        ? " vp-calendar-day-today"
                                        : "") +
                                    (hasTasks
                                        ? " vp-calendar-day-has-tasks"
                                        : "");

                                <div class="@dayClasses"
                                     data-calendar-date="@calendarDate.ToString("yyyy-MM-dd")">

                                    <!-- =================================
                                         DAY HEADER
                                         ================================= -->
                                    <div class="vp-calendar-day-header">

                                        <div>

                                            <span class="vp-calendar-day-name">
                                                @calendarDate.ToString("ddd")
                                            </span>

                                            <span class="vp-calendar-day-number">
                                                @calendarDate.Day
                                            </span>

                                        </div>


                                        @if (isToday)
                                        {
                                            <span class="vp-calendar-day-indicator">

                                                <i class="bi bi-star-fill"></i>

                                            </span>
                                        }

                                    </div>

                                    <!-- =================================
     DAY BODY
     ================================= -->
                                    <div class="vp-calendar-day-body">

                                        <!-- =================================
         SHIFT
         ================================= -->
                                        @if (hasShifts)
                                        {
                                            foreach (var shift in dayShifts)
                                            {
                                                var isDayOff =
                                                    shift.Status.GetDisplayName()
                                                        .Equals("Day Off", StringComparison.OrdinalIgnoreCase);

                                                if (isDayOff)
                                                {
                                                    <!-- DAY OFF -->
                                                    <div class="vp-calendar-shift vp-calendar-shift-day-off">

                                                        <div class="vp-calendar-shift-label">

                                                            <i class="bi bi-calendar-x"></i>

                                                            <span>
                                                                DAY OFF
                                                            </span>

                                                        </div>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- SCHEDULED SHIFT -->
                                                    <div class="vp-calendar-shift vp-calendar-shift-scheduled">

                                                        <div class="vp-calendar-shift-label">

                                                            <i class="bi bi-clock"></i>
                                                        </div>

                                                        <div class="vp-calendar-shift-time">

                                                            @shift.StartTime.ToString(@"hh\:mm")
                                                            -
                                                            @shift.EndTime.ToString(@"hh\:mm")

                                                        </div>

                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <!-- NO SHIFT -->
                                            <div class="vp-calendar-shift vp-calendar-shift-none">

                                                <i class="bi bi-calendar-x"></i>

                                                <span>
                                                    NO SHIFT
                                                </span>

                                            </div>
                                        }


                                        <!-- =================================
         TASKS
         ================================= -->
                                        @if (hasTasks)
                                        {
                                            foreach (var assignment in dayAssignments)
                                            {
                                                var taskStatusClass =
                                                    assignment.Status
                                                        .ToString()
                                                        .ToLowerInvariant()
                                                        .Replace(" ", "");

                                                var taskArea =
                                                    assignment.VolunteerTask == null
                                                        ? ""
                                                        : assignment.VolunteerTask.Area.GetDisplayName();

                                                var taskPriority =
                                                    assignment.VolunteerTask == null
                                                        ? ""
                                                        : assignment.VolunteerTask.Priority.GetDisplayName();

                                                <button type="button"
                                                        class="vp-calendar-task vp-calendar-task-@taskStatusClass"
                                                        data-calendar-task="true"
                                                        data-volunteer-task-id="@assignment.VolunteerTaskId"
                                                        data-task-title="@assignment.VolunteerTask?.Title"
                                                        data-task-description="@assignment.VolunteerTask?.Description"
                                                        data-task-date="@assignment.TaskDate.ToString("yyyy-MM-dd")"
                                                        data-task-area="@taskArea"
                                                        data-task-priority="@taskPriority"
                                                        data-task-status="@assignment.Status.GetDisplayName()"
                                                        data-task-started-date="@(assignment.StartedDate?.ToString("o") ?? "")"
                                                        data-task-completed-date="@(assignment.CompletedDate?.ToString("o") ?? "")"
                                                        data-task-completion-notes="@assignment.CompletionNotes"
                                                        data-task-start="@assignment.StartTime.ToString(@"hh\:mm")"
                                                        data-task-end="@assignment.EndTime.ToString(@"hh\:mm")">

                                                    <span class="vp-calendar-task-time">

                                                        @assignment.StartTime.ToString(@"hh\:mm")
                                                        -
                                                        @assignment.EndTime.ToString(@"hh\:mm")

                                                    </span>

                                                    <span class="vp-calendar-task-title">

                                                        @assignment.VolunteerTask?.Title

                                                    </span>

                                                </button>
                                            }
                                        }

                                    </div>

                                </div>
                            }

                        </div>


                        <!-- =====================================
                             WEEK EMPTY / STATUS
                             ===================================== -->
                        @if (calendarWeek.Roster == null)
                        {
                            <div class="vp-calendar-week-empty">

                                <i class="bi bi-calendar-plus"></i>

                                <div>

                                    <strong>
                                        No roster created for this week
                                    </strong>

                                    <span>
                                        Create a roster above before assigning volunteer tasks.
                                    </span>

                                </div>

                            </div>
                        }
                        else if (!weekAssignments.Any() && !weekShifts.Any())
                        {
                            <div class="vp-calendar-week-empty">

                                <i class="bi bi-calendar-check"></i>

                                <div>

                                    <strong>
                                        Roster created — no shifts or tasks yet
                                    </strong>

                                    <span>
                                        The volunteer's shifts and assigned tasks will appear here.
                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </section>
    <br />

    <!-- =========================================================
     VOLUNTEER ATTENDANCE — CURRENT WEEK
     ========================================================= -->
    <section class="vp-attendance-section vp-library-card vp-library-card-full">

        <div class="vp-library-header">
            <div>
                <span class="vp-section-kicker">THIS WEEK</span>

                <h3>Volunteer Attendance</h3>

                <p>
                    Attendance for the current roster week,
                    Monday @Model.CurrentWeekStart.ToString("dd MMM")
                    -
                    @Model.CurrentWeekEnd.ToString("dd MMM yyyy").
                </p>
            </div>

            <div class="vp-library-count">
                @Model.Attendances.Count
            </div>
        </div>

        @if (Model.Attendances.Any())
        {
            <div class="vp-attendance-list">

                <div class="vp-attendance-item">

                    <div class="vp-attendance-table-wrapper">

                        <table class="vp-attendance-table">

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Shift</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Late</th>
                                    <th>Early Departure</th>
                                    <th>Status</th>
                                    <th>Face</th>
                                    <th>Liveness</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var attendance in Model.Attendances)
                                {
                                    var rosterShift = attendance.VolunteerRosterShift;

                                    var statusName =
                                        attendance.Status.GetDisplayName();

                                    var attendanceStatusClass =
                                        attendance.Status == VolunteerAttendanceStatus.Late
                                            ? "vp-attendance-status-late"
                                            : attendance.Status == VolunteerAttendanceStatus.Absent
                                                ? "vp-attendance-status-absent"
                                                : attendance.Status == VolunteerAttendanceStatus.CheckedOut
                                                    ? "vp-attendance-status-checkedout"
                                                    : "";

                                    <tr>

                                        <!-- =====================================================
                                         DATE
                                         ===================================================== -->
                                        <td>
                                            <span class="vp-attendance-date">
                                                @(
                                                    rosterShift != null
                                                        ? rosterShift.ShiftDate.ToString("dd MMM yyyy")
                                                        : attendance.AttendanceDate.ToString("dd MMM yyyy")
                                                )
                                            </span>

                                            <span class="vp-attendance-day">
                                                @(
                                                    rosterShift != null
                                                        ? rosterShift.ShiftDate.ToString("dddd")
                                                        : attendance.AttendanceDate.ToString("dddd")
                                                )
                                            </span>
                                        </td>


                                        <!-- =====================================================
                                         SHIFT
                                         ===================================================== -->
                                        <td>
                                            @if (rosterShift != null)
                                            {
                                                <span class="vp-attendance-shift-time">
                                                    @rosterShift.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @rosterShift.EndTime.ToString(@"hh\:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    Shift unavailable
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         CHECK IN
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.CheckInTime.HasValue)
                                            {
                                                var checkIn =
                                                    TimeZoneInfo.ConvertTimeFromUtc(
                                                        DateTime.SpecifyKind(
                                                            attendance.CheckInTime.Value,
                                                            DateTimeKind.Utc),
                                                        attendanceTimeZone);

                                                <span class="vp-attendance-date">
                                                    @checkIn.ToString("HH:mm")
                                                </span>

                                                <span class="vp-attendance-day">
                                                    @checkIn.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    Not checked in
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         CHECK OUT
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.CheckOutTime.HasValue)
                                            {
                                                var checkOut =
                                                    TimeZoneInfo.ConvertTimeFromUtc(
                                                        DateTime.SpecifyKind(
                                                            attendance.CheckOutTime.Value,
                                                            DateTimeKind.Utc),
                                                        attendanceTimeZone);

                                                <span class="vp-attendance-date">
                                                    @checkOut.ToString("HH:mm")
                                                </span>

                                                <span class="vp-attendance-day">
                                                    @checkOut.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    Not checked out
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         LATE
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.LateMinutes > 0)
                                            {
                                                <span class="vp-attendance-status vp-attendance-status-late">
                                                    @attendance.LateMinutes min
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-verified">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    On time
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         EARLY DEPARTURE
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.EarlyDepartureMinutes > 0)
                                            {
                                                <span class="vp-attendance-status vp-attendance-status-late">
                                                    @attendance.EarlyDepartureMinutes min
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-verified">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    None
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         STATUS
                                         ===================================================== -->
                                        <td>
                                            <span class="vp-attendance-status @attendanceStatusClass">
                                                @statusName
                                            </span>
                                        </td>


                                        <!-- =====================================================
                                         FACE VERIFICATION
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.FaceVerified)
                                            {
                                                <span class="vp-attendance-verified">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    Not verified
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         LIVENESS
                                         ===================================================== -->
                                        <td>
                                            @if (attendance.LivenessVerified)
                                            {
                                                <span class="vp-attendance-verified">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    Not verified
                                                </span>
                                            }
                                        </td>


                                        <!-- =====================================================
                                         NOTES
                                         ===================================================== -->
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(attendance.Notes))
                                            {
                                                @attendance.Notes
                                            }
                                            else
                                            {
                                                <span class="vp-attendance-not-verified">
                                                    —
                                                </span>
                                            }
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="vp-library-empty">

                <i class="bi bi-calendar-check"></i>

                <h4>No attendance this week</h4>

                <p>
                    No attendance has been recorded for this volunteer
                    during the current roster week.
                </p>

                <small>
                    @Model.CurrentWeekStart.ToString("dd MMM yyyy")
                    -
                    @Model.CurrentWeekEnd.ToString("dd MMM yyyy")
                </small>

            </div>
        }

    </section>

    <!-- =========================================================
         TASK LIBRARY
         ========================================================= -->
    <section class="vp-library-card vp-library-card-full">

        <div class="vp-library-header">

            <div>

                <span class="vp-section-kicker">
                    TASK MANAGEMENT
                </span>

                <h3>
                    Task Library
                </h3>

                <p>
                    Assign available
                    <strong>@Model.AreaName</strong>
                    tasks to this volunteer.
                </p>

            </div>


            <div class="vp-library-count">
                @Model.AreaTasks.Count
            </div>

        </div>


        @if (!string.IsNullOrWhiteSpace(Model.AreaName))
        {
            <div class="vp-filtered-label">

                <i class="bi bi-funnel-fill"></i>

                Showing tasks for:

                <strong>
                    @Model.AreaName
                </strong>

            </div>
        }


        @if (Model.AreaTasks.Any())
        {
            <div class="vp-library-list">

                @foreach (var task in Model.AreaTasks)
                {
                    var priorityClass =
                        task.Priority
                            .ToString()
                            .ToLowerInvariant();

                    <div class="vp-library-task">

                        <div class="vp-library-task-content">

                            <div class="vp-library-task-heading">

                                <span class="vp-library-task-area">
                                    @task.Area.GetDisplayName()
                                </span>

                                <span class="vp-priority vp-priority-@priorityClass">
                                    @task.Priority.GetDisplayName()
                                </span>

                            </div>


                            <h4>
                                @task.Title
                            </h4>


                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <p>
                                    @task.Description
                                </p>
                            }
                            else
                            {
                                <p class="vp-no-description">
                                    No description provided.
                                </p>
                            }

                        </div>


                        <button type="button"
                                class="vp-assign-button js-open-assign"
                                data-task-id="@task.VolunteerTaskId"
                                data-task-title="@task.Title"
                                data-task-description="@task.Description">

                            <i class="bi bi-plus-lg"></i>

                            Assign

                        </button>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="vp-library-empty">

                <i class="bi bi-inbox"></i>

                <h4>
                    No tasks available
                </h4>

                <p>
                    There are currently no tasks available for this volunteer's area.
                </p>

            </div>
        }

    </section>

</div>


<!-- =============================================================
     CREATE ROSTER MODAL
     ============================================================= -->
@await Html.PartialAsync(
    "~/Views/Supervisor/Partials/_CreateRosterModal.cshtml",
    new VolunteerRoster
    {
        VolunteerId = Model.Volunteer.Id,
        SupervisorId = Model.Volunteer.SupervisorId,
        Volunteer = Model.Volunteer
    })


<!-- =============================================================
     ASSIGN TASK MODAL
     ============================================================= -->
<div id="vpAssignModal"
     class="vp-modal"
     aria-hidden="true">

    <div class="vp-modal-backdrop js-close-assign-modal"></div>

    <div class="vp-modal-dialog"
         role="dialog"
         aria-modal="true">

        <div class="vp-modal-header">

            <div class="vp-modal-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <button type="button"
                    class="vp-modal-close js-close-assign-modal"
                    aria-label="Close">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="vp-modal-body">

            <span class="vp-modal-kicker">
                TASK ASSIGNMENT
            </span>

            <h2>
                Assign Task
            </h2>


            <div class="vp-modal-task-description">

                <span>
                    Selected Task
                </span>

                <p id="vpModalTaskTitle">
                    —
                </p>

                <p id="vpModalTaskDescription">
                </p>

            </div>


            <form id="vpAssignForm"
                  asp-controller="Supervisor"
                  asp-action="AssignTaskFromProfile"
                  method="post"
                  class="vp-assign-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="vpModalTaskId"
                       name="VolunteerTaskId" />

                <input type="hidden"
                       name="VolunteerId"
                       value="@Model.Volunteer.Id" />


                <div class="vp-form-group">

                    <label for="vpTaskDate">
                        Task Date
                    </label>

                    <input type="date"
                           id="vpTaskDate"
                           name="TaskDate"
                           class="vp-form-input"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           max="@Model.UpcomingWeekEnd.ToString("yyyy-MM-dd")"
                           value="@defaultAssignmentDate.ToString("yyyy-MM-dd")"
                           required />

                    <small>
                        Tasks can only be assigned within the displayed roster weeks.
                    </small>

