@using Microsoft.AspNetCore.Identity
@using SwiftCare.Data
@using SwiftCare.Models
@using SwiftCare.Interfaces
@using Microsoft.EntityFrameworkCore

@inject SignInManager<UserBaseModel> SignInManager
@inject UserManager<UserBaseModel> UserManager
@inject SwiftCareDbContext _context
@inject IEncryptionService EncryptionService
@inject IWebHostEnvironment WebHostEnvironment

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    UserBaseModel? user = null;

    if (isAuthenticated)
    {
        user = await UserManager.GetUserAsync(User);
    }

    var firstName = user?.FirstName ?? "";
    var lastName = user?.LastName ?? "";

    var userRole = "";

    if (user != null)
    {
        userRole = _context.UserRoles
            .Where(ur => ur.UserId == user.Id)
            .Join(
                _context.Roles,
                ur => ur.RoleId,
                r => r.Id,
                (ur, r) => r.Name
            )
            .FirstOrDefault() ?? "";
    }

    var profilePhotoUrl = "";

    if (user != null && !string.IsNullOrEmpty(user.ProfilePicture))
    {
        profilePhotoUrl = Url.Content("~/" + user.ProfilePicture);
    }

    var encryptedUserId = "";

    if (user != null)
    {
        encryptedUserId = EncryptionService.Encrypt(user.Id.ToString());
    }
}

