
@model IEnumerable<SwiftCare.Models.Resident>

@{
    ViewData["Title"] = "Residents";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var residentCount = Model?.Count() ?? 0;
}
<br />
<div class="sc-residents-page">

    <!-- ============================================================
         HERO HEADER
         ============================================================ -->

    <div class="sc-residents-hero">

        <div class="sc-residents-hero-bg"></div>

        <div class="sc-residents-hero-content">

            <div class="sc-residents-heading">

                <a asp-controller="Home"
                       asp-action="Index"
                       class="sc-back-button">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <div class="sc-residents-title">

                    <div class="sc-residents-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div>
                        <h1>Residents</h1>

                        <p>
                            View, search and manage all registered residents.
                        </p>
                    </div>

                </div>

            </div>


            <div class="sc-residents-count">

                <div class="sc-count-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>
                    <span>Total Residents</span>
                    <strong>@residentCount</strong>
                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <div class="sc-residents-content">


        <!-- ========================================================
             SEARCH PANEL
             ======================================================== -->

        <div class="sc-search-card">

            <div class="sc-search-card-left">

                <div class="sc-search-heading-icon">
                    <i class="bi bi-search"></i>
                </div>

                <div>

                    <h4>Find a Resident</h4>

                    <p>
                        Search by name, email, phone number or room.
                    </p>

                </div>

            </div>


            <div class="sc-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="residentSearch"
                       placeholder="Search residents..." />

                <button type="button"
                        id="clearResidentSearch"
                        class="sc-clear-search"
                        title="Clear search">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>


        <!-- ========================================================
             EMPTY STATE
             ======================================================== -->
        @if (Model == null || !Model.Any())
        {
            <div class="sc-empty-residents">

                <div class="sc-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>No Residents Found</h3>

                <p>
                    There are currently no residents registered in the system.
                </p>

            </div>
        }
        else
        {

            <!-- ====================================================
                 RESIDENTS GLASS CARD
                 ==================================================== -->

            <div class="sc-residents-glass">

                <div class="sc-table-header">

                    <div>

                        <h3>Resident Directory</h3>

                        <p>
                            @residentCount resident@(residentCount == 1 ? "" : "s") currently registered
                        </p>

                    </div>


                    <div class="sc-table-header-icon">

                        <i class="bi bi-person-vcard-fill"></i>

                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table sc-residents-table"
                           id="residentsTable">

                        <thead>

                            <tr>

                                <th>Resident</th>

                                <th>Contact Information</th>

                                <th>Date of Birth</th>

                                <th>Room</th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var resident in Model)
                            {
                                var profileImage =
                                    string.IsNullOrWhiteSpace(resident.ProfilePicture)
                                        ? Url.Content("~/Images/default_profile_image.jpg")
                                        : Url.Content("~/" + resident.ProfilePicture.TrimStart('/'));

                                <tr>

                                    <!-- =================================================
                                         RESIDENT
                                         ================================================= -->

                                    <td>

                                        <div class="sc-resident-profile-cell">

                                            <div class="sc-profile-image-wrapper">

                                                <img src="@profileImage"
                                                     alt="@resident.FirstName @resident.LastName"
                                                     class="sc-resident-profile-image"
                                                     onerror="this.src='@Url.Content("~/Images/default_profile_image.jpg")'" />

                                            </div>


                                            <div class="sc-resident-info">

                                                <h5>
                                                    @resident.FirstName @resident.LastName
                                                </h5>

                                                <span>

                                                    <i class="bi bi-person"></i>

                                                    Resident

                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- =================================================
                                         CONTACT
                                         ================================================= -->

                                    <td>

                                        <div class="sc-contact-info">

                                            @if (!string.IsNullOrWhiteSpace(resident.Email))
                                            {
                                                <div class="sc-contact-row">

                                                    <div class="sc-contact-icon">

                                                        <i class="bi bi-envelope"></i>

                                                    </div>

                                                    <span>
                                                        @resident.Email
                                                    </span>

                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(resident.PhoneNumber))
                                            {
                                                <div class="sc-contact-row">

                                                    <div class="sc-contact-icon">

                                                        <i class="bi bi-telephone"></i>

                                                    </div>

                                                    <span>
                                                        @resident.PhoneNumber
                                                    </span>

                                                </div>
                                            }

                                            @if (string.IsNullOrWhiteSpace(resident.Email)
                                                && string.IsNullOrWhiteSpace(resident.PhoneNumber))
                                            {
                                                <span class="sc-not-provided">

                                                    Not provided

                                                </span>
                                            }

                                        </div>

                                    </td>


                                    <!-- =================================================
                                         DATE OF BIRTH
                                         ================================================= -->

                                    <td>

                                        <div class="sc-date-info">

                                            <div class="sc-date-icon">

                                                <i class="bi bi-calendar3"></i>

                                            </div>

                                            <span>

                                                @resident.DateOfBirth.ToString("dd MMM yyyy")

                                            </span>

                                        </div>

                                    </td>


                                    <!-- =================================================
                                         ROOM
                                         ================================================= -->

                                    <td>
                                            <div class="sc-room-badge">

                                                <i class="bi bi-door-open-fill"></i>

                                                <span>
                                                    Room @resident.RoomNumber
                                                </span>

                                            </div>
                                    </td>


                                    <!-- =================================================
                                         ACTION
                                         ================================================= -->

                                    <td class="text-end">

                                        <a asp-controller="Residents"
                                               asp-action="ResidentDetails"
                                               asp-route-id="@resident.Id"
                                               class="sc-details-button">

                                            <span>
                                                View Details
                                            </span>

                                            <i class="bi bi-arrow-right"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- ====================================================
                     NO SEARCH RESULTS
                     ==================================================== -->

                <div id="noSearchResults"
                     class="sc-no-search-results"
                     style="display:none;">

                    <div class="sc-empty-icon">

                        <i class="bi bi-search"></i>

                    </div>

                    <h4>No Residents Found</h4>

                    <p>
                        Try searching using a different name, email or room.
                    </p>

                </div>

            </div>

        }

    </div>

</div>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("residentSearch");

            const clearButton =
                document.getElementById("clearResidentSearch");

            const table =
                document.getElementById("residentsTable");

            const noResults =
                document.getElementById("noSearchResults");


            if (!searchInput || !table) {
                return;
            }


            searchInput.addEventListener("input", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    table.querySelectorAll("tbody tr");

                let visibleRows = 0;


                rows.forEach(function (row) {

                    const rowText =
                        row.textContent
                            .toLowerCase();

                    if (rowText.includes(searchValue)) {

                        row.style.display = "";

                        visibleRows++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });


                if (noResults) {

                    if (visibleRows === 0) {

                        noResults.style.display =
                            "block";

                    }
                    else {

                        noResults.style.display =
                            "none";

                    }

                }


                if (clearButton) {

                    clearButton.style.opacity =
                        searchValue.length > 0
                            ? "1"
                            : "0";

                }

            });


            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        searchInput.dispatchEvent(
                            new Event("input")
                        );

                        searchInput.focus();

                    }
                );

            }

        });

    </script>


