
@using SwiftCare.Models
@using SwiftCare.Helpers

@model IEnumerable<VolunteerOpportunity>

@{
    ViewData["Title"] = "SwiftCare";
}

<div class="swiftcare-page container-fluid">

    <!-- =========================================================
         BACKGROUND DECORATION
         ========================================================= -->

    <div class="swiftcare-circle swiftcare-circle-one"></div>
    <div class="swiftcare-circle swiftcare-circle-two"></div>


    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="swiftcare-hero">

        <div class="swiftcare-container">

            <div class="swiftcare-hero-grid">

                <!-- =================================================
                     INTRODUCTION
                     ================================================= -->

                <div class="swiftcare-hero-content">

                    <div class="swiftcare-welcome">

                        <span class="swiftcare-welcome-dot"></span>

                        <i class="bi bi-heart-pulse"></i>

                        Welcome to SwiftCare

                    </div>


                    <h1 class="swiftcare-title">

                        Caring with
                        <br />

                        <span>compassion.</span>

                    </h1>


                    <p class="swiftcare-description">

                        SwiftCare is the digital management system
                        for our nursing home. It helps our staff
                        manage residents, equipment, users and
                        daily operations in one secure and organised
                        environment.

                    </p>


                    <div class="swiftcare-image-showcase">

                        <div class="swiftcare-image-frame">

                            <img src="~/Images/old_age_home.jpeg"
                                 alt="SwiftCare Nursing Home"
                                 class="swiftcare-main-image" />

                            <div class="swiftcare-image-overlay"></div>

                            <div class="swiftcare-image-badge">

                                <div class="swiftcare-image-badge-icon">

                                    <i class="bi bi-heart-pulse-fill"></i>

                                </div>

                                <div>

                                    <strong>Compassionate Care</strong>

                                    <span>People come first</span>

                                </div>

                            </div>

                        </div>

                        <div class="swiftcare-image-glow"></div>

                    </div>


                    <div class="swiftcare-hero-actions">

                        <a href="#about"
                               class="swiftcare-enter-button">

                            Discover SwiftCare

                            <i class="bi bi-arrow-right"></i>

                        </a>


                        <a href="#volunteer-opportunities"
                               class="swiftcare-join-button">

                            Join Us

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>
                </div>


                <!-- =================================================
                     FACILITY GLASS PANEL
                     ================================================= -->

                <div class="swiftcare-facility-wrapper">

                    <div class="swiftcare-facility-card">

                        <!-- HEADER -->

                        <div class="swiftcare-facility-header">

                            <div class="swiftcare-facility-brand">

                                <div class="swiftcare-logo">

                                    <i class="bi bi-heart-pulse"></i>

                                </div>


                                <div>

                                    <div class="swiftcare-facility-name">
                                        SwiftCare
                                    </div>

                                    <div class="swiftcare-facility-subtitle">
                                        Nursing Home Management
                                    </div>

                                </div>

                            </div>


                            <div class="swiftcare-status">

                                <span></span>

                                Active

                            </div>

                        </div>


                        <!-- CARE MESSAGE -->

                        <div class="swiftcare-care-card">

                            <div class="swiftcare-care-small">

                                <i class="bi bi-heart-fill"></i>

                                Our Care

                            </div>

                            <div class="swiftcare-care-title">

                                People come first.

                            </div>

                            <div class="swiftcare-care-text">

                                SwiftCare helps our facility stay
                                organised so our staff can focus
                                on what matters most — providing
                                quality care to our residents.

                            </div>

                        </div>


                        <!-- SYSTEM AREAS -->

                        <div class="swiftcare-access-grid">


                            <div class="swiftcare-access-card">

                                <div class="swiftcare-access-icon">

                                    <i class="bi bi-person-heart"></i>

                                </div>

                                <div class="swiftcare-access-title">

                                    Residents

                                </div>

                                <div class="swiftcare-access-text">

                                    Resident information and care
                                    management.

                                </div>

                            </div>


                            <div class="swiftcare-access-card">

                                <div class="swiftcare-access-icon">

                                    <i class="bi bi-people-fill"></i>

                                </div>

                                <div class="swiftcare-access-title">

                                    Staff & Users

                                </div>

                                <div class="swiftcare-access-text">

                                    Manage authorised facility
                                    users.

                                </div>

                            </div>


                            <div class="swiftcare-access-card">

                                <div class="swiftcare-access-icon">

                                    <i class="bi bi-box-seam"></i>

                                </div>

                                <div class="swiftcare-access-title">

                                    Equipment

                                </div>

                                <div class="swiftcare-access-text">

                                    Keep facility equipment
                                    organised.

                                </div>

                            </div>


                            <div class="swiftcare-access-card">

                                <div class="swiftcare-access-icon">

                                    <i class="bi bi-shield-check"></i>

                                </div>

                                <div class="swiftcare-access-title">

                                    Secure System

                                </div>

                                <div class="swiftcare-access-text">

                                    Controlled access to
                                    facility information.

                                </div>

                            </div>


                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         ABOUT SWIFTCARE
         ========================================================= -->

    <section id="about" class="swiftcare-about">

        <div class="swiftcare-about-container">

            <div class="swiftcare-about-grid">


                <!-- TEXT -->

                <div>

                    <div class="swiftcare-section-label">

                        <i class="bi bi-info-circle"></i>

                        About SwiftCare

                    </div>


                    <h2>

                        One place for

                        <span>
                            better care.
                        </span>

                    </h2>


                    <p class="swiftcare-about-description">

                        SwiftCare was created to make the daily
                        management of our nursing home simpler
                        and more organised.

                        <br /><br />

                        From resident information and staff
                        management to medical equipment and
                        facility operations, everything can be
                        managed through one connected system.

                    </p>

                </div>


                <!-- GLASS VALUES -->

                <div class="swiftcare-values">


                    <div class="swiftcare-value">

                        <div class="swiftcare-value-icon">

                            <i class="bi bi-heart-fill"></i>

                        </div>

                        <div>

                            <h4>
                                Resident First
                            </h4>

                            <p>
                                Keeping the needs and wellbeing
                                of residents at the centre of care.
                            </p>

                        </div>

                    </div>


                    <div class="swiftcare-value">

                        <div class="swiftcare-value-icon">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <div>

                            <h4>
                                Connected Staff
                            </h4>

                            <p>
                                Helping our staff access the
                                information they need.
                            </p>

                        </div>

                    </div>


                    <div class="swiftcare-value">

                        <div class="swiftcare-value-icon">

                            <i class="bi bi-box-seam-fill"></i>

                        </div>

                        <div>

                            <h4>
                                Organised Equipment
                            </h4>

                            <p>
                                Keeping important facility
                                equipment accounted for.
                            </p>

                        </div>

                    </div>


                    <div class="swiftcare-value">

                        <div class="swiftcare-value-icon">

                            <i class="bi bi-shield-lock-fill"></i>

                        </div>

                        <div>

                            <h4>
                                Secure Information
                            </h4>

                            <p>
                                Protecting important information
                                through controlled system access.
                            </p>

                        </div>

                    </div>


                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         VOLUNTEER OPPORTUNITIES
         ========================================================= -->

    <section id="volunteer-opportunities"
             class="swiftcare-volunteer-section">

        <div class="swiftcare-volunteer-container">

            <!-- SECTION HEADER -->

            <div class="swiftcare-volunteer-header">

                <div>

                    <div class="swiftcare-section-label">

                        <i class="bi bi-heart-pulse"></i>

                        Volunteer With Us

                    </div>

                    <h2>

                        Make a difference
                        <span>with SwiftCare.</span>

                    </h2>

                    <p>

                        Explore our current volunteer opportunities
                        and find a meaningful way to support our
                        residents and community.

                    </p>

                </div>


                <a href="@Url.Action("VolunteerOpportunities", "Home")"
                       class="swiftcare-volunteer-view-all">

                    View All Opportunities

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="swiftcare-opportunities-grid">

                    @foreach (var opportunity in Model.Take(8))
                    {
                        <article class="swiftcare-opportunity-card">

                            <!-- CARD TOP -->
                            <div class="swiftcare-opportunity-top">

                                <div class="swiftcare-opportunity-icon">
                                    <i class="bi bi-heart-fill"></i>
                                </div>

                                <span class="swiftcare-opportunity-status">
                                    <span></span>
                                    Open
                                </span>

                            </div>


                            <!-- TITLE -->
                            <h3 class="swiftcare-opportunity-title">
                                @opportunity.Title
                            </h3>


                            <!-- DESCRIPTION -->
                            <p class="swiftcare-opportunity-description">

                                @if (!string.IsNullOrWhiteSpace(opportunity.Description))
                                {
                                    @(opportunity.Description.Length > 105
                                        ? opportunity.Description.Substring(0, 105) + "..."
                                        : opportunity.Description)
                                }
                                else
                                {
                                    <text>
                                        Help make a meaningful difference
                                        in the lives of our residents.
                                    </text>
                                }

                            </p>


                            <!-- DETAILS -->
                            <div class="swiftcare-opportunity-details">

                                <!-- CITY -->
                                <div class="swiftcare-opportunity-detail">

                                    <i class="bi bi-geo-alt-fill"></i>

                                    <span>
                                        @opportunity.CityName
                                    </span>

                                </div>


                                <!-- VOLUNTEER AREA -->
                                <div class="swiftcare-opportunity-detail">

                                    <i class="bi bi-person-heart"></i>

                                    <span>
                                        @opportunity.Area?.GetDisplayName()
                                    </span>

                                </div>


                                <!-- CATEGORY -->
                                <div class="swiftcare-opportunity-detail">

                                    <i class="bi bi-tag-fill"></i>

                                    <span>
                                        @opportunity.Category?.GetDisplayName()
                                    </span>

                                </div>

                            </div>


                            <!-- VIEW OPPORTUNITY -->
                            <a href="@Url.Action(
                                                                       "Opportunity",
                                                                       "VolunteerOpportunities",
                                                                       new { opportunityId = opportunity.VolunteerOpportunityId }
                                                                   )"
                                   class="swiftcare-opportunity-button">

                                View Opportunity

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- =================================================
         EMPTY STATE
         ================================================= -->

                <div class="swiftcare-volunteer-empty">

                    <div class="swiftcare-volunteer-empty-icon">

                        <i class="bi bi-heart"></i>

                    </div>

                    <h3>
                        No volunteer opportunities available
                    </h3>

                    <p>
                        There are currently no open volunteer
                        opportunities. Please check again soon.
                    </p>

                </div>
            }

        </div>

    </section>


    <!-- =========================================================
         FINAL CTA
         ========================================================= -->

    <section class="swiftcare-cta">

        <h2>

            Welcome to SwiftCare.

        </h2>


        <p>

            A simpler way for our nursing home to manage
            people, equipment and everyday care.

        </p>


        <a href="#"
               class="swiftcare-login-button">

            <i class="bi bi-box-arrow-in-right"></i>

            Enter SwiftCare

            <i class="bi bi-arrow-right"></i>

        </a>

    </section>


</div>

