@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding

@{
    ViewData["Title"] = "Onboarding Documents";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

<style>
    .documents-page {
        max-width: 1100px;
        margin: 35px auto 60px;
    }

    .documents-header {
        background: linear-gradient(135deg, #eaffd0, #f7ffed);
        border-radius: 22px;
        padding: 28px;
        margin-bottom: 25px;
    }

        .documents-header h1 {
            color: #174d32;
            font-weight: 800;
        }

    .upload-card,
    .documents-card {
        background: #fff;
        border: 1px solid #dfe9da;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(25, 75, 45, .06);
    }

        .upload-card h4,
        .documents-card h4 {
            color: #174d32;
            font-weight: 750;
        }

    .form-label {
        color: #31543e;
        font-weight: 650;
    }

    .btn-swift {
        background: #72b82a;
        border: none;
        color: #163d25;
        font-weight: 750;
        border-radius: 11px;
        padding: 10px 18px;
    }

    .document-row {
        padding: 17px 0;
        border-bottom: 1px solid #edf1ea;
    }

        .document-row:last-child {
            border-bottom: none;
        }

    .document-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eaffd0;
        color: #23633d;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .document-name {
        color: #174d32;
        font-weight: 700;
    }

    .document-meta {
        color: #788379;
        font-size: .82rem;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 700;
        background: #eef3ea;
        color: #49604f;
    }
</style>

<div class="container documents-page">

    <div class="documents-header">

        <h1>
            <i class="bi bi-folder-check me-2"></i>
            Onboarding Documents
        </h1>

        <p class="mb-0 text-muted">
            Upload the documents required to complete your volunteer onboarding.
            Maximum file size: 50 MB.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">

        <!-- UPLOAD -->

        <div class="col-lg-5">

            <div class="upload-card">

                <h4 class="mb-4">
                    <i class="bi bi-cloud-arrow-up me-2"></i>
                    Upload Document
                </h4>

                <form asp-action="UploadDocument"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="onboardingId"
                           value="@Model.VolunteerOnboardingId" />

                    <div class="mb-3">

                        <label class="form-label">
                            Document Type
                        </label>

                        <select name="documentType"
                                class="form-select"
                                required>

                            <option value="">
                                Select document type
                            </option>

                            @foreach (var type in
                                Enum.GetValues<SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingDocumentType>())
                            {
                                <option value="@type">
                                    @type.ToString()
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Document Name
                        </label>

                        <input type="text"
                               name="documentName"
                               class="form-control"
                               maxlength="200"
                               placeholder="e.g. South African ID"
                               required />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            File
                        </label>

                        <input type="file"
                               name="file"
                               class="form-control"
                               required />

                        <div class="form-text">
                            Maximum size: 50 MB.
                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-swift w-100">

                        <i class="bi bi-upload me-2"></i>
                        Upload Document

                    </button>

                </form>

            </div>

        </div>

        <!-- EXISTING DOCUMENTS -->

        <div class="col-lg-7">

            <div class="documents-card">

                <h4 class="mb-3">
                    <i class="bi bi-files me-2"></i>
                    Uploaded Documents
                </h4>

                @if (!Model.Documents.Any())
                {
                    <div class="text-center py-5 text-muted">

                        <i class="bi bi-folder2-open"
                               style="font-size:3rem;">
                        </i>

                        <p class="mt-3 mb-0">
                            No documents uploaded yet.
                        </p>

                    </div>
                }
                else
                {
                    foreach (var document in Model.Documents.OrderByDescending(x => x.UploadedDate))
                    {
                        <div class="document-row">

                            <div class="d-flex gap-3 align-items-center">

                                <div class="document-icon">
                                    <i class="bi bi-file-earmark"></i>
                                </div>

                                <div class="flex-grow-1">

                                    <div class="document-name">
                                        @document.DocumentName
                                    </div>

                                    <div class="document-meta">
                                        @document.FileName
                                        ·
                                        @document.DocumentType
                                        ·
                                        @document.FileSize.ToString("N0") bytes
                                    </div>

                                    <div class="document-meta">
                                        Uploaded
                                        @document.UploadedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </div>

                                </div>

                                <div class="text-end">

                                    <div class="status-badge mb-2">
                                        @document.Status
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(document.FilePath))
                                    {
                                        <div>
                                            <a href="@Url.Content("~/" + document.FilePath)"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-eye"></i>
                                                View
                                            </a>
                                        </div>
                                    }

                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(document.RejectionReason))
                            {
                                <div class="alert alert-danger mt-3 mb-0">
                                    <strong>Correction required:</strong>
                                    @document.RejectionReason
                                </div>
                            }

                        </div>
                    }
                }

            </div>

        </div>

    </div>

    <div class="d-flex justify-content-end mt-4">

        <form asp-action="SubmitForVerification"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.VolunteerOnboardingId" />

            <button type="submit"
                    class="btn btn-swift">

                <i class="bi bi-send-check me-2"></i>
                Submit for Verification

            </button>

        </form>

    </div>

</div>