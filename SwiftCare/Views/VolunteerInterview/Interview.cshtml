@model SwiftCare.ViewModels.VolunteerInterviewViewModel

@{
    ViewData["Title"] = "Volunteer Interview";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="scv-interview-page">

    <div class="scv-shell">

        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="scv-header">

            <div class="scv-header-left">

                <div class="scv-avatar">
                    <i class="bi bi-robot"></i>
                </div>

                <div>

                    <div class="scv-title">
                        SwiftCare Interviewer
                    </div>

                    <div class="scv-subtitle">
                        Voice & text interview
                    </div>

                </div>

            </div>

            <div style="display:flex;align-items:center;gap:12px;">

                <button id="scvFullscreenButton"
                        type="button"
                        class="btn btn-sm btn-outline-success"
                        title="Enter fullscreen">

                    <i class="bi bi-fullscreen"></i>

                    <span>
                        Fullscreen
                    </span>

                </button>

                <div id="scvConnectionStatus"
                     class="scv-status">

                    <span class="scv-status-dot"></span>

                    <span id="scvStatusText">
                        Connecting...
                    </span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             VIDEO / PROCTORING BAR
             ======================================================== -->

        <div class="scv-proctoring-bar">

            <div class="scv-proctoring-camera">

                <div class="scv-proctoring-camera-preview">

                    <video id="scvCameraPreview"
                           autoplay
                           muted
                           playsinline>
                    </video>

                </div>

                <div>

                    <strong>
                        <i class="bi bi-camera-video-fill"></i>
                        Video recording
                    </strong>

                    <span id="scvRecordingStatus">
                        Starting camera...
                    </span>

                </div>

            </div>


            <div class="scv-proctoring-status">

                <span id="scvProctoringIndicator"
                      class="scv-proctoring-indicator">

                    <i class="bi bi-shield-check"></i>

                </span>

                <div>

                    <strong>
                        Interview monitoring
                    </strong>

                    <span id="scvProctoringText">
                        Active
                    </span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             CHAT
             ======================================================== -->

        <div id="scvChat"
             class="scv-chat">

            <div id="scvThinking"
                 class="scv-thinking">

                <span></span>
                <span></span>
                <span></span>

            </div>


            <div id="scvListening"
                 class="scv-listening">

                <div class="scv-mic-icon">
                    <i class="bi bi-mic-fill"></i>
                </div>

                <span>
                    Listening
                </span>

                <div class="scv-listening-bars">

                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             TEXT RESPONSE AREA
             ======================================================== -->

        <div class="scv-text-response-area">

            <div class="scv-text-response-header">

                <div class="scv-text-response-title">

                    <i class="bi bi-keyboard"></i>

                    <span>
                        Type your response
                    </span>

                </div>

                <span class="scv-text-response-hint">
                    You can answer by voice or text.
                </span>

            </div>


            <div class="scv-text-response-input-row">

                <textarea id="scvTextResponse"
                          class="scv-text-response-input"
                          rows="3"
                          maxlength="3000"
                          placeholder="Type your answer here..."
                          autocomplete="off"
                          spellcheck="true"
                          aria-label="Type your interview response"></textarea>


                <button id="scvSendTextResponse"
                        type="button"
                        class="scv-text-send-button">

                    <i class="bi bi-send-fill"></i>

                    <span>
                        Send
                    </span>

                </button>

            </div>


            <div class="scv-text-response-footer">

                <span id="scvTextResponseCount">
                    0 / 3000
                </span>

                <span>
                    <i class="bi bi-universal-access"></i>
                    Voice and text responses are supported.
                </span>

            </div>

        </div>


        <!-- ========================================================
             FOOTER
             ======================================================== -->

        <div class="scv-footer">

            <i class="bi bi-mic"></i>

            <span>
                Speak naturally, or type your response below.
            </span>

        </div>

    </div>

</div>


<!-- ================================================================
     SUSPICIOUS ACTIVITY MODAL
     ================================================================ -->

<div id="scvSuspiciousOverlay"
     class="scv-suspicious-overlay">

    <div class="scv-suspicious-card">

        <div class="scv-suspicious-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>

        <h2>
            Interview ended
        </h2>

        <p>
            An interview integrity event caused your interview to be
            ended. Your interview and available recording have been
            submitted for administrative review.
        </p>

        <div class="scv-suspicious-status"
             id="scvSuspiciousStatus">

            Processing interview...

        </div>

    </div>

</div>


<script src="~/lib/signalr/signalr.js"></script>

<script src="~/lib/speech/speech-sdk.js"></script>


<script>

    (() => {

        "use strict";


        /* ============================================================
           SESSION
           ============================================================ */

        const sessionToken =
            '@Context.Request.Query["token"]';


        if (!sessionToken) {

            console.error(
                "[SWIFTCARE INTERVIEW] No session token."
            );

            return;

        }


        /* ============================================================
           DOM
           ============================================================ */

        const chat =
            document.getElementById("scvChat");

        const thinking =
            document.getElementById("scvThinking");

        const listening =
            document.getElementById("scvListening");

        const status =
            document.getElementById("scvConnectionStatus");

        const statusText =
            document.getElementById("scvStatusText");

        const cameraPreview =
            document.getElementById("scvCameraPreview");

        const recordingStatus =
            document.getElementById("scvRecordingStatus");

        const proctoringText =
            document.getElementById("scvProctoringText");

        const proctoringIndicator =
            document.getElementById(
                "scvProctoringIndicator"
            );

        const suspiciousOverlay =
            document.getElementById(
                "scvSuspiciousOverlay"
            );

        const suspiciousStatus =
            document.getElementById(
                "scvSuspiciousStatus"
            );

        const fullscreenButton =
            document.getElementById(
                "scvFullscreenButton"
            );

        const textResponse =
            document.getElementById(
                "scvTextResponse"
            );

        const sendTextResponse =
            document.getElementById(
                "scvSendTextResponse"
            );

        const textResponseCount =
            document.getElementById(
                "scvTextResponseCount"
            );


        /* ============================================================
           INTERVIEW STATE
           ============================================================ */

        let connection = null;

        let speechRecognizer = null;

        let speechTokenPromise = null;

        let speechTokenExpiresAt = 0;

        let currentApplicantName =
            "there";

        let currentQuestionNumber =
            0;

        let totalQuestions =
            0;

        let currentQuestionId =
            null;

        let currentQuestionText =
            "";

        let interviewStarted =
            false;

        let interviewCompleted =
            false;

        let greetingPlayed =
            false;

        let speaking =
            false;

        let listeningNow =
            false;

        let submittingAnswer =
            false;

        let recognitionStopping =
            false;

        let answerParts =
            [];

        let silenceTimer =
            null;

        let speechStartedAt =
            null;

        let currentVoiceBubble =
            null;

        let currentWave =
            null;

        let lastQuestionHandled =
            null;

        let reconnecting =
            false;


        /* ============================================================
           SPEECH SERIALIZATION

           This guarantees:

               GREETING
                   ↓
               QUESTION
                   ↓
               LISTENING

           No TTS can overlap another TTS.
           ============================================================ */

        let speechQueue =
            Promise.resolve();

        let speechLock =
            Promise.resolve();

        let speechGeneration =
            0;

        let speechSequence =
            0;

        let activeSpeechSynthesizer =
            null;

        /*
         * IMPORTANT:
         *
         * This was missing from the supplied page, but
         * cancelActiveSpeech() uses it.
         */
        let activeSpeaker =
            null;

        let greetingSpeechFinished =
            false;

        let greetingStarted =
            false;

        let greetingFinished =
            false;

        let pendingFirstQuestion =
            null;

        let greetingPromise =
            null;

        let firstQuestionRequested =
            false;

        let questionProcessing =
            false;

        let currentQuestionKey =
            null;

        let currentQuestionSignature =
            null;

        let questionGeneration =
            0;

        let microphoneStarting =
            false;


        /* ============================================================
           VIDEO RECORDING STATE
           ============================================================ */

        let cameraStream =
            null;

        let mediaRecorder =
            null;

        let recordedVideoChunks =
            [];

        let recordingStartedAt =
            null;

        let videoUploadCompleted =
            false;

        let videoStopPromise =
            null;


        /* ============================================================
           PROCTORING STATE
           ============================================================ */

        let tabSwitchCount =
            0;

        let windowBlurCount =
            0;

        let fullScreenExitCount =
            0;

        let pageLeaveCount =
            0;

        let cameraStoppedCount =
            0;

        let suspiciousEventCount =
            0;

        let suspiciousActivityHandled =
            false;

        let pageVisible =
            !document.hidden;

        let lastBlurAt =
            null;

        let totalUnfocusedSeconds =
            0;

        let terminatingInterview =
            false;


        /* ============================================================
           PROCTORING EVENT DEDUPLICATION
           ============================================================ */

        let lastProctoringEventType =
            null;

        let lastProctoringEventAt =
            0;

        const PROCTORING_DUPLICATE_WINDOW_MS =
            1500;

        const SUSPICIOUS_EVENT_THRESHOLD =
            3;


        /* ============================================================
           CONSTANTS
           ============================================================ */

        const GREETING_PAUSE =
            1400;

        const QUESTION_PAUSE =
            450;

        const ANSWER_SILENCE =
            1900;

        const MINIMUM_ANSWER_LENGTH =
            2;

        const MAX_TEXT_RESPONSE_LENGTH =
            3000;


        /*
         * This is the important controlled TTS fallback.
         *
         * If Azure's SpeakerAudioDestination.onAudioEnd fires,
         * we continue immediately.
         *
         * If it does not fire, we release the speech barrier after
         * a conservative calculated period.
         */
        const SPEECH_PLAYBACK_MINIMUM_MS =
            4000;

        const SPEECH_PLAYBACK_MAXIMUM_MS =
            30000;

        const SPEECH_PLAYBACK_MS_PER_CHARACTER =
            75;


        /* ============================================================
           AZURE VOICES
           ============================================================ */

        const INTERVIEWER_VOICE =
            "en-ZA-LeahNeural";

        const ZULU_NAME_VOICE =
            "zu-ZA-ThandoNeural";


        /* ============================================================
           STATUS
           ============================================================ */

        function setStatus(
            text,
            isError = false
        ) {

            if (!status || !statusText)
                return;

            statusText.textContent =
                text;

            status.classList.toggle(
                "scv-error",
                isError
            );

        }


        /* ============================================================
           SCROLL
           ============================================================ */

        function scrollChat() {

            if (!chat)
                return;

            requestAnimationFrame(() => {

                chat.scrollTop =
                    chat.scrollHeight;

            });

        }


        /* ============================================================
           THINKING
           ============================================================ */

        function showThinking() {

            if (!thinking)
                return;

            thinking.classList.add(
                "scv-visible"
            );

            scrollChat();

        }


        function hideThinking() {

            if (!thinking)
                return;

            thinking.classList.remove(
                "scv-visible"
            );

        }


        /* ============================================================
           LISTENING UI
           ============================================================ */

        function showListening() {

            if (!listening)
                return;

            listening.classList.add(
                "scv-active"
            );

        }


        function hideListening() {

            if (!listening)
                return;

            listening.classList.remove(
                "scv-active"
            );

        }


        /* ============================================================
           TEXT RESPONSE
           ============================================================ */

        function updateTextResponseCount() {

            if (
                !textResponse ||
                !textResponseCount
            ) {

                return;

            }

            const length =
                textResponse.value.length;

            textResponseCount.textContent =
                `${length} / ${MAX_TEXT_RESPONSE_LENGTH}`;

        }


        function clearTextResponse() {

            if (!textResponse)
                return;

            textResponse.value =
                "";

            updateTextResponseCount();

        }


        function setTextResponseEnabled(
            enabled
        ) {

            if (!textResponse)
                return;

            textResponse.disabled =
                !enabled;

            if (sendTextResponse) {

                sendTextResponse.disabled =
                    !enabled;

            }

        }


        function focusTextResponse() {

            if (
                !textResponse ||
                textResponse.disabled
            ) {

                return;

            }

            setTimeout(() => {

                try {

                    textResponse.focus();

                }
                catch (_) {}

            }, 50);

        }


        /* ============================================================
           ANTI FORGERY
           ============================================================ */

        function getAntiForgeryToken() {

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            return token
                ? token.value
                : "";

        }


        /* ============================================================
           VIDEO RECORDING
           ============================================================ */

        async function startVideoRecording() {

            if (
                !navigator.mediaDevices ||
                !navigator.mediaDevices.getUserMedia
            ) {

                throw new Error(
                    "Camera access is not supported by this browser."
                );

            }


            cameraStream =
                await navigator.mediaDevices.getUserMedia({

                    video: {
                        facingMode: "user"
                    },

                    audio: true

                });


            if (!cameraStream) {

                throw new Error(
                    "Could not obtain camera stream."
                );

            }


            cameraPreview.srcObject =
                cameraStream;


            try {

                await cameraPreview.play();

            }
            catch (_) {}


            cameraStream
                .getVideoTracks()
                .forEach(track => {

                    track.addEventListener(
                        "ended",
                        () => {

                            if (
                                interviewStarted &&
                                !interviewCompleted &&
                                !suspiciousActivityHandled &&
                                !terminatingInterview
                            ) {

                                cameraStoppedCount++;

                                registerSuspiciousEvent(
                                    "CameraStopped"
                                );

                            }

                        }
                    );

                });


            const mimeTypes = [

                "video/webm;codecs=vp9,opus",

                "video/webm;codecs=vp8,opus",

                "video/webm"

            ];


            let selectedMimeType =
                "";


            for (
                const mimeType
                of mimeTypes
            ) {

                if (
                    typeof MediaRecorder !== "undefined" &&
                    MediaRecorder.isTypeSupported(
                        mimeType
                    )
                ) {

                    selectedMimeType =
                        mimeType;

                    break;

                }

            }


            if (
                typeof MediaRecorder ===
                "undefined"
            ) {

                throw new Error(
                    "Video recording is not supported by this browser."
                );

            }


            mediaRecorder =
                selectedMimeType
                    ? new MediaRecorder(
                        cameraStream,
                        {
                            mimeType:
                                selectedMimeType
                        }
                    )
                    : new MediaRecorder(
                        cameraStream
                    );


            recordedVideoChunks =
                [];


            mediaRecorder.ondataavailable =
                event => {

                    if (
                        event.data &&
                        event.data.size > 0
                    ) {

                        recordedVideoChunks.push(
                            event.data
                        );

                    }

                };


            mediaRecorder.onstart =
                () => {

                    recordingStartedAt =
                        Date.now();


                    if (recordingStatus) {

                        recordingStatus.innerHTML =
                            '<i class="bi bi-record-circle-fill"></i> Recording interview';

                    }


                    console.log(
                        "[SWIFTCARE VIDEO] Recording started."
                    );

                };


            mediaRecorder.onerror =
                event => {

                    console.error(
                        "[SWIFTCARE VIDEO] Recording error:",
                        event
                    );


                    if (recordingStatus) {

                        recordingStatus.textContent =
                            "Recording error";

                    }

                };


            mediaRecorder.start(1000);

        }


        /* ============================================================
           STOP VIDEO
           ============================================================ */

        async function stopVideoRecording() {

            if (videoStopPromise) {

                return videoStopPromise;

            }


            if (
                !mediaRecorder ||
                mediaRecorder.state === "inactive"
            ) {

                stopCameraTracks();

                return null;

            }


            const recorder =
                mediaRecorder;


            videoStopPromise =
                new Promise(resolve => {

                    let resolved =
                        false;


                    const finish =
                        result => {

                            if (resolved)
                                return;

                            resolved =
                                true;

                            mediaRecorder =
                                null;

                            videoStopPromise =
                                null;

                            resolve(result);

                        };


                    recorder.onstop =
                        () => {

                            try {

                                const mimeType =
                                    recorder.mimeType ||
                                    "video/webm";


                                const videoBlob =
                                    new Blob(
                                        recordedVideoChunks,
                                        {
                                            type:
                                                mimeType
                                        }
                                    );


                                const duration =
                                    recordingStartedAt
                                        ? Math.round(
                                            (
                                                Date.now() -
                                                recordingStartedAt
                                            ) / 1000
                                        )
                                        : 0;


                                if (recordingStatus) {

                                    recordingStatus.innerHTML =
                                        '<i class="bi bi-check-circle-fill"></i> Recording ready';

                                }


                                finish({

                                    blob:
                                        videoBlob,

                                    duration:
                                        duration

                                });

                            }
                            catch (error) {

                                console.error(
                                    "[SWIFTCARE VIDEO] Could not create video:",
                                    error
                                );

                                finish(null);

                            }

                        };


                    recorder.onerror =
                        error => {

                            console.error(
                                "[SWIFTCARE VIDEO] Recorder stop error:",
                                error
                            );

                            finish(null);

                        };


                    try {

                        recorder.stop();

                    }
                    catch (error) {

                        console.error(
                            "[SWIFTCARE VIDEO] Stop failed:",
                            error
                        );

                        finish(null);

                    }

                });


            return videoStopPromise;

        }


        /* ============================================================
           STOP CAMERA
           ============================================================ */

        function stopCameraTracks() {

            if (!cameraStream)
                return;


            cameraStream
                .getTracks()
                .forEach(track => {

                    try {

                        track.stop();

                    }
                    catch (_) {}

                });


            cameraStream =
                null;


            if (cameraPreview) {

                cameraPreview.srcObject =
                    null;

            }

        }


        /* ============================================================
           UPLOAD VIDEO
           ============================================================ */

        async function uploadInterviewVideo(
            videoData
        ) {

            if (
                !videoData ||
                !videoData.blob ||
                videoData.blob.size === 0
            ) {

                return false;

            }


            const formData =
                new FormData();


            const extension =
                videoData.blob.type.includes("mp4")
                    ? "mp4"
                    : "webm";


            formData.append(
                "video",
                videoData.blob,
                `VolunteerInterview_${Date.now()}.${extension}`
            );


            formData.append(
                "token",
                sessionToken
            );


            formData.append(
                "durationSeconds",
                String(
                    videoData.duration || 0
                )
            );


            try {

                const response =
                    await fetch(
                        "/VolunteerInterview/UploadInterviewVideo",
                        {

                            method:
                                "POST",

                            body:
                                formData,

                            headers: {

                                "RequestVerificationToken":
                                    getAntiForgeryToken()

                            },

                            credentials:
                                "same-origin"

                        }
                    );


                const result =
                    await response
                        .json()
                        .catch(
                            () => null
                        );


                if (
                    !response.ok ||
                    !result ||
                    !result.success
                ) {

                    console.error(
                        "[SWIFTCARE VIDEO] Upload failed:",
                        result
                    );

                    return false;

                }


                videoUploadCompleted =
                    true;


                console.log(
                    "[SWIFTCARE VIDEO] Upload completed."
                );


                return true;

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE VIDEO] Upload error:",
                    error
                );

                return false;

            }

        }


        /* ============================================================
           PROCTORING UI
           ============================================================ */

        function updateProctoringUi() {

            if (
                !proctoringText ||
                !proctoringIndicator
            ) {

                return;

            }


            if (
                suspiciousEventCount === 0
            ) {

                proctoringText.textContent =
                    "Active";

                proctoringIndicator.className =
                    "scv-proctoring-indicator";

                return;

            }


            proctoringText.textContent =
                `${suspiciousEventCount} event(s) detected`;


            if (
                suspiciousEventCount <
                SUSPICIOUS_EVENT_THRESHOLD
            ) {

                proctoringIndicator.className =
                    "scv-proctoring-indicator scv-warning";

                return;

            }


            proctoringIndicator.className =
                "scv-proctoring-indicator scv-danger";

        }


        /* ============================================================
           SEND PROCTORING EVENT
           ============================================================ */

        async function sendProctoringEvent(
            eventType,
            useKeepAlive = false
        ) {

            const body = {

                token:
                    sessionToken,

                eventType:
                    eventType,

                questionNumber:
                    currentQuestionNumber,

                timestamp:
                    new Date().toISOString(),

                pageVisibilityState:
                    document.visibilityState,

                pageHidden:
                    document.hidden,

                unfocusedSeconds:
                    totalUnfocusedSeconds

            };


            try {

                const response =
                    await fetch(
                        "/VolunteerInterview/ProctoringEvent",
                        {

                            method:
                                "POST",

                            headers: {

                                "Content-Type":
                                    "application/json",

                                "RequestVerificationToken":
                                    getAntiForgeryToken()

                            },

                            credentials:
                                "same-origin",

                            keepalive:
                                useKeepAlive,

                            body:
                                JSON.stringify(body)

                        }
                    );


                const result =
                    await response
                        .json()
                        .catch(
                            () => null
                        );


                if (!response.ok) {

                    console.warn(
                        "[SWIFTCARE PROCTORING] Server rejected event:",
                        response.status,
                        result
                    );

                    return null;

                }


                return result;

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE PROCTORING] Event failed:",
                    error
                );

                return null;

            }

        }


        /* ============================================================
           REGISTER SUSPICIOUS EVENT
           ============================================================ */

        async function registerSuspiciousEvent(
            eventType
        ) {

            if (
                !interviewStarted ||
                interviewCompleted ||
                suspiciousActivityHandled ||
                terminatingInterview
            ) {

                return;

            }


            const now =
                Date.now();


            if (
                lastProctoringEventType === eventType &&
                (
                    now -
                    lastProctoringEventAt
                ) <
                PROCTORING_DUPLICATE_WINDOW_MS
            ) {

                console.log(
                    "[SWIFTCARE PROCTORING] Duplicate event ignored:",
                    eventType
                );

                return;

            }


            lastProctoringEventType =
                eventType;

            lastProctoringEventAt =
                now;


            suspiciousEventCount++;


            updateProctoringUi();


            console.warn(
                "[SWIFTCARE PROCTORING] Event:",
                eventType,
                "Count:",
                suspiciousEventCount
            );


            const serverResult =
                await sendProctoringEvent(
                    eventType
                );


            if (
                serverResult &&
                serverResult.suspicious === true &&
                !suspiciousActivityHandled &&
                !terminatingInterview
            ) {

                await terminateForSuspiciousActivity(
                    eventType
                );

                return;

            }


            if (
                suspiciousEventCount >=
                SUSPICIOUS_EVENT_THRESHOLD
            ) {

                await terminateForSuspiciousActivity(
                    eventType
                );

            }

        }


        /* ============================================================
           VISIBILITY
           ============================================================ */

        document.addEventListener(
            "visibilitychange",
            () => {

                if (
                    interviewCompleted ||
                    !interviewStarted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                if (
                    document.visibilityState === "hidden"
                ) {

                    pageVisible =
                        false;

                    lastBlurAt =
                        Date.now();

                    tabSwitchCount++;


                    console.warn(
                        "[SWIFTCARE PROCTORING] Interview tab became hidden."
                    );


                    registerSuspiciousEvent(
                        "TabSwitch"
                    );

                    return;

                }


                pageVisible =
                    true;


                if (lastBlurAt) {

                    const elapsedSeconds =
                        Math.max(
                            0,
                            Math.round(
                                (
                                    Date.now() -
                                    lastBlurAt
                                ) / 1000
                            )
                        );


                    totalUnfocusedSeconds +=
                        elapsedSeconds;


                    console.log(
                        "[SWIFTCARE PROCTORING] Interview tab visible again. Unfocused seconds:",
                        elapsedSeconds
                    );

                }


                lastBlurAt =
                    null;

            }
        );


        /* ============================================================
           WINDOW BLUR
           ============================================================ */

        window.addEventListener(
            "blur",
            () => {

                if (
                    interviewCompleted ||
                    !interviewStarted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                if (
                    document.visibilityState === "hidden" ||
                    document.hidden
                ) {

                    console.log(
                        "[SWIFTCARE PROCTORING] Window blur ignored because interview tab is hidden."
                    );

                    return;

                }


                windowBlurCount++;


                console.warn(
                    "[SWIFTCARE PROCTORING] Window lost focus while page remained visible."
                );


                registerSuspiciousEvent(
                    "WindowBlur"
                );

            }
        );


        /* ============================================================
           WINDOW FOCUS
           ============================================================ */

        window.addEventListener(
            "focus",
            () => {

                if (
                    !interviewStarted ||
                    interviewCompleted
                ) {

                    return;

                }


                if (
                    lastBlurAt &&
                    !document.hidden
                ) {

                    const elapsedSeconds =
                        Math.max(
                            0,
                            Math.round(
                                (
                                    Date.now() -
                                    lastBlurAt
                                ) / 1000
                            )
                        );


                    totalUnfocusedSeconds +=
                        elapsedSeconds;


                    lastBlurAt =
                        null;

                }

            }
        );


        /* ============================================================
           FULLSCREEN
           ============================================================ */

        document.addEventListener(
            "fullscreenchange",
            () => {

                if (
                    interviewCompleted ||
                    !interviewStarted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                if (
                    !document.fullscreenElement
                ) {

                    fullScreenExitCount++;


                    registerSuspiciousEvent(
                        "FullScreenExit"
                    );

                }

            }
        );


        async function requestInterviewFullscreen() {

            if (
                document.fullscreenElement
            ) {

                return true;

            }


            if (
                !document.documentElement.requestFullscreen
            ) {

                console.warn(
                    "[SWIFTCARE PROCTORING] Fullscreen API unavailable."
                );

                return false;

            }


            try {

                await document.documentElement
                    .requestFullscreen();


                console.log(
                    "[SWIFTCARE PROCTORING] Fullscreen enabled."
                );


                return true;

            }
            catch (error) {

                console.warn(
                    "[SWIFTCARE PROCTORING] Fullscreen unavailable:",
                    error
                );


                return false;

            }

        }


        if (fullscreenButton) {

            fullscreenButton.addEventListener(
                "click",
                async () => {

                    await requestInterviewFullscreen();

                }
            );

        }


        /* ============================================================
           PAGE LEAVE
           ============================================================ */

        window.addEventListener(
            "beforeunload",
            event => {

                if (
                    !interviewStarted ||
                    interviewCompleted ||
                    suspiciousActivityHandled ||
                    terminatingInterview
                ) {

                    return;

                }


                pageLeaveCount++;


                const payload = {

                    token:
                        sessionToken,

                    eventType:
                        "PageLeave",

                    questionNumber:
                        currentQuestionNumber,

                    timestamp:
                        new Date().toISOString(),

                    pageVisibilityState:
                        document.visibilityState,

                    pageHidden:
                        document.hidden,

                    unfocusedSeconds:
                        totalUnfocusedSeconds

                };


                const token =
                    getAntiForgeryToken();


                try {

                    if (token) {

                        fetch(
                            "/VolunteerInterview/ProctoringEvent",
                            {

                                method:
                                    "POST",

                                headers: {

                                    "Content-Type":
                                        "application/json",

                                    "RequestVerificationToken":
                                        token

                                },

                                credentials:
                                    "same-origin",

                                keepalive:
                                    true,

                                body:
                                    JSON.stringify(
                                        payload
                                    )

                            }
                        );

                    }
                    else {

                        navigator.sendBeacon(
                            "/VolunteerInterview/ProctoringEventBeacon",
                            JSON.stringify(
                                payload
                            )
                        );

                    }

                }
                catch (_) {

                    try {

                        navigator.sendBeacon(
                            "/VolunteerInterview/ProctoringEventBeacon",
                            JSON.stringify(
                                payload
                            )
                        );

                    }
                    catch (_) {}

                }

            }
        );


        /* ============================================================
           CANCEL ACTIVE SPEECH
           ============================================================ */

        function cancelActiveSpeech() {

            speechGeneration++;


            try {

                window.speechSynthesis.cancel();

            }
            catch (_) {}


            if (activeSpeechSynthesizer) {

                try {

                    activeSpeechSynthesizer.close();

                }
                catch (_) {}

                activeSpeechSynthesizer =
                    null;

            }


            if (activeSpeaker) {

                try {

                    activeSpeaker.close();

                }
                catch (_) {}

                activeSpeaker =
                    null;

            }


            speaking =
