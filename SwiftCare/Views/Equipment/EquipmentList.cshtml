@model IEnumerable<SwiftCare.Models.Equipment>

@{
    ViewData["Title"] = "Equipment";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="swift-equipment-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="swift-equipment-header">

        <div class="swift-equipment-header-inner">

            <div class="swift-equipment-header-left">

                <a asp-controller="Home"
                       asp-action="Index"
                       class="swift-equipment-back">

                    <i class="bi bi-chevron-left me-1"></i>

                    Back

                </a>

                <div>

                    <h2 class="swift-equipment-title">
                        Nursing Home Equipment
                    </h2>

                    <p class="swift-equipment-subtitle">
                        Browse and request equipment for your facility
                    </p>

                </div>

            </div>


            <!-- CART BUTTON -->

            <button type="button"
                    class="swift-cart-button"
                    id="cartIcon">

                <i class="fas fa-shopping-cart"></i>

                <span class="swift-cart-text">
                    Equipment Cart
                </span>

                <span class="swift-cart-count"
                      id="cartItemCount">

                    0

                </span>

            </button>

        </div>

    </div>


    <!-- ============================================================
         SEARCH
         ============================================================ -->

    <div class="swift-equipment-toolbar">

        <div class="swift-equipment-search-group">

            <div class="swift-equipment-search-icon">

                <i class="fas fa-search"></i>

            </div>

            <input type="text"
                   id="searchInput"
                   class="swift-equipment-search"
                   placeholder="Search equipment by name or description..."
                   autocomplete="off" />

        </div>

    </div>


    <!-- ============================================================
         EQUIPMENT
         ============================================================ -->
    @if (Model != null && Model.Any())
    {
        <div class="swift-equipment-grid"
             id="equipmentContainer">

            @foreach (var equipment in Model)
            {
                <div class="swift-equipment-card"
                     data-equipment-name="@equipment.EquipmentName"
                     data-equipment-description="@equipment.Description">

                    <div class="swift-equipment-image-wrapper">

                        @if (!string.IsNullOrWhiteSpace(equipment.ImageUrl))
                        {
                            <img src="~/@equipment.ImageUrl"
                                 alt="@equipment.EquipmentName"
                                 class="swift-equipment-image"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="swift-equipment-icon-placeholder"
                                 style="display:none;">

                                <i class="fas fa-wheelchair"></i>

                            </div>
                        }
                        else
                        {
                            <div class="swift-equipment-icon-placeholder">

                                <i class="fas fa-wheelchair"></i>

                            </div>
                        }

                    </div>


                    <div class="swift-equipment-content">

                        <h5 class="swift-equipment-name">
                            @equipment.EquipmentName
                        </h5>

                        <p class="swift-equipment-description">

                            @if (!string.IsNullOrWhiteSpace(equipment.Description))
                            {
                                @equipment.Description
                            }
                            else
                            {
                                <span>
                                    No description available.
                                </span>
                            }

                        </p>


                        <div class="swift-equipment-actions">

                            <button type="button"
                                    class="swift-equipment-view-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#equipmentDetails_@equipment.EquipmentId">

                                <i class="fas fa-eye"></i>

                                Details

                            </button>


                            <button type="button"
                                    class="swift-equipment-cart-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#equipmentCart_@equipment.EquipmentId">

                                <i class="fas fa-cart-plus"></i>

                                Add

                            </button>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     DETAILS MODAL
                     ==================================================== -->

                <div class="modal fade"
                     id="equipmentDetails_@equipment.EquipmentId"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content swift-modal">

                            <div class="modal-header swift-modal-header">

                                <h5 class="swift-modal-title">
                                    @equipment.EquipmentName
                                </h5>

                                <button type="button"
                                        class="swift-modal-close"
                                        data-bs-dismiss="modal">

                                    <i class="fas fa-times"></i>

                                </button>

                            </div>


                            <div class="modal-body swift-modal-body">

                                <div class="swift-modal-image-container">

                                    @if (!string.IsNullOrWhiteSpace(
                                        equipment.ImageUrl))
                                    {
                                        <img src="~/@equipment.ImageUrl"
                                             alt="@equipment.EquipmentName"
                                             class="swift-modal-image" />
                                    }
                                    else
                                    {
                                        <div class="swift-equipment-icon-placeholder">

                                            <i class="fas fa-wheelchair"></i>

                                        </div>
                                    }

                                </div>


                                <div>

                                    <div class="swift-description-label">
                                        Equipment Description
                                    </div>

                                    <div class="swift-description">

                                        @if (!string.IsNullOrWhiteSpace(
                                            equipment.Description))
                                        {
                                            @equipment.Description
                                        }
                                        else
                                        {
                                            <span>
                                                No description available.
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <div class="modal-footer swift-modal-footer">

                                <button type="button"
                                        class="swift-close-button"
                                        data-bs-dismiss="modal">

                                    Close

                                </button>


                                <button type="button"
                                        class="swift-add-button"
                                        data-bs-dismiss="modal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#equipmentCart_@equipment.EquipmentId">

                                    <i class="fas fa-cart-plus me-1"></i>

                                    Add to Cart

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ====================================================
                     ADD TO CART MODAL
                     ==================================================== -->

                <div class="modal fade"
                     id="equipmentCart_@equipment.EquipmentId"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content swift-modal">

                            <div class="modal-header swift-modal-header">

                                <div>

                                    <h5 class="swift-modal-title">
                                        Add Equipment
                                    </h5>

                                    <span class="swift-modal-subtitle">
                                        @equipment.EquipmentName
                                    </span>

                                </div>

                                <button type="button"
                                        class="swift-modal-close"
                                        data-bs-dismiss="modal">

                                    <i class="fas fa-times"></i>

                                </button>

                            </div>


                            <div class="modal-body swift-modal-body">

                                <div class="swift-cart-preview">

                                    @if (!string.IsNullOrWhiteSpace(
                                        equipment.ImageUrl))
                                    {
                                        <div class="swift-cart-preview-image">

                                            <img src="~/@equipment.ImageUrl"
                                                 alt="@equipment.EquipmentName" />

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="swift-cart-preview-placeholder">

                                            <i class="fas fa-wheelchair"></i>

                                        </div>
                                    }


                                    <div>

                                        <h5 class="swift-cart-preview-name">

                                            @equipment.EquipmentName

                                        </h5>

                                        <p class="swift-cart-preview-description">

                                            Select the quantity required.

                                        </p>

                                    </div>

                                </div>


                                <div class="quantity-wrapper">

                                    <label class="quantity-label"
                                           for="quantity_@equipment.EquipmentId">

                                        Quantity

                                    </label>

                                    <input type="number"
                                           min="1"
                                           value="1"
                                           class="quantity-input"
                                           id="quantity_@equipment.EquipmentId" />

                                </div>

                            </div>


                            <div class="modal-footer swift-modal-footer">

                                <button type="button"
                                        class="swift-close-button"
                                        data-bs-dismiss="modal">

                                    Cancel

                                </button>


                                <button type="button"
                                        class="swift-add-button add-equipment-to-cart"
                                        data-equipment-id="@equipment.EquipmentId"
                                        data-equipment-name="@equipment.EquipmentName">

                                    <i class="fas fa-cart-plus me-1"></i>

                                    Add to Cart

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <div id="noItemsMessage"
             class="swift-no-equipment-results">

            <i class="fas fa-search me-2"></i>

            No equipment found for your search.

        </div>
    }
    else
    {
        <div class="swift-equipment-empty">

            <div class="swift-equipment-empty-icon">

                <i class="fas fa-wheelchair"></i>

            </div>

            <h4>
                No equipment available
            </h4>

            <p>
                There is currently no nursing home equipment available.
            </p>

        </div>
    }

</div>


<!-- ================================================================
     CART OVERLAY
     ================================================================ -->

<div class="swift-cart-overlay"
     id="cartOverlay">
</div>


<!-- ================================================================
     CART PANEL
     ================================================================ -->

<div class="swift-cart-panel"
     id="cartPanel">

    <div class="swift-cart-header">

        <h4>

            <i class="fas fa-shopping-cart me-2"></i>

            Equipment Cart

        </h4>


        <button type="button"
                class="swift-cart-close"
                id="closeCart">

            <i class="fas fa-times"></i>

        </button>

    </div>


    <div class="swift-cart-body">

        <div id="cartItemsBody">

            <div class="swift-cart-empty">

                <div class="swift-cart-empty-icon">

                    <i class="fas fa-shopping-cart"></i>

                </div>

                <h5>
                    Loading cart...
                </h5>

            </div>

        </div>

    </div>


    <div class="swift-cart-footer">

        <button type="button"
                class="swift-close-button w-100"
                id="continueShoppingBtn">

            <i class="fas fa-arrow-left me-1"></i>

            Continue Shopping

        </button>

    </div>

</div>


@section Scripts {

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>

        /* ============================================================
        CART
        ============================================================ */

        function openCart() {

        $('#cartPanel').addClass('show');

        $('#cartOverlay').addClass('show');

        fetchCartItems();
        }


        function closeCart() {

        $('#cartPanel').removeClass('show');

        $('#cartOverlay').removeClass('show');
        }


        $('#cartIcon').on('click', function () {

        openCart();

        });


        $('#closeCart').on('click', function () {

        closeCart();

        });


        $('#cartOverlay').on('click', function () {

        closeCart();

        });


        $('#continueShoppingBtn').on('click', function () {

        closeCart();

        });


        $(document).on('keydown', function (event) {

        if (event.key === 'Escape') {

        closeCart();

        }

        });


        /* ============================================================
        SEARCH
        ============================================================ */

        $('#searchInput').on('input', function () {

        var search = $(this)
        .val()
        .toLowerCase()
        .trim();

        var visibleItems = 0;


        $('#equipmentContainer .swift-equipment-card')
        .each(function () {

        var card = $(this);

        var name =
        (card.attr('data-equipment-name') || '')
        .toLowerCase();

        var description =
        (card.attr('data-equipment-description') || '')
        .toLowerCase();


        var matches =
        !search ||
        name.includes(search) ||
        description.includes(search);


        card.toggle(matches);


        if (matches) {

        visibleItems++;

        }

        });


        $('#noItemsMessage').toggle(
        visibleItems === 0
        );

        });


        /* ============================================================
        ADD EQUIPMENT
        ============================================================ */

        $(document).on(
        'click',
        '.add-equipment-to-cart',
        function () {

        var button = $(this);

        var equipmentId =
        button.data('equipment-id');

        var equipmentName =
        button.data('equipment-name');

        var quantityInput =
        $('#quantity_' + equipmentId);

        var quantity =
        parseInt(quantityInput.val());


        if (
        isNaN(quantity) ||
        quantity < 1
        ) {

        quantity = 1;

        quantityInput.val(1);

        }


        button.prop('disabled', true);


        $.ajax({

        url: '@Url.Action("AddToCart", "Cart")',

        type: 'POST',

        data: {

        equipmentId: equipmentId,

        quantity: quantity

        },

        success: function (response) {

        if (
        response &&
        response.success
        ) {

        $('#cartItemCount')
        .text(response.count);

        $('.modal').modal('hide');

        setTimeout(function () {

        openCart();

        }, 250);

        }
        else {

        alert(
        response.message ||
        'Unable to add equipment to cart.'
        );

        }

        },

        error: function (xhr) {

        console.error(
        xhr.responseText
        );

        alert(
        'Unable to add ' +
        equipmentName +
        ' to the cart.'
        );

        },

        complete: function () {

        button.prop('disabled', false);

        }

        });

        }
        );


        /* ============================================================
        CART COUNT
        ============================================================ */

        function updateCartCount() {

        $.get(
        '@Url.Action("GetCartItemCount", "Cart")'
        )

        .done(function (data) {

        $('#cartItemCount').text(data);

        })

        .fail(function () {

        $('#cartItemCount').text('0');

        });

        }


        /* ============================================================
        FETCH PARTIAL
        ============================================================ */

        function fetchCartItems() {

        $('#cartItemsBody').html(`

        <div class="swift-cart-empty">

        <div class="swift-cart-empty-icon">

        <i class="fas fa-spinner fa-spin"></i>

        </div>

        <h5>
        Loading cart...
        </h5>

        </div>

        `);


        $.get(
        '@Url.Action("GetCartItems", "Cart")'
        )

        .done(function (data) {

        $('#cartItemsBody').html(data);

        })

        .fail(function (xhr) {

        console.error(
        xhr.responseText
        );


        $('#cartItemsBody').html(`

        <div class="swift-cart-empty">

        <div class="swift-cart-empty-icon">

        <i class="fas fa-exclamation-triangle"></i>

        </div>

        <h5>
        Unable to load cart
        </h5>

        <p>
        Please try again.
        </p>

        </div>

        `);

        });

        }


        /* ============================================================
        DELETE CART ITEM
        ============================================================ */

        $(document).on(
        'click',
        '.delete-cart-item',
        function () {

        var button = $(this);

        var cartItemId =
        button.data('cartitemid');


        button.prop('disabled', true);


        $.ajax({

        url:
        '@Url.Action("Delete", "Cart")',

        type: 'POST',

        data: {

        id: cartItemId

        },

        success: function (response) {

        if (
        response &&
        response.success
        ) {

        $('#cartItemCount')
        .text(response.count);

        fetchCartItems();

        }
        else {

        alert(
        response.message ||
        'Unable to remove equipment.'
        );

        button.prop(
        'disabled',
        false
        );

        }

        },

        error: function (xhr) {

        console.error(
        xhr.responseText
        );

        button.prop(
        'disabled',
        false
        );

        }

        });

        }
        );


        /* ============================================================
        QUANTITY INPUT
        ============================================================ */

        $(document).on(
        'change',
        '.quantity-input-cart',
        function () {

        var input = $(this);

        var cartItemId =
        input.data('cartitemid');

        var quantity =
        parseInt(input.val());


        if (
        isNaN(quantity) ||
        quantity < 1
        ) {

        quantity = 1;

        input.val(1);

        }


        $.ajax({

        url:
        '@Url.Action("UpdateQuantity", "Cart")',

        type: 'POST',

        data: {

        id: cartItemId,

        quantity: quantity

        },

        success: function (response) {

        if (
        response &&
        response.success
        ) {

        fetchCartItems();

        }

        }

        });

        }
        );


        /* ============================================================
        PLUS
        ============================================================ */


        /* ============================================================
        PLACE ORDER
        ============================================================ */

        $(document).on('click', '#placeOrderButton', function () {

        const button = $(this);

        button.prop('disabled', true);

        button.html(
        '<i class="fas fa-spinner fa-spin me-1"></i> Placing Order...'
        );

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({

        url: '@Url.Action("PlaceOrder", "Orders")',

        type: 'POST',

        headers: {
        'RequestVerificationToken': token
        },

        success: function (response) {

        console.log("Place order response:", response);

        if (response && response.success) {

        window.location.href = response.redirectUrl;

        }
        else {

        alert(
        response?.message ||
        'Unable to place the order.'
        );

        button.prop('disabled', false);

        button.html(
        '<i class="fas fa-check-circle me-1"></i> Place Order'
        );
        }
        },

        error: function (xhr) {

        console.error("PLACE ORDER ERROR");
        console.error("Status:", xhr.status);
        console.error("Response:", xhr.responseText);

        let message =
        'The server encountered an error while placing the order.';

        try {

        const response = JSON.parse(xhr.responseText);

        if (response.message) {

        message = response.message;

        }

        if (response.error) {

        console.error(
        "Server error:",
        response.error
        );
        }

        if (response.innerError) {

        console.error(
        "Inner error:",
        response.innerError
        );
        }

        }
        catch (parseError) {

        console.error(
        "Could not parse server response:",
        parseError
        );
        }

        alert(message);

        button.prop('disabled', false);

        button.html(
        '<i class="fas fa-check-circle me-1"></i> Place Order'
        );
        }

        });

        });

        /* ============================================================
        MINUS
        ============================================================ */

        $(document).on(
        'click',
        '.decrease-cart-quantity',
        function () {

        var button = $(this);

        var cartItemId =
        button.data('cartitemid');

        var input =
        button
        .closest('.swift-cart-quantity')
        .find('.quantity-input-cart');

        var quantity =
        parseInt(input.val()) || 1;


        if (quantity <= 1) {

        return;

        }


        quantity--;


        input.val(quantity);


        updateCartQuantity(
        cartItemId,
        quantity
        );

        }
        );


        /* ============================================================
        UPDATE CART QUANTITY
        ============================================================ */

        function updateCartQuantity(
        cartItemId,
        quantity
        ) {

        $.ajax({

        url:
        '@Url.Action("UpdateQuantity", "Cart")',

        type: 'POST',

        data: {

        id: cartItemId,

        quantity: quantity

        },

        success: function (response) {

        if (
        response &&
        response.success
        ) {

        fetchCartItems();

        }

        },

        error: function (xhr) {

        console.error(
        xhr.responseText
        );

        }

        });

        }


        /* ============================================================
        CLEAR CART
        ============================================================ */

        $(document).on(
        'click',
        '#clearCartButton',
        function () {

        if (
        !confirm(
        'Are you sure you want to clear the equipment cart?'
        )
        ) {

        return;

        }


        $.ajax({

        url:
        '@Url.Action("ClearCart", "Cart")',

        type: 'POST',

        success: function (response) {

        if (
        response &&
        response.success
        ) {

        $('#cartItemCount')
        .text(0);

        fetchCartItems();

        }
        else {

        alert(
        response.message ||
        'Unable to clear cart.'
        );

        }

        },

        error: function (xhr) {

        console.error(
        xhr.responseText
        );

        }

        });

        }
        );


        /* ============================================================
        INITIAL LOAD
        ============================================================ */

        $(document).ready(function () {

        updateCartCount();

        });

    </script>
}