</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =========================================================
           ELEMENTS
           ========================================================= */

        const assignModal =
            document.getElementById("vpAssignModal");

        const taskDetailsModal =
            document.getElementById("vpTaskDetailsModal");

        const rosterModal =
            document.getElementById("vpRosterModal");

        const assignForm =
            document.getElementById("vpAssignForm");

        const rosterForm =
            document.getElementById("vpCreateRosterForm");

        const ajaxMessage =
            document.getElementById("vpAjaxMessage");

        const modalTaskId =
            document.getElementById("vpModalTaskId");

        const modalTaskTitle =
            document.getElementById("vpModalTaskTitle");

        const modalTaskDescription =
            document.getElementById("vpModalTaskDescription");

        const taskDate =
            document.getElementById("vpTaskDate");

        const taskDetailsTitle =
            document.getElementById("vpTaskDetailsTitle");

        const taskDetailsDescription =
            document.getElementById("vpTaskDetailsDescription");

        const taskDetailsDate =
            document.getElementById("vpTaskDetailsDate");

        const taskDetailsArea =
            document.getElementById("vpTaskDetailsArea");

        const taskDetailsPriority =
            document.getElementById("vpTaskDetailsPriority");

        const taskDetailsStatus =
            document.getElementById("vpTaskDetailsStatus");

        const taskDetailsTime =
            document.getElementById("vpTaskDetailsTime");

        const taskActualTimes =
            document.getElementById("vpTaskActualTimes");

        const taskStartedBox =
            document.getElementById("vpTaskStartedBox");

        const taskStartedDateTime =
            document.getElementById("vpTaskStartedDateTime");

        const taskCompletedBox =
            document.getElementById("vpTaskCompletedBox");

        const taskCompletedDateTime =
            document.getElementById("vpTaskCompletedDateTime");

        const taskCompletionNotesBox =
            document.getElementById("vpTaskCompletionNotesBox");

        const taskCompletionNotes =
            document.getElementById("vpTaskCompletionNotes");

        const rosterWeekType =
            document.getElementById("vpRosterWeekType");

        const rosterStartDate =
            document.getElementById("vpRosterStartDate");

        const rosterEndDate =
            document.getElementById("vpRosterEndDate");

        const rosterName =
            document.getElementById("vpRosterName");


        const currentWeekStart =
            "@Model.CurrentWeekStart.ToString("yyyy-MM-dd")";

        const currentWeekEnd =
            "@Model.CurrentWeekEnd.ToString("yyyy-MM-dd")";

        const upcomingWeekStart =
            "@Model.UpcomingWeekStart.ToString("yyyy-MM-dd")";

        const upcomingWeekEnd =
            "@Model.UpcomingWeekEnd.ToString("yyyy-MM-dd")";


        /* =========================================================
           MESSAGE
           ========================================================= */

        function showMessage(message, type = "success") {

            if (!ajaxMessage) {
                return;
            }

            ajaxMessage.textContent = message;

            ajaxMessage.className =
                "vp-ajax-message vp-ajax-message-visible " +
                (
                    type === "success"
                        ? "vp-ajax-message-success"
                        : "vp-ajax-message-error"
                );

            window.setTimeout(function () {

                ajaxMessage.classList.remove(
                    "vp-ajax-message-visible"
                );

            }, 4500);
        }


        /* =========================================================
           MODALS
           ========================================================= */

        function openModal(modal) {

            if (!modal) {
                console.error("Modal element not found.");
                return;
            }

            modal.classList.add(
                "vp-modal-visible"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "vp-modal-body-lock"
            );
        }


        function closeModal(modal) {

            if (!modal) {
                return;
            }

            modal.classList.remove(
                "vp-modal-visible"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            if (!document.querySelector(
                ".vp-modal-visible"
            )) {

                document.body.classList.remove(
                    "vp-modal-body-lock"
                );
            }
        }


        /* =========================================================
           DATE
           ========================================================= */

        function formatReadableDate(dateValue) {

            if (!dateValue) {
                return "—";
            }

            const date =
                new Date(
                    dateValue + "T00:00:00"
                );

            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {
                return dateValue;
            }

            return date.toLocaleDateString(
                undefined,
                {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                }
            );
        }


        /* =========================================================
           ACTUAL TASK TIMESTAMP
           ISO timestamps with an offset or Z are displayed in the
           browser's local time. Timestamps without an offset retain
           their supplied local clock time.
           ========================================================= */

        function formatTaskDateTime(value) {
            if (!value || !String(value).trim()) {
                return "Not recorded";
            }

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) {
                return String(value);
            }

            return date.toLocaleString(undefined, {
                day: "numeric",
                month: "long",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function setTaskDetailVisibility(element, visible) {
            if (!element) {
                return;
            }

            element.hidden = !visible;
            element.style.display = visible ? "" : "none";
        }


        /* =========================================================
           HTML ESCAPE
           ========================================================= */

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        /* =========================================================
           RESPONSE
           ========================================================= */

        function readJsonResponse(response) {

            return response.text()
                .then(function (text) {

                    let data = null;

                    try {

                        data =
                            text
                                ? JSON.parse(text)
                                : null;

                    }
                    catch (error) {

                        console.error(
                            "Invalid JSON:",
                            text
                        );

                        throw new Error(
                            "The server returned an invalid response."
                        );
                    }

                    if (!response.ok) {

                        throw new Error(
                            data?.message ||
                            data?.error ||
                            "The request could not be completed."
                        );
                    }

                    return data;
                });
        }


        /* =========================================================
           CREATE ROSTER
           ========================================================= */

        document
            .querySelectorAll(
                ".vp-create-roster-trigger"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        if (!rosterModal) {
                            return;
                        }

                        const week =
                            button.dataset.week;

                        if (week === "current") {

                            if (rosterWeekType) {
                                rosterWeekType.value =
                                    "current";
                            }

                            if (rosterStartDate) {
                                rosterStartDate.value =
                                    currentWeekStart;
                            }

                            if (rosterEndDate) {
                                rosterEndDate.value =
                                    currentWeekEnd;
                            }

                            if (rosterName) {
                                rosterName.value =
                                    "Current Week Roster";
                            }

                        }
                        else {

                            if (rosterWeekType) {
                                rosterWeekType.value =
                                    "upcoming";
                            }

                            if (rosterStartDate) {
                                rosterStartDate.value =
                                    upcomingWeekStart;
                            }

                            if (rosterEndDate) {
                                rosterEndDate.value =
                                    upcomingWeekEnd;
                            }

                            if (rosterName) {
                                rosterName.value =
                                    "Upcoming Week Roster";
                            }
                        }

                        openModal(
                            rosterModal
                        );
                    }
                );
            });


        document
            .querySelectorAll(
                ".js-close-roster-modal"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeModal(
                            rosterModal
                        );

                    }
                );
            });


        /* =========================================================
           CREATE ROSTER FORM
           ========================================================= */

        if (rosterForm) {

            rosterForm.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const submitButton =
                        rosterForm.querySelector(
                            "[type='submit']"
                        );

                    const originalHtml =
                        submitButton
                            ? submitButton.innerHTML
                            : "";

                    if (submitButton) {

                        submitButton.disabled =
                            true;

                        submitButton.innerHTML =
                            '<i class="bi bi-arrow-repeat vp-spin"></i> Creating...';
                    }

                    fetch(
                        rosterForm.action,
                        {
                            method: "POST",

                            body:
                                new FormData(
                                    rosterForm
                                ),

                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    )
                    .then(
                        readJsonResponse
                    )
                    .then(function (result) {

                        if (
                            !result ||
                            result.success !== true
                        ) {

                            throw new Error(
                                result?.message ||
                                "Roster could not be created."
                            );
                        }

                        updateRosterUI(
                            result
                        );

                        closeModal(
                            rosterModal
                        );

                        showMessage(
                            result.message ||
                            "Roster created successfully.",
                            "success"
                        );

                    })
                    .catch(function (error) {

                        console.error(
                            "Create roster error:",
                            error
                        );

                        showMessage(
                            error.message ||
                            "Unable to create roster.",
                            "error"
                        );

                    })
                    .finally(function () {

                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerHTML =
                                originalHtml;
                        }

                    });
                }
            );
        }


        /* =========================================================
           ROSTER UI
           ========================================================= */

        function updateRosterUI(result) {

            updateCalendarRosterState(
                result
            );
        }


        function updateCalendarRosterState(result) {

            if (!result) {
                return;
            }

            const weekStart =
                String(
                    result.startDate ||
                    result.StartDate ||
                    ""
                ).substring(0, 10);

            if (!weekStart) {
                return;
            }

            const weekElement =
                document.querySelector(
                    '.vp-calendar-week[data-calendar-week="' +
                    weekStart +
                    '"]'
                );

            if (!weekElement) {
                return;
            }

            const createButton =
                weekElement.querySelector(
                    ".vp-create-roster-trigger"
                );

            if (createButton) {
                createButton.remove();
            }

            const oldRosterBadge =
                weekElement.querySelector(
                    ".vp-calendar-roster-badge"
                );

            if (oldRosterBadge) {

                const status =
                    result.status ||
                    result.Status ||
                    "Published";

                const statusClass =
                    String(status)
                        .toLowerCase();

                oldRosterBadge.className =
                    "vp-calendar-roster-badge " +
                    "vp-calendar-roster-" +
                    statusClass;

                oldRosterBadge.innerHTML =
                    '<i class="bi bi-calendar-check"></i>' +
                    '<span class="vp-calendar-roster-status-text">' +
                    escapeHtml(status) +
                    "</span>";
            }

            const emptyMessage =
                weekElement.querySelector(
                    ".vp-calendar-week-empty"
                );

            if (emptyMessage) {

                emptyMessage.innerHTML = `
                    <i class="bi bi-calendar-check"></i>

                    <div>
                        <strong>
                            Roster created — no tasks yet
                        </strong>

                        <span>
                            Use the task library below to assign tasks to this volunteer.
                        </span>
                    </div>
                `;
            }
        }


        /* =========================================================
           ASSIGN TASK MODAL
           ========================================================= */

        document
            .querySelectorAll(
                ".js-open-assign"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        if (modalTaskId) {

                            modalTaskId.value =
                                button.dataset.taskId ||
                                "";
                        }

                        if (modalTaskTitle) {

                            modalTaskTitle.textContent =
                                button.dataset.taskTitle ||
                                "Task";
                        }

                        if (modalTaskDescription) {

                            modalTaskDescription.textContent =
                                button.dataset.taskDescription ||
                                "";
                        }

                        openModal(
                            assignModal
                        );
                    }
                );
            });


        /* =========================================================
           CLOSE ASSIGN MODAL
           ========================================================= */

        document
            .querySelectorAll(
                ".js-close-assign-modal"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeModal(
                            assignModal
                        );

                    }
                );
            });


        /* =========================================================
           ASSIGN TASK
           ========================================================= */

        if (assignForm) {

            assignForm.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    if (
                        !taskDate ||
                        !taskDate.value
                    ) {

                        showMessage(
                            "Please select a task date.",
                            "error"
                        );

                        return;
                    }

                    const selectedDate =
                        new Date(
                            taskDate.value +
                            "T00:00:00"
                        );

                    if (
                        selectedDate.getDay() === 0 ||
                        selectedDate.getDay() === 6
                    ) {

                        showMessage(
                            "Tasks cannot be assigned on weekends.",
                            "error"
                        );

                        return;
                    }

                    const submitButton =
                        document.getElementById(
                            "vpAssignButton"
                        );

                    const originalHtml =
                        submitButton
                            ? submitButton.innerHTML
                            : "";

                    if (submitButton) {

                        submitButton.disabled =
                            true;

                        submitButton.innerHTML =
                            '<i class="bi bi-arrow-repeat vp-spin"></i> Assigning...';
                    }

                    fetch(
                        assignForm.action,
                        {
                            method: "POST",

                            body:
                                new FormData(
                                    assignForm
                                ),

                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            }
                        }
                    )
                    .then(readJsonResponse)
                    .then(function (result) {

                        console.log(
                            "ASSIGN TASK RESPONSE:",
                            result
                        );

                        if (
                            !result ||
                            result.success !== true
                        ) {

                            throw new Error(
                                result?.message ||
                                "Task could not be assigned."
                            );
                        }

                        updateStatistics(
                            result
                        );

                        addAssignmentToCalendar(
                            result
                        );

                        closeModal(
                            assignModal
                        );

                        assignForm.reset();

                        if (taskDate) {
                            taskDate.value =
                                currentWeekStart;
                        }

                        showMessage(
                            result.message ||
                            "Task assigned successfully.",
                            "success"
                        );
                    })
                    .catch(function (error) {

                        console.error(
                            "Assign task error:",
                            error
                        );

                        showMessage(
                            error.message ||
                            "Unable to assign task.",
                            "error"
                        );

                        closeModal(
                            assignModal
                        );
                    })
                    .finally(function () {

                        if (submitButton) {

                            submitButton.disabled =
                                false;

                            submitButton.innerHTML =
                                originalHtml;
                        }

                    });
                }
            );
        }


        /* =========================================================
           TIME TO MINUTES
           ========================================================= */

        function timeToMinutes(time) {

            if (!time) {
                return 9999;
            }

            const parts =
                time.split(":");

            const hours =
                parseInt(parts[0], 10);

            const minutes =
                parseInt(parts[1], 10);

            if (
                Number.isNaN(hours) ||
                Number.isNaN(minutes)
            ) {
                return 9999;
            }

            return (
                hours * 60
            ) + minutes;
        }


        /* =========================================================
           ADD ASSIGNMENT TO CALENDAR
           ========================================================= */

        function addAssignmentToCalendar(result) {

            if (!result) {
                console.error(
                    "No assignment result received."
                );
                return;
            }

            console.log(
                "ADDING NEW TASK TO CALENDAR:",
                result
            );

            const dateValue =
                String(
                    result.taskDate ||
                    result.TaskDate ||
                    ""
                ).substring(0, 10);

            if (!dateValue) {

                console.error(
                    "No task date returned.",
                    result
                );

                return;
            }

            const dayElement =
                document.querySelector(
                    '.vp-calendar-day[data-calendar-date="' +
                    dateValue +
                    '"]'
                );

            if (!dayElement) {

                console.error(
                    "Calendar day not found for:",
                    dateValue
                );

                return;
            }

            const dayBody =
                dayElement.querySelector(
                    ".vp-calendar-day-body"
                );

            if (!dayBody) {
                console.error(
                    "Calendar day body not found."
                );
                return;
            }

            const empty =
                dayBody.querySelector(
                    ".vp-calendar-day-empty"
                );

            if (empty) {
                empty.remove();
            }

            const title =
                result.title ||
                result.taskTitle ||
                result.Title ||
                result.TaskTitle ||
                "Assigned Task";

            const description =
                result.description ||
                result.taskDescription ||
                result.Description ||
                result.TaskDescription ||
                "";

            const area =
                result.area ||
                result.taskArea ||
                result.Area ||
                result.TaskArea ||
                "";

            const priority =
                result.priority ||
                result.taskPriority ||
                result.Priority ||
                result.TaskPriority ||
                "";

            const status =
                result.status ||
                result.Status ||
                "Assigned";

            const start =
                result.startTime ||
                result.StartTime ||
                "08:00";

            const end =
                result.endTime ||
                result.EndTime ||
                "09:00";

            const volunteerTaskId =
                result.volunteerTaskId ||
                result.VolunteerTaskId ||
                "";

            if (!volunteerTaskId) {

                console.error(
                    "No VolunteerTaskId returned from server.",
                    result
                );

                showMessage(
                    "The task was created, but its calendar ID was not returned.",
                    "error"
                );

                return;
            }

            const task =
                document.createElement("button");

            task.type =
                "button";

            const statusClass =
                String(status)
                    .toLowerCase()
                    .replace(/\s+/g, "");

            task.className =
                "vp-calendar-task " +
                "vp-calendar-task-" +
                statusClass;

            task.dataset.calendarTask =
                "true";

            task.dataset.volunteerTaskId =
                String(volunteerTaskId);

            task.dataset.taskTitle =
                title;

            task.dataset.taskDescription =
                description;

            task.dataset.taskDate =
                dateValue;

            task.dataset.taskArea =
                area;

            task.dataset.taskPriority =
                priority;

            task.dataset.taskStatus =
                status;

            task.dataset.taskStartedDate =
                result.startedDate || result.StartedDate || "";

            task.dataset.taskCompletedDate =
                result.completedDate || result.CompletedDate || "";

            task.dataset.taskCompletionNotes =
                result.completionNotes || result.CompletionNotes || "";

            task.dataset.taskStart =
                start;

            task.dataset.taskEnd =
                end;

            task.innerHTML = `
                <span class="vp-calendar-task-time">
                    ${escapeHtml(start)} - ${escapeHtml(end)}
                </span>

                <span class="vp-calendar-task-title">
                    ${escapeHtml(title)}
                </span>
            `;

            const existingTasks =
                Array.from(
                    dayBody.querySelectorAll(
                        '[data-calendar-task="true"]'
                    )
                );

            const newStartMinutes =
                timeToMinutes(start);

            let inserted =
                false;

            for (
                const existingTask
                of existingTasks
            ) {

                const existingStart =
                    existingTask.getAttribute(
                        "data-task-start"
                    ) ||
                    "23:59";

                const existingStartMinutes =
                    timeToMinutes(
                        existingStart
                    );

                if (
                    newStartMinutes <
                    existingStartMinutes
                ) {

                    dayBody.insertBefore(
                        task,
                        existingTask
                    );

                    inserted =
                        true;

                    break;
                }
            }

            if (!inserted) {
                dayBody.appendChild(
                    task
                );
            }

            dayElement.classList.add(
                "vp-calendar-day-has-tasks"
            );

            bindCalendarTask(
                task
            );

            updateCalendarCount(
                dayElement.closest(
                    ".vp-calendar-week"
                )
            );

            console.log(
                "TASK ADDED TO CALENDAR WITHOUT PAGE RELOAD:",
                {
                    volunteerTaskId,
                    dateValue,
                    start,
                    end,
                    title
                }
            );
        }


        /* =========================================================
           CALENDAR TASK DETAILS
           ========================================================= */

        function bindCalendarTask(button) {

            if (!button) {
                return;
            }

            button.addEventListener(
                "click",
                function () {

                    console.log(
                        "CALENDAR TASK CLICKED",
                        button
                    );

                    const volunteerTaskId =
                        button.getAttribute(
                            "data-volunteer-task-id"
                        );

                    const assignmentDate =
                        button.getAttribute(
                            "data-task-date"
                        ) ||
                        "";

                    if (
                        !volunteerTaskId ||
                        volunteerTaskId === "0"
                    ) {

                        console.error(
                            "VolunteerTaskId is missing.",
                            button.outerHTML
                        );

                        showMessage(
                            "Unable to identify this task.",
                            "error"
                        );

                        return;
                    }

                    if (taskDetailsModal) {

                        taskDetailsModal.dataset.volunteerTaskId =
                            volunteerTaskId;

                        taskDetailsModal.dataset.taskDate =
                            assignmentDate;
                    }

                    if (taskDetailsTitle) {

                        taskDetailsTitle.textContent =
                            button.getAttribute(
                                "data-task-title"
                            ) ||
                            "Task";
                    }

                    if (taskDetailsDescription) {

                        taskDetailsDescription.textContent =
                            button.getAttribute(
                                "data-task-description"
                            ) ||
                            "No description provided.";
                    }

                    if (taskDetailsDate) {

                        taskDetailsDate.textContent =
                            formatReadableDate(
                                assignmentDate
                            );
                    }

                    if (taskDetailsArea) {

                        taskDetailsArea.textContent =
                            button.getAttribute(
                                "data-task-area"
                            ) ||
                            "—";
                    }

                    if (taskDetailsPriority) {

                        taskDetailsPriority.textContent =
                            button.getAttribute(
                                "data-task-priority"
                            ) ||
                            "—";
                    }

                    if (taskDetailsStatus) {

                        taskDetailsStatus.textContent =
                            button.getAttribute(
                                "data-task-status"
                            ) ||
                            "—";
                    }

                    const start =
                        button.getAttribute(
                            "data-task-start"
                        ) ||
                        "—";

                    const end =
                        button.getAttribute(
                            "data-task-end"
                        ) ||
                        "—";

                    if (taskDetailsTime) {

                        taskDetailsTime.textContent =
                            start +
                            " - " +
                            end;
                    }

                    const status = (
                        button.getAttribute("data-task-status") || ""
                    ).trim().toLowerCase().replace(/\s+/g, "");

                    const isCompleted = status === "completed";
                    const showStarted = isCompleted || status === "inprogress";

                    const startedDate = button.getAttribute(
                        "data-task-started-date"
                    );
                    const completedDate = button.getAttribute(
                        "data-task-completed-date"
                    );
                    const completionNotes = button.getAttribute(
                        "data-task-completion-notes"
                    );

                    setTaskDetailVisibility(taskActualTimes, showStarted);
                    setTaskDetailVisibility(taskStartedBox, showStarted);
                    setTaskDetailVisibility(taskCompletedBox, isCompleted);
                    setTaskDetailVisibility(taskCompletionNotesBox, isCompleted);

                    if (taskStartedDateTime) {
                        taskStartedDateTime.textContent =
                            showStarted ? formatTaskDateTime(startedDate) : "—";
                    }

                    if (taskCompletedDateTime) {
                        taskCompletedDateTime.textContent =
                            isCompleted ? formatTaskDateTime(completedDate) : "—";
                    }

                    if (taskCompletionNotes) {
                        taskCompletionNotes.textContent = isCompleted
                            ? (completionNotes?.trim() || "No completion notes provided.")
                            : "—";
                    }

                    openModal(
                        taskDetailsModal
                    );
                }
            );
        }


        /* =========================================================
           EXISTING CALENDAR TASKS
           ========================================================= */

        document
            .querySelectorAll(
                '[data-calendar-task="true"]'
            )
            .forEach(function (button) {

                bindCalendarTask(
                    button
                );

            });


        /* =========================================================
           CLOSE TASK DETAILS MODAL
           ========================================================= */

        document
            .querySelectorAll(
                ".js-close-task-details-modal"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeModal(
                            taskDetailsModal
                        );

                    }
                );

            });


        /* =========================================================
           CALENDAR COUNT
           ========================================================= */

        function updateCalendarCount(
            weekElement
        ) {

            if (!weekElement) {
                return;
            }

            const count =
                weekElement.querySelectorAll(
                    '[data-calendar-task="true"]'
                ).length;

            const countElement =
                weekElement.querySelector(
                    ".vp-calendar-task-count-value"
                );

            if (countElement) {

                countElement.textContent =
                    count;
            }

            const emptyMessage =
                weekElement.querySelector(
                    ".vp-calendar-week-empty"
                );

            if (
                count > 0 &&
                emptyMessage
            ) {

                emptyMessage.remove();
            }
        }


        /* =========================================================
           REMOVE TASK ASSIGNMENT
           ========================================================= */

        const removeTaskButton =
            document.getElementById(
                "vpRemoveTaskButton"
            );

        if (removeTaskButton) {

            removeTaskButton.addEventListener(
                "click",
                async function () {

                    const modal =
                        document.getElementById(
                            "vpTaskDetailsModal"
                        );

                    if (!modal) {
                        return;
                    }

                    const volunteerTaskId =
                        modal.dataset.volunteerTaskId ||
                        "";

                    const assignmentDate =
                        modal.dataset.taskDate ||
                        "";

                    console.log(
                        "REMOVE VolunteerTaskId:",
                        volunteerTaskId
                    );

                    if (!volunteerTaskId) {

                        showMessage(
                            "Unable to identify this task.",
                            "error"
                        );

                        return;
                    }

                    const confirmed =
                        window.confirm(
                            "Are you sure you want to remove this task from the volunteer's roster?"
                        );

                    if (!confirmed) {
                        return;
                    }

                    removeTaskButton.disabled =
                        true;

                    removeTaskButton.classList.add(
                        "is-loading"
                    );

                    const originalContent =
                        removeTaskButton.innerHTML;

                    removeTaskButton.innerHTML = `
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Removing...</span>
                    `;

                    try {

                        const tokenElement =
                            assignForm?.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            ) ||
                            document.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            );

                        const token =
                            tokenElement?.value ||
                            "";

                        const requestBody =
                            new URLSearchParams();

                        requestBody.append(
                            "volunteerTaskId",
                            String(
                                volunteerTaskId
                            )
                        );

                        const response =
                            await fetch(
                                "/Supervisor/RemoveTaskAssignment",
                                {
                                    method: "POST",

                                    headers: {

                                        "Content-Type":
                                            "application/x-www-form-urlencoded; charset=UTF-8",

                                        "RequestVerificationToken":
                                            token,

                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    },

                                    body:
                                        requestBody.toString()
                                }
                            );

                        const result =
                            await readJsonResponse(
                                response
                            );

                        console.log(
                            "REMOVE RESPONSE:",
                            result
                        );

                        if (
                            !result ||
                            result.success !== true
                        ) {

                            throw new Error(
                                result?.message ||
                                "Unable to remove the task."
                            );
                        }

                        let taskElement =
                            null;

                        if (assignmentDate) {

                            const dayElement =
                                document.querySelector(
                                    '.vp-calendar-day[data-calendar-date="' +
                                    assignmentDate +
                                    '"]'
                                );

                            if (dayElement) {

                                taskElement =
                                    dayElement.querySelector(
                                        '[data-calendar-task="true"][data-volunteer-task-id="' +
                                        volunteerTaskId +
                                        '"]'
                                    );
                            }
                        }

                        if (!taskElement) {

                            taskElement =
                                document.querySelector(
                                    '[data-calendar-task="true"][data-volunteer-task-id="' +
                                    volunteerTaskId +
                                    '"]'
                                );
                        }

                        if (taskElement) {

                            const dayElement =
                                taskElement.closest(
                                    ".vp-calendar-day"
                                );

                            const weekElement =
                                taskElement.closest(
                                    ".vp-calendar-week"
                                );

                            taskElement.remove();

                            if (dayElement) {

                                const remainingTasks =
                                    dayElement.querySelectorAll(
                                        '[data-calendar-task="true"]'
                                    );

                                if (
                                    remainingTasks.length === 0
                                ) {

                                    dayElement.classList.remove(
                                        "vp-calendar-day-has-tasks"
                                    );

                                    const bodyElement =
                                        dayElement.querySelector(
                                            ".vp-calendar-day-body"
                                        );

                                    if (bodyElement) {

                                        const hasShift =
                                            bodyElement.querySelector(
                                                ".vp-calendar-shift"
                                            );

                                        if (!hasShift) {

                                            bodyElement.innerHTML = `
                                                <div class="vp-calendar-day-empty">
                                                    No shift or tasks
                                                </div>
                                            `;
                                        }
                                    }
                                }
                            }

                            if (weekElement) {

                                updateCalendarCount(
                                    weekElement
                                );
                            }
                        }

                        updateStatistics(
                            result.statistics ||
                            result
                        );

                        closeModal(
                            modal
                        );

                        delete modal.dataset.volunteerTaskId;
                        delete modal.dataset.taskDate;

                        showMessage(
                            result.message ||
                            "Task removed successfully.",
                            "success"
                        );

                    }
                    catch (error) {

                        console.error(
                            "Remove task error:",
                            error
                        );

                        showMessage(
                            error.message ||
                            "An error occurred while removing the task.",
                            "error"
                        );

                        removeTaskButton.innerHTML =
                            originalContent;
                    }
                    finally {

                        removeTaskButton.disabled =
                            false;

                        removeTaskButton.classList.remove(
                            "is-loading"
                        );

                        if (
                            removeTaskButton.innerHTML.includes(
                                "Removing..."
                            )
                        ) {

                            removeTaskButton.innerHTML =
                                originalContent;
                        }
                    }
                }
            );
        }


        /* =========================================================
           STATISTICS
           ========================================================= */

        function updateStatistics(result) {

            if (!result) {
                return;
            }

            const completed =
                result.completedCount ??
                result.CompletedCount;

            const inProgress =
                result.inProgressCount ??
                result.InProgressCount;

            if (
                completed !== undefined
            ) {

                const completedElement =
                    document.getElementById(
                        "vpCompletedCount"
                    );

                if (completedElement) {

                    completedElement.textContent =
                        completed;
                }
            }

            if (
                inProgress !== undefined
            ) {

                const progressElement =
                    document.getElementById(
                        "vpInProgressCount"
                    );

                if (progressElement) {

                    progressElement.textContent =
                        inProgress;
                }
            }
        }


        /* =========================================================
           ESCAPE KEY
           ========================================================= */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key !== "Escape"
                ) {
                    return;
                }

                closeModal(
                    assignModal
                );

                closeModal(
                    taskDetailsModal
                );

                closeModal(
                    rosterModal
                );
            }
        );


        /* =========================================================
           DEBUG
           ========================================================= */

        console.log(
            "Volunteer Profile JavaScript loaded."
        );

        console.log(
            "Assign modal:",
            assignModal
        );

        console.log(
            "Task details modal:",
            taskDetailsModal
        );

        console.log(
            "Roster modal:",
            rosterModal
        );

        console.log(
            "Calendar tasks:",
            document.querySelectorAll(
                '[data-calendar-task="true"]'
            ).length
        );

        console.log(
            "Current week shifts:",
            @Model.CurrentWeekShifts.Count
        );

        console.log(
            "Upcoming week shifts:",
            @Model.UpcomingWeekShifts.Count
        );

    });
</script>