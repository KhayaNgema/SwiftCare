@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding
@inject IConfiguration Configuration
@using SwiftCare.Models.VolunteerOnboarding

@{
    ViewData["Title"] = "Volunteer Onboarding Review";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var onboardingStatus = Model.Status;

    var readyForActivation =
        onboardingStatus == VolunteerOnboardingStatus.ReadyForActivation;

    var onboardingCompleted =
        onboardingStatus == VolunteerOnboardingStatus.Completed;

    var adminVerification =
        onboardingStatus == VolunteerOnboardingStatus.AdminVerification;

    var documentsPending =
        onboardingStatus == VolunteerOnboardingStatus.DocumentsPending;

    var policiesPending =
        onboardingStatus == VolunteerOnboardingStatus.PoliciesPending;

    var offerPending =
        onboardingStatus == VolunteerOnboardingStatus.OfferPending;

    var correctionRequired =
        onboardingStatus == VolunteerOnboardingStatus.RejectedForCorrection;

    var applicantName =
        $"{Model.Applicant?.FirstName} {Model.Applicant?.LastName}".Trim();

    if (string.IsNullOrWhiteSpace(applicantName))
    {
        applicantName = "Volunteer Applicant";
    }

    var opportunityTitle =
        Model.VolunteerApplication
            ?.VolunteerOpportunity
            ?.Title
        ?? "Volunteer Opportunity";


    // =============================================================
    // REQUIREMENTS
    // =============================================================

    var displayRequirements =
        Model.Requirements?
            .GroupBy(x => x.RequirementType)
            .Select(group =>
                group
                    .OrderByDescending(x => x.IsCompleted)
                    .ThenBy(x => x.DisplayOrder)
                    .ThenBy(x => x.VolunteerOnboardingRequirementId)
                    .First())
            .OrderBy(x => x.DisplayOrder)
            .ToList()
        ?? new List<VolunteerOnboardingRequirement>();

    var totalRequirements =
        displayRequirements.Count;

    var completedRequirements =
        displayRequirements.Count(x => x.IsCompleted);


    // =============================================================
    // DOCUMENTS
    // =============================================================

    var totalDocuments =
        Model.Documents?.Count() ?? 0;

    var verifiedDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Approved)
        ?? 0;

    var pendingDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Uploaded ||
            x.Status == VolunteerOnboardingDocumentStatus.UnderReview)
        ?? 0;

    var rejectedDocuments =
        Model.Documents?.Count(x =>
            x.Status == VolunteerOnboardingDocumentStatus.Rejected ||
            x.Status == VolunteerOnboardingDocumentStatus.ResubmissionRequired)
        ?? 0;


    // =============================================================
    // IDENTITY DOCUMENTS
    // =============================================================

    var identityDocuments =
        Model.Documents?
            .Where(x =>
                x.DocumentType ==
                VolunteerOnboardingDocumentType.IdentityDocument)
            .OrderByDescending(x => x.UploadedDate)
            .ToList()
        ?? new List<VolunteerOnboardingDocument>();

    var hasIdentityDocument =
        identityDocuments.Any();

    // =============================================================
    // LATEST VOLUNTEER CONTRACT
    // =============================================================

    var contract =
        ViewBag.Contract
        as SwiftCare.Models.VolunteerOnboarding.VolunteerContract;

    var hasContract =
        contract != null;

    var contractGenerated =
        contract != null &&
        !string.IsNullOrWhiteSpace(
            contract.GeneratedFilePath);

    var contractSigned =
        contract != null &&
        !string.IsNullOrWhiteSpace(
            contract.SignedFilePath);

    var contractSubmitted =
        contract?.Status ==
        VolunteerContractStatus.Submitted;

    var contractUnderReview =
        contract?.Status ==
        VolunteerContractStatus.UnderReview;

    var contractCorrectionRequired =
        contract?.Status ==
        VolunteerContractStatus.CorrectionRequired;

    var contractApproved =
        contract?.Status ==
        VolunteerContractStatus.Approved;

    var contractRejected =
        contract?.Status ==
        VolunteerContractStatus.Rejected;

    // IMPORTANT:
    // Always use the LATEST identity document.
    // Do not use an older approved identity document if a newer one
    // is pending/rejected/resubmission.
    var latestIdentityDocument =
        identityDocuments.FirstOrDefault();

    var approvedIdentityDocument =
        latestIdentityDocument?.Status ==
        VolunteerOnboardingDocumentStatus.Approved
            ? latestIdentityDocument
            : null;

    var pendingIdentityDocument =
        latestIdentityDocument?.Status ==
            VolunteerOnboardingDocumentStatus.Uploaded ||
        latestIdentityDocument?.Status ==
            VolunteerOnboardingDocumentStatus.UnderReview
            ? latestIdentityDocument
            : null;

    var rejectedIdentityDocument =
        latestIdentityDocument?.Status ==
            VolunteerOnboardingDocumentStatus.Rejected ||
        latestIdentityDocument?.Status ==
            VolunteerOnboardingDocumentStatus.ResubmissionRequired
            ? latestIdentityDocument
            : null;


    // =============================================================
    // REQUIREMENT HELPERS
    // =============================================================

    var supportingDocumentsRequirement =
        displayRequirements.FirstOrDefault(x =>
            x.RequirementType ==
            VolunteerOnboardingRequirementType.DocumentUpload);

    var contractRequirement =
        displayRequirements.FirstOrDefault(x =>
            x.RequirementType ==
            VolunteerOnboardingRequirementType.Contract);

    var identityRequirement =
        displayRequirements.FirstOrDefault(x =>
            x.RequirementType ==
            VolunteerOnboardingRequirementType.IdentityVerification);


    var supportingDocumentsComplete =
        supportingDocumentsRequirement?.IsCompleted == true;

    var contractComplete =
        contractRequirement?.IsCompleted == true;

    var identityRequirementComplete =
        identityRequirement?.IsCompleted == true;


    var contractPending =
        onboardingStatus == VolunteerOnboardingStatus.ContractPending &&
        !contractComplete;

         var storageAccountUrl = Configuration["AzureBlobStorage:BlobUrl"];
         var containerName = Configuration["AzureBlobStorage:ContainerName"];
}


<div class="onboarding-review-page">

   
    <!-- =========================================================
         HERO HEADER
         ========================================================= -->

    <section class="review-hero">

        <div class="review-hero-content">

            <div class="review-hero-left">

                <div class="review-eyebrow">
                    <i class="bi bi-person-vcard-fill"></i>
                    SwiftCare Administration
                </div>

                <h1>
                    Volunteer Onboarding Review
                </h1>

                <p class="review-hero-subtitle">
                    Review documents, identity verification, the volunteer
                    agreement and final activation requirements.
                </p>

            </div>


            <div class="review-status-area">

                <a asp-controller="VolunteerOnboardingAdmin"
                       asp-action="Index"
                       class="btn-back-onboarding">

                    <i class="bi bi-arrow-left"></i>

                    <span>
                        Back to Onboarding
                    </span>

                </a>


                <span class="review-status-pill">

                    @if (onboardingCompleted)
                    {
                        <i class="bi bi-check-circle-fill"></i>
                    }
                    else if (readyForActivation)
                    {
                        <i class="bi bi-person-check-fill"></i>
                    }
                    else if (adminVerification)
                    {
                        <i class="bi bi-shield-check"></i>
                    }
                    else if (contractPending)
                    {
                        <i class="bi bi-file-earmark-check-fill"></i>
                    }
                    else if (correctionRequired)
                    {
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-hourglass-split"></i>
                    }

                    @Model.Status.GetDisplayName()

                </span>

            </div>

        </div>

    </section>


    <!-- =========================================================
         TEMP DATA
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4"
             role="alert">

            <div class="d-flex align-items-start gap-3">

                <div class="flex-shrink-0">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>

                <div class="flex-grow-1">

                    <div class="fw-bold mb-1">
                        Success
                    </div>

                    <div>
                        @TempData["Success"]
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4"
             role="alert">

            <div class="d-flex align-items-start gap-3">

                <div class="flex-shrink-0">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>

                <div class="flex-grow-1">

                    <div class="fw-bold mb-1">
                        Action Required
                    </div>

                    <div>
                        @TempData["Error"]
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        </div>
    }


    <!-- =========================================================
         CURRENT ACTION / WORKFLOW STAGE
         ========================================================= -->

    <section class="review-card mb-4"
             id="workflowActionCard">

        <div class="review-card-header">

            <h4 class="review-card-title">

                <span class="review-card-title-icon">
                    <i class="bi bi-signpost-split-fill"></i>
                </span>

                Current Onboarding Action

            </h4>

            <span class="status-badge"
                  id="workflowStageBadge">

                @Model.Status.GetDisplayName()

            </span>

        </div>


        <div id="workflowActionContent">

            @if (onboardingCompleted)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>

                        <h5>
                            Onboarding Completed
                        </h5>

                        <p class="mb-3">
                            This volunteer has completed the onboarding
                            process and has been activated.
                        </p>

                    </div>

                </div>
            }
            else if (readyForActivation)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>

                        <h5>
                            Ready for Activation
                        </h5>

                        <p class="mb-3">
                            Identity verification, supporting documentation,
                            the Volunteer Service Agreement and final
                            verification have been completed.
                        </p>

                        <a asp-controller="VolunteerOnboardingAdmin"
                               asp-action="Activate"
                               asp-route-id="@Model.VolunteerOnboardingId"
                               class="btn-swift">

                            <i class="bi bi-person-check"></i>

                            Activate Volunteer

                        </a>

                    </div>

                </div>
            }
            else if (adminVerification)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <h5>
                            Final Verification Required
                        </h5>

                        <p class="mb-3">
                            The Volunteer Service Agreement has been completed.
                            Review the completed onboarding record and perform
                            the final administrative verification before
                            activation.
                        </p>

                        <button type="button"
                                class="btn-swift"
                                data-bs-toggle="modal"
                                data-bs-target="#completeVerificationModal">

                            <i class="bi bi-check-circle"></i>

                            Complete Final Verification

                        </button>

                    </div>

                </div>
            }
            else if (contractPending)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-file-earmark-text-fill"></i>
                        </div>

                        <h5>
                            Volunteer Service Agreement Required
                        </h5>

                        <p class="mb-3">
                            Identity verification has been successfully
                            completed. The next stage is the Volunteer
                            Service Agreement. The volunteer must complete
                            and upload the contract before final verification
                            and activation can continue.
                        </p>

                        <div class="d-flex justify-content-center flex-wrap gap-2">

                            <span class="status-badge pending">

                                <i class="bi bi-file-earmark-arrow-up"></i>

                                Contract Pending

                            </span>

                            @if (contractComplete)
                            {
                                <span class="status-badge verified">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Contract Completed

                                </span>
                            }

                        </div>

                    </div>

                </div>
            }
            else if (correctionRequired)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                        <h5>
                            Correction Required
                        </h5>

                        <p class="mb-3">
                            One or more onboarding items require correction
                            or resubmission before the onboarding process
                            can continue.
                        </p>

                        <button type="button"
                                class="btn btn-outline-danger rounded-3 fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#correctionModal">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>

                            Request / Review Correction

                        </button>

                    </div>

                </div>
            }
            else if (documentsPending)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-folder-check"></i>
                        </div>

                        <h5>
                            Documents and Identity Verification
                        </h5>

                        <p class="mb-3">
                            Complete the outstanding document reviews and
                            identity verification before the Volunteer
                            Service Agreement becomes available.
                        </p>

                    </div>

                </div>
            }
            else if (policiesPending)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-file-earmark-check"></i>
                        </div>

                        <h5>
                            Required Policies Pending
                        </h5>

                        <p class="mb-3">
                            The applicant must complete all required
                            policies and the Code of Conduct before
                            onboarding can proceed.
                        </p>

                    </div>

                </div>
            }
            else if (offerPending)
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-envelope-paper"></i>
                        </div>

                        <h5>
                            Volunteer Offer Pending
                        </h5>

                        <p class="mb-3">
                            The applicant must accept the volunteer offer
                            before the remaining onboarding stages can begin.
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="activation-panel">

                    <div class="activation-content">

                        <div class="activation-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <h5>
                            Onboarding In Progress
                        </h5>

                        <p class="mb-0">
                            Complete the outstanding onboarding actions
                            shown below.
                        </p>

                    </div>

                </div>
            }

        </div>

    </section>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <section class="review-summary-grid">

        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Documents
                </span>

                <div class="summary-value">
                    @totalDocuments
                    <small>uploaded</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-patch-check-fill"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Verified
                </span>

                <div class="summary-value">
                    @verifiedDocuments
                    <small>verified</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Requirements
                </span>

                <div class="summary-value">
                    @completedRequirements
                    <small>/ @totalRequirements</small>
                </div>

            </div>

        </div>


        <div class="review-summary-card">

            <div class="summary-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Review State
                </span>

                <div class="summary-value"
                     style="font-size:1rem;">

                    @(adminVerification
                        ? "Final Review"
                        : contractPending
                            ? "Contract Pending"
                            : readyForActivation
                                ? "Ready"
                                : onboardingCompleted
                                    ? "Complete"
                                    : "Pending")

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="row g-4">


        <!-- =====================================================
             APPLICANT
             ===================================================== -->

        <div class="col-lg-4">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        Applicant

                    </h4>

                </div>


                <div class="applicant-profile">

                    <div class="applicant-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>

                        <div class="applicant-profile-name">
                            @applicantName
                        </div>

                        <div class="applicant-profile-role">
                            Volunteer Applicant
                        </div>

                    </div>

                </div>


                <div class="info-grid">

                    <div class="info-box full-width">

                        <span class="info-label">
                            Email Address
                        </span>

                        <div class="info-value">
                            @(Model.Applicant?.Email ?? "Not provided")
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Application
                        </span>

                        <div class="info-value">
                            #@Model.VolunteerApplication.Reference
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Onboarding
                        </span>

                        <div class="info-value">
                            #@Model.VolunteerOnboardingId
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Current Step
                        </span>

                        <div class="info-value">
                            Step @Model.CurrentStep
                        </div>

                    </div>


                    <div class="info-box">

                        <span class="info-label">
                            Status
                        </span>

                        <div class="info-value">
                            @Model.Status.GetDisplayName()
                        </div>

                    </div>


                    <div class="info-box full-width">

                        <span class="info-label">
                            Volunteer Opportunity
                        </span>

                        <div class="info-value">
                            @opportunityTitle
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             REQUIREMENTS
             ===================================================== -->

        <div class="col-lg-8">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-list-check"></i>
                        </span>

                        Requirements

                    </h4>

                    <span class="status-badge">

                        @completedRequirements /
                        @totalRequirements

                    </span>

                </div>


                @if (!displayRequirements.Any())
                {
                    <div class="empty-state">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            No onboarding requirements have been configured.
                        </span>

                    </div>
                }
                else
                {

                    <div class="requirements-progress">

                        <div class="requirements-progress-top">

                            <span class="requirements-progress-label">
                                Completion
                            </span>

                            <span class="requirements-progress-value">

                                @(totalRequirements == 0
                                    ? 0
                                    : (completedRequirements * 100 / totalRequirements))%

                            </span>

                        </div>

                        <div class="requirements-progress-bar">

                            <div class="requirements-progress-fill"
                                 style="width:@(
                                                                 totalRequirements == 0
                                                                     ? 0
                                                                     : (completedRequirements * 100 / totalRequirements)
                                                                                              )%;">
                            </div>

                        </div>

                    </div>


                    foreach (var requirement in displayRequirements)
                    {

                        var requirementIsContract =
                            requirement.RequirementType ==
                            VolunteerOnboardingRequirementType.Contract;

                        var requirementIsIdentity =
                            requirement.RequirementType ==
                            VolunteerOnboardingRequirementType.IdentityVerification;

                        var requirementIsDocuments =
                            requirement.RequirementType ==
                            VolunteerOnboardingRequirementType.DocumentUpload;


                        <div class="requirement-item">

                            <div class="requirement-icon
                                @(requirement.IsCompleted ? "completed" : "")">

                                @if (requirement.IsCompleted)
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle"></i>
                                }

                            </div>


                            <div class="requirement-content">

                                <div class="requirement-title">

                                    @requirement.RequirementType.GetDisplayName()

                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.Description))
                                {
                                    <span class="requirement-description">
                                        @requirement.Description
                                    </span>
                                }


                                @if (requirementIsIdentity &&
                                     !requirement.IsCompleted)
                                {
                                    <span class="requirement-description">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Requires successful Didit document,
                                        liveness and face-match verification.

                                    </span>
                                }


                                @if (requirementIsDocuments &&
                                     !requirement.IsCompleted)
                                {
                                    <span class="requirement-description">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Required supporting documents must
                                        be uploaded and approved.

                                    </span>
                                }


                                @if (requirementIsContract &&
                                     !requirement.IsCompleted)
                                {
                                    <span class="requirement-description">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Completed after identity and required
                                        supporting documents are verified.

                                    </span>
                                }

                            </div>


                            <span class="status-badge
                                @(requirement.IsCompleted
                                                                      ? "completed"
                                                                      : "pending")">

                                @if (requirement.IsCompleted)
                                {
                                    <i class="bi bi-check-circle-fill"></i>

                                    <span>
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-clock"></i>

                                    <span>
                                        Pending
                                    </span>
                                }

                            </span>

                        </div>

                    }

                }

            </div>

        </div>


        <!-- =====================================================
             DOCUMENTS
             ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-folder-check"></i>
                        </span>

                        Onboarding Documents

                    </h4>


                    <div class="documents-summary">

                        <span class="document-summary-pill">

                            <i class="bi bi-files"></i>

                            <strong>
                                @totalDocuments
                            </strong>

                            Total

                        </span>


                        <span class="document-summary-pill">

                            <i class="bi bi-check-circle"></i>

                            <strong>
                                @verifiedDocuments
                            </strong>

                            Verified

                        </span>


                        @if (pendingDocuments > 0)
                        {
                            <span class="document-summary-pill">

                                <i class="bi bi-clock"></i>

                                <strong>
                                    @pendingDocuments
                                </strong>

                                Pending

                            </span>
                        }


                        @if (rejectedDocuments > 0)
                        {
                            <span class="document-summary-pill"
                                  style="color:#9b3b3b;">

                                <i class="bi bi-exclamation-circle"></i>

                                <strong style="color:#9b3b3b;">
                                    @rejectedDocuments
                                </strong>

                                Attention

                            </span>
                        }

                    </div>

                </div>


                @if (Model.Documents == null ||
                     !Model.Documents.Any())
                {
                    <div class="empty-state">

                        <i class="bi bi-folder2-open"></i>

                        <span>
                            No onboarding documents have been uploaded.
                        </span>

                    </div>
                }
                else
                {

                    foreach (var document in Model.Documents
                        .OrderByDescending(x => x.UploadedDate))
                    {

                        var isIdentityDocument =
                            document.DocumentType ==
                            VolunteerOnboardingDocumentType.IdentityDocument;

                        var isContractDocument =
                            document.DocumentType ==
                            VolunteerOnboardingDocumentType.VolunteerContract;

                        var documentStatus =
                            document.Status;

                        var documentStatusClass =
                            documentStatus ==
                                VolunteerOnboardingDocumentStatus.Approved
                                    ? "verified"
                                    : documentStatus ==
                                        VolunteerOnboardingDocumentStatus.Rejected ||
                                      documentStatus ==
                                        VolunteerOnboardingDocumentStatus.ResubmissionRequired
                                        ? "rejected"
                                        : "pending";


                        <div class="document-item">

                            <div class="document-row">


                                <!-- DOCUMENT -->

                                <div class="document-main">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="document-icon">

                                            @if (isIdentityDocument)
                                            {
                                                <i class="bi bi-person-vcard-fill"></i>
                                            }
                                            else if (isContractDocument)
                                            {
                                                <i class="bi bi-file-earmark-text-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-text"></i>
                                            }

                                        </div>


                                        <div class="min-w-0">

                                            <div class="document-name">

                                                @document.DocumentName

                                                @if (isIdentityDocument)
                                                {
                                                    <span class="identity-document-label">

                                                        <i class="bi bi-shield-check"></i>

                                                        Identity Document

                                                    </span>
                                                }

                                                @if (isContractDocument)
                                                {
                                                    <span class="identity-document-label">

                                                        <i class="bi bi-file-earmark-check"></i>

                                                        Volunteer Contract

                                                    </span>
                                                }

                                            </div>


                                            <div class="document-meta">

                                                <i class="bi bi-file-earmark"></i>

                                                @document.DocumentType.GetDisplayName()

                                                <span class="mx-1">
                                                    ·
                                                </span>

                                                @document.FileName

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- STATUS -->

                                <div>

                                    <span class="status-badge @documentStatusClass">

                                        @if (documentStatus ==
                                            VolunteerOnboardingDocumentStatus.Approved)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                        }
                                        else if (
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.Rejected ||
                                            documentStatus ==
                                                VolunteerOnboardingDocumentStatus.ResubmissionRequired)
                                        {
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock-fill"></i>
                                        }

                                        @documentStatus.GetDisplayName()

                                    </span>

                                </div>


                                <!-- DATE -->

                                <div class="document-date">

                                    <i class="bi bi-calendar3 me-1"></i>

                                    @document.UploadedDate.ToLocalTime().ToString("dd MMM yyyy")

                                </div>


                                <!-- ACTIONS -->

                                <div class="document-actions">


                                    @if (!string.IsNullOrWhiteSpace(document.FilePath))
                                    {
                                        <a href="@storageAccountUrl/@containerName/@document.FilePath.TrimStart('/')"
                                               target="_blank"
                                               class="btn-outline-swift">

                                            <i class="bi bi-eye"></i>

                                            View

                                        </a>
                                    }


                                    <button type="button"
                                            class="btn-swift"
                                            data-bs-toggle="modal"
                                            data-bs-target="#reviewDocumentModal"
                                            data-document-id="@document.VolunteerOnboardingDocumentId">

                                        <i class="bi bi-check2-square"></i>

                                        Review

                                    </button>
                                </div>

                            </div>


                            <!-- IDENTITY DOCUMENT INFORMATION -->
                            @if (isIdentityDocument)
                            {
                                <div class="identity-document-panel">

                                    <div class="identity-document-panel-icon">

                                        <i class="bi bi-shield-check"></i>

                                    </div>


                                    <div class="identity-document-panel-content">

                                        <div class="identity-document-panel-title">

                                            Identity verification document

                                        </div>

                                        <div class="identity-document-panel-text">

                                            The latest approved identity document
                                            can be used for Didit identity
                                            verification.

                                        </div>

                                    </div>


                                    <div class="identity-document-panel-status">

                                        @if (approvedIdentityDocument?.VolunteerOnboardingDocumentId ==
                                            document.VolunteerOnboardingDocumentId)
                                        {
                                            <span class="identity-ready-badge">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Ready for verification

                                            </span>
                                        }
                                        else if (
                                            pendingIdentityDocument?.VolunteerOnboardingDocumentId ==
                                            document.VolunteerOnboardingDocumentId)
                                        {
                                            <span class="identity-pending-badge">

                                                <i class="bi bi-clock-fill"></i>

                                                Awaiting document approval

                                            </span>
                                        }
                                        else if (
                                            rejectedIdentityDocument?.VolunteerOnboardingDocumentId ==
                                            document.VolunteerOnboardingDocumentId)
                                        {
                                            <span class="identity-rejected-badge">

                                                <i class="bi bi-exclamation-circle-fill"></i>

                                                Document requires attention

                                            </span>
                                        }

                                    </div>

                                </div>
                            }


                            <!-- REJECTION REASON -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            document.RejectionReason))
                            {
                                <div class="document-rejection">

                                    <strong>

                                        <i class="bi bi-exclamation-triangle me-1"></i>

                                        Review Note:

                                    </strong>

                                    @document.RejectionReason

                                </div>
                            }


                        </div>

                    }

                }

            </div>

        </div>


        <!-- =====================================================
             DIDIT IDENTITY VERIFICATION
             ===================================================== -->

        <div class="col-12">

            <div class="review-card didit-verification-card"
                 id="diditVerificationCard"
                 data-onboarding-id="@Model.VolunteerOnboardingId"
                 data-status-url="@Url.Action(
                                                      "IdentityVerificationStatus",
                                                      "VolunteerOnboardingAdmin")">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">

                            <i class="bi bi-person-vcard-fill"></i>

                        </span>

                        Identity Verification

                    </h4>


                    <span class="didit-header-badge">

                        <i class="bi bi-shield-check"></i>

                        Didit

                    </span>

                </div>


                <div class="didit-verification-content">


                    <div class="didit-verification-icon">

                        <i class="bi bi-person-badge-fill"></i>

                    </div>


                    <div class="didit-verification-information">

                        <h5>
                            Verify Applicant Identity
                        </h5>

                        <p>

                            The applicant completes identity verification
                            through Didit using the approved identity document.

                        </p>


                        <div class="didit-verification-steps">

                            <div class="didit-step">

                                <span class="didit-step-number">
                                    1
                                </span>

                                <span>
                                    Identity document
                                </span>

                            </div>


                            <div class="didit-step">

                                <span class="didit-step-number">
                                    2
                                </span>

                                <span>
                                    Liveness
                                </span>

                            </div>


                            <div class="didit-step">

                                <span class="didit-step-number">
                                    3
                                </span>

                                <span>
                                    Face verification
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         DYNAMIC DIDIT ACTION
                         ============================================= -->

                    <div class="didit-verification-action"
                         id="diditActionArea">

                        @if (!hasIdentityDocument)
                        {
                            <div class="didit-not-ready">

                                <i class="bi bi-exclamation-circle"></i>

                                <span>
                                    Upload an Identity Document first
                                </span>

                            </div>
                        }
                        else if (approvedIdentityDocument == null)
                        {
                            <div class="didit-not-ready">

                                <i class="bi bi-clock"></i>

                                <span>
                                    Approve the latest Identity Document first
                                </span>

                            </div>
                        }
                        else
                        {
                            <form asp-action="StartIdentityVerification"
                                  method="post"
                                  class="main-identity-verification-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="onboardingId"
                                       value="@Model.VolunteerOnboardingId" />

                                <input type="hidden"
                                       name="identityDocumentId"
                                       value="@approvedIdentityDocument.VolunteerOnboardingDocumentId" />

                                <button type="submit"
                                        class="btn-didit-main">

                                    <i class="bi bi-shield-check"></i>

                                    Start Didit Verification

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </form>
                        }

                    </div>

                </div>


                <!-- =====================================================
                     LIVE DIDIT STATUS
                     ===================================================== -->

                <div id="diditLiveStatus"
                     class="didit-live-status"
                     style="
                    margin-top:1.25rem;
                    padding:1rem 1.15rem;
                    border:1px solid rgba(27,94,32,.14);
                    border-radius:16px;
                    background:rgba(240,253,244,.72);
                    ">

                    <div style="
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        gap:1rem;
                        flex-wrap:wrap;
                        ">

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:.75rem;
                            ">

                            <span id="diditLiveIcon"
                                  style="
                                width:38px;
                                height:38px;
                                border-radius:50%;
                                display:inline-flex;
                                align-items:center;
                                justify-content:center;
                                background:#DCEDC8;
                                color:#1B5E20;
                                ">

                                <i class="bi bi-arrow-repeat"></i>

                            </span>


                            <div>

                                <div style="
                                    font-size:.72rem;
                                    font-weight:800;
                                    letter-spacing:.08em;
                                    color:#5d7561;
                                    text-transform:uppercase;
                                    ">
                                    Live Didit Status
                                </div>

                                <div id="diditLiveStatusText"
                                     style="
                                    font-weight:800;
                                    color:#1B5E20;
                                    ">

                                    Checking verification status...

                                </div>

                            </div>

                        </div>


                        <span id="diditLiveBadge"
                              style="
                            display:inline-flex;
                            align-items:center;
                            gap:.35rem;
                            padding:.45rem .75rem;
                            border-radius:999px;
                            background:#DCEDC8;
                            color:#1B5E20;
                            font-size:.8rem;
                            font-weight:800;
                            ">

                            Checking

                        </span>

                    </div>


                    <div id="diditLiveDetails"
                         style="
                        margin-top:.8rem;
                        color:#5d7561;
                        font-size:.88rem;
                        ">

                        The admin page checks automatically every 3 seconds.

                    </div>


                    <div id="diditLiveChecks"
                         style="
                        display:none;
                        margin-top:.85rem;
                        gap:.5rem;
                        flex-wrap:wrap;
                        ">
                    </div>

                </div>


                @if (hasIdentityDocument)
                {
                    <div class="didit-document-reference">

                        <div>

                            <i class="bi bi-file-earmark-person-fill"></i>

                            <span>
                                Selected Identity Document
                            </span>

                        </div>


                        <strong>

                            @(approvedIdentityDocument?.DocumentName
                                ?? latestIdentityDocument?.DocumentName
                                ?? "Identity Document")

                        </strong>

                    </div>
                }

            </div>

        </div>

        <!-- =====================================================
     VOLUNTEER SERVICE AGREEMENT
     ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">

                            <i class="bi bi-file-earmark-check-fill"></i>

                        </span>

                        Volunteer Service Agreement

                    </h4>


                    @if (!hasContract)
                    {
                        <span class="status-badge pending">

                            <i class="bi bi-clock"></i>

                            Not Generated

                        </span>
                    }
                    else
                    {
                        <span class="status-badge
                            @(contractApproved
                                                      ? "verified"
                                                      : contractRejected || contractCorrectionRequired
                                                          ? "rejected"
                                                          : "pending")">

                            @if (contractApproved)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (contractRejected ||
                                     contractCorrectionRequired)
                            {
                                <i class="bi bi-exclamation-circle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-clock-fill"></i>
                            }

                            @contract.Status.GetDisplayName()

                        </span>
                    }

                </div>


                @if (!hasContract)
                {
                    <div class="empty-state">

                        <i class="bi bi-file-earmark-x"></i>

                        <span>
                            No Volunteer Service Agreement has been generated
                            for this onboarding record yet.
                        </span>

                    </div>
                }
                else
                {

                    <div class="verification-state">

                        <div class="verification-state-icon">

                            @if (contractApproved)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (contractRejected)
                            {
                                <i class="bi bi-x-circle-fill"></i>
                            }
                            else if (contractCorrectionRequired)
                            {
                                <i class="bi bi-arrow-counterclockwise"></i>
                            }
                            else if (contractSubmitted ||
                                     contractUnderReview)
                            {
                                <i class="bi bi-file-earmark-check-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-text-fill"></i>
                            }

                        </div>


                        <div>

                            <div class="verification-state-title">

                                @if (contractApproved)
                                {
                                    <span>
                                        Volunteer Service Agreement approved
                                    </span>
                                }
                                else if (contractRejected)
                                {
                                    <span>
                                        Volunteer Service Agreement rejected
                                    </span>
                                }
                                else if (contractCorrectionRequired)
                                {
                                    <span>
                                        Contract correction required
                                    </span>
                                }
                                else if (contractSubmitted ||
                                         contractUnderReview)
                                {
                                    <span>
                                        Signed Volunteer Service Agreement submitted
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Volunteer Service Agreement generated
                                    </span>
                                }

                            </div>


                            <div class="verification-state-text">

                                @if (contractApproved)
                                {
                                    <span>
                                        The applicant's signed Volunteer Service
                                        Agreement has been approved. The onboarding
                                        record can proceed to final administrative
                                        verification.
                                    </span>
                                }
                                else if (contractCorrectionRequired)
                                {
                                    <span>
                                        The applicant must correct the Volunteer
                                        Service Agreement and upload a new signed
                                        copy before onboarding can continue.
                                    </span>
                                }
                                else if (contractRejected)
                                {
                                    <span>
                                        This Volunteer Service Agreement has been
                                        rejected and cannot be used for activation.
                                    </span>
                                }
                                else if (contractSubmitted ||
                                         contractUnderReview)
                                {
                                    <span>
                                        The applicant has uploaded the signed
                                        Volunteer Service Agreement. Please review
                                        the submitted document before continuing.
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        The Volunteer Service Agreement has been
                                        generated and is awaiting completion by
                                        the applicant.
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- =====================================================
                 CONTRACT INFORMATION
                 ===================================================== -->

                    <div class="info-grid mt-4">

                        <div class="info-box">

                            <span class="info-label">
                                Contract Reference
                            </span>

                            <div class="info-value">

                                @contract.ContractReference

                            </div>

                        </div>


                        <div class="info-box">

                            <span class="info-label">
                                Version
                            </span>

                            <div class="info-value">

                                @contract.ContractVersion

                            </div>

                        </div>


                        <div class="info-box">

                            <span class="info-label">
                                Contract Status
                            </span>

                            <div class="info-value">

                                @contract.Status.GetDisplayName()

                            </div>

                        </div>


                        <div class="info-box">

                            <span class="info-label">
                                Generated
                            </span>

                            <div class="info-value">

                                @contract.GeneratedDate.Value.ToLocalTime().ToString("dd MMM yyyy")

                            </div>

                        </div>


                        <div class="info-box">

                            <span class="info-label">
                                Signed
                            </span>

                            <div class="info-value">

                                @(contract.SignedDate.HasValue
                                    ? contract.SignedDate.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy HH:mm")
                                    : "Not submitted")

                            </div>

                        </div>


                        <div class="info-box">

                            <span class="info-label">
                                Reviewed
                            </span>

                            <div class="info-value">

                                @(contract.ReviewedDate.HasValue
                                    ? contract.ReviewedDate.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy HH:mm")
                                    : "Not reviewed")

                            </div>

                        </div>

                    </div>


                    <!-- =====================================================
                 CONTRACT FILES
                 ===================================================== -->

                    <div class="mt-4">

                        <div class="document-item">

                            <div class="document-row">


                                <div class="document-main">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="document-icon">

                                            <i class="bi bi-file-earmark-pdf-fill"></i>

                                        </div>


                                        <div class="min-w-0">

                                            <div class="document-name">

                                                Generated Volunteer Service Agreement

                                            </div>


                                            <div class="document-meta">

                                                <i class="bi bi-file-earmark"></i>

                                                @(contract.GeneratedFileName
                                                    ?? "Generated Contract")

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="document-actions">
                                    @if (contractGenerated)
                                    {
                                        <a href="@storageAccountUrl/@containerName/@contract.GeneratedFilePath?.TrimStart('/')"
                                               target="_blank"
                                               class="btn-outline-swift">

                                            <i class="bi bi-eye"></i>

                                            View Contract

                                        </a>
                                    }
                                </div>

                            </div>

                        </div>


                        @if (contractSigned)
                        {
                            <div class="document-item">

                                <div class="document-row">


                                    <div class="document-main">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="document-icon">

                                                <i class="bi bi-file-earmark-check-fill"></i>

                                            </div>


                                            <div class="min-w-0">

                                                <div class="document-name">

                                                    Applicant Signed Contract

                                                </div>


                                                <div class="document-meta">

                                                    <i class="bi bi-file-earmark-pdf"></i>

                                                    @(contract.SignedFileName
                                                        ?? "Signed Contract")

                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <div>

                                        <span class="status-badge
                                            @(contractApproved
                                                                                      ? "verified"
                                                                                      : contractRejected
                                                                                          ? "rejected"
                                                                                          : contractCorrectionRequired
                                                                                              ? "rejected"
                                                                                              : "pending")">

                                            @if (contractApproved)
                                            {
                                                <i class="bi bi-check-circle-fill"></i>
                                            }
                                            else if (contractRejected ||
                                                     contractCorrectionRequired)
                                            {
                                                <i class="bi bi-exclamation-circle-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-clock-fill"></i>
                                            }

                                            @contract.Status.GetDisplayName()

                                        </span>

                                    </div>


                                    <div class="document-actions">

                                        <a href="@storageAccountUrl/@containerName/@contract.SignedFilePath?.TrimStart('/')"
                                               target="_blank"
                                               class="btn-outline-swift">

                                            <i class="bi bi-eye"></i>

                                            View Signed Contract

                                        </a>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>


                    <!-- =====================================================
                 REJECTION / CORRECTION REASON
                 ===================================================== -->
                    @if (!string.IsNullOrWhiteSpace(
                                    contract.RejectionReason))
                    {
                        <div class="document-rejection mt-3">

                            <strong>

                                <i class="bi bi-exclamation-triangle me-1"></i>

                                Admin Review Note:

                            </strong>

                            @contract.RejectionReason

                        </div>
                    }


                    @if (contractSigned &&
                        !contractApproved &&
                        !contractRejected)
                    {
                        <div class="verification-actions">

                            <!-- APPROVE -->
                            <button type="button"
                                    class="contract-action-btn contract-approve"
                                    data-bs-toggle="modal"
                                    data-bs-target="#approveContractModal">

                                <i class="bi bi-check-circle"></i>

                                <span>Approve Contract</span>

                            </button>


                            <!-- CORRECTION -->
                            <button type="button"
                                    class="contract-action-btn contract-correction"
                                    data-bs-toggle="modal"
                                    data-bs-target="#contractCorrectionModal">

                                <i class="bi bi-arrow-counterclockwise"></i>

                                <span>Request Correction</span>

                            </button>


                            <!-- REJECT -->
                            <button type="button"
                                    class="contract-action-btn contract-reject"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectContractModal">

                                <i class="bi bi-x-circle"></i>

                                <span>Reject Contract</span>

                            </button>

                        </div>
                    }


                    @if (contractApproved)
                    {
                        <div class="activation-panel mt-4">

                            <div class="activation-content">

                                <div class="activation-icon">

                                    <i class="bi bi-check-circle-fill"></i>

                                </div>

                                <h5>
                                    Contract Approved
                                </h5>

                                <p class="mb-0">

                                    The signed Volunteer Service Agreement has
                                    been approved. Final administrative verification
                                    can now be completed.

                                </p>

                            </div>

                        </div>
                    }

                }

            </div>

        </div>
        <!-- =====================================================
             VERIFICATION
             ===================================================== -->

        <div class="col-12">

            <div class="review-card verification-card">

                <div class="review-card-header">

                    <h4 class="review-card-title">

                        <span class="review-card-title-icon">
                            <i class="bi bi-shield-check"></i>
                        </span>

                        Administrative Verification

                    </h4>


                    <span class="status-badge
                        @(adminVerification
                                                      ? "pending"
                                                      : onboardingCompleted || readyForActivation
                                                          ? "verified"
                                                          : contractPending
                                                              ? "pending"
                                                              : "")">

                        @if (adminVerification)
                        {
                            <i class="bi bi-hourglass-split"></i>

                            <span>
                                Final Review
                            </span>
                        }
                        else if (onboardingCompleted)
                        {
                            <i class="bi bi-check-circle-fill"></i>

                            <span>
                                Completed
                            </span>
                        }
                        else if (readyForActivation)
                        {
                            <i class="bi bi-patch-check-fill"></i>

                            <span>
                                Verified
                            </span>
                        }
                        else if (contractPending)
                        {
                            <i class="bi bi-file-earmark-text"></i>

                            <span>
                                Contract Pending
                            </span>
                        }
                        else
                        {
                            <i class="bi bi-clock"></i>

                            <span>
                                Pending
                            </span>
                        }

                    </span>

                </div>


                <div class="verification-state">

                    <div class="verification-state-icon">

                        @if (onboardingCompleted)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else if (readyForActivation)
                        {
                            <i class="bi bi-person-check-fill"></i>
                        }
                        else if (adminVerification)
                        {
                            <i class="bi bi-shield-check"></i>
                        }
                        else if (contractPending)
                        {
                            <i class="bi bi-file-earmark-check-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-hourglass-split"></i>
                        }

                    </div>


                    <div>

                        <div class="verification-state-title">

                            @if (onboardingCompleted)
                            {
                                <span>
                                    Onboarding completed
                                </span>
                            }
                            else if (readyForActivation)
                            {
                                <span>
                                    Verification completed — ready for activation
                                </span>
                            }
                            else if (adminVerification)
                            {
                                <span>
                                    Final administrative verification required
                                </span>
                            }
                            else if (contractPending)
                            {
                                <span>
                                    Waiting for Volunteer Service Agreement
                                </span>
                            }
                            else
                            {
                                <span>
                                    Onboarding requirements are still in progress
                                </span>
                            }

                        </div>


                        <div class="verification-state-text">

                            @if (contractPending)
                            {
                                <span>
                                    Identity verification has passed.
                                    The contract must now be completed before
                                    final verification can be performed.
                                </span>
                            }
                            else if (adminVerification)
                            {
                                <span>
                                    The contract has been completed.
                                    Review the complete onboarding record
                                    before confirming final verification.
                                </span>
                            }
                            else if (readyForActivation)
                            {
                                <span>
                                    All required onboarding stages have been
                                    completed. The volunteer can now be activated.
                                </span>
                            }
                            else
                            {
                                <span>
                                    Complete the required onboarding stages
                                    in sequence.
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     ADMIN ACTIONS
                     ============================================= -->

                <div class="verification-actions"
                     id="adminVerificationActions">


                    @if (adminVerification &&
                         !onboardingCompleted)
                    {
                        <button type="button"
                                class="btn-swift"
                                data-bs-toggle="modal"
                                data-bs-target="#completeVerificationModal">

                            <i class="bi bi-check-circle"></i>

                            Complete Final Verification

                        </button>
                    }


                    @if (!onboardingCompleted &&
                         !readyForActivation &&
                         !contractPending)
                    {
                        <button type="button"
                                class="btn btn-outline-danger rounded-3 fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#correctionModal">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>

                            Request Correction

                        </button>
                    }

                </div>

            </div>

        </div>
    </div>

</div>


