@model SwiftCare.Models.VolunteerOnboarding.VolunteerOnboarding

@{
    ViewData["Title"] = "Volunteer Onboarding Review";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";

    var onboardingStatus =
        Model.Status;

    var readyForActivation =
        onboardingStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.ReadyForActivation;

    var onboardingCompleted =
        onboardingStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.Completed;

    var adminVerification =
        onboardingStatus ==
        SwiftCare.Models.VolunteerOnboarding.VolunteerOnboardingStatus.AdminVerification;
}

<style>
    .review-page {
        padding: 30px 0 60px;
    }

    .review-header {
        background: linear-gradient(135deg, #eaffd0, #f7ffed);
        border-radius: 22px;
        padding: 28px;
        margin-bottom: 22px;
        border: 1px solid #dcebcf;
    }

        .review-header h1 {
            color: #174d32;
            font-weight: 800;
            margin-bottom: 8px;
        }

    .review-card {
        background: #fff;
        border: 1px solid #dfe9da;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 8px 25px rgba(25, 75, 45, .06);
        height: 100%;
    }

        .review-card h4 {
            color: #174d32;
            font-weight: 750;
            margin-bottom: 20px;
        }

    .info-label {
        color: #78847b;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 3px;
    }

    .info-value {
        color: #254d35;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .document-item {
        padding: 16px 0;
        border-bottom: 1px solid #edf1ea;
    }

        .document-item:last-child {
            border-bottom: 0;
        }

    .document-name {
        color: #174d32;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 700;
        background: #edf4e9;
        color: #426244;
    }

    .btn-swift {
        background: #72b82a;
        border: none;
        color: #163d25;
        font-weight: 750;
        border-radius: 10px;
    }

        .btn-swift:hover {
            background: #63a520;
            color: #102d1c;
        }

    .verification-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .activation-panel {
        background: linear-gradient(135deg, #efffdc, #f8fff1);
        border: 1px solid #d4e9bf;
        border-radius: 16px;
        padding: 18px;
    }

        .activation-panel h5 {
            color: #174d32;
            font-weight: 800;
            margin-bottom: 6px;
        }

    .empty-state {
        padding: 20px;
        border-radius: 12px;
        background: #f8faf6;
        color: #6c756e;
    }
</style>

<div class="container review-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="review-header">

        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">

            <div>

                <div class="text-success fw-semibold mb-1">
                    <i class="bi bi-person-vcard me-1"></i>
                    Volunteer Onboarding Review
                </div>

                <h1>
                    @Model.Applicant?.FirstName
                    @Model.Applicant?.LastName
                </h1>

                <p class="mb-0 text-muted">
                    @(Model.VolunteerApplication
                        ?.VolunteerOpportunity
                        ?.Title ?? "Volunteer Opportunity")
                </p>

            </div>

            <div class="d-flex align-items-start">

                <span class="badge rounded-pill text-bg-success px-3 py-2">
                    @Model.Status
                </span>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->

    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- APPLICANT -->
        <!-- ===================================================== -->

        <div class="col-lg-4">

            <div class="review-card">

                <h4>
                    <i class="bi bi-person me-2"></i>
                    Applicant
                </h4>

                <div class="info-label">
                    Name
                </div>

                <div class="info-value">
                    @Model.Applicant?.FirstName
                    @Model.Applicant?.LastName
                </div>

                <div class="info-label">
                    Email
                </div>

                <div class="info-value">
                    @(Model.Applicant?.Email ?? "Not provided")
                </div>

                <div class="info-label">
                    Application
                </div>

                <div class="info-value">
                    #@Model.VolunteerApplicationId
                </div>

                <div class="info-label">
                    Onboarding
                </div>

                <div class="info-value">
                    #@Model.VolunteerOnboardingId
                </div>

                <div class="info-label">
                    Current Step
                </div>

                <div class="info-value">
                    @Model.CurrentStep
                </div>

                <div class="info-label">
                    Status
                </div>

                <div class="info-value mb-0">
                    @Model.Status
                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- REQUIREMENTS -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <div class="review-card">

                <h4>
                    <i class="bi bi-list-check me-2"></i>
                    Requirements
                </h4>

                @if (Model.Requirements == null ||
                     !Model.Requirements.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-info-circle me-2"></i>
                        No onboarding requirements have been configured.
                    </div>
                }
                else
                {
                    foreach (var requirement in Model.Requirements
                        .OrderBy(x => x.DisplayOrder))
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">

                            @if (requirement.IsCompleted)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-muted fs-5"></i>
                            }

                            <div class="flex-grow-1">

                                <div class="fw-semibold"
                                     style="color:#174d32;">
                                    @requirement.Title
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    requirement.Description))
                                {
                                    <small class="text-muted">
                                        @requirement.Description
                                    </small>
                                }

                            </div>

                            <span class="status-badge">
                                @(requirement.IsCompleted
                                    ? "Completed"
                                    : "Pending")
                            </span>

                        </div>
                    }
                }

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- DOCUMENTS -->
        <!-- ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <h4>
                    <i class="bi bi-folder-check me-2"></i>
                    Documents
                </h4>

                @if (Model.Documents == null ||
                     !Model.Documents.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-folder2-open me-2"></i>
                        No documents have been uploaded.
                    </div>
                }
                else
                {
                    foreach (var document in Model.Documents
                        .OrderByDescending(x => x.UploadedDate))
                    {
                        <div class="document-item">

                            <div class="row align-items-center g-3">

                                <!-- DOCUMENT INFORMATION -->

                                <div class="col-md-5">

                                    <div class="document-name">
                                        @document.DocumentName
                                    </div>

                                    <small class="text-muted">
                                        @document.DocumentType
                                        ·
                                        @document.FileName
                                    </small>

                                </div>


                                <!-- STATUS -->

                                <div class="col-md-2">

                                    <span class="status-badge">
                                        @document.Status
                                    </span>

                                </div>


                                <!-- DATE -->

                                <div class="col-md-2">

                                    <small class="text-muted">
                                        @document.UploadedDate
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                    </small>

                                </div>


                                <!-- ACTIONS -->

                                <div class="col-md-3 text-md-end">

                                    @if (!string.IsNullOrWhiteSpace(
                                        document.FilePath))
                                    {
                                        <a href="@Url.Content(
                                                                                                                                   "~/" + document.FilePath)"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-success me-1">

                                            <i class="bi bi-eye"></i>
                                            View

                                        </a>
                                    }

                                    <button type="button"
                                            class="btn btn-sm btn-swift"
                                            data-bs-toggle="modal"
                                            data-bs-target="#reviewDocumentModal"
                                            data-document-id="@document.VolunteerOnboardingDocumentId">

                                        <i class="bi bi-check2-square"></i>
                                        Review

                                    </button>

                                </div>

                            </div>


                            <!-- REJECTION REASON -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            document.RejectionReason))
                            {
                                <div class="alert alert-danger mt-3 mb-0">

                                    <strong>Reason:</strong>

                                    @document.RejectionReason

                                </div>
                            }

                        </div>
                    }
                }

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- VERIFICATION -->
        <!-- ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <h4>
                    <i class="bi bi-shield-check me-2"></i>
                    Verification
                </h4>

                <div class="verification-actions">

                    @if (!adminVerification &&
                         !readyForActivation &&
                         !onboardingCompleted)
                    {
                        <form asp-action="StartVerification"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="onboardingId"
                                   value="@Model.VolunteerOnboardingId" />

                            <button type="submit"
                                    class="btn btn-outline-success">

                                <i class="bi bi-play-circle me-1"></i>
                                Start Verification

                            </button>

                        </form>
                    }


                    @if (!onboardingCompleted)
                    {
                        <button type="button"
                                class="btn btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#correctionModal">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Request Correction

                        </button>
                    }


                    @if (adminVerification && !onboardingCompleted)
                    {
                        <button type="button"
                                class="btn btn-swift"
                                data-bs-toggle="modal"
                                data-bs-target="#completeVerificationModal">

                            <i class="bi bi-check-circle me-1"></i>
                            Complete Verification

                        </button>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- ACTIVATION -->
        <!-- ===================================================== -->

        <div class="col-12">

            <div class="review-card">

                <h4>
                    <i class="bi bi-person-check me-2"></i>
                    Volunteer Activation
                </h4>

                @if (readyForActivation)
                {
                    <div class="activation-panel">

                        <h5>
                            Ready for Activation
                        </h5>

                        <p class="text-muted mb-3">
                            All required onboarding verification steps have
                            been completed. You can now create and activate
                            the Volunteer account.
                        </p>

                        <a asp-controller="VolunteerOnboardingAdmin"
                               asp-action="Activate"
                               asp-route-id="@Model.VolunteerOnboardingId"
                               class="btn btn-success">

                            <i class="bi bi-person-check me-2"></i>
                            Activate Volunteer

                        </a>

                    </div>
                }
                else if (onboardingCompleted)
                {
                    <div class="activation-panel">

                        <h5>
                            Volunteer Activated
                        </h5>

                        <p class="text-muted mb-3">
                            This onboarding process has been completed and
                            the Volunteer account has been activated.
                        </p>

                        <a asp-controller="VolunteerOnboardingAdmin"
                               asp-action="ActivatedVolunteer"
                               asp-route-onboardingId="@Model.VolunteerOnboardingId"
                               class="btn btn-success">

                            <i class="bi bi-person-vcard me-2"></i>
                            View Volunteer

                        </a>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <i class="bi bi-hourglass-split me-2"></i>

                        This volunteer is not yet ready for activation.

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- REVIEW DOCUMENT MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="reviewDocumentModal"
     tabindex="-1"
     aria-labelledby="reviewDocumentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="ReviewDocument"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="reviewDocumentModalLabel">

                        Review Document

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="reviewDocumentId"
                           name="documentId" />


                    <div class="mb-3">

                        <label class="form-label">
                            Decision
                        </label>

                        <select name="status"
                                class="form-select"
                                required>

                            <option value="Approved">
                                Approve
                            </option>

                            <option value="Rejected">
                                Reject
                            </option>

                            <option value="ResubmissionRequired">
                                Request Resubmission
                            </option>

                        </select>

                    </div>


                    <div>

                        <label class="form-label">
                            Reason
                        </label>

                        <textarea name="rejectionReason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Optional review reason..."></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-swift">

                        Save Review

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CORRECTION MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="correctionModal"
     tabindex="-1"
     aria-labelledby="correctionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="RejectForCorrection"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="correctionModalLabel">

                        Request Correction

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           name="onboardingId"
                           value="@Model.VolunteerOnboardingId" />


                    <label class="form-label">
                        Reason
                    </label>

                    <textarea name="reason"
                              class="form-control"
                              rows="5"
                              maxlength="1000"
                              required
                              placeholder="Explain what the applicant needs to correct."></textarea>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        Request Correction

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- COMPLETE VERIFICATION MODAL -->
<!-- ============================================================= -->

<div class="modal fade"
     id="completeVerificationModal"
     tabindex="-1"
     aria-labelledby="completeVerificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="CompleteVerification"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="completeVerificationModalLabel">

                        Complete Verification

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           name="onboardingId"
                           value="@Model.VolunteerOnboardingId" />


                    <p class="text-muted">

                        Completing verification will move this onboarding
                        record to <strong>Ready for Activation</strong>.

                    </p>


                    <label class="form-label">
                        Verification Notes
                    </label>

                    <textarea name="verificationNotes"
                              class="form-control"
                              rows="5"
                              maxlength="1000"
                              placeholder="Optional verification notes..."></textarea>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-swift">

                        Complete Verification

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const reviewDocumentModal =
                document.getElementById("reviewDocumentModal");

            if (!reviewDocumentModal) {
                return;
            }

            reviewDocumentModal.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button =
                        event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    const documentId =
                        button.getAttribute(
                            "data-document-id"
                        );

                    const hiddenInput =
                        document.getElementById(
                            "reviewDocumentId"
                        );

                    if (hiddenInput) {
                        hiddenInput.value =
                            documentId || "";
                    }
                }
            );

        });
    </script>
}