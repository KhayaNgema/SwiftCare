@model SwiftCare.ViewModels.VolunteerInterviewViewModel

@{
    ViewData["Title"] = "Volunteer Interview";
    Layout = "~/Views/Shared/_PagesLayout.cshtml";
}



<div class="scv-interview-page">

    <div class="scv-shell">

        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="scv-header">

            <div class="scv-header-left">

                <div class="scv-avatar">
                    <i class="bi bi-robot"></i>
                </div>

                <div>

                    <div class="scv-title">
                        SwiftCare Interviewer
                    </div>

                    <div class="scv-subtitle">
                        Voice interview
                    </div>

                </div>

            </div>

            <div id="scvConnectionStatus"
                 class="scv-status">

                <span class="scv-status-dot"></span>

                <span id="scvStatusText">
                    Connecting...
                </span>

            </div>

        </div>


        <!-- ========================================================
             CHAT
             ======================================================== -->

        <div id="scvChat"
             class="scv-chat">

            <div id="scvThinking"
                 class="scv-thinking">

                <span></span>
                <span></span>
                <span></span>

            </div>


            <!-- ====================================================
                 AUTOMATIC MICROPHONE INDICATOR
                 ==================================================== -->

            <div id="scvListening"
                 class="scv-listening">

                <div class="scv-mic-icon">
                    <i class="bi bi-mic-fill"></i>
                </div>

                <span>
                    Listening
                </span>

                <div class="scv-listening-bars">

                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>

                </div>

            </div>

        </div>


        <!-- ========================================================
             FOOTER
             ======================================================== -->

        <div class="scv-footer">

            <i class="bi bi-mic"></i>

            <span>
                Speak naturally. The interviewer listens automatically.
            </span>

        </div>

    </div>

</div>


<!-- ================================================================
     SIGNALR
     ================================================================ -->

<script src="~/lib/signalr/signalr.js"></script>


<!-- ================================================================
     AZURE SPEECH SDK
     ================================================================ -->

<script src="~/lib/speech/speech-sdk.js"></script>


<script>

    (() => {

        "use strict";


        /* ============================================================
           SESSION
           ============================================================ */

        const sessionToken =
            '@Context.Request.Query["token"]';


        if (!sessionToken) {

            console.error(
                "[SWIFTCARE INTERVIEW] No session token."
            );

            return;
        }


        /* ============================================================
           DOM
           ============================================================ */

        const chat =
            document.getElementById("scvChat");

        const thinking =
            document.getElementById("scvThinking");

        const listening =
            document.getElementById("scvListening");

        const status =
            document.getElementById("scvConnectionStatus");

        const statusText =
            document.getElementById("scvStatusText");


        /* ============================================================
           STATE
           ============================================================ */

        let connection = null;

        let speechRecognizer = null;

        let speechTokenPromise = null;

        let speechTokenExpiresAt = 0;

        let currentApplicantName =
            "there";

        let currentQuestionNumber =
            0;

        let totalQuestions =
            0;

        let currentQuestionId =
            null;

        let currentQuestionText =
            "";

        let interviewStarted =
            false;

        let interviewCompleted =
            false;

        let greetingPlayed =
            false;

        let speaking =
            false;

        let listeningNow =
            false;

        let submittingAnswer =
            false;

        let recognitionStopping =
            false;

        let answerParts = [];

        let silenceTimer =
            null;

        let speechStartedAt =
            null;

        let currentVoiceBubble =
            null;

        let currentWave =
            null;

        let lastQuestionHandled =
            null;

        let reconnecting =
            false;


        /* ============================================================
           CONSTANTS
           ============================================================ */

        const GREETING_PAUSE =
            1400;

        const ANSWER_SILENCE =
            1900;

        const MINIMUM_ANSWER_LENGTH =
            2;


        /* ============================================================
           STATUS
           ============================================================ */

        function setStatus(text, isError = false) {

            if (!status || !statusText)
                return;

            statusText.textContent =
                text;

            status.classList.toggle(
                "scv-error",
                isError
            );
        }


        /* ============================================================
           SCROLL
           ============================================================ */

        function scrollChat() {

            if (!chat)
                return;

            requestAnimationFrame(() => {

                chat.scrollTop =
                    chat.scrollHeight;

            });
        }


        /* ============================================================
           THINKING
           ============================================================ */

        function showThinking() {

            if (!thinking)
                return;

            thinking.classList.add(
                "scv-visible"
            );

            scrollChat();
        }


        function hideThinking() {

            if (!thinking)
                return;

            thinking.classList.remove(
                "scv-visible"
            );
        }


        /* ============================================================
           LISTENING UI
           ============================================================ */

        function showListening() {

            if (!listening)
                return;

            listening.classList.add(
                "scv-active"
            );
        }


        function hideListening() {

            if (!listening)
                return;

            listening.classList.remove(
                "scv-active"
            );
        }


        /* ============================================================
           BOT VOICE BUBBLE
           ============================================================ */

        function addBotVoiceBubble(duration = null) {

            const row =
                document.createElement("div");

            row.className =
                "scv-row scv-row-bot";


            const bubble =
                document.createElement("div");

            bubble.className =
                "scv-bubble scv-bubble-bot";


            const label =
                document.createElement("div");

            label.className =
                "scv-bubble-label";

            label.innerHTML =
                '<i class="bi bi-robot"></i> Interviewer';


            const voiceLine =
                document.createElement("div");

            voiceLine.className =
                "scv-voice-line";


            const play =
                document.createElement("button");

            play.type =
                "button";

            play.className =
                "scv-play";

            play.innerHTML =
                '<i class="bi bi-volume-up-fill"></i>';


            const wave =
                document.createElement("div");

            wave.className =
                "scv-wave";


            for (let i = 0; i < 12; i++) {

                const bar =
                    document.createElement("span");

                wave.appendChild(bar);
            }


            const durationElement =
                document.createElement("span");

            durationElement.className =
                "scv-duration";

            durationElement.textContent =
                duration || "Voice";


            voiceLine.appendChild(play);
            voiceLine.appendChild(wave);
            voiceLine.appendChild(durationElement);

            bubble.appendChild(label);
            bubble.appendChild(voiceLine);

            row.appendChild(bubble);

            chat.insertBefore(
                row,
                thinking
            );

            scrollChat();


            play.addEventListener(
                "click",
                () => {

                    if (
                        currentQuestionText &&
                        !speaking
                    ) {

                        speakText(
                            currentQuestionText
                        );

                    }

                }
            );


            return {
                row,
                bubble,
                play,
                wave,
                durationElement
            };
        }


        /* ============================================================
           APPLICANT VOICE BUBBLE
           ============================================================ */

        function addApplicantVoiceBubble(
            durationSeconds
        ) {

            const row =
                document.createElement("div");

            row.className =
                "scv-row scv-row-user";


            const bubble =
                document.createElement("div");

            bubble.className =
                "scv-bubble scv-bubble-user";


            const label =
                document.createElement("div");

            label.className =
                "scv-bubble-label";

            label.innerHTML =
                '<i class="bi bi-mic-fill"></i> You';


            const voiceLine =
                document.createElement("div");

            voiceLine.className =
                "scv-voice-line";


            const mic =
                document.createElement("div");

            mic.className =
                "scv-play";

            mic.innerHTML =
                '<i class="bi bi-mic-fill"></i>';

            mic.style.cursor =
                "default";


            const wave =
                document.createElement("div");

            wave.className =
                "scv-wave";


            for (let i = 0; i < 12; i++) {

                const bar =
                    document.createElement("span");

                wave.appendChild(bar);
            }


            const duration =
                document.createElement("span");

            duration.className =
                "scv-duration";

            duration.textContent =
                formatDuration(
                    durationSeconds
                );


            voiceLine.appendChild(mic);
            voiceLine.appendChild(wave);
            voiceLine.appendChild(duration);

            bubble.appendChild(label);
            bubble.appendChild(voiceLine);

            row.appendChild(bubble);

            chat.insertBefore(
                row,
                thinking
            );

            scrollChat();

            return row;
        }


        /* ============================================================
           DURATION
           ============================================================ */

        function formatDuration(seconds) {

            if (!seconds ||
                seconds < 1) {

                return "Voice";
            }

            const rounded =
                Math.max(
                    1,
                    Math.round(seconds)
                );

            const minutes =
                Math.floor(
                    rounded / 60
                );

            const secs =
                rounded % 60;

            if (minutes > 0) {

                return (
                    minutes +
                    ":" +
                    String(secs)
                        .padStart(2, "0")
                );
            }

            return `${secs}s`;
        }


        /* ============================================================
           AZURE SPEECH TOKEN
           ============================================================ */

        async function getAzureSpeechToken() {

            const now =
                Date.now();

            if (
                speechTokenPromise &&
                speechTokenExpiresAt > now + 30000
            ) {

                return speechTokenPromise;
            }


            console.log(
                "[SWIFTCARE SPEECH] Requesting Azure Speech token..."
            );


            speechTokenPromise =
                fetch(
                    "/VolunteerInterview/SpeechToken?token=" +
                    encodeURIComponent(sessionToken),
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        cache: "no-store"
                    }
                )
                .then(async response => {

                    const data =
                        await response.json()
                            .catch(() => null);


                    if (!response.ok ||
                        !data ||
                        !data.success ||
                        !data.token) {

                        console.error(
                            "[SWIFTCARE SPEECH] Token failure:",
                            data
                        );

                        throw new Error(
                            "Could not obtain Azure Speech token."
                        );
                    }


                    speechTokenExpiresAt =
                        Date.now() +
                        (9 * 60 * 1000);


                    return data;
                })
                .catch(error => {

                    speechTokenPromise =
                        null;

                    speechTokenExpiresAt =
                        0;

                    throw error;
                });


            return speechTokenPromise;
        }


        /* ============================================================
           CREATE AZURE RECOGNIZER
           ============================================================ */

        async function createRecognizer() {

            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                throw new Error(
                    "Azure Speech SDK is not loaded."
                );
            }


            const speech =
                await getAzureSpeechToken();


            const speechConfig =
                SpeechSDK.SpeechConfig
                    .fromAuthorizationToken(
                        speech.token,
                        speech.region
                    );


            speechConfig.speechRecognitionLanguage =
                "en-ZA";


            /*
             * Ask Azure to finish after a short silence.
             * Our own silence timer below is still the
             * main automatic answer detector.
             */

            try {

                speechConfig.setProperty(
                    SpeechSDK.PropertyId
                        .SpeechServiceConnection_EndSilenceTimeoutMs,
                    "1500"
                );

            }
            catch (error) {

                console.warn(
                    "[SWIFTCARE SPEECH] Could not set silence timeout:",
                    error
                );
            }


            const audioConfig =
                SpeechSDK.AudioConfig
                    .fromDefaultMicrophoneInput();


            const recognizer =
                new SpeechSDK.SpeechRecognizer(
                    speechConfig,
                    audioConfig
                );


            return recognizer;
        }


        /* ============================================================
           CLEAR SILENCE TIMER
           ============================================================ */

        function clearSilenceTimer() {

            if (silenceTimer) {

                clearTimeout(
                    silenceTimer
                );

                silenceTimer =
                    null;
            }
        }


        /* ============================================================
           ARM SILENCE DETECTION
           ============================================================ */

        function armSilenceTimer() {

            clearSilenceTimer();


            if (
                !listeningNow ||
                submittingAnswer ||
                interviewCompleted
            ) {

                return;
            }


            silenceTimer =
                setTimeout(
                    () => {

                        finishListeningAndSubmit();

                    },
                    ANSWER_SILENCE
                );
        }


        /* ============================================================
           START AUTOMATIC LISTENING
           ============================================================ */

        async function startListening() {

            if (
                interviewCompleted ||
                submittingAnswer ||
                speaking ||
                listeningNow
            ) {

                return;
            }


            if (!currentQuestionId) {

                console.warn(
                    "[SWIFTCARE SPEECH] No current question."
                );

                return;
            }


            answerParts =
                [];

            speechStartedAt =
                Date.now();

            recognitionStopping =
                false;

            hideThinking();

            setStatus(
                "Listening..."
            );


            try {

                /*
                 * Explicitly request microphone permission first.
                 */

                const stream =
                    await navigator.mediaDevices
                        .getUserMedia({
                            audio: {
                                echoCancellation: true,
                                noiseSuppression: true,
                                autoGainControl: true
                            }
                        });


                /*
                 * We only need the stream to obtain permission.
                 * Azure Speech opens its own microphone input.
                 */

                stream
                    .getTracks()
                    .forEach(track =>
                        track.stop()
                    );


                speechRecognizer =
                    await createRecognizer();


                speechRecognizer.recognizing =
                    (sender, event) => {

                        if (
                            !event ||
                            !event.result
                        ) {

                            return;
                        }


                        const text =
                            event.result.text ||
                            "";


                        if (
                            text.trim().length >
                            MINIMUM_ANSWER_LENGTH
                        ) {

                            clearSilenceTimer();
                        }
                    };


                speechRecognizer.recognized =
                    (sender, event) => {

                        if (
                            !event ||
                            !event.result
                        ) {

                            return;
                        }


                        if (
                            event.result.reason !==
                            SpeechSDK.ResultReason.RecognizedSpeech
                        ) {

                            return;
                        }


                        const text =
                            (
                                event.result.text ||
                                ""
                            ).trim();


                        if (!text) {
                            return;
                        }


                        answerParts.push(
                            text
                        );


                        /*
                         * Every successful final recognition
                         * gives the applicant a fresh silence window.
                         */

                        armSilenceTimer();
                    };


                speechRecognizer.canceled =
                    (sender, event) => {

                        console.error(
                            "[SWIFTCARE SPEECH] Recognition canceled:",
                            event
                        );


                        if (
                            submittingAnswer ||
                            interviewCompleted
                        ) {

                            return;
                        }


                        listeningNow =
                            false;

                        hideListening();


                        try {

                            speechRecognizer.close();

                        }
                        catch (_) {}


                        speechRecognizer =
                            null;


                        /*
                         * If Azure token expired,
                         * refresh it on the next attempt.
                         */

                        if (
                            event &&
                            event.reason ===
                            SpeechSDK.CancellationReason.Error
                        ) {

                            speechTokenPromise =
                                null;

                            speechTokenExpiresAt =
                                0;
                        }


                        setStatus(
                            "Reconnecting microphone..."
                        );


                        setTimeout(
                            () => {

                                if (
                                    !interviewCompleted &&
                                    !speaking &&
                                    !submittingAnswer
                                ) {

                                    startListening()
                                        .catch(error => {

                                            console.error(
                                                "[SWIFTCARE SPEECH] Restart error:",
                                                error
                                            );

                                            setStatus(
                                                "Microphone unavailable",
                                                true
                                            );

                                        });
                                }

                            },
                            900
                        );
                    };


                speechRecognizer.sessionStopped =
                    () => {

                        console.log(
                            "[SWIFTCARE SPEECH] Recognition session stopped."
                        );


                        if (
                            submittingAnswer ||
                            interviewCompleted
                        ) {

                            return;
                        }


                        listeningNow =
                            false;

                        hideListening();


                        /*
                         * If the browser/Azure session ends
                         * naturally while we have an answer,
                         * submit it.
                         */

                        if (
                            answerParts.length > 0
                        ) {

                            submitCollectedAnswer();

                        }

                    };


                speechRecognizer.sessionStarted =
                    () => {

                        console.log(
                            "[SWIFTCARE SPEECH] Recognition session started."
                        );
                    };


                await new Promise(
                    (resolve, reject) => {

                        speechRecognizer.startContinuousRecognitionAsync(
                            () => {

                                listeningNow =
                                    true;

                                showListening();

                                setStatus(
                                    "Listening..."
                                );

                                console.log(
                                    "[SWIFTCARE SPEECH] Listening automatically."
                                );

                                resolve();
                            },

                            error => {

                                reject(
                                    error
                                );
                            }
                        );

                    }
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE SPEECH] Start listening error:",
                    error
                );


                listeningNow =
                    false;

                hideListening();


                if (
                    speechRecognizer
                ) {

                    try {
                        speechRecognizer.close();
                    }
                    catch (_) {}

                    speechRecognizer =
                        null;
                }


                setStatus(
                    "Microphone unavailable",
                    true
                );


                /*
                 * Try again automatically.
                 */

                setTimeout(
                    () => {

                        if (
                            !interviewCompleted &&
                            !speaking &&
                            !submittingAnswer &&
                            !listeningNow
                        ) {

                            startListening()
                                .catch(() => {});
                        }

                    },
                    1800
                );
            }
        }


        /* ============================================================
           STOP RECOGNITION
           ============================================================ */

        async function stopRecognition() {

            clearSilenceTimer();


            if (!speechRecognizer) {

                listeningNow =
                    false;

                hideListening();

                return;
            }


            const recognizer =
                speechRecognizer;


            speechRecognizer =
                null;

            listeningNow =
                false;

            recognitionStopping =
                true;

            hideListening();


            try {

                await new Promise(
                    resolve => {

                        recognizer
                            .stopContinuousRecognitionAsync(
                                () => {
                                    resolve();
                                },
                                () => {
                                    resolve();
                                }
                            );

                    }
                );

            }
            catch (error) {

                console.warn(
                    "[SWIFTCARE SPEECH] Stop error:",
                    error
                );
            }


            try {

                recognizer.close();

            }
            catch (_) {}


            recognitionStopping =
                false;
        }


        /* ============================================================
           FINISH LISTENING
           ============================================================ */

        async function finishListeningAndSubmit() {

            if (
                submittingAnswer ||
                interviewCompleted
            ) {

                return;
            }


            if (
                answerParts.length === 0
            ) {

                armSilenceTimer();

                return;
            }


            await submitCollectedAnswer();
        }


        /* ============================================================
           SUBMIT COLLECTED ANSWER
           ============================================================ */

        async function submitCollectedAnswer() {

            if (
                submittingAnswer ||
                interviewCompleted
            ) {

                return;
            }


            const answer =
                answerParts
                    .join(" ")
                    .trim();


            if (
                answer.length <
                MINIMUM_ANSWER_LENGTH
            ) {

                armSilenceTimer();

                return;
            }


            submittingAnswer =
                true;


            clearSilenceTimer();


            const duration =
                speechStartedAt
                    ? (
                        Date.now() -
                        speechStartedAt
                    ) / 1000
                    : 0;


            await stopRecognition();


            /*
             * Show only the voice bubble.
             * We deliberately DO NOT render the transcript.
             */

            addApplicantVoiceBubble(
                duration
            );


            answerParts =
                [];


            setStatus(
                "Interviewer is thinking..."
            );


            showThinking();


            try {

                await connection.invoke(
                    "SubmitAnswer",
                    sessionToken,
                    answer
                );


                console.log(
                    "[SWIFTCARE INTERVIEW] Answer submitted."
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE INTERVIEW] SubmitAnswer failed:",
                    error
                );


                submittingAnswer =
                    false;


                hideThinking();


                setStatus(
                    "Could not submit answer",
                    true
                );


                /*
                 * Allow another attempt.
                 */

                answerParts =
                    [];


                setTimeout(
                    () => {

                        if (
                            !interviewCompleted &&
                            !speaking
                        ) {

                            startListening()
                                .catch(() => {});

                        }

                    },
                    1000
                );


                return;
            }


            /*
             * IMPORTANT:
             *
             * We DO NOT start listening here.
             *
             * The server will increment CurrentQuestionNumber
             * and send BotQuestion.
             *
             * The BotQuestion handler below will speak the
             * next question and only after that finishes will
             * microphone listening begin.
             */

        }


        /* ============================================================
           TEXT TO SPEECH
           ============================================================ */

        function speakText(text) {

            return new Promise(
                resolve => {

                    if (
                        !text ||
                        !text.trim()
                    ) {

                        resolve();

                        return;
                    }


                    /*
                     * Stop any previous browser speech.
                     */

                    try {
                        window.speechSynthesis.cancel();
                    }
                    catch (_) {}


                    speaking =
                        true;


                    submittingAnswer =
                        false;


                    clearSilenceTimer();


                    hideListening();

                    hideThinking();


                    setStatus(
                        "Interviewer is speaking..."
                    );


                    /*
                     * Create the voice bubble.
                     */

                    currentVoiceBubble =
                        addBotVoiceBubble();


                    currentWave =
                        currentVoiceBubble.wave;


                    currentWave.classList.add(
                        "scv-speaking"
                    );


                    const utterance =
                        new SpeechSynthesisUtterance(
                            text
                        );


                    utterance.lang =
                        "en-ZA";


                    /*
                     * Slightly slower than normal.
                     * This makes the interviewer sound
                     * more natural and easier to follow.
                     */

                    utterance.rate =
                        0.94;


                    utterance.pitch =
                        1.0;


                    utterance.volume =
                        1.0;


                    /*
                     * Prefer an English South African
                     * voice when the browser provides one.
                     */

                    const voices =
                        window.speechSynthesis
                            .getVoices();


                    const preferredVoice =
                        voices.find(
                            voice =>
                                voice.lang &&
                                voice.lang
                                    .toLowerCase()
                                    .startsWith(
                                        "en-za"
                                    )
                        )
                        ||
                        voices.find(
                            voice =>
                                voice.lang &&
                                voice.lang
                                    .toLowerCase()
                                    .startsWith(
                                        "en"
                                    )
                        );


                    if (preferredVoice) {

                        utterance.voice =
                            preferredVoice;
                    }


                    utterance.onstart =
                        () => {

                            speaking =
                                true;


                            if (currentWave) {

                                currentWave.classList.add(
                                    "scv-speaking"
                                );
                            }

                        };


                    utterance.onend =
                        async () => {

                            speaking =
                                false;


                            if (currentWave) {

                                currentWave.classList.remove(
                                    "scv-speaking"
                                );
                            }


                            setStatus(
                                "Interviewer is listening..."
                            );


                            resolve();
                        };


                    utterance.onerror =
                        error => {

                            console.error(
                                "[SWIFTCARE TTS] Speech error:",
                                error
                            );


                            speaking =
                                false;


                            if (currentWave) {

                                currentWave.classList.remove(
                                    "scv-speaking"
                                );
                            }


                            resolve();
                        };


                    window.speechSynthesis.speak(
                        utterance
                    );

                }
            );
        }


        /* ============================================================
           NATURAL PAUSE
           ============================================================ */

        function wait(milliseconds) {

            return new Promise(
                resolve =>
                    setTimeout(
                        resolve,
                        milliseconds
                    )
            );
        }


        /* ============================================================
           HANDLE CURRENT QUESTION
           ============================================================ */

        async function handleQuestion(
            questionData,
            fromBotQuestion = false
        ) {

            if (
                interviewCompleted ||
                !questionData
            ) {

                return;
            }


            /*
             * The hub sends:
             *
             * questionId
             * questionNumber
             * totalQuestions
             * question
             * existingAnswer
             * isLastQuestion
             */

            const question =
                questionData.question ||
                questionData.Question ||
                questionData.currentQuestion ||
                questionData.CurrentQuestion ||
                "";


            const questionId =
                questionData.questionId ??
                questionData.QuestionId ??
                questionData.currentQuestionId ??
                questionData.CurrentQuestionId ??
                null;


            const questionNumber =
                questionData.questionNumber ??
                questionData.QuestionNumber ??
                questionData.currentQuestionNumber ??
                questionData.CurrentQuestionNumber ??
                0;


            const total =
                questionData.totalQuestions ??
                questionData.TotalQuestions ??
                0;


            if (!question) {

                console.error(
                    "[SWIFTCARE INTERVIEW] BotQuestion received without question text:",
                    questionData
                );

                hideThinking();

                setStatus(
                    "Interviewer could not load the question",
                    true
                );

                return;
            }


            /*
             * Prevent the same server question from being
             * spoken twice after reconnects.
             */

            const questionKey =
                `${questionNumber}:${questionId}:${question}`;


            if (
                lastQuestionHandled ===
                questionKey
            ) {

                console.log(
                    "[SWIFTCARE INTERVIEW] Duplicate question ignored:",
                    questionKey
                );

                return;
            }


            lastQuestionHandled =
                questionKey;


            currentQuestionNumber =
                Number(questionNumber) || 0;


            totalQuestions =
                Number(total) || totalQuestions;


            currentQuestionId =
                questionId;


            currentQuestionText =
                question;


            hideThinking();

            hideListening();


            /*
             * If this came from BotQuestion after an answer,
             * give the conversation a small natural pause.
             */

            if (fromBotQuestion) {

                await wait(700);

            }


            if (
                interviewCompleted
            ) {

                return;
            }


            /*
             * Speak the question.
             */

            await speakText(
                question
            );


            if (
                interviewCompleted
            ) {

                return;
            }


            /*
             * IMPORTANT:
             *
             * Only after the interviewer has completely
             * finished talking do we open the microphone.
             */

            await wait(350);


            if (
                !interviewCompleted &&
                !speaking &&
                !submittingAnswer
            ) {

                await startListening();
            }

        }


        /* ============================================================
           HANDLE INITIAL INTERVIEW STATE
           ============================================================ */

        async function handleInterviewState(
            state
        ) {

            if (
                !state ||
                interviewCompleted
            ) {

                return;
            }


            console.log(
                "[SWIFTCARE INTERVIEW] InterviewState:",
                state
            );


            const applicantName =
                state.applicantName ||
                state.ApplicantName ||
                "Applicant";


            currentApplicantName =
                applicantName.trim() ||
                "Applicant";


            currentQuestionNumber =
                Number(
                    state.currentQuestionNumber ??
                    state.CurrentQuestionNumber ??
                    0
                );


            totalQuestions =
                Number(
                    state.totalQuestions ??
                    state.TotalQuestions ??
                    0
                );


            currentQuestionId =
                state.currentQuestionId ??
                state.CurrentQuestionId ??
                null;


            currentQuestionText =
                state.currentQuestion ||
                state.CurrentQuestion ||
                "";


            /*
             * If reconnecting to an interview where the
             * greeting has already happened, do NOT greet again.
             */

            if (greetingPlayed) {

                if (
                    currentQuestionText &&
                    !speaking &&
                    !listeningNow &&
                    !submittingAnswer
                ) {

                    await handleQuestion(
                        {
                            questionId:
                                currentQuestionId,

                            questionNumber:
                                currentQuestionNumber,

                            totalQuestions:
                                totalQuestions,

                            question:
                                currentQuestionText
                        },
                        false
                    );
                }

                return;
            }


            greetingPlayed =
                true;


            /*
             * First greeting.
             */

            const greeting =
                `Hello ${currentApplicantName}. ` +
                `Welcome to your SwiftCare volunteer interview. ` +
                `I will ask you a few questions. ` +
                `Please answer naturally, just as if you were speaking with a real interviewer.`;


            await speakText(
                greeting
            );


            /*
             * Natural pause after greeting.
             */

            await wait(
                GREETING_PAUSE
            );


            if (
                interviewCompleted
            ) {

                return;
            }


            /*
             * Now ask the server's current question.
             */

            if (
                currentQuestionText
            ) {

                await handleQuestion(
                    {
                        questionId:
                            currentQuestionId,

                        questionNumber:
                            currentQuestionNumber,

                        totalQuestions:
                            totalQuestions,

                        question:
                            currentQuestionText
                    },
                    false
                );

            }
            else {

                showThinking();

                setStatus(
                    "Interviewer is preparing..."
                );
            }

        }


        /* ============================================================
           BOT QUESTION
           ============================================================ */

        /*
         * THIS IS THE IMPORTANT FIX.
         *
         * The hub calls:
         *
         * Clients.Group(sessionToken)
         *     .SendAsync("BotQuestion", ...)
         *
         * Therefore the browser MUST register:
         *
         * connection.on("BotQuestion", ...)
         *
         * before connection.start().
         */

        function registerBotQuestionHandler() {

            connection.on(
                "BotQuestion",
                async questionData => {

                    console.log(
                        "[SWIFTCARE INTERVIEW] BotQuestion received:",
                        questionData
                    );


                    /*
                     * Stop any old microphone state.
                     */

                    clearSilenceTimer();


                    if (
                        speechRecognizer
                    ) {

                        try {

                            await stopRecognition();

                        }
                        catch (_) {}

                    }


                    listeningNow =
                        false;


                    hideListening();


                    submittingAnswer =
                        false;


                    answerParts =
                        [];


                    /*
                     * Now speak the question sent
                     * directly from the hub.
                     */

                    await handleQuestion(
                        questionData,
                        true
                    );

                }
            );

        }


        /* ============================================================
           INTERVIEW STATE HANDLER
           ============================================================ */

        function registerInterviewStateHandler() {

            connection.on(
                "InterviewState",
                async state => {

                    await handleInterviewState(
                        state
                    );

                }
            );

        }


        /* ============================================================
           APPLICANT MESSAGE
           ============================================================ */

        function registerApplicantMessageHandler() {

            connection.on(
                "ApplicantMessage",
                message => {

                    /*
                     * The server sends the answer back to the
                     * group, but we deliberately DO NOT display
                     * its transcript.
                     */

                    console.log(
                        "[SWIFTCARE INTERVIEW] ApplicantMessage received."
                    );

                }
            );

        }


        /* ============================================================
           COMPLETED
           ============================================================ */

        function registerCompletedHandler() {

            connection.on(
                "InterviewCompleted",
                async message => {

                    console.log(
                        "[SWIFTCARE INTERVIEW] Completed:",
                        message
                    );


                    interviewCompleted =
                        true;


                    clearSilenceTimer();


                    await stopRecognition();


                    hideListening();

                    hideThinking();


                    try {

                        window.speechSynthesis.cancel();

                    }
                    catch (_) {}


                    speaking =
                        false;


                    setStatus(
                        "Interview completed"
                    );


                    /*
                     * Small final voice message.
                     */

                    await speakText(
                        "Thank you for completing the interview. " +
                        "Your responses have been recorded successfully."
                    );


                    setStatus(
                        "Interview completed"
                    );

                }
            );

        }


        /* ============================================================
           SIGNALR CONNECTION
           ============================================================ */

        async function createConnection() {

            connection =
                new signalR.HubConnectionBuilder()

                    .withUrl(
                        "/volunteerInterviewHub"
                    )

                    .withAutomaticReconnect(
                        [0, 2000, 5000, 10000]
                    )

                    .configureLogging(
                        signalR.LogLevel.Warning
                    )

                    .build();


            /* ========================================================
               IMPORTANT:
               ALL CLIENT HANDLERS ARE REGISTERED BEFORE START.
               ======================================================== */

            registerBotQuestionHandler();

            registerInterviewStateHandler();

            registerApplicantMessageHandler();

            registerCompletedHandler();


            /* ========================================================
               CONNECTED
               ======================================================== */

            connection.onreconnecting(
                error => {

                    console.warn(
                        "[SWIFTCARE SIGNALR] Reconnecting:",
                        error
                    );


                    setStatus(
                        "Reconnecting..."
                    );


                    hideListening();

                }
            );


            connection.onreconnected(
                async connectionId => {

                    console.log(
                        "[SWIFTCARE SIGNALR] Reconnected:",
                        connectionId
                    );


                    setStatus(
                        "Connected"
                    );


                    /*
                     * Rejoin the interview group.
                     *
                     * The server's JoinInterview method will then
                     * send InterviewState.
                     */

                    try {

                        await connection.invoke(
                            "JoinInterview",
                            sessionToken
                        );

                    }
                    catch (error) {

                        console.error(
                            "[SWIFTCARE SIGNALR] Rejoin failed:",
                            error
                        );

                        setStatus(
                            "Could not resume interview",
                            true
                        );
                    }

                }
            );


            connection.onclose(
                error => {

                    console.error(
                        "[SWIFTCARE SIGNALR] Connection closed:",
                        error
                    );


                    if (
                        !interviewCompleted
                    ) {

                        setStatus(
                            "Connection lost",
                            true
                        );
                    }

                }
            );


            /* ========================================================
               START
               ======================================================== */

            try {

                await connection.start();


                console.log(
                    "[SWIFTCARE SIGNALR] Connected."
                );


                setStatus(
                    "Connected"
                );


                /*
                 * Join only AFTER all connection.on handlers
                 * have already been registered.
                 */

                await connection.invoke(
                    "JoinInterview",
                    sessionToken
                );


                interviewStarted =
                    true;


                console.log(
                    "[SWIFTCARE INTERVIEW] Joined interview."
                );

            }
            catch (error) {

                console.error(
                    "[SWIFTCARE SIGNALR] Connection/start error:",
                    error
                );


                setStatus(
                    "Unable to connect",
                    true
                );

            }

        }


        /* ============================================================
           CLEANUP
           ============================================================ */

        window.addEventListener(
            "beforeunload",
            () => {

                clearSilenceTimer();


                try {

                    window.speechSynthesis.cancel();

                }
                catch (_) {}


                if (
                    speechRecognizer
                ) {

                    try {

                        speechRecognizer.stopContinuousRecognitionAsync(
                            () => {},
                            () => {}
                        );

                    }
                    catch (_) {}

                }

            }
        );


        /* ============================================================
           START INTERVIEW
           ============================================================ */

        async function initializeInterview() {

            console.log(
                "[SWIFTCARE INTERVIEW] Initializing..."
            );


            if (
                typeof signalR ===
                "undefined"
            ) {

                setStatus(
                    "SignalR unavailable",
                    true
                );

                console.error(
                    "[SWIFTCARE INTERVIEW] signalR.js not loaded."
                );

                return;
            }


            if (
                typeof SpeechSDK ===
                "undefined"
            ) {

                setStatus(
                    "Speech system unavailable",
                    true
                );

                console.error(
                    "[SWIFTCARE INTERVIEW] Azure Speech SDK not loaded."
                );

                return;
            }


            /*
             * Load voices before the first greeting.
             */

            try {

                window.speechSynthesis
                    .getVoices();

            }
            catch (_) {}


            /*
             * Some browsers populate voices asynchronously.
             */

            if (
                "onvoiceschanged" in
                window.speechSynthesis
            ) {

                window.speechSynthesis
                    .onvoiceschanged =
                    () => {

                        try {

                            window.speechSynthesis
                                .getVoices();

                        }
                        catch (_) {}

                    };
            }


            await createConnection();

        }


        /* ============================================================
           START
           ============================================================ */

        initializeInterview()
            .catch(error => {

                console.error(
                    "[SWIFTCARE INTERVIEW] Initialization failed:",
                    error
                );


                setStatus(
                    "Interview could not start",
                    true
                );

            });


    })();

</script>